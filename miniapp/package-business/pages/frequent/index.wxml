<view class="page"><responsive-topbar title="常购清单" subtitle="真实历史清单 · 数量按采购规则校验" bind:back="back"/><view wx:if="{{status == 'loading'}}" class="state">正在加载常购清单</view><view wx:elif="{{status == 'error'}}" class="state"><text>常购清单加载失败</text><text>{{errorText}}</text><button bindtap="retry">重新加载</button></view><view wx:elif="{{status == 'forbidden'}}" class="state"><text>需要登录</text><text>{{errorText}}</text><button bindtap="back">返回登录</button></view><view wx:elif="{{status == 'empty'}}" class="state"><text>暂无常购商品</text><text>完成采购后，服务端会生成真实常购记录</text></view><block wx:elif="{{status == 'ready'}}"><view wx:for="{{rows}}" wx:key="id" class="card {{item.unavailable ? 'disabled' : ''}}"><view class="check" data-id="{{item.id}}" bindtap="toggle">{{item.selected ? '✓' : ''}}</view><image src="{{item.image || '/assets/products/placeholder.svg'}}" mode="aspectFit"/><view class="info"><text>{{item.name}}</text><text>{{item.spec}}</text><text>{{item.minOrderQuantity}} 件起购 · {{item.orderMultiple}} 件倍数</text><text wx:if="{{item.unavailable}}" class="warning">{{item.unavailableReason || '商品当前不可加购'}}</text></view><view wx:if="{{!item.unavailable}}" class="qty"><button data-id="{{item.id}}" data-direction="-1" bindtap="changeQuantity">−</button><text>{{item.quantity}}</text><button data-id="{{item.id}}" data-direction="1" bindtap="changeQuantity">＋</button></view></view><view wx:if="{{resultVisible}}" class="result"><text>成功加入 {{addedItems.length}} 项</text><text wx:for="{{invalidItems}}" wx:key="index">未加入：{{item.name || item.skuId || '商品'}} · {{item.reason || item.message || '当前不可用'}}</text><button wx:if="{{addedItems.length}}" bindtap="goCart">查看购物车</button></view><view class="bar"><button disabled="{{submitLocked}}" bindtap="batchAdd">{{submitLocked ? '正在加入' : '批量加入购物车'}}</button></view></block></view>
