<view class="page"><responsive-topbar title="常购清单" subtitle="常买商品，批量加购" bind:back="back"/><view wx:if="{{status == 'loading'}}" class="state state-loading">正在加载常购清单</view><view wx:elif="{{status == 'error'}}" class="state"><text>常购清单加载失败</text><text>{{errorText}}</text><button bindtap="retry">重新加载</button></view><view wx:elif="{{status == 'forbidden'}}" class="state"><text>仅企业采购账户可用</text><text>{{errorText}}</text><button bindtap="back">返回</button></view><view wx:elif="{{status == 'empty'}}" class="state"><text>暂无常购商品</text><text>完成采购后，常买商品会显示在这里</text></view><block wx:elif="{{status == 'ready'}}"><view wx:for="{{rows}}" wx:key="id" class="card {{item.unavailable ? 'disabled' : ''}}"><view class="check" data-id="{{item.id}}" aria-role="checkbox" aria-checked="{{item.selected}}" aria-label="{{item.selected ? '取消选择' : '选择'}} {{item.name}}" hover-class="control-pressed" bindtap="toggle"><text aria-hidden="true">{{item.selected ? '✓' : ''}}</text></view><image src="{{item.image || '/assets/products/placeholder.svg'}}" mode="aspectFit"/><view class="info"><text>{{item.name}}</text><text>{{item.spec}}</text><text>{{item.purchaseRuleText}}</text><text wx:if="{{item.unavailable}}" class="warning">{{item.unavailableReason || '商品当前不可加购'}}</text></view><view wx:if="{{!item.unavailable}}" class="qty"><quantity-stepper compact quantity="{{item.quantity}}" min="{{item.minOrderQuantity}}" max="{{999}}" step="{{item.orderMultiple}}" bind:change="changeQuantity" data-id="{{item.id}}" /></view></view><view wx:if="{{resultVisible}}" class="result"><text>成功加入 {{addedItems.length}} 项</text><text wx:for="{{invalidItems}}" wx:key="index">未加入：{{item.name || '商品'}} · {{item.reason || item.message || '当前不可用'}}</text><button wx:if="{{addedItems.length}}" bindtap="goCart">查看购物车</button></view><view class="bar"><button disabled="{{submitLocked}}" bindtap="batchAdd">{{submitLocked ? '正在加入' : '批量加入购物车'}}</button></view></block></view>
