.page{min-height:100vh;padding-bottom:140rpx;background:#f3f7fc;color:#203a53}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:18px;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:13px}.card{display:flex;align-items:center;margin:18rpx;padding:22rpx;border-radius:12rpx;background:#fff;gap:14rpx}.card.disabled{opacity:.65}.check{display:flex;align-items:center;justify-content:center;width:34rpx;height:34rpx;border:2rpx solid #a9bed2;border-radius:50%;color:#fff;background:#0a69e9;font-size:14px}.card image{width:78rpx;height:78rpx}.info{display:flex;min-width:0;flex:1;flex-direction:column;gap:5rpx}.info text:first-child{font-size:14px;font-weight:700}.info text:not(:first-child){color:#60768c;font-size:13px}.info .warning{color:#c95042}.qty{display:flex;align-items:center;gap:7rpx}.qty button{width:42rpx;height:42rpx;margin:0;padding:0;color:#0a69e9;background:#edf5ff;font-size:14px;line-height:42rpx}.qty text{min-width:30rpx;text-align:center;font-size:14px}.state,.result{display:flex;align-items:center;justify-content:center;min-height:260rpx;margin:18rpx;padding:26rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx;text-align:center}.state text:nth-child(2),.result text:not(:first-child){color:#60768c;font-size:14px}.result{align-items:stretch;min-height:0;text-align:left}.result>text:first-child{color:#16805c;font-weight:700}.bar{position:fixed;right:0;bottom:0;left:0;padding:15rpx 18rpx calc(15rpx + env(safe-area-inset-bottom));background:#fff}.bar button{color:#fff;background:#0a69e9;font-size:14px}


/* 交付态控件层级：触控尺寸使用 px，避免窄屏被 rpx 继续缩小。 */
button {
  min-height: 44px;
  box-sizing: border-box;
  white-space: nowrap;
  line-height: 1.25;
}

.control-pressed {
  opacity: .72;
}

.state {
  min-height: 0;
  padding-top: 44rpx;
  padding-bottom: 44rpx;
}

.state-loading {
  min-height: 320rpx;
}

.check,
.qty button {
  width: 44px;
  min-width: 44px;
  height: 44px;
  min-height: 44px;
  padding: 0;
}


input,
textarea,
picker {
  min-height: 44px;
  box-sizing: border-box;
  font-size: 14px;
}

/* 底部内容占位与固定操作栏高度使用同一组安全区计算。 */
.page {
  padding-bottom: calc(44px + 30rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(44px + 30rpx + env(safe-area-inset-bottom));
}

.bar {
  padding: 15rpx 18rpx calc(15rpx + constant(safe-area-inset-bottom));
  padding: 15rpx 18rpx calc(15rpx + env(safe-area-inset-bottom));
}

/* Keep hit targets accessible without enlarging their visible faces. */
.check {
  position: relative;
  width: 44px;
  min-width: 44px;
  height: 44px;
  border: 0;
  background: transparent;
}

.check::before {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 34rpx;
  max-width: 22px;
  height: 34rpx;
  max-height: 22px;
  border: 1px solid #7fa7cf;
  border-radius: 50%;
  box-sizing: border-box;
  background: #0a69e9;
  transform: translate(-50%, -50%);
  content: "";
}

.check > text {
  position: relative;
  z-index: 1;
}

.qty button {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.qty button::after {
  border: 0;
}

.qty button > text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  min-width: 0;
  max-width: 28px;
  height: 42rpx;
  max-height: 28px;
  box-sizing: border-box;
  border: 1px solid #829ab2;
  border-radius: 50%;
  color: #365675;
  background: #fff;
  line-height: 1;
}

.qty button:last-child > text {
  border-color: #287ff1;
  color: #fff;
  background: #287ff1;
}
