.page{min-height:100vh;padding-bottom:140rpx;background:#f3f7fc;color:#203a53}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:32rpx;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:20rpx}.card{display:flex;align-items:center;margin:18rpx;padding:22rpx;border-radius:12rpx;background:#fff;gap:14rpx}.card.disabled{opacity:.65}.check{display:flex;align-items:center;justify-content:center;width:34rpx;height:34rpx;border:2rpx solid #a9bed2;border-radius:50%;color:#fff;background:#0a69e9;font-size:21rpx}.card image{width:78rpx;height:78rpx}.info{display:flex;min-width:0;flex:1;flex-direction:column;gap:5rpx}.info text:first-child{font-size:23rpx;font-weight:700}.info text:not(:first-child){color:#60768c;font-size:20rpx}.info .warning{color:#c95042}.qty{display:flex;align-items:center;gap:7rpx}.qty button{width:42rpx;height:42rpx;margin:0;padding:0;color:#0a69e9;background:#edf5ff;font-size:23rpx;line-height:42rpx}.qty text{min-width:30rpx;text-align:center;font-size:21rpx}.state,.result{display:flex;align-items:center;justify-content:center;min-height:260rpx;margin:18rpx;padding:26rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx;text-align:center}.state text:nth-child(2),.result text:not(:first-child){color:#60768c;font-size:21rpx}.result{align-items:stretch;min-height:0;text-align:left}.result>text:first-child{color:#16805c;font-weight:700}.bar{position:fixed;right:0;bottom:0;left:0;padding:15rpx 18rpx calc(15rpx + env(safe-area-inset-bottom));background:#fff}.bar button{color:#fff;background:#0a69e9;font-size:24rpx}
