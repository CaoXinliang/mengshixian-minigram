<view class="page"><responsive-topbar title="询价详情" subtitle="查看报价版本与有效期" bind:back="back"/><view wx:if="{{status == 'loading'}}" class="state state-loading">正在加载询价详情</view><view wx:elif="{{status != 'ready'}}" class="state"><text>{{status == 'empty' ? '询价不存在' : '暂时无法查看'}}</text><text>{{errorText}}</text><button wx:if="{{status == 'error'}}" bindtap="retry">重新加载</button></view><block wx:elif="{{detail}}"><view class="card hero"><text>{{detail.statusLabel}}</text><text>询价单 {{detail.inquiryNo}}</text><text>{{detail.description || '未填写补充说明'}}</text></view><view class="card"><text class="title">询价商品</text><view wx:for="{{detail.items}}" wx:key="skuId" class="row"><view><text>{{item.productNameSnapshot || item.productName || '询价商品'}}</text><text>{{item.specSnapshot || item.specName}}</text></view><text>×{{item.quantity}}</text></view></view><view wx:if="{{detail.quote}}" class="card quote"><view class="quote-head"><text>报价 V{{detail.quote.version}}</text><text>{{detail.quote.expired ? '已过期' : ('有效期至 ' + detail.quote.validUntilText)}}</text></view><text wx:if="{{detail.quote.temporary}}" class="draft">报价待确认，暂不可接受</text><view wx:for="{{detail.quote.items}}" wx:key="skuId" class="row"><view><text>{{item.productNameSnapshot || item.productName || '询价商品'}}</text><text>单价 ¥{{item.unitPrice}}</text></view><text>小计 ¥{{item.subtotal}}</text></view><button wx:if="{{detail.canAccept}}" disabled="{{acceptLocked}}" bindtap="accept">{{acceptLocked ? '正在接受' : '接受正式报价'}}</button><text wx:elif="{{detail.quote.expired}}" class="warning">报价已过有效期，请重新询价</text></view><view wx:else class="card empty">暂未报价</view><text wx:if="{{acceptError}}" class="error">{{acceptError}}</text><view wx:if="{{acceptResult}}" class="card result"><text>报价已接受</text><text>已加入购物车 {{acceptResult.addedItems.length}} 项</text><text wx:for="{{acceptResult.invalidItems}}" wx:key="index">未加入：{{item.name || '商品'}} · {{item.reason || item.message || '当前不可用'}}</text><view><button wx:if="{{acceptResult.addedItems.length}}" bindtap="goCart">查看购物车</button><button wx:if="{{acceptResult.quoteToken}}" bindtap="goCheckout">按报价结算</button></view></view></block></view>
