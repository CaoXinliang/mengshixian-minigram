.page{min-height:100vh;background:#f3f7fc;color:#203a53}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:32rpx;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:20rpx}.card{display:flex;margin:18rpx;padding:24rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:13rpx}.hero{color:#fff;background:linear-gradient(135deg,#123b61,#0a69e9)}.hero text:first-child{font-size:30rpx;font-weight:700}.hero text:not(:first-child){color:#dcecff;font-size:20rpx}.title,.quote-head text:first-child{font-size:25rpx;font-weight:700}.row,.quote-head{display:flex;align-items:center;justify-content:space-between;gap:14rpx;padding:11rpx 0;border-top:1rpx solid #edf1f4}.row>view{display:flex;min-width:0;flex:1;flex-direction:column;gap:4rpx}.row text{font-size:20rpx}.row>view text:last-child,.quote-head text:last-child{color:#60768c;font-size:18rpx}.quote button{margin:8rpx 0 0;color:#fff;background:#0a69e9}.draft,.warning{padding:13rpx;border-radius:8rpx;color:#a45a1f;background:#fff4de;font-size:20rpx}.error{display:block;margin:18rpx;padding:13rpx;color:#c95042;background:#fff1ef}.result>view{display:flex;gap:10rpx}.result button{flex:1;margin:0;color:#0a69e9;background:#edf5ff;font-size:20rpx}.state{display:flex;align-items:center;justify-content:center;min-height:350rpx;margin:18rpx;background:#fff;flex-direction:column;gap:12rpx;text-align:center}.state text:nth-child(2){color:#60768c;font-size:21rpx}


.control-pressed {
  opacity: .72;
}

.state {
  min-height: 0;
  padding-top: 44rpx;
  padding-bottom: 44rpx;
}

.state-loading {
  min-height: 320rpx;
}


.result > view {
  min-width: 0;
  flex-wrap: wrap;
}

.result button {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  flex: 1 1 220rpx;
  box-sizing: border-box;
  white-space: normal;
  overflow-wrap: anywhere;
}

.hero text,
.draft,
.warning,
.error,
.row text,
.quote-head text {
  overflow-wrap: anywhere;
}

.row {
  align-items: flex-start;
}

.row > view {
  min-width: 0;
  flex: 1;
}

.row > text {
  max-width: 46%;
  flex: none;
  text-align: right;
}

.quote-head {
  align-items: flex-start;
}

.quote-head text:first-child {
  flex: none;
}

.quote-head text:last-child {
  min-width: 0;
  flex: 1;
  text-align: right;
  white-space: normal;
}

/* Fixed readable typography; amounts and explanations can wrap. */
.page { font-size: 16px; line-height: 1.5; }
.hero text:first-child { font-size: 20px; }
.title, .quote-head text:first-child { font-size: 18px; }
.row text { font-size: 16px; }
.hero text:not(:first-child), .row > view text:last-child,
.quote-head text:last-child, .draft, .warning,
.state text:nth-child(2) { font-size: 14px; }
.result button, .quote button, .state button {
  min-height: 44px;
  font-size: 16px;
  line-height: 1.5;
  white-space: normal;
}
