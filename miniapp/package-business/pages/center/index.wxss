.page{min-height:100vh;background:#f3f7fc;color:#203a53}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:18px;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:13px}.account{display:flex;margin:18rpx;padding:28rpx;border-radius:15rpx;color:#fff;background:linear-gradient(135deg,#123b61,#0a69e9);flex-direction:column;gap:9rpx}.account>text:first-child{font-size:18px;font-weight:700}.account>text:nth-child(2){color:#dcecff;font-size:13px}.account>view{display:grid;margin-top:15rpx;grid-template-columns:repeat(3,1fr)}.account>view>view{display:flex;flex-direction:column;gap:7rpx}.account>view>view text:first-child{color:#dcecff;font-size:13px}.account>view>view text:last-child{font-size:14px;font-weight:700}.quick{display:grid;margin:18rpx;grid-template-columns:repeat(3,1fr);gap:10rpx}.quick button{margin:0;padding:16rpx 8rpx;border-radius:8rpx;color:#0a69e9;background:#fff;font-size:14px}.card{display:flex;margin:18rpx;padding:24rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx}.title{font-size:16px;font-weight:700}.row{display:flex;align-items:center;justify-content:space-between;padding:12rpx 0;border-top:1rpx solid #edf1f4}.row>view{display:flex;flex-direction:column;gap:4rpx}.row>view text:first-child{font-size:14px;font-weight:700}.row>view text:last-child,.empty{color:#60768c;font-size:13px}.row>text{color:#e35d36;font-size:14px;font-weight:700}.state{display:flex;align-items:center;justify-content:center;min-height:360rpx;margin:18rpx;padding:30rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx;text-align:center}.state text:nth-child(2){color:#60768c;font-size:14px}


/* 交付态控件层级：触控尺寸使用 px，避免窄屏被 rpx 继续缩小。 */
button {
  min-height: 44px;
  box-sizing: border-box;
  white-space: nowrap;
  line-height: 1.25;
}

.control-pressed {
  opacity: .72;
}

.state {
  min-height: 0;
  padding-top: 44rpx;
  padding-bottom: 44rpx;
}

.state-loading {
  min-height: 320rpx;
}


input,
textarea,
picker {
  min-height: 44px;
  box-sizing: border-box;
  font-size: 14px;
}

.quick {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.quick button {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  white-space: normal;
  overflow-wrap: anywhere;
}
