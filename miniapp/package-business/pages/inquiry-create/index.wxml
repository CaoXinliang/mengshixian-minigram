<view class="page"><responsive-topbar title="新建询价" subtitle="选择商品并填写采购数量" bind:back="back"/><view wx:if="{{status == 'loading'}}" class="state state-loading">正在加载商品</view><view wx:elif="{{status == 'forbidden' || status == 'error'}}" class="state"><text>{{status == 'forbidden' ? '暂不可访问' : '商品加载失败'}}</text><text>{{errorText}}</text><button wx:if="{{status == 'error'}}" bindtap="retry">重新加载</button></view><view wx:elif="{{status == 'empty'}}" class="state"><text>暂无可询价商品</text></view><block wx:else><input class="search" value="{{query}}" bindinput="inputSearch" placeholder="搜索商品或规格"/><view wx:for="{{rows}}" wx:key="id" wx:if="{{item.visible}}" class="item"><view class="check" data-id="{{item.id}}" aria-role="checkbox" aria-checked="{{item.selected}}" aria-label="{{item.selected ? '取消选择' : '选择'}} {{item.name}}" hover-class="control-pressed" bindtap="toggle"><text aria-hidden="true">{{item.selected ? '✓' : ''}}</text></view><view class="info"><text>{{item.name}}</text><text>{{item.spec}} · {{item.purchaseRuleText}}</text></view><view class="qty"><quantity-stepper compact quantity="{{item.quantity}}" min="{{item.minOrderQuantity}}" max="{{999}}" step="{{item.orderMultiple}}" bind:change="quantity" data-id="{{item.id}}" /></view></view><view class="note"><textarea maxlength="500" value="{{description}}" bindinput="description" placeholder="采购要求、交期或其他说明（选填）"/><text>{{description.length}}/500</text></view><text wx:if="{{submitError}}" class="error">{{submitError}}</text><view class="bar"><button disabled="{{submitLocked}}" bindtap="submit">{{submitLocked ? '正在提交' : '提交询价'}}</button></view></block></view>
