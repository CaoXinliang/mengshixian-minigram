.page{min-height:100vh;padding-bottom:140rpx;background:#f3f7fc;color:#203a53}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:32rpx;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:20rpx}.search{box-sizing:border-box;margin:18rpx;width:calc(100% - 36rpx);padding:18rpx 22rpx;border-radius:10rpx;background:#fff;font-size:22rpx}.item{display:flex;align-items:center;margin:12rpx 18rpx;padding:20rpx;border-radius:10rpx;background:#fff;gap:12rpx}.check{display:flex;align-items:center;justify-content:center;width:34rpx;height:34rpx;border:2rpx solid #a9bed2;border-radius:50%;color:#fff;background:#0a69e9}.info{display:flex;min-width:0;flex:1;flex-direction:column;gap:5rpx}.info text:first-child{font-size:22rpx;font-weight:700}.info text:last-child{color:#60768c;font-size:18rpx}.qty{display:flex;align-items:center;gap:6rpx}.qty button{width:40rpx;height:40rpx;margin:0;padding:0;color:#0a69e9;background:#edf5ff;line-height:40rpx}.qty text{min-width:28rpx;text-align:center}.note{display:flex;margin:18rpx;padding:18rpx;border-radius:10rpx;background:#fff;flex-direction:column}.note textarea{width:100%;height:150rpx;font-size:21rpx}.note text{align-self:flex-end;color:#8292a3;font-size:18rpx}.error{display:block;margin:18rpx;padding:12rpx;color:#c95042;background:#fff1ef}.bar{position:fixed;right:0;bottom:0;left:0;padding:15rpx 18rpx calc(15rpx + env(safe-area-inset-bottom));background:#fff}.bar button{margin:0;color:#fff;background:#0a69e9}.state{display:flex;align-items:center;justify-content:center;min-height:350rpx;margin:18rpx;background:#fff;flex-direction:column;gap:12rpx}
