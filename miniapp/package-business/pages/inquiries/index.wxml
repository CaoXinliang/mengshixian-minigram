<view class="page"><responsive-topbar title="询价记录" subtitle="查看报价与有效期" action-label="{{canCreateInquiry ? '新建询价' : ''}}" bind:back="back" bind:action="create"/><view wx:if="{{status == 'loading'}}" class="state">正在加载询价记录</view><view wx:elif="{{status == 'forbidden' || status == 'error'}}" class="state"><text>{{status == 'forbidden' ? '暂不可访问' : '加载失败'}}</text><text>{{errorText}}</text><button wx:if="{{status == 'error'}}" bindtap="retry">重新加载</button></view><view wx:elif="{{status == 'empty'}}" class="state"><text>暂无询价记录</text><text>可提交商品与采购数量，等待企业报价</text><button bindtap="create">新建询价</button></view><block wx:else><view wx:for="{{rows}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view><text>{{item.inquiryNo}}</text><text>{{item.statusLabel}}</text></view><text>共 {{item.itemCount}} 种商品</text><text wx:if="{{item.quoteVersion}}">报价版本 V{{item.quoteVersion}} · 有效期 {{item.validUntil}}</text><text wx:if="{{item.quoteTemporary}}">报价待确认，暂不可接受</text><text>查看详情 ›</text></view></block></view>
