.page{min-height:100vh;background:#f3f7fc;color:#203a53}.topbar{display:flex;align-items:center;gap:18rpx;padding:56rpx 22rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx}.topbar>view{display:flex;min-width:0;flex:1;flex-direction:column}.topbar>view text:first-child{font-size:31rpx;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:19rpx}.topbar button{margin:0;padding:10rpx 14rpx;color:#0a69e9;background:#fff;font-size:20rpx}.card{display:flex;margin:18rpx;padding:24rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:10rpx}.card>view{display:flex;justify-content:space-between}.card>view text:first-child{font-size:24rpx;font-weight:700}.card>view text:last-child{color:#0a69e9;font-size:21rpx}.card>text{color:#60768c;font-size:20rpx}.card>text:last-child{align-self:flex-end;color:#0a69e9}.state{display:flex;align-items:center;justify-content:center;min-height:350rpx;margin:18rpx;padding:30rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx;text-align:center}.state text:nth-child(2){color:#60768c;font-size:21rpx}
.page{font-size:14px}.card>view text:first-child{font-size:16px}.card>view text:last-child,.card>text,.state text:nth-child(2){font-size:13px}.state button{min-height:44px;font-size:14px;box-sizing:border-box}

/* 普通空态不再占据近半屏高度。 */
.state {
  min-height: 0;
  padding-top: 44rpx;
  padding-bottom: 44rpx;
}
