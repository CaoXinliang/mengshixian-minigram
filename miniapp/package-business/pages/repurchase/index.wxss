.page{min-height:100vh;padding-bottom:140rpx;background:#f3f7fc;color:#203a53}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:32rpx;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:20rpx}.card,.success{display:flex;margin:18rpx;padding:24rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx}.title{font-size:25rpx;font-weight:700}.row{display:flex;align-items:center;gap:12rpx;padding:13rpx 0;border-top:1rpx solid #edf1f4}.check{display:flex;align-items:center;justify-content:center;width:33rpx;height:33rpx;border-radius:50%;color:#fff;background:#0a69e9}.row>view{display:flex;min-width:0;flex:1;flex-direction:column}.row>view text:last-child{color:#60768c;font-size:19rpx}.invalid{background:#fff9f7}.invalid-row{display:flex;justify-content:space-between;gap:16rpx;color:#60768c;font-size:20rpx}.invalid-row text:last-child{color:#c95042}.error{display:block;margin:18rpx;padding:13rpx;color:#c95042;background:#fff1ef}.success{color:#277854;background:#effaf4}.success button{color:#0a69e9;background:#fff}.bar{position:fixed;right:0;bottom:0;left:0;padding:15rpx 18rpx calc(15rpx + env(safe-area-inset-bottom));background:#fff}.bar button{margin:0;color:#fff;background:#0a69e9}.state{display:flex;align-items:center;justify-content:center;min-height:350rpx;margin:18rpx;background:#fff;flex-direction:column;gap:12rpx;text-align:center}.state text:nth-child(2){color:#60768c;font-size:21rpx}


.control-pressed {
  opacity: .72;
}

.state {
  min-height: 0;
  padding-top: 44rpx;
  padding-bottom: 44rpx;
}

.state-loading {
  min-height: 320rpx;
}

.row {
  min-height: 44px;
}

.check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 33rpx;
  min-width: 33rpx;
  max-width: 22px;
  height: 33rpx;
  max-height: 22px;
  flex: none;
}

/* 底部内容占位与固定操作栏高度使用同一组安全区计算。 */
.page {
  padding-bottom: calc(44px + 30rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(44px + 30rpx + env(safe-area-inset-bottom));
}

.bar {
  padding: 15rpx 18rpx calc(15rpx + constant(safe-area-inset-bottom));
  padding: 15rpx 18rpx calc(15rpx + env(safe-area-inset-bottom));
}

.bar button {
  min-height: 44px;
  box-sizing: border-box;
}

.row > view,
.invalid-row text {
  min-width: 0;
}

.row text,
.invalid-row text,
.error,
.success text {
  overflow-wrap: anywhere;
}

.row > text {
  max-width: 30%;
  flex: none;
  text-align: right;
}

.invalid-row {
  align-items: flex-start;
  flex-wrap: wrap;
}

.invalid-row text:first-child {
  flex: 1 1 220rpx;
}

.invalid-row text:last-child {
  max-width: 100%;
  flex: 0 1 auto;
  text-align: right;
}

/* Keep status and invalid-item explanations legible on every phone. */
.page { font-size: 16px; line-height: 1.5; }
.title { font-size: 18px; }
.row > view text:last-child, .invalid-row,
.state text:nth-child(2) { font-size: 14px; }
.success button, .bar button, .state button {
  min-height: 44px;
  font-size: 16px;
  line-height: 1.5;
  white-space: normal;
}
