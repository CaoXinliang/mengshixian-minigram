<view class="page"><responsive-topbar title="再次购买" subtitle="选择仍可购买的商品" bind:back="back"/><view wx:if="{{status == 'loading'}}" class="state state-loading">正在加载可购商品</view><view wx:elif="{{status == 'error' || status == 'forbidden'}}" class="state"><text>暂时无法再次购买</text><text>{{errorText}}</text><button wx:if="{{status == 'error'}}" bindtap="retry">重新加载</button></view><view wx:elif="{{status == 'empty'}}" class="state"><text>原订单暂无可再次购买商品</text></view><block wx:else><view class="card"><text class="title">可再次购买</text><view wx:for="{{rows}}" wx:key="skuId" class="row" data-sku-id="{{item.skuId}}" aria-role="checkbox" aria-checked="{{item.selected}}" aria-label="{{item.selected ? '取消选择' : '选择'}} {{item.name}}" hover-class="control-pressed" bindtap="toggle"><text class="check" aria-hidden="true">{{item.selected ? '✓' : ''}}</text><view><text>{{item.name || '订单商品'}}</text><text>{{item.spec}}</text></view><text>×{{item.quantity}}</text></view></view><view wx:if="{{invalidItems.length}}" class="card invalid"><text class="title">未加入购物车</text><view wx:for="{{invalidItems}}" wx:key="index" class="invalid-row"><text>{{item.name || item.productName || '订单商品'}}</text><text>{{item.reason || item.message || '商品或规格已失效'}}</text></view></view><text wx:if="{{commitError}}" class="error">{{commitError}}</text><view wx:if="{{addedItems.length}}" class="success"><text>已加入购物车 {{addedItems.length}} 项</text><button bindtap="goCart">去购物车结算</button></view><view class="bar"><button disabled="{{commitLocked}}" bindtap="commit">{{commitLocked ? '正在加入' : '加入购物车'}}</button></view></block></view>
