<view class="page"><responsive-topbar title="套餐详情" subtitle="数量与金额由服务端核验" bind:back="back"/><view wx:if="{{status == 'loading'}}" class="state">正在加载套餐详情</view><view wx:elif="{{status == 'empty'}}" class="state"><text>套餐不存在或已下架</text><text>{{errorText}}</text></view><view wx:elif="{{status == 'error'}}" class="state error"><text>套餐详情加载失败</text><text>{{errorText}}</text><button bindtap="retry">重新加载</button></view><block wx:elif="{{bundle}}"><view class="hero"><text>{{bundle.name}}</text><text>{{bundle.description}}</text></view><view class="card"><text class="title">套餐内容</text><view wx:for="{{bundle.items}}" wx:key="skuId" class="row"><view><text>{{item.name}}</text><text>{{item.spec}}</text></view><text>×{{item.quantity}}</text></view></view><view class="card qty"><text>套餐数量</text><view><button bindtap="changeQty" data-step="-1">−</button><text>{{quantity}}</text><button bindtap="changeQty" data-step="1">＋</button></view></view><view wx:if="{{errorText}}" class="notice"><text>{{errorText}}</text><button bindtap="loadQuote">重试报价</button></view><view class="card total"><text>服务端应付报价</text><text>{{quoting ? '核验中' : (quote ? ('¥' + quote.total) : '--')}}</text></view><view class="bottom"><button disabled="{{!quote || quoting}}" bindtap="buy">进入结算</button></view></block></view>
