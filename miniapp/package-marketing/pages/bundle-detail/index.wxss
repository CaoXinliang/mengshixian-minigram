.page{min-height:100vh;padding-bottom:140rpx;background:#f3f7fc;color:#203a53}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:32rpx;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:20rpx}.hero,.card,.notice{display:flex;margin:18rpx;padding:24rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx}.hero text:first-child,.title{font-size:28rpx;font-weight:700}.hero text:last-child,.row>view text:last-child{color:#60768c;font-size:21rpx}.row{display:flex;justify-content:space-between;padding:12rpx 0;border-top:1rpx solid #edf1f4}.row>view{display:flex;flex-direction:column;gap:5rpx}.qty{flex-direction:row;align-items:center;justify-content:space-between}.qty>view{display:flex;align-items:center;gap:18rpx}.qty button{margin:0;padding:6rpx 18rpx}.total{flex-direction:row;justify-content:space-between}.total text:last-child{color:#e35d36;font-size:28rpx;font-weight:700}.notice{color:#b55245;background:#fff7f5}.notice button{align-self:flex-start}.bottom{position:fixed;right:0;bottom:0;left:0;padding:16rpx 18rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff}.bottom button{color:#fff;background:#0a69e9}.state{display:flex;align-items:center;justify-content:center;min-height:360rpx;margin:18rpx;padding:30rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx;text-align:center}.state.error{background:#fff7f5}
