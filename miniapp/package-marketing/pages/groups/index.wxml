<view class="page"><responsive-topbar title="拼团专场" subtitle="成团与订单状态由服务端确认" bind:back="back"/><view class="tabs"><button class="{{tab == 'campaigns' ? 'active' : ''}}" bindtap="switchTab" data-tab="campaigns">活动</button><button class="{{tab == 'mine' ? 'active' : ''}}" bindtap="switchTab" data-tab="mine">我的团</button></view><view wx:if="{{status == 'loading'}}" class="state">正在加载拼团</view><view wx:elif="{{status == 'error'}}" class="state error"><text>拼团加载失败</text><text>{{errorText}}</text><button bindtap="retry">重新加载</button></view><block wx:elif="{{status == 'ready'}}"><view wx:if="{{tab == 'campaigns'}}" class="list"><view wx:for="{{campaigns}}" wx:key="id" class="card" bindtap="openCampaign" data-id="{{item.id}}"><text>{{item.name}}</text><text>{{item.groupSize}} 人团 · {{item.statusText}}</text><text>截止 {{item.endText || '以活动详情为准'}}</text></view><view wx:if="{{!campaigns.length}}" class="state"><text>暂无拼团活动</text><text>活动开始后会在这里显示</text></view></view><view wx:else class="list"><view wx:for="{{mine}}" wx:key="id" class="card" bindtap="openGroup" data-id="{{item.id}}"><text>{{item.name}}</text><text>{{item.joined}}/{{item.target}} 人 · {{item.statusText}}</text><text>{{item.endText}}</text><text wx:if="{{item.status == 'failed'}}" class="warn">未成团后的退款仍以支付渠道回调为准</text></view><view wx:if="{{!mine.length}}" class="state"><text>暂无参与记录</text><text>登录并参团后会显示在这里</text></view></view></block></view>
