.page{min-height:100vh;background:#f5f8fc;color:#0f1b2d;font-size:14px;}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#176bd5;color:#fff}.topbar>text{font-size:32px}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:18px;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:13px}.tabs{display:grid;margin:12px 16px;grid-template-columns:1fr 1fr;gap:12px}.tabs button{margin:0;color:#176bd5;background:#fff;padding:8px 12px;border-radius:999px;font-size:14px;border:1px solid #b8cdea;}.tabs .active{color:#fff;background:#176bd5}.list{padding:0 16px}.card{display:flex;margin-bottom:14rpx;padding:16px 14px;border-radius:16px;background:#fff;flex-direction:column;gap:8px;min-height:44px;border:1px solid #e1eaf5;}.card text:first-child{font-size:16px;font-weight:700}.card text:not(:first-child){color:#667085;font-size:14px}.card .warn{color:#b55245}.state{display:flex;align-items:center;justify-content:center;min-height:320rpx;padding:20px 14px;border-radius:16px;background:#fff;flex-direction:column;gap:12rpx;text-align:center;margin:12px 16px;padding-top:20px;padding-bottom:20px;line-height:1.6;}.state.error{margin:18rpx;background:#fff7f5}


/* 交付态控件层级：触控尺寸使用 px，避免窄屏被 rpx 继续缩小。 */
button {
  min-height: 44px;
  box-sizing: border-box;
  white-space: nowrap;
  line-height: 1.25;
}

.control-pressed {
  opacity: .72;
}

.state {min-height: 0;padding-top:20px;padding-bottom:20px;margin:12px 16px;padding:20px 14px;border-radius:16px;line-height:1.6;}

.state-loading {
  min-height: 320rpx;
}


input,
textarea,
picker {
  min-height: 44px;
  box-sizing: border-box;
  font-size: 14px;
}

.tabs {grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);margin:12px 16px;gap:12px;}

.tabs button {width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;padding:8px 12px;border-radius:999px;font-size:14px;border:1px solid #b8cdea;}

.card text{min-width:0;overflow-wrap:anywhere;line-height:1.6}
.card::after{content:"查看详情 ›";align-self:flex-end;display:flex;align-items:center;min-height:34px;padding:6px 16px;border:1px solid #176bd5;border-radius:999px;color:#176bd5;font-size:14px;line-height:1.4}
