.page{min-height:100vh;background:#f3f7fc;color:#203a53}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:18px;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:13px}.section{display:flex;margin:18rpx;flex-direction:column;gap:12rpx}.title{font-size:16px;font-weight:700}.coupon{display:flex;align-items:center;padding:20rpx;border-radius:12rpx;background:#fff;gap:18rpx}.coupon>view:first-child{display:flex;width:150rpx;color:#e35d36;flex-direction:column}.coupon>view:first-child text:first-child{font-size:35rpx;font-weight:800}.coupon>view:first-child text:last-child{font-size:13px}.coupon>view:nth-child(2){display:flex;min-width:0;flex:1;flex-direction:column;gap:5rpx}.coupon>view:nth-child(2) text:first-child{font-weight:700}.coupon>view:nth-child(2) text:not(:first-child){color:#60768c;font-size:13px}.coupon button{margin:0;padding:9rpx 16rpx;color:#fff;background:#0a69e9;font-size:13px}.coupon.disabled{opacity:.55}.clear{margin:18rpx;padding:20rpx;border-radius:12rpx;color:#0a69e9;background:#fff;text-align:center}.empty{padding:50rpx;color:#60768c;background:#fff;text-align:center}.state{display:flex;align-items:center;justify-content:center;min-height:360rpx;margin:18rpx;padding:30rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx;text-align:center}.state.error{background:#fff7f5}


/* 交付态控件层级：触控尺寸使用 px，避免窄屏被 rpx 继续缩小。 */
button {
  min-height: 44px;
  box-sizing: border-box;
  white-space: nowrap;
  line-height: 1.25;
}

.control-pressed {
  opacity: .72;
}

.state {
  min-height: 0;
  padding-top: 44rpx;
  padding-bottom: 44rpx;
}

.state-loading {
  min-height: 320rpx;
}


input,
textarea,
picker {
  min-height: 44px;
  box-sizing: border-box;
  font-size: 14px;
}

.clear {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  box-sizing: border-box;
}

.coupon button {
  width: auto;
  min-width: 44px;
  max-width: 100%;
  flex: 0 1 auto;
  box-sizing: border-box;
  white-space: normal;
  overflow-wrap: anywhere;
}
