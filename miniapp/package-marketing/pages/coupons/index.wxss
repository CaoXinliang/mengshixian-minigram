.page{min-height:100vh;background:#f3f7fc;color:#203a53}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:32rpx;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:20rpx}.section{display:flex;margin:18rpx;flex-direction:column;gap:12rpx}.title{font-size:27rpx;font-weight:700}.coupon{display:flex;align-items:center;padding:20rpx;border-radius:12rpx;background:#fff;gap:18rpx}.coupon>view:first-child{display:flex;width:150rpx;color:#e35d36;flex-direction:column}.coupon>view:first-child text:first-child{font-size:35rpx;font-weight:800}.coupon>view:first-child text:last-child{font-size:18rpx}.coupon>view:nth-child(2){display:flex;min-width:0;flex:1;flex-direction:column;gap:5rpx}.coupon>view:nth-child(2) text:first-child{font-weight:700}.coupon>view:nth-child(2) text:not(:first-child){color:#60768c;font-size:19rpx}.coupon button{margin:0;padding:9rpx 16rpx;color:#fff;background:#0a69e9;font-size:20rpx}.coupon.disabled{opacity:.55}.clear{margin:18rpx;padding:20rpx;border-radius:12rpx;color:#0a69e9;background:#fff;text-align:center}.empty{padding:50rpx;color:#60768c;background:#fff;text-align:center}.state{display:flex;align-items:center;justify-content:center;min-height:360rpx;margin:18rpx;padding:30rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx;text-align:center}.state.error{background:#fff7f5}
