.page {
  min-height: 100vh;
  padding-bottom: 24px;
  box-sizing: border-box;
  color: var(--color-text-primary);
  background: var(--color-surface-page);
  font-size: var(--font-body);
}

.control-pressed {
  opacity: .72;
}

.state {
  display: flex;
  min-height: 160px;
  margin: var(--space-md) var(--space-lg);
  padding: 20px var(--space-lg);
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8px;
  border-radius: var(--radius-coupon-card);
  box-sizing: border-box;
  background: var(--color-surface-card);
  line-height: 1.5;
  text-align: center;
}

.state-loading {
  min-height: 320rpx;
}

.state.error {
  background: var(--color-coupon-error-surface);
}

.state button {
  width: auto;
  min-height: var(--control-hit);
  margin: 0;
  padding: 0 22rpx;
  border-radius: 999px;
  box-sizing: border-box;
  font-size: var(--font-body);
  line-height: 1.25;
}

.coupon-summary,
.coupon-rules,
.coupon {
  border-radius: var(--radius-coupon-card);
  box-sizing: border-box;
}

.coupon-summary {
  display: flex;
  margin: var(--space-md) var(--space-lg) 10px;
  padding: var(--space-lg);
  flex-direction: column;
  gap: var(--space-sm);
  background: var(--color-brand-soft);
}

.summary-title {
  color: var(--color-text-primary);
  font-size: var(--font-coupon-value);
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.summary-copy {
  color: var(--color-text-secondary);
  font-size: var(--font-body);
  line-height: 1.64;
}

.summary-actions {
  display: flex;
  min-height: 40px;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px 12px;
}

.summary-actions > text {
  color: var(--color-coupon-muted);
  font-size: var(--font-support);
  line-height: 21px;
}

.browse-link {
  display: flex;
  min-width: 104px;
  min-height: var(--control-hit);
  max-width: 100%;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.browse-link > text {
  display: flex;
  min-width: 104px;
  min-height: 36px;
  padding: 6px 16px;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  box-sizing: border-box;
  color: var(--color-surface-card);
  background: var(--color-brand-primary);
  font-size: var(--font-body);
  line-height: 1.4;
  text-align: center;
}

.clear {
  display: flex;
  min-height: var(--control-hit);
  margin: 10px 16px;
  padding: 8px 14px;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--color-border-default);
  border-radius: 999px;
  box-sizing: border-box;
  color: var(--color-brand-primary);
  background: var(--color-surface-card);
  text-align: center;
}

.section {
  display: flex;
  margin: 10px var(--space-lg);
  flex-direction: column;
  gap: 10px;
}

.title {
  font-size: var(--font-coupon-section);
  font-weight: 600;
  line-height: 1.65;
}

.coupon {
  display: grid;
  min-width: 0;
  padding: 14px;
  grid-template-columns: minmax(72px, 84px) minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  background: var(--color-surface-card);
}

.coupon-value-column,
.coupon-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.coupon-value-column {
  gap: 2px;
  color: var(--color-state-danger);
}

.coupon-copy {
  gap: 4px;
}

.coupon-value,
.coupon-threshold,
.coupon-name,
.coupon-validity,
.coupon-status {
  min-width: 0;
  overflow-wrap: anywhere;
}

.coupon-value {
  font-size: var(--font-coupon-value);
  font-weight: 600;
  line-height: 1.6;
}

.coupon-threshold {
  color: var(--color-coupon-muted);
  font-size: var(--font-support);
  line-height: 1.55;
}

.coupon-name {
  color: var(--color-text-primary);
  font-size: var(--font-coupon-section);
  line-height: 1.6;
}

.coupon-validity,
.coupon-status {
  color: var(--color-coupon-muted);
  font-size: var(--font-body);
  line-height: 1.55;
}

.coupon-status {
  color: var(--color-coupon-status);
}

.coupon.disabled {
  background: var(--color-coupon-muted-surface);
}

.coupon.disabled .coupon-value,
.coupon.disabled .coupon-name,
.coupon.disabled .coupon-status {
  color: var(--color-coupon-muted);
}

.coupon button {
  display: flex;
  width: auto;
  min-width: 44px;
  min-height: var(--control-hit);
  max-width: 104px;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 0;
  box-sizing: border-box;
  color: inherit;
  background: transparent;
  line-height: 1;
}

.coupon button::after {
  border: 0;
}

.coupon button > text {
  display: inline-flex;
  min-width: 88px;
  min-height: 36px;
  max-width: 104px;
  padding: 6px 12px;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: var(--color-surface-card);
  background: var(--color-brand-primary);
  font-size: var(--font-body);
  line-height: 1.25;
  text-align: center;
  white-space: normal;
}

.coupon button[disabled] {
  opacity: 1;
}

.coupon button[disabled] > text {
  color: var(--color-coupon-disabled-text);
  background: var(--color-coupon-disabled-surface);
}

.claim-feedback {
  margin: 10px var(--space-lg);
  padding: 12px 14px;
  border-radius: 12px;
  background: var(--color-brand-soft);
  color: var(--color-coupon-status);
  font-size: var(--font-body);
  line-height: 1.5;
}

.claim-feedback.error,
.claim-feedback.unknown {
  color: var(--color-coupon-error-text);
  background: var(--color-coupon-error-surface);
}

.claim-feedback.confirmed {
  color: var(--color-coupon-success-text);
  background: var(--color-coupon-success-surface);
}

.coupon-rules {
  display: flex;
  margin: 10px var(--space-lg) 0;
  padding: 14px var(--space-lg);
  flex-direction: column;
  gap: 6px;
  color: var(--color-text-primary);
  background: var(--color-surface-card);
  font-size: var(--font-body);
  line-height: 1.65;
}

@media screen and (max-width: 360px) {
  .coupon {
    padding: 14px 12px;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    gap: 8px;
  }

  .coupon button > text {
    min-width: 76px;
    padding-right: 8px;
    padding-left: 8px;
  }
}
