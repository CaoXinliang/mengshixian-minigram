.page{min-height:100vh;background:#f5f8fc;color:#0f1b2d;font-size:14px;}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#176bd5;color:#fff}.topbar>text{font-size:32px}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:18px;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:13px}.section{display:flex;margin:12px 16px;flex-direction:column;gap:12px}.title{font-size:16px;font-weight:700}.coupon{display:flex;align-items:center;padding:14px;border-radius:16px;background:#fff;gap:12px}.coupon>view:first-child{display:flex;width:84px;color:#ff4d4f;flex-direction:column;flex-shrink:0;}.coupon>view:first-child text:first-child{font-size:35rpx;font-weight:800}.coupon>view:first-child text:last-child{font-size:12px}.coupon>view:nth-child(2){display:flex;min-width:0;flex:1;flex-direction:column;gap:5rpx}.coupon>view:nth-child(2) text:first-child{font-weight:700}.coupon>view:nth-child(2) text:not(:first-child){color:#667085;font-size:12px}.coupon button{margin:0;padding:9rpx 16rpx;color:#fff;background:#176bd5;font-size:13px}.coupon.disabled{opacity:.55}.clear{margin:12px 16px;padding:8px 14px;border-radius:999px;color:#176bd5;background:#fff;text-align:center;min-height:44px;border:1px solid #cfdef1;}.empty{padding:50rpx;color:#667085;background:#fff;text-align:center}.state{display:flex;align-items:center;justify-content:center;min-height:360rpx;margin:12px 16px;padding:20px 14px;border-radius:16px;background:#fff;flex-direction:column;gap:12rpx;text-align:center;padding-top:20px;padding-bottom:20px;line-height:1.6;}.state.error{background:#fff7f5}


.control-pressed {
  opacity: .72;
}

.state {min-height: 0;padding-top:20px;padding-bottom:20px;margin:12px 16px;padding:20px 14px;border-radius:16px;line-height:1.6;}

.state-loading {
  min-height: 320rpx;
}


.clear {display: flex;
  align-items: center;
  justify-content: center;min-height:44px;
  box-sizing: border-box;margin:12px 16px;padding:8px 14px;border:1px solid #cfdef1;border-radius:999px;}

.coupon button {
  width: auto;
  min-width: 44px;
  height: 44px;
  min-height: 44px;
  max-width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin: 0;
  padding: 0 4rpx;
  border: 0;
  box-sizing: border-box;
  color: inherit;
  background: transparent;
  line-height: 1;
}

.coupon button::after {
  border: 0;
}

.coupon button > text {
  display: inline-flex;
  align-items: center;
  justify-content: center;min-height:34px;max-height:none;padding:6px 16px;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #fff;
  background: #176bd5;font-size:14px;
  line-height: 1.2;white-space:normal;
}

.coupon > view:first-child,
.coupon > view:nth-child(2),
.coupon text {min-width: 0;}

.coupon text {
  overflow-wrap: anywhere;
}

.state button {width: auto;min-height:44px;
  margin: 0;
  padding: 0 22rpx;
  box-sizing: border-box;
  font-size:14px;
  line-height: 1.25;border-radius:999px;}

@media screen and (max-width: 360px) {
  .coupon {align-items: flex-start;
    flex-wrap: wrap;gap:12px;padding:14px;}

  .coupon > view:first-child {width:84px;flex-shrink:0;}

  .coupon button {
    margin-left: auto;
  }
}

.coupon-summary{display:flex;flex-direction:column;gap:12px;margin:12px 16px;padding:18px 16px;border-radius:16px;background:#eaf2fd}
.summary-title{font-size:20px;line-height:1.4;color:#0f1b2d;overflow-wrap:anywhere}
.summary-copy,.summary-actions>text{font-size:14px;line-height:1.5;color:#667085}
.summary-actions{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px 12px}
.browse-link{display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;max-width:100%;box-sizing:border-box}
.browse-link>text{display:flex;align-items:center;justify-content:center;min-height:36px;padding:6px 22px;border-radius:999px;background:#176bd5;color:#fff;font-size:14px;line-height:1.4;text-align:center}
.coupon-rules{display:flex;flex-direction:column;gap:10px;margin:12px 16px 24px;padding:16px 14px;border-radius:16px;background:#fff;font-size:14px;line-height:1.6;color:#344054}
.coupon button[disabled]{opacity:1}
.coupon button[disabled]>text{background:#dbe7f5;color:#69849f}

/* S4: coupon conditions use the available text column, not a fixed text width. */
.coupon>view:first-child text:last-child,.coupon>view:nth-child(2) text:not(:first-child){font-size:16px;line-height:1.5}
