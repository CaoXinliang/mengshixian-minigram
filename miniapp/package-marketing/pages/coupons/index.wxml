<view class="page"><responsive-topbar title="{{selectMode ? '选择优惠券' : '优惠券中心'}}" subtitle="领取并管理可用优惠" bind:back="back"/><view wx:if="{{status == 'loading'}}" class="state state-loading">正在加载优惠券</view><view wx:elif="{{status == 'forbidden'}}" class="state"><text>需要登录</text><text>{{errorText}}</text></view><view wx:elif="{{status == 'error'}}" class="state error"><text>优惠券加载失败</text><text>{{errorText}}</text><button bindtap="retry">重新加载</button></view><block wx:elif="{{status == 'ready'}}"><view wx:if="{{selectMode}}" class="clear" bindtap="clearSelection" aria-role="button" aria-label="不使用优惠券" hover-class="control-pressed">不使用优惠券</view><view class="section"><text class="title">我的优惠券</text><view wx:for="{{coupons}}" wx:key="id" class="coupon {{item.usable ? '' : 'disabled'}}" bindtap="choose" data-id="{{item.id}}" aria-role="button" aria-label="选择优惠券 {{item.name}}" hover-class="control-pressed"><view><text>{{item.valueText}}</text><text>{{item.thresholdText}}</text></view><view><text>{{item.name}}</text><text>{{item.validityText || '有效期以券面为准'}}</text><text>{{item.statusText}}</text></view></view><text wx:if="{{!coupons.length}}" class="empty">暂无优惠券</text></view><view wx:if="{{!selectMode}}" class="section"><text class="title">可领取</text><view wx:for="{{templates}}" wx:key="id" class="coupon"><view><text>{{item.valueText}}</text><text>{{item.thresholdText}}</text></view><view><text>{{item.name}}</text><text>{{item.validityText || '领取后查看有效期'}}</text></view><button disabled="{{item.claimed || busyId}}" bindtap="claim" data-id="{{item.id}}">{{item.claimed ? '已领取' : (busyId == item.id ? '领取中' : '领取')}}</button></view><text wx:if="{{!templates.length}}" class="empty">暂无可领取优惠券</text></view></block></view>
