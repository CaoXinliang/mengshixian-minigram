<view class="page"><responsive-topbar title="套餐采购" subtitle="套餐价格与库存由服务端核验" bind:back="back"/><view wx:if="{{status == 'loading'}}" class="state">正在加载采购套餐</view><view wx:elif="{{status == 'error'}}" class="state error"><text>套餐加载失败</text><text>{{errorText}}</text><button bindtap="retry">重新加载</button></view><view wx:elif="{{status == 'empty'}}" class="state"><text>暂无在售套餐</text><text>上架后会在这里显示</text></view><view wx:else class="list"><view wx:for="{{rows}}" wx:key="id" class="card" bindtap="open" data-id="{{item.id}}"><image src="{{item.image}}" mode="aspectFit"/><view><text>{{item.name}}</text><text>{{item.description}}</text><text>{{item.priceText ? ('¥' + item.priceText + ' 起') : item.priceHint}}</text></view><text>›</text></view></view></view>
