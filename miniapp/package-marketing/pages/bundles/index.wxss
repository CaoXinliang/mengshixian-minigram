.page{min-height:100vh;background:#f3f7fc;color:#203a53}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:32rpx;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:20rpx}.list{padding:18rpx}.card{display:flex;align-items:center;margin-bottom:14rpx;padding:20rpx;border-radius:12rpx;background:#fff;gap:16rpx}.card image{width:120rpx;height:120rpx}.card>view{display:flex;min-width:0;flex:1;flex-direction:column;gap:7rpx}.card>view text:first-child{font-size:25rpx;font-weight:700}.card>view text:nth-child(2){color:#60768c;font-size:20rpx}.card>view text:last-child{color:#e35d36;font-weight:700}.state{display:flex;align-items:center;justify-content:center;min-height:360rpx;margin:18rpx;padding:30rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx;text-align:center}.state.error{background:#fff7f5}
