:host{position:fixed;right:0;bottom:0;left:0;z-index:15;display:block;--tabbar-divider:var(--color-border-default,#d7e2ef);--tabbar-text:var(--color-text-secondary,#667085);--tabbar-active:var(--color-brand-primary,#176bd5)}
.tabbar{display:flex;width:100%;height:calc(var(--fixed-bar-height,64px) + constant(safe-area-inset-bottom));height:calc(var(--fixed-bar-height,64px) + env(safe-area-inset-bottom));padding:4px 4px calc(4px + constant(safe-area-inset-bottom));padding:4px 4px calc(4px + env(safe-area-inset-bottom));box-sizing:border-box;border-top:1px solid var(--tabbar-divider);background:var(--color-surface-card,#fff)}
.tabbar__item{display:flex;align-items:center;justify-content:center;min-width:0;min-height:56px;margin:0;padding:0;overflow:visible;border:0;border-radius:0;color:var(--tabbar-text);background:transparent;flex:1;flex-direction:column;line-height:1.3}
.tabbar__item::after{display:none}
.tabbar__item+.tabbar__item{border-left:1px solid var(--tabbar-divider)}
.tabbar__icon{width:24px;height:24px;margin:3px 0;opacity:.55}
.tabbar__label{margin-top:2px;font-size:13px;font-weight:600;line-height:1.3}
.tabbar__item.is-active{color:var(--tabbar-active);font-weight:700}
.tabbar__item.is-active .tabbar__icon{opacity:1}
.tabbar__cart-icon{position:relative;display:flex;align-items:center;justify-content:center;width:44px;height:32px;overflow:visible}
.tabbar__cart-icon .tabbar__icon{margin:0}
.tabbar__badge{position:absolute;right:0;top:0;z-index:2;display:flex;align-items:center;justify-content:center;min-width:16px;max-width:32px;height:16px;padding:0 4px;box-sizing:border-box;border:2px solid #fff;border-radius:9px;color:#fff;background:var(--color-state-danger,#e65353);font-size:13px;font-weight:700;line-height:1;white-space:nowrap}
.tabbar__cart-icon.is-pulsing{animation:cart-badge-pulse 240ms ease-out}
@keyframes cart-badge-pulse{0%{transform:scale(1)}45%{transform:scale(1.14)}100%{transform:scale(1)}}
@media (prefers-reduced-motion:reduce){.tabbar__cart-icon.is-pulsing{animation:none}}
