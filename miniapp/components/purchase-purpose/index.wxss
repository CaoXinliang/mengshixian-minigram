:host{display:block;width:100%;height:100%}
.purpose-page{position:fixed;inset:0;z-index:80;display:flex;width:100%;height:100%;box-sizing:border-box;color:var(--text-primary,#122118);background:var(--surface-page,#f6f8f6);flex-direction:column;padding-top:var(--purpose-safe-top)}
.purpose-head{position:relative;display:grid;align-items:center;height:52px;padding:0 16px;box-sizing:border-box;background:rgba(246,248,246,.96);grid-template-columns:44px 1fr 44px}
.purpose-back{display:flex;align-items:center;justify-content:center;width:44px;height:44px;margin:0;padding:0;border-radius:22px;color:var(--text-primary,#122118);background:transparent;font-size:34px;line-height:1}
.purpose-back::after,.purpose-option::after,.purpose-skip::after{display:none}
.purpose-brand{text-align:center;font-size:18px;font-weight:700;letter-spacing:.06em}
.purpose-head-space{width:44px;height:44px}
.purpose-scroll{min-height:0;flex:1}
.purpose-content{display:flex;width:750rpx;min-width:750rpx;min-height:calc(100vh - var(--purpose-safe-top) - 52px);padding:54px 24px calc(28px + constant(safe-area-inset-bottom));padding:54px 24px calc(28px + env(safe-area-inset-bottom));box-sizing:border-box;flex-direction:column}
.purpose-title{font-size:32px;font-weight:750;letter-spacing:-.02em;line-height:1.25}
.purpose-subtitle{margin-top:14px;color:var(--text-secondary,#617066);font-size:15px;line-height:1.65}
.purpose-options{display:flex;width:686rpx;margin-top:44px;gap:18px;align-self:center;flex-direction:column}
.purpose-option{position:relative;display:flex;align-items:center;justify-content:space-between;width:686rpx;min-height:132px;margin:0;padding:24px 22px 24px 24px;overflow:hidden;box-sizing:border-box;border:1px solid rgba(18,99,61,.08);border-radius:20px;text-align:left;box-shadow:0 14px 34px rgba(18,52,35,.08);transition:transform 160ms ease,box-shadow 160ms ease}
.purpose-option-business{color:#103b29;background:linear-gradient(135deg,#d8f7e6,#aeeccc)}
.purpose-option-personal{color:#4c3210;background:linear-gradient(135deg,#fff0c9,#ffd783)}
.purpose-option.is-pressed{transform:scale(.985);box-shadow:0 8px 18px rgba(18,52,35,.1)}
.purpose-option-copy{position:relative;z-index:1;display:flex;min-width:0;flex-direction:column}
.purpose-option-title{display:flex;align-items:center;gap:10px;font-size:23px;font-weight:750;line-height:1.3}
.purpose-option-arrow{font-size:30px;font-weight:400}
.purpose-option-desc{margin-top:9px;font-size:14px;line-height:1.55}
.purpose-option-mark{display:flex;align-items:center;justify-content:center;width:70px;height:70px;margin-left:14px;border-radius:50%;background:rgba(255,255,255,.36);font-size:27px;font-weight:750;flex:0 0 70px}
.purpose-skip{display:flex;align-items:center;justify-content:center;min-height:44px;margin:30px 0 0;padding:0 18px;color:var(--action-primary,#16764b);background:transparent;font-size:15px;font-weight:650}
.purpose-note{margin:10px 18px 0;color:var(--text-tertiary,#7b887f);font-size:12px;line-height:1.55;text-align:center}
@media (max-width:340px){.purpose-content{padding-right:18px;padding-left:18px}.purpose-title{font-size:28px}.purpose-options{margin-top:30px}.purpose-option{min-height:116px;padding:20px}.purpose-option-mark{width:58px;height:58px;flex-basis:58px}}
@media (prefers-reduced-motion:reduce){.purpose-option{transition:none}}
