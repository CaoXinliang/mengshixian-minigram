.panel{display:flex;margin:18rpx;padding:24rpx;border-radius:16px;background:#fff;box-sizing:border-box;flex-direction:column;gap:16px;color:#0f1b2d}
.heading{display:flex;align-items:center;gap:12px}.avatar{display:flex;width:44px;height:44px;border-radius:14px;align-items:center;justify-content:center;color:#176bd5;background:#eaf2fd;font-weight:700}.heading>view:last-child{display:flex;min-width:0;flex-direction:column;gap:4px}.heading text:first-child{font-size:19px;font-weight:700}.heading text:last-child{color:#526175;font-size:15px}
.content,.questions,.questions>view{display:flex;min-width:0;flex-direction:column;gap:10px}.content text,.questions text,.source-note{font-size:16px;line-height:1.55;overflow-wrap:anywhere}.content text,.questions text:last-child{color:#46566b}.questions>view{padding:12px;border-radius:12px;background:#f5f8fc}.questions text:first-child{font-weight:700}.source-note{padding:12px;border-radius:12px;color:#526175;background:#eaf2fd;font-size:14px}
button{display:flex;align-items:center;justify-content:center;width:auto;min-width:44px;min-height:44px;max-width:100%;margin:0;padding:8px 18px;border:0;border-radius:999px;box-sizing:border-box;color:#176bd5;background:#eaf2fd;font-size:16px;font-weight:600;line-height:1.4;white-space:normal}button::after{border:0}.primary{align-self:flex-start;color:#fff;background:#176bd5}.primary.is-disabled{color:#667085;background:#e5ebf2}.actions{display:flex;gap:10px;flex-wrap:wrap}.actions button{flex:1}
