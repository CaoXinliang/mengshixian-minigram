.quantity-stepper{display:flex;align-items:center;justify-content:flex-end;width:120px;min-width:120px;max-width:120px;height:44px;box-sizing:border-box;flex:0 0 120px;gap:0}
.quantity-stepper .step-control{display:flex;align-items:center;justify-content:center;width:44px;min-width:44px;max-width:44px;height:44px;min-height:44px;margin:0;padding:0;box-sizing:border-box;border:0;border-radius:0;background:transparent;line-height:1;flex:0 0 44px;transition:transform 160ms ease,opacity 160ms ease}
.step-control::after{border:0}
/* Keep the established visual diameter independent of the transparent hit area. */
.step-face{display:flex;align-items:center;justify-content:center;width:30px;height:30px;box-sizing:border-box;border:1px solid #829ab2;border-radius:50%;font-size:20px;line-height:1;flex:none}
.is-plus .step-face{border:1px solid #287ff1;color:#fff;background:#287ff1}
.is-minus .step-face{border:1px solid #829ab2;color:#365675;background:#fff}
.quantity-stepper .step-control.is-disabled{border:0;background:transparent;opacity:.4}
.quantity-value{width:32px;min-width:32px;max-width:32px;height:36px;min-height:36px;padding:0;color:#1f3650;font-size:17px;font-weight:700;line-height:36px;text-align:center;white-space:nowrap;box-sizing:border-box;flex:none}
.quantity-value.is-editing{border-bottom:1px solid #287ff1}
.quantity-value.is-invalid{border-bottom-color:#d84040;color:#b42318}
.quantity-stepper .is-pressed{opacity:.74;transform:scale(.9)}
.quantity-stepper.is-compact{width:120px;min-width:120px;max-width:120px;height:44px;flex-basis:120px;gap:0}
.quantity-stepper.is-compact .step-control{width:44px;min-width:44px;max-width:44px;height:44px;flex-basis:44px}
.quantity-stepper.is-compact .step-face{width:28px;height:28px;font-size:18px}
.quantity-stepper.is-compact .quantity-value{width:32px;min-width:32px;max-width:32px;font-size:16px}
@media (prefers-reduced-motion: reduce){.quantity-stepper .step-control{transition:none}}
