<view class="quantity-stepper {{compact ? 'is-compact' : ''}}">
  <button class="step-control is-minus" disabled="{{disabled || quantity <= 0}}" hover-class="is-pressed" catchtap="subtract" aria-label="减少数量">−</button>
  <text class="quantity-value">{{quantity}}</text>
  <button class="step-control is-plus" disabled="{{disabled}}" hover-class="is-pressed" catchtap="add" aria-label="增加数量">+</button>
</view>
