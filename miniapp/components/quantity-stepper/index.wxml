<view class="quantity-stepper {{compact ? 'is-compact' : ''}}">
  <button class="step-control is-minus {{disabled || quantity <= min ? 'is-disabled' : ''}}" disabled="{{disabled || quantity <= min}}" hover-class="is-pressed" catchtap="subtract" aria-label="减少数量"><text class="step-face" aria-hidden="true">−</text></button>
  <text class="quantity-value">{{quantity}}</text>
  <button class="step-control is-plus {{disabled || quantity >= max ? 'is-disabled' : ''}}" disabled="{{disabled || quantity >= max}}" hover-class="is-pressed" catchtap="add" aria-label="增加数量"><text class="step-face" aria-hidden="true">+</text></button>
</view>
