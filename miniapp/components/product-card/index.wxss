:host{display:block;margin-bottom:10px}
.product-card{display:grid;align-items:center;min-height:108px;padding:10px;box-sizing:border-box;border:0;border-radius:var(--radius-card,14px);background:var(--color-surface-card,#fff);grid-template-columns:84px minmax(0,1fr) auto;gap:10px}
.product-card__media{position:relative;display:flex;align-items:center;justify-content:center;width:84px;height:84px;overflow:hidden;border-radius:10px;background:#f3f7fb}
.product-card__image{width:100%;height:100%}
.product-card__tag{position:absolute;left:4px;top:4px;max-width:78px;padding:2px 5px;overflow:hidden;border-radius:999px;color:#fff;background:var(--color-state-danger,#e65353);font-size:12px;line-height:1.25;text-overflow:ellipsis;white-space:nowrap}
.product-card__copy{display:flex;min-width:0;align-self:stretch;justify-content:center;flex-direction:column}
.product-card__name{display:-webkit-box;color:var(--color-text-primary,#172b43);font-size:16px;font-weight:700;line-height:1.35;overflow:hidden;overflow-wrap:anywhere;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.product-card__spec{margin-top:4px;color:var(--color-text-secondary,#526175);font-size:13px;line-height:1.35;overflow-wrap:anywhere}
.product-card__status{margin-top:4px;color:var(--color-state-warning,#d98b26);font-size:14px;font-weight:600;line-height:1.35}
.product-card__price{margin-top:6px;max-width:100%;color:var(--color-brand-primary,#176bd5);font-size:19px;font-weight:700;line-height:1.3;white-space:nowrap}
.product-card__price-unit{margin-left:2px;color:var(--color-text-primary,#172b43);font-size:15px;font-weight:600}
.product-card__price-label{color:inherit;font:inherit}
.product-card__price.is-locked{color:var(--color-text-secondary,#526175);font-size:16px;font-weight:600;white-space:normal;overflow-wrap:anywhere}
.product-card__price.is-temporary{color:#e96762}
.product-card__action{display:flex;align-items:center;justify-content:flex-end;width:120px;min-width:120px;min-height:44px;height:44px;align-self:center}
.product-card.has-wide-price{grid-template-columns:84px minmax(0,1fr);grid-template-rows:auto auto}
.product-card.has-wide-price .product-card__media{align-self:start;grid-row:1/3}
.product-card.has-wide-price .product-card__action{justify-self:end;grid-column:2;grid-row:2}
@media (max-width:350px){.product-card{grid-template-columns:72px minmax(0,1fr);grid-template-rows:auto auto;gap:8px 10px}.product-card__media{width:72px;height:78px;align-self:start;grid-row:1/3}.product-card__action{justify-self:end;grid-column:2;grid-row:2}.product-card__price{font-size:19px}}
