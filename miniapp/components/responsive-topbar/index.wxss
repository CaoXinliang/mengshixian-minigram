:host {
  display: block;
  position: sticky;
  top: 0;
  z-index: 30;
}

.responsive-topbar {
  width: 100%;
  color: var(--color-brand-primary);
  background: var(--color-surface-page);
  box-sizing: border-box;
}

.topbar__content {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
  padding-left: 18rpx;
  box-sizing: border-box;
  gap: 12rpx;
}

.topbar__back,
.topbar__action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  color: var(--color-brand-primary);
  background: transparent;
  box-sizing: border-box;
  line-height: 1.25;
}

.topbar__back {
  width: 44px;
  height: 44px;
  flex: none;
}

.topbar__back-face {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border: 0;
  border-radius: 16px;
  background: var(--color-brand-soft);
  box-sizing: border-box;
  font-size: 28px;
  font-weight: 500;
  line-height: 1;
}

.topbar__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  text-align: center;
}

.topbar__content:not(.has-action) .topbar__copy {
  position: absolute;
  left: var(--topbar-side);
  right: var(--topbar-side);
}

.topbar__title,
.topbar__subtitle {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.topbar__title {
  font-size: 22px;
  font-weight: 700;
  line-height: 1.2;
}

.topbar__content.compact-title .topbar__title {
  font-size: var(--font-large-title);
  font-weight: 400;
  letter-spacing: .5px;
}

.topbar__subtitle {
  margin-top: 3rpx;
  color: var(--color-text-secondary);
  font-size: 15px;
  line-height: 1.3;
}

.topbar__action {
  max-width: 168rpx;
  min-height: 44px;
  padding: 0 18rpx;
  overflow: hidden;
  flex: none;
  border-radius: var(--radius-pill);
  color: var(--color-brand-primary);
  background: var(--color-brand-soft);
  font-size: 17px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.topbar__back--pressed,
.topbar__action--pressed {
  opacity: .72;
}
