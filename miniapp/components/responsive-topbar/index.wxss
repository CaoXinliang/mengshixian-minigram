:host {
  display: block;
  position: sticky;
  top: 0;
  z-index: 30;
}

.responsive-topbar {
  width: 100%;
  color: #fff;
  background: #0a69e9;
  box-sizing: border-box;
}

.topbar__content {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
  padding-left: 18rpx;
  box-sizing: border-box;
  gap: 12rpx;
}

.topbar__back,
.topbar__action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  color: #fff;
  background: transparent;
  box-sizing: border-box;
  line-height: 1.25;
}

.topbar__back {
  width: 44px;
  height: 44px;
  flex: none;
}

.topbar__back-face {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  border: 1px solid rgba(255, 255, 255, .85);
  border-radius: 50%;
  box-sizing: border-box;
  font-size: 47rpx;
  font-weight: 500;
  line-height: 1;
}

.topbar__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  justify-content: center;
}

.topbar__title,
.topbar__subtitle {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.topbar__title {
  font-size: 18px;
  font-weight: 700;
  line-height: 1.2;
}

.topbar__subtitle {
  margin-top: 3rpx;
  color: #dcecff;
  font-size: 13px;
  line-height: 1.3;
}

.topbar__action {
  max-width: 168rpx;
  min-height: 44px;
  padding: 0 18rpx;
  overflow: hidden;
  flex: none;
  border-radius: 8rpx;
  color: #0a69e9;
  background: #fff;
  font-size: 14px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.topbar__back--pressed,
.topbar__action--pressed {
  opacity: .72;
}
