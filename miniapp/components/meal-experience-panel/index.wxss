:host{display:block;min-height:100%}
button{margin:0;padding:0;border:0;border-radius:0;color:inherit;background:transparent;font:inherit;line-height:1.4}
button::after{border:0}
.control-pressed{opacity:.72}
.sub-head{position:sticky;top:0;z-index:25;display:flex;align-items:center;min-height:56px;padding:0 12px;box-sizing:border-box;background:#f7faff}.sub-head>view{display:flex;min-width:0;margin-left:8rpx;overflow:hidden;flex-direction:column;flex:1}.sub-head>view text:first-child{color:#1c3550;font-size:22px;font-weight:700}.sub-head>view text:first-child,.sub-head>view text:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.sub-head>view text:last-child{margin-top:5rpx;color:#46566b;font-size:16px}
.sub-head>button{display:flex;align-items:center;justify-content:center;width:44px;min-width:44px;height:44px;color:#0b61dc;font-size:30px}
.meal-head .meal-shuffle{display:flex;align-items:center;justify-content:center;width:auto;min-width:76px;min-height:44px;margin-left:16rpx;padding:0 14px;box-sizing:border-box;border:1rpx solid #bed6f5;border-radius:999px;color:#1264d6;background:#fff;font-size:16px;font-weight:600;line-height:1;flex:none;white-space:nowrap}.meal-head .meal-shuffle[disabled]{color:#526477;border-color:#d0d8e2;background:#eef2f6}
.meal-state{display:flex;align-items:center;margin:0 18rpx;padding:40px 16px;color:#71869a;flex-direction:column;justify-content:center;text-align:center}.meal-state>text,.meal-state>text:first-child,.meal-state>text:nth-child(2),.meal-product-empty text:first-child,.meal-product-empty text:last-child,.meal-disclaimer{color:#46566b;font-size:16px;line-height:1.6}.meal-state>text:first-child{font-weight:700}.meal-state>text:nth-child(2){max-width:560rpx;margin-top:12rpx}.meal-state>button{display:flex;align-items:center;justify-content:center;min-height:44px;margin-top:22rpx;padding:0 30rpx;border:0;border-radius:999px;color:#fff;background:#287ff1;font-size:16px;line-height:1}.meal-scene-filter{margin:0 16px 16px;padding:12px;border-radius:16px;background:#fff}.meal-scene-label{display:block;margin-bottom:11rpx;color:#46566b;font-size:16px;font-weight:600;line-height:1.5}.meal-scene-track{display:grid;gap:8px;grid-template-columns:repeat(3,minmax(0,1fr))}.meal-scene-track button{display:flex;align-items:center;justify-content:center;width:100%;min-width:0;min-height:44px;padding:8px 4px;box-sizing:border-box;border:1rpx solid #d8e5f2;border-radius:999px;color:#526a82;background:#fff;font-size:16px;line-height:1.4;white-space:normal;overflow-wrap:anywhere}.meal-scene-track button.is-active{border-color:#287ff1;color:#fff;background:#287ff1;font-weight:700}
.meal-grid{display:grid;padding:0 16px;gap:12px;grid-template-columns:minmax(0,1fr)}.meal-grid-skeleton{padding-bottom:4rpx}.meal-card{display:grid;min-width:0;overflow:hidden;grid-template-columns:88px minmax(0,1fr);gap:12px;padding:12px;border:0;border-radius:16px;background:#fff;box-shadow:none}.meal-card-cover{position:relative;height:auto;overflow:hidden;border-radius:12px;align-self:start;background:#eaf3ff}.meal-card-cover image{display:block;width:100%;height:88px;background:#eaf3ff}.meal-card-cover>text{position:static;display:block;padding:8px;color:#46566b;background:#f5f8fc;font-size:16px;line-height:1.4;white-space:normal}.meal-card-copy{display:flex;min-width:0;min-height:112px;padding:0;box-sizing:border-box;flex-direction:column;gap:8px}.meal-card-copy>text:first-child{overflow:visible;color:#1b3653;font-size:19px;font-weight:700;line-height:1.45;white-space:normal;overflow-wrap:anywhere}.meal-card-copy>text:nth-child(2){margin-top:0;color:#46566b;font-size:16px;line-height:1.5;overflow-wrap:anywhere}.meal-card-copy>button{display:flex;align-items:center;justify-content:center;width:auto;min-width:44px;max-width:100%;min-height:44px;margin:0 auto 0 0;padding:0 16px;box-sizing:border-box;border:0;border-radius:999px;color:#fff;background:#176bd5;font-size:16px;font-weight:700;line-height:1.4;white-space:normal}.meal-card-skeleton{animation:content-skeleton-breathe 1050ms ease-in-out infinite;pointer-events:none}.meal-grid-skeleton.is-motion-reduced .meal-card-skeleton{animation:none}.meal-skeleton-cover{height:112px;border-radius:12px;background:#e7eef6}.meal-skeleton-copy{display:flex;min-width:0;min-height:112px;padding:0;box-sizing:border-box;flex-direction:column;gap:12rpx}.meal-skeleton-copy view{height:13px;border-radius:7px;background:#e7eef6}.meal-skeleton-copy view:first-child{width:72%}.meal-skeleton-copy view:nth-child(2){width:48%}.meal-skeleton-copy view:last-child{width:100%;height:44px;margin-top:auto;border-radius:999px}
.detail-head{position:sticky;top:0;z-index:25;display:grid;align-items:center;height:56px;padding:0 12px;box-sizing:border-box;color:#176bd5;background:#f5f8fc;grid-template-columns:44px 1fr 44px}.detail-head>button{display:flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0}.detail-head>text{text-align:center;font-size:22px;font-weight:700}.back-control{position:relative;border:0!important;background:transparent!important;color:#174567!important;font-size:47rpx!important;font-weight:500!important;line-height:1!important;flex:none}.back-control::before{position:absolute;top:50%;left:50%;width:50rpx;height:50rpx;box-sizing:border-box;border:1px solid #829ab2;border-radius:50%;transform:translate(-50%,-50%);content:"";pointer-events:none}.meal-detail-head>button{min-width:44px;min-height:44px}.meal-detail-head>view{width:48rpx;height:48rpx;flex:none}
.meal-video-card{margin:0 16px 12px;overflow:hidden;border-radius:16px;background:#fff}.meal-video-stage{position:relative;height:calc((100vw - 32px) * .5625);min-height:180px;max-height:280px;overflow:hidden;background:#102238}.meal-video-stage>video,.meal-video-stage>image{display:block;width:100%;height:100%}.meal-video-overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;background:rgba(5,20,38,.34);flex-direction:column}.meal-video-overlay>text{margin-top:12rpx;font-size:16px;line-height:1.5;text-align:center}.meal-video-overlay.is-state{padding:30rpx;background:rgba(11,30,50,.82)}.meal-video-overlay.is-state>text:first-of-type{margin-top:0;font-size:19px;font-weight:700}.meal-video-overlay.is-state>text+text{color:#d7e2ed}.meal-video-overlay button{min-height:44px;margin-top:20rpx;padding:0 30rpx;border:0;border-radius:999px;color:#176bd5;background:#fff;font-size:16px}.meal-video-play{width:0;height:0;margin-left:8rpx;border-top:24rpx solid transparent;border-bottom:24rpx solid transparent;border-left:36rpx solid #fff;filter:drop-shadow(0 2rpx 6rpx rgba(0,0,0,.28))}.meal-video-spinner{width:42rpx;height:42rpx;border:5rpx solid rgba(255,255,255,.32);border-top-color:#fff;border-radius:50%;animation:meal-video-spin .9s linear infinite}.meal-video-meta{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;gap:16rpx}.meal-video-meta>text:first-child{min-width:0;color:#193653;font-size:17px;font-weight:700;line-height:1.45;overflow-wrap:anywhere}.meal-video-meta>text:last-child{color:#657b90;font-size:15px;flex:none}
.meal-detail-hero{position:relative;height:330rpx;margin:0 18rpx;overflow:hidden;border-radius:14rpx;background:#eaf3ff}.meal-detail-hero>image{width:100%;height:100%}.meal-detail-hero>view{position:absolute;inset:0;opacity:.22}.meal-detail-hero>text{position:absolute;left:20rpx;top:20rpx;padding:8rpx 16rpx;border-radius:22rpx;color:#fff;background:rgba(14,42,73,.72);font-size:13px}.meal-detail-copy{display:flex;margin:12px 16px;padding:16px;border-radius:16px;background:#fff;flex-direction:column}.meal-section{margin:12px 16px;padding:16px;border-radius:16px;background:#fff}.meal-detail-copy>text:first-child{color:#193653;font-size:24px;font-weight:700;line-height:1.4;overflow-wrap:anywhere}.meal-detail-copy>text:nth-child(2){margin-top:10rpx;color:#46566b;font-size:16px;line-height:1.6}.meal-detail-copy>view{display:flex;margin-top:16rpx;flex-wrap:wrap;gap:8px}.meal-detail-copy>view text{padding:6px 12px;border-radius:20rpx;color:#176bd5;background:#eaf3ff;font-size:16px;line-height:1.6}.meal-section-title,.meal-section-heading>.meal-section-title{color:#172b43;font-size:19px;font-weight:700;text-align:left}.meal-step{display:flex;align-items:flex-start;margin-top:18rpx;color:#46566b;font-size:16px;line-height:1.6}.meal-step>text:first-child{display:flex;align-items:center;justify-content:center;width:26px;height:26px;margin-right:12px;border-radius:50%;color:#176bd5;background:#eaf2fd;font-size:16px;font-weight:700;line-height:1;flex:none}.meal-step>text:last-child{min-width:0;padding-top:2rpx;flex:1}.meal-section-heading{display:flex;align-items:baseline;justify-content:space-between;gap:14rpx}.meal-section-heading>text:last-child{color:#8a9bad;font-size:13px;text-align:right}.meal-product-list{margin-top:12rpx}.meal-product{display:grid;align-items:center;min-height:112rpx;padding:12px 0;border-top:1rpx solid #edf2f6;grid-template-columns:64px minmax(0,1fr);gap:8px 12px}.meal-product>image{width:64px;height:64px;margin:0;border-radius:8rpx;background:#f1f5f9;grid-row:1/3}.meal-product>view{display:flex;min-width:0;flex-direction:column}.meal-product>view text:first-child{overflow:visible;color:#24425f;font-size:19px;font-weight:700;line-height:1.45;white-space:normal;overflow-wrap:anywhere}.meal-product>view text:last-child{margin-top:7rpx;overflow:visible;color:#46566b;font-size:16px;line-height:1.5;white-space:normal;overflow-wrap:anywhere}.meal-product>button{display:flex;align-items:center;justify-content:center;width:auto;min-width:44px;max-width:100%;min-height:44px;margin:0;padding:0 16px;border:0;border-radius:999px;color:#fff;background:#287ff1;font-size:16px;line-height:1.4;white-space:normal;grid-column:2;justify-self:start}.meal-product-empty{display:flex;align-items:center;padding:28px 12px;flex-direction:column;justify-content:center;text-align:center}.meal-product-empty text:first-child{font-weight:700}.meal-product-empty text:last-child{margin-top:10rpx}.meal-disclaimer{margin:0 26rpx;text-align:center}.meal-unlisted-state>button{min-height:44px}.meal-bottom-space{height:calc(var(--fixed-one-space) + constant(safe-area-inset-bottom));height:calc(var(--fixed-one-space) + env(safe-area-inset-bottom))}.meal-bottom-space.has-quick-checkout{height:calc(var(--fixed-two-space) + constant(safe-area-inset-bottom));height:calc(var(--fixed-two-space) + env(safe-area-inset-bottom))}
@keyframes meal-video-spin{to{transform:rotate(360deg)}}@keyframes content-skeleton-breathe{0%,100%{opacity:.62}50%{opacity:1}}@media (prefers-reduced-motion:reduce){.meal-card-skeleton{animation:none}}
