<view class="page"><responsive-topbar title="积分中心" subtitle="积分与等级由服务端核算" bind:back="back"/><view wx:if="{{status == 'loading'}}" class="state">正在加载积分账户</view><view wx:elif="{{status == 'forbidden'}}" class="state"><text>需要登录</text><text>{{errorText}}</text></view><view wx:elif="{{status == 'error'}}" class="state error"><text>积分加载失败</text><text>{{errorText}}</text><button bindtap="retry">重新加载</button></view><block wx:elif="{{account}}"><view class="hero"><text>{{profile.levelName}}</text><text>{{account.balance}}</text><text>可用积分 · 成长值 {{profile.growthValue}}</text><button disabled="{{signing || account.signedToday}}" bindtap="signIn">{{account.signedToday ? '今日已签到' : (signing ? '正在签到' : '今日签到')}}</button></view><view class="card"><text class="title">等级权益</text><view wx:for="{{profile.benefits}}" wx:key="*this" class="benefit">{{item}}</view><text wx:if="{{!profile.benefits.length}}" class="empty">当前等级暂无额外权益</text></view><view class="card"><text class="title">积分流水</text><view wx:for="{{ledger}}" wx:key="_id" class="row"><view><text>{{item.label}}</text><text>{{item.time}}</text></view><text>{{item.amountText}}</text></view><text wx:if="{{!ledger.length}}" class="empty">暂无积分流水</text></view></block></view>
