.page{min-height:100vh;background:#f5f8fc;color:#0f1b2d;font-size:14px;}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#176bd5;color:#fff}.topbar>text{font-size:32px}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:18px;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:13px}.hero,.card{display:flex;margin:12px 16px;padding:16px 14px;border-radius:16px;background:#fff;flex-direction:column;gap:12px}.hero{color:#fff;background:#176bd5;flex-direction:row;align-items:center;justify-content:space-between;flex-wrap:wrap;min-height:140px;padding:24px 18px}.hero>text:nth-child(2){font-size:44px;font-weight:800}.hero button{align-self:center;margin:0;color:#176bd5;background:transparent;font-size:14px;display:flex;align-items:center;justify-content:center;width:auto;min-width:44px;min-height:44px;padding:0;border-radius:0;}.title{font-size:16px;font-weight:700}.row{display:flex;justify-content:space-between;padding:12px 0;border-top:1rpx solid #edf1f4;align-items:center;gap:12px;}.row>view{display:flex;flex-direction:column;gap:5rpx;min-width:0;flex:1;overflow-wrap:anywhere;}.row>view text:last-child,.empty{color:#667085;font-size:13px}.row>text{color:#ff4d4f;font-weight:700}.benefit{padding:12rpx;border-radius:8rpx;background:#eaf2fd}.state{display:flex;align-items:center;justify-content:center;min-height:360rpx;margin:12px 16px;padding:20px 14px;border-radius:16px;background:#fff;flex-direction:column;gap:12rpx;text-align:center;padding-top:20px;padding-bottom:20px;line-height:1.6;}.state.error{background:#fff7f5}
.page{font-size:14px}.title{font-size:16px}.row>view text:last-child,.empty{font-size:13px}.hero button,.state button{min-height:44px;font-size:14px;box-sizing:border-box;display:flex;align-items:center;justify-content:center;width:auto;min-width:44px;margin:0;padding:0;border-radius:0;background:transparent;align-self:center;}

/* 普通空态不再占据近半屏高度。 */
.state {
  min-height: 0;
  padding-top: 44rpx;
  padding-bottom: 44rpx;
}
.state.error text:first-child{color:#0f1b2d;font-size:18px;font-weight:700}
.state.error button{min-width:112px;min-height:44px;margin-top:4px;padding:0 18px;border-radius:999px;color:#fff;background:#176bd5;font-size:15px;font-weight:600}

@media (min-width: 480px) {
  .hero button,
  .state button {min-height:44px;display:flex;align-items:center;justify-content:center;width:auto;min-width:44px;margin:0;padding:0;border-radius:0;background:transparent;align-self:center;}
  .page {font-size:14px; }
  .title { font-size: 16px; }
  .row > view text:last-child,
  .empty { font-size: 13px; }
  .hero button,
  .state button {font-size: 14px;display:flex;align-items:center;justify-content:center;width:auto;min-width:44px;min-height:44px;margin:0;padding:0;border-radius:0;background:transparent;align-self:center;}
}

.point-summary{display:flex;min-width:0;flex:1;flex-direction:column;gap:8px;line-height:1.5}
.point-balance{font-size:44px;font-weight:700;line-height:1.2;overflow-wrap:anywhere}
.hero button>text{display:flex;align-items:center;justify-content:center;min-height:36px;padding:6px 18px;border-radius:999px;background:#fff;color:#176bd5;font-size:14px;font-weight:600;line-height:1.4}
.hero button[disabled]{opacity:1}
.sign-notice{display:flex;flex-direction:column;align-items:flex-start;gap:10px;margin:12px 16px;padding:16px 14px;border-radius:16px;background:#eaf2fd;color:#667085;line-height:1.6}
.sign-notice button{display:flex;align-items:center;justify-content:center;width:auto;min-width:44px;min-height:44px;margin:0;padding:0;background:transparent}
.sign-notice button>text{padding:7px 22px;border-radius:999px;background:#176bd5;color:#fff;font-size:14px}
.ledger-change{flex-shrink:0;font-size:16px;overflow-wrap:anywhere;max-width:45%}
.ledger-change.is-credit{color:#13a35c}
.ledger-change.is-debit{color:#667085}
.ledger-empty{display:flex;flex-direction:column;gap:8px;padding:14px;border-radius:14px;background:#eaf2fd;color:#667085;font-size:14px;line-height:1.6}
