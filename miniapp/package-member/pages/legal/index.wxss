.page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  color: #203a53;
  background: #f3f7fc;
}

.document-tabs {
  display: flex;
  margin: 20rpx 24rpx 0;
  padding: 6rpx;
  border-radius: 14rpx;
  background: #e7eef7;
  gap: 6rpx;
}

.document-tabs button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 44px;
  margin: 0;
  padding: 0 12rpx;
  flex: 1;
  border-radius: 10rpx;
  color: #5c7187;
  background: transparent;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.3;
}

.document-tabs button.is-active {
  color: #0a69e9;
  background: #fff;
  box-shadow: 0 4rpx 14rpx rgba(20, 57, 94, .08);
}

.legal-document {
  margin: 18rpx 24rpx 0;
  padding: 30rpx 28rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 6rpx 22rpx rgba(28, 69, 109, .06);
}

.document-heading,
.legal-section,
.contact-card {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.document-title {
  color: #102f4d;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.3;
}

.document-subtitle {
  margin-top: 8rpx;
  color: #60768c;
  font-size: 14px;
  line-height: 1.55;
}

.document-meta {
  display: flex;
  margin-top: 18rpx;
  flex-wrap: wrap;
  gap: 10rpx 22rpx;
  color: #7c8fa2;
  font-size: 13px;
  line-height: 1.5;
}

.draft-notice {
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #cfe2fb;
  border-radius: 10rpx;
  color: #315c86;
  background: #f0f7ff;
  font-size: 14px;
  line-height: 1.65;
}

.legal-section {
  margin-top: 30rpx;
  gap: 14rpx;
}

.section-title {
  color: #153d62;
  font-size: 16px;
  font-weight: 700;
  line-height: 1.45;
}

.section-paragraph {
  color: #455e75;
  font-size: 14px;
  line-height: 1.85;
  text-align: justify;
  overflow-wrap: break-word;
}

.contact-card {
  margin-top: 34rpx;
  padding: 22rpx;
  border-radius: 12rpx;
  background: #f5f8fc;
  gap: 8rpx;
}

.contact-card text:nth-child(odd) {
  margin-top: 8rpx;
  color: #183e62;
  font-size: 14px;
  font-weight: 700;
}

.contact-card text:nth-child(even) {
  color: #5b7187;
  font-size: 14px;
  line-height: 1.6;
}

.contact-card button,
.wechat-contract {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  min-height: 44px;
  margin: 18rpx 0 0;
  padding: 0 18rpx;
  border-radius: 10rpx;
  color: #fff;
  background: #0a69e9;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.35;
}

.wechat-contract {
  color: #0a69e9;
  background: #eaf3ff;
}

@media (min-width: 700px) {
  .document-tabs,
  .legal-document {
    width: calc(100% - 48rpx);
    max-width: 980rpx;
    margin-right: auto;
    margin-left: auto;
  }

  .legal-document {
    padding: 38rpx 44rpx;
  }
}


/* 交付态控件层级：触控尺寸使用 px，避免窄屏被 rpx 继续缩小。 */
button {
  min-height: 44px;
  box-sizing: border-box;
  white-space: nowrap;
  line-height: 1.25;
}

.control-pressed {
  opacity: .72;
}


input,
textarea,
picker {
  min-height: 44px;
  box-sizing: border-box;
  font-size: 14px;
}
