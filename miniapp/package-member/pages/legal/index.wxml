<view class="page">
  <responsive-topbar title="隐私与协议" subtitle="阅读当前生效版本" bind:back="back" />

  <view class="document-tabs" role="tablist">
    <button class="{{activeType == 'privacy' ? 'is-active' : ''}}" data-type="privacy" bindtap="switchDocument">隐私政策</button>
    <button class="{{activeType == 'terms' ? 'is-active' : ''}}" data-type="terms" bindtap="switchDocument">用户服务协议</button>
  </view>

  <view class="legal-document">
    <view class="document-heading">
      <text class="document-title">{{document.title}}</text>
      <text class="document-subtitle">{{document.subtitle}}</text>
      <view class="document-meta">
        <text>版本 {{document.version}}</text>
        <text>生效日期 {{document.effectiveDate}}</text>
      </view>
    </view>

    <view class="draft-notice">{{document.notice}}</view>

    <view
      wx:for="{{document.sections}}"
      wx:key="title"
      wx:for-item="section"
      wx:for-index="sectionIndex"
      class="legal-section"
    >
      <text class="section-title">{{sectionIndex + 1}}. {{section.title}}</text>
      <text
        wx:for="{{section.paragraphs}}"
        wx:key="*this"
        wx:for-item="paragraph"
        class="section-paragraph"
      >{{paragraph}}</text>
    </view>

    <view class="contact-card">
      <text>运营者</text>
      <text>{{document.operatorName}}</text>
      <text>联系方式</text>
      <text>{{document.contactMethod}}</text>
      <button open-type="contact" session-from="梦食鲜协议咨询" bindtap="contact">联系微信客服</button>
    </view>

    <button
      wx:if="{{activeType == 'privacy'}}"
      class="wechat-contract"
      bindtap="openWechatPrivacyContract"
    >查看微信平台隐私保护指引</button>
  </view>
</view>
