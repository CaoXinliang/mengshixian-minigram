.page{min-height:100vh;background:#f5f8fc;color:#0f1b2d;font-size:14px;}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#176bd5;color:#fff}.topbar>text{font-size:32px}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:18px;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:13px}.hero,.card{display:flex;margin:18rpx;padding:26rpx;border-radius:14rpx;background:#fff;flex-direction:column;gap:12rpx}.hero{color:#fff;background:linear-gradient(135deg,#123b61,#176bd5)}.hero>text:nth-child(2){font-size:32px;font-weight:800}.title{font-size:16px;font-weight:700}.warning{padding:14rpx;border-radius:8rpx;color:#9a5b1b;background:#fff6e8;font-size:13px}.card input{padding:18rpx;border:1rpx solid #d4e0eb;border-radius:8rpx}.card button{color:#fff;background:#176bd5}.row{display:flex;justify-content:space-between;padding:13rpx 0;border-top:1rpx solid #edf1f4}.row>view{display:flex;flex-direction:column;gap:5rpx}.row>view text:last-child,.empty{color:#667085;font-size:13px}.row>text{color:#ff4d4f;font-weight:700}.state{display:flex;align-items:flex-start;justify-content:center;min-height:360rpx;margin:12px 16px;padding:20px 14px;border-radius:16px;background:#eaf2fd;flex-direction:column;gap:12rpx;text-align:left;padding-top:20px;padding-bottom:20px;line-height:1.6;color:#0f1b2d;font-size:14px;}.state.error{background:#fff7f5}
.recharge-input{width:100%;min-width:0;height:44px;padding:0 18rpx!important;box-sizing:border-box;line-height:44px}.recharge-action{display:flex;align-items:center;justify-content:center;width:100%;min-width:0;min-height:44px;margin:0;box-sizing:border-box;white-space:nowrap;line-height:1.25}
.page{font-size:14px}.title{font-size:16px}.warning,.row>view text:last-child,.empty{font-size:13px}.card button,.state button,.recharge-input{min-height:44px;font-size:14px}.recharge-input{height:44px;line-height:44px}

/* 未开放类普通空态保持紧凑，不占据近半屏高度。 */
.state {
  min-height: 0;
  padding-top: 44rpx;
  padding-bottom: 44rpx;
}

@media (min-width: 480px) {
  .card button,
  .state button,
  .recharge-input,
  .recharge-action { min-height: 44px; }
  .recharge-input { height: 44px; line-height: 44px; }
  .page {font-size:14px; }
  .title { font-size: 16px; }
  .warning,
  .row > view text:last-child,
  .empty { font-size: 13px; }
  .card button,
  .state button,
  .recharge-input { font-size: 14px; }
}
