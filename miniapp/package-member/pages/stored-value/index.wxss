.page{min-height:100vh;background:#f3f7fc;color:#203a53}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:32rpx;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:20rpx}.hero,.card{display:flex;margin:18rpx;padding:26rpx;border-radius:14rpx;background:#fff;flex-direction:column;gap:12rpx}.hero{color:#fff;background:linear-gradient(135deg,#123b61,#0a69e9)}.hero>text:nth-child(2){font-size:52rpx;font-weight:800}.title{font-size:26rpx;font-weight:700}.warning{padding:14rpx;border-radius:8rpx;color:#9a5b1b;background:#fff6e8;font-size:21rpx}.card input{padding:18rpx;border:1rpx solid #d4e0eb;border-radius:8rpx}.card button{color:#fff;background:#0a69e9}.row{display:flex;justify-content:space-between;padding:13rpx 0;border-top:1rpx solid #edf1f4}.row>view{display:flex;flex-direction:column;gap:5rpx}.row>view text:last-child,.empty{color:#60768c;font-size:20rpx}.row>text{color:#e35d36;font-weight:700}.state{display:flex;align-items:center;justify-content:center;min-height:360rpx;margin:18rpx;padding:30rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx;text-align:center}.state.error{background:#fff7f5}
