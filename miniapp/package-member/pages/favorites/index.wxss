.page{min-height:100vh;background:#f5f8fc;color:#0f1b2d;font-size:14px;}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#176bd5;color:#fff}.topbar>text{font-size:32px}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:18px;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:13px}.list{padding:12px 16px}.card{display:flex;align-items:center;margin-bottom:10px;padding:14px;border-radius:16px;background:#fff;gap:12px;flex-wrap:wrap;}.product-link{display:flex;align-items:center;min-width:0;min-height:44px;flex:1;gap:16rpx;flex-wrap:wrap;}.product-link image{width:64px;height:64px;flex:0 0 auto}.product-copy{display:flex;min-width:0;flex:1;flex-direction:column;gap:7rpx;flex-basis:120px;}.product-copy text:first-child{font-weight:700;overflow-wrap:anywhere}.product-copy text:not(:first-child){color:#667085;font-size:13px;overflow-wrap:anywhere}.product-link-action{flex:0 0 auto;padding:7px 14px;border:1rpx solid #8cbcf7;border-radius:999px;color:#176bd5;background:#f4f8ff;font-size:14px;font-weight:700}.card button{margin:0;padding:8rpx 14rpx;color:#176bd5;background:#eaf2fd;font-size:13px;width:auto;min-width:44px;min-height:44px;}.state{display:flex;align-items:center;justify-content:center;min-height:360rpx;margin:12px 16px;padding:20px 14px;border-radius:16px;background:#fff;flex-direction:column;gap:12rpx;text-align:center;padding-top:20px;padding-bottom:20px;line-height:1.6;}.state.error{background:#fff7f5}


/* 正文字号与触控热区使用 px，容器随视口收缩。 */
button {
  min-height:44px;
  box-sizing: border-box;
  white-space: nowrap;
  line-height: 1.25;
}

.control-pressed {
  opacity: .72;
}

.state {min-height: 0;padding-top:20px;padding-bottom:20px;margin:12px 16px;padding:20px 14px;border-radius:16px;line-height:1.6;}

.state-loading {
  min-height: 320rpx;
}


input,
textarea,
picker {
  min-height:44px;
  box-sizing: border-box;
  font-size:14px;
}

.card .remove-favorite {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 44px;
  min-height: 44px;
  max-width: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  color: inherit;
  background: transparent;
  flex: 0 1 auto;
  box-sizing: border-box;
}

.remove-favorite::after {
  border: 0;
}

.remove-area {
  display: flex;
  align-items: flex-end;
  min-width: 0;
  flex-direction: column;
  gap: 6px;
}

.remove-result {
  max-width: 220px;
  color: #b24d43;
  font-size: 13px;
  line-height: 1.5;
  text-align: right;
  overflow-wrap: anywhere;
}

.remove-result.is-unknown {
  color: #8a5a16;
}

.remove-favorite-face {
  display: block;
  max-width: 100%;padding:7px 14px;border-radius:999px;
  color: #176bd5;
  background: #eaf2fd;font-size:14px;
  line-height: 1.25;
  white-space: normal;
  overflow-wrap: anywhere;
}

@media (max-width: 360px) {
  .card {align-items: stretch;
    flex-direction: column;padding:14px;gap:12px;margin-bottom:10px;flex-wrap:wrap;}

  .product-link-action {padding-right: 10rpx;
    padding-left: 10rpx;padding:7px 14px;font-size:14px;border-radius:999px;}

  .remove-favorite {
    align-self: flex-end;
  }
}

@media (min-width: 480px) {
  button,
  input,
  textarea,
  picker { min-height: 44px; }
  .topbar > view text:first-child { font-size: 18px; }
  .topbar > view text:last-child,
  .product-copy text:not(:first-child),
  .product-link-action,
  .card button,
  .remove-favorite-face {font-size:14px;}
}

.collection-empty{display:flex;flex-direction:column;gap:12px;margin:12px 16px;padding:18px 16px;border-radius:16px;background:#eaf2fd}
.summary-title{font-size:20px;line-height:1.4;color:#0f1b2d;overflow-wrap:anywhere}
.summary-copy,.summary-actions>text{font-size:14px;line-height:1.5;color:#667085}
.summary-actions{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px 12px}
.browse-link{display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;max-width:100%;box-sizing:border-box}
.browse-link>text{display:flex;align-items:center;justify-content:center;min-height:36px;padding:6px 22px;border-radius:999px;background:#176bd5;color:#fff;font-size:14px;line-height:1.4;text-align:center}
