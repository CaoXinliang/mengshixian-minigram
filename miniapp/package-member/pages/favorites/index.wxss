.page{min-height:100vh;background:#f3f7fc;color:#203a53}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:18px;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:13px}.list{padding:18rpx}.card{display:flex;align-items:center;margin-bottom:14rpx;padding:20rpx;border-radius:12rpx;background:#fff;gap:16rpx}.product-link{display:flex;align-items:center;min-width:0;min-height:44px;flex:1;gap:16rpx}.product-link image{width:100rpx;height:100rpx;flex:0 0 auto}.product-copy{display:flex;min-width:0;flex:1;flex-direction:column;gap:7rpx}.product-copy text:first-child{font-weight:700}.product-copy text:not(:first-child){color:#60768c;font-size:13px}.product-link-action{flex:0 0 auto;padding:10rpx 14rpx;border:1rpx solid #8cbcf7;border-radius:999rpx;color:#0a69e9;background:#f4f8ff;font-size:13px;font-weight:700}.card button{margin:0;padding:8rpx 14rpx;color:#0a69e9;background:#edf5ff;font-size:13px}.state{display:flex;align-items:center;justify-content:center;min-height:360rpx;margin:18rpx;padding:30rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx;text-align:center}.state.error{background:#fff7f5}


/* 交付态控件层级：触控尺寸使用 px，避免窄屏被 rpx 继续缩小。 */
button {
  min-height: 44px;
  box-sizing: border-box;
  white-space: nowrap;
  line-height: 1.25;
}

.control-pressed {
  opacity: .72;
}

.state {
  min-height: 0;
  padding-top: 44rpx;
  padding-bottom: 44rpx;
}

.state-loading {
  min-height: 320rpx;
}


input,
textarea,
picker {
  min-height: 44px;
  box-sizing: border-box;
  font-size: 14px;
}

.card button {
  width: auto;
  min-width: 44px;
  max-width: 100%;
  flex: 0 1 auto;
  box-sizing: border-box;
  white-space: normal;
  overflow-wrap: anywhere;
}

@media (max-width: 360px) {
  .card {
    align-items: stretch;
    flex-direction: column;
  }

  .product-link-action {
    padding-right: 10rpx;
    padding-left: 10rpx;
  }

  .remove-favorite {
    align-self: flex-end;
  }
}
