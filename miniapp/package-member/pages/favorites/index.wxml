<view class="page">
  <responsive-topbar title="我的收藏" compact-title="{{true}}" bind:back="back"/>
  <view wx:if="{{status == 'loading'}}" class="state state-loading">正在加载收藏</view>
  <view wx:elif="{{status == 'forbidden'}}" class="state">
    <text>需要登录</text>
    <text>{{errorText}}</text>
  </view>
  <view wx:elif="{{status == 'error'}}" class="state error">
    <text>收藏加载失败</text>
    <text>{{errorText}}</text>
    <button bindtap="retry">重新加载</button>
  </view>
  <view wx:elif="{{status == 'empty'}}" class="collection-empty">
    <text class="summary-title">当前没有收藏商品</text>
    <text class="summary-copy">收藏商品后，可在这里快速查看。</text>
    <view class="summary-actions">
      <text>收藏数量 0</text>
      <navigator class="browse-link" url="/pages/index/index?tab=home" open-type="reLaunch" hover-class="control-pressed">
        <text>继续选购</text>
      </navigator>
    </view>
  </view>
  <view wx:elif="{{status == 'ready'}}" class="list">
    <view wx:for="{{rows}}" wx:key="id" class="card">
      <view wx:if="{{item.purchasable}}" class="product-link" bindtap="openProduct" data-id="{{item.id}}" aria-role="button" aria-label="查看 {{item.name}}" hover-class="control-pressed">
        <image src="{{item.image}}" mode="aspectFit"/>
        <view class="product-copy">
          <text>{{item.name}}</text>
          <text>{{item.spec}}</text>
        </view>
        <text class="product-link-action">查看商品 ›</text>
      </view>
      <view wx:else class="product-link is-disabled" aria-disabled="true">
        <image src="{{item.image}}" mode="aspectFit"/>
        <view class="product-copy">
          <text>{{item.name}}</text>
          <text>{{item.spec}}</text>
          <text class="unavailable-copy">{{item.unavailableText}}</text>
        </view>
      </view>
      <view class="remove-area">
        <button class="remove-favorite" disabled="{{item.removing || !item.canRemove}}" bindtap="remove" data-id="{{item.id}}">
          <text class="remove-favorite-face">{{item.removing ? '处理中' : '取消收藏'}}</text>
        </button>
        <text wx:if="{{item.removeText}}" class="remove-result {{item.removeState == 'unknown' ? 'is-unknown' : 'is-error'}}">{{item.removeText}}</text>
      </view>
    </view>
  </view>
</view>
