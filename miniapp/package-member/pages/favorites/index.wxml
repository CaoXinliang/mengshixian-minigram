<view class="page"><responsive-topbar title="我的收藏" subtitle="收藏的商品" bind:back="back"/><view wx:if="{{status == 'loading'}}" class="state state-loading">正在加载收藏</view><view wx:elif="{{status == 'forbidden'}}" class="state"><text>需要登录</text><text>{{errorText}}</text></view><view wx:elif="{{status == 'error'}}" class="state error"><text>收藏加载失败</text><text>{{errorText}}</text><button bindtap="retry">重新加载</button></view><view wx:elif="{{status == 'empty'}}" class="state"><text>暂无收藏商品</text><text>在商品详情可添加收藏</text></view><view wx:else class="list"><view wx:for="{{rows}}" wx:key="id" class="card"><view wx:if="{{!item.unavailable}}" class="product-link" bindtap="openProduct" data-id="{{item.id}}" aria-role="button" aria-label="查看 {{item.name}}" hover-class="control-pressed"><image src="{{item.image}}" mode="aspectFit"/><view class="product-copy"><text>{{item.name}}</text><text>{{item.spec}}</text></view><text class="product-link-action">查看商品 ›</text></view><view wx:else class="product-link is-disabled" aria-disabled="true"><image src="{{item.image}}" mode="aspectFit"/><view class="product-copy"><text>{{item.name}}</text><text>{{item.spec}}</text><text>商品当前不可购买</text></view></view><button class="remove-favorite" disabled="{{busyId}}" bindtap="remove" data-id="{{item.id}}">{{busyId == item.id ? '处理中' : '取消收藏'}}</button></view></view></view>
