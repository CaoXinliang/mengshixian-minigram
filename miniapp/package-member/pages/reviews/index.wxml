<view class="page"><responsive-topbar title="评价晒单" subtitle="仅已完成订单可评价" bind:back="back"/><view wx:if="{{status == 'loading'}}" class="state">正在加载评价数据</view><view wx:elif="{{status == 'forbidden'}}" class="state"><text>需要登录</text><text>{{errorText}}</text></view><view wx:elif="{{status == 'error'}}" class="state error"><text>评价数据加载失败</text><text>{{errorText}}</text><button bindtap="retry">重新加载</button></view><block wx:elif="{{status == 'ready'}}"><view wx:if="{{!current}}" class="card"><text class="title">待评价订单</text><view wx:for="{{orders}}" wx:key="id" class="row" bindtap="selectOrder" data-id="{{item.id}}"><view><text>{{item.orderNo}}</text><text>{{item.createdAt}}</text></view><text>去评价 ›</text></view><text wx:if="{{!orders.length}}" class="empty">暂无待评价订单</text></view><view wx:else><view class="card"><text class="title">{{current.orderNo}}</text><view wx:for="{{current.items}}" wx:key="id" class="check" bindtap="toggleItem" data-id="{{item.id}}"><text>{{item.selected ? '✓' : '○'}}</text><text>{{item.name}}</text></view></view><view class="card"><text class="title">评分</text><view class="rating"><text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="{{rating >= item ? 'active' : ''}}" bindtap="setRating" data-rating="{{item}}">★</text></view><textarea maxlength="500" value="{{content}}" bindinput="inputContent" placeholder="说说商品和配送体验"/><view class="media"><view wx:for="{{media}}" wx:key="id"><image src="{{item.path}}" mode="aspectFill"/><text>{{item.status == 'uploading' ? '上传中' : (item.status == 'failed' ? '上传失败' : '')}}</text><button wx:if="{{item.status == 'failed'}}" bindtap="retryMedia" data-id="{{item.id}}">重试</button><button bindtap="removeMedia" data-id="{{item.id}}">删除</button></view><button bindtap="chooseMedia">添加图片</button></view><button disabled="{{busy}}" bindtap="submit">{{busy ? '提交中' : '提交评价'}}</button></view></view><view class="card"><text class="title">我的评价</text><view wx:for="{{mine}}" wx:key="_id" class="row"><view><text>{{item.content || item.reviewText}}</text><text>{{item.rating}} 星 · {{item.createdAt}}</text></view></view><text wx:if="{{!mine.length}}" class="empty">暂无已提交评价</text></view></block></view>
