.page{min-height:100vh;background:#f3f7fc;color:#203a53}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:32rpx;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:20rpx}.card{display:flex;margin:18rpx;padding:24rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx}.title{font-size:26rpx;font-weight:700}.row,.check{display:flex;align-items:center;justify-content:space-between;padding:13rpx 0;border-top:1rpx solid #edf1f4}.row>view{display:flex;flex-direction:column;gap:5rpx}.row>view text:last-child,.empty{color:#60768c;font-size:20rpx}.check{justify-content:flex-start;gap:12rpx}.rating{display:flex;gap:8rpx}.rating text{color:#cdd7e0;font-size:46rpx}.rating .active{color:#ffad33}.card textarea{width:100%;min-height:150rpx;padding:15rpx;border:1rpx solid #d4e0eb;border-radius:8rpx;box-sizing:border-box}.media{display:flex;gap:10rpx;flex-wrap:wrap}.media>view{display:flex;width:130rpx;flex-direction:column}.media image{width:130rpx;height:130rpx}.media button{margin:4rpx 0 0;padding:5rpx;font-size:18rpx}.state{display:flex;align-items:center;justify-content:center;min-height:360rpx;margin:18rpx;padding:30rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx;text-align:center}.state.error{background:#fff7f5}
