/* 普通空态不再占据近半屏高度。 */
.state {
  min-height: 0;
  padding-top: 44rpx;
  padding-bottom: 44rpx;
}

/* 媒体格按文字所需宽度换列，不把两个操作塞进窄屏的 130rpx。 */
.media {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220rpx, 1fr));
  gap: 16rpx;
  align-items: start;
}

.media > view,
.media > .media-add {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  margin: 0;
}

.media image {
  width: 100%;
  height: 180rpx;
  border-radius: 8rpx;
}

.media-actions {grid-template-columns:repeat(auto-fit, minmax(48px, 1fr));gap:6px;
}

.media-actions > button,
.media > .media-add {max-width: 100%;
  margin: 0;padding:6px 4px;
  white-space: normal;
  line-height: 1.4;min-height:44px;font-size:14px;}

@media (min-width: 480px) {
  .state button,
  .review-submit,
  .media button {min-height:44px;border-radius:999px;padding:8px 20px;}
  .page {font-size:14px; }
  .title { font-size: 16px; }
  .order-label,
  .row > view text:last-child,
  .empty,
  .media-item > text { font-size: 13px; }
  .state button,
  .review-submit {font-size: 14px;min-height:44px;border-radius:999px;padding:8px 20px;}
  .media button { font-size: 12px; }
  .card textarea {font-size: 14px;min-height:132px;height:132px;padding:12px;border-radius:12px;background:#f7faff;line-height:1.6;}
  .media {grid-template-columns:repeat(auto-fill, minmax(120px, 1fr));gap:8px; }
  .media image { height: 96px; }
  .media-actions {gap:6px;grid-template-columns:repeat(auto-fit, minmax(48px, 1fr));}
  .media-actions > button,
  .media > .media-add {padding:6px 4px;min-height:44px;font-size:14px;}
}

.review-summary{display:flex;flex-direction:column;gap:12px;margin:12px 16px;padding:18px 16px;border-radius:16px;background:#eaf2fd;color:#176bd5;font-size:14px;line-height:1.6}
.summary-title{color:#0f1b2d;font-size:20px;line-height:1.4}
.review-order{min-height:44px}
.review-order-action{display:flex;align-items:center;min-height:34px;padding:6px 16px;border:1px solid #176bd5;border-radius:999px;color:#176bd5;font-size:14px;line-height:1.4}
.content-count{align-self:flex-end;font-size:12px;color:#667085}
.submit-status{display:flex;flex-direction:column;gap:8px;padding:14px;border-radius:14px;background:#eaf2fd;color:#667085;font-size:14px;line-height:1.6}
.review-rules{font-size:14px;line-height:1.6;color:#667085}
.review-rules .title{color:#0f1b2d}
.check>text{min-width:0;overflow-wrap:anywhere}
.submission-ok{margin-left:auto;color:#23805a;font-size:13px;font-weight:600}
.submission-error{width:100%;padding-left:48rpx;color:#c95042;font-size:13px}
