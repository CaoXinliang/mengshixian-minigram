.page{min-height:100vh;background:#f3f7fc;color:#203a53}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:32rpx;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:20rpx}.card{display:flex;margin:18rpx;padding:24rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx}.title{font-size:26rpx;font-weight:700}.row,.check{display:flex;align-items:center;justify-content:space-between;padding:13rpx 0;border-top:1rpx solid #edf1f4}.row>view{display:flex;flex-direction:column;gap:5rpx}.row>view text:last-child,.empty{color:#60768c;font-size:20rpx}.check{justify-content:flex-start;gap:12rpx}.rating{display:flex;gap:8rpx}.rating text{color:#cdd7e0;font-size:46rpx}.rating .active{color:#ffad33}.card textarea{width:100%;min-height:150rpx;padding:15rpx;border:1rpx solid #d4e0eb;border-radius:8rpx;box-sizing:border-box}.media{display:flex;gap:10rpx;flex-wrap:wrap}.media>view{display:flex;width:130rpx;flex-direction:column}.media image{width:130rpx;height:130rpx}.media button{margin:4rpx 0 0;padding:5rpx;font-size:18rpx}.state{display:flex;align-items:center;justify-content:center;min-height:360rpx;margin:18rpx;padding:30rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx;text-align:center}.state.error{background:#fff7f5}
.order-label{color:#60768c;font-size:20rpx}.check{min-height:44px;box-sizing:border-box}.check-icon{display:flex;align-items:center;justify-content:center;width:36rpx;height:36rpx;border:2rpx solid #9fb0bf;border-radius:50%;box-sizing:border-box}.check.is-selected .check-icon{border-color:#0a69e9;background:#0a69e9}.check-icon-mark{width:14rpx;height:8rpx;margin-top:-4rpx;border-bottom:3rpx solid #fff;border-left:3rpx solid #fff;transform:rotate(-45deg)}.media-item{gap:4rpx}.media-actions{display:grid!important;width:100%!important;grid-template-columns:repeat(2,minmax(0,1fr));gap:6rpx}.media button{display:flex;align-items:center;justify-content:center;min-height:44px;box-sizing:border-box}.media-add{width:130rpx;min-width:130rpx;margin:0;color:#0a69e9;background:#edf5ff}.media-retry,.media-remove{width:100%;min-width:0}.media-retry{color:#0a69e9;background:#edf5ff}.media-remove{color:#a33c31;background:#fff1ef}.review-submit{display:flex;align-items:center;justify-content:center;width:100%;min-width:0;min-height:44px;margin:0;color:#fff;background:#0a69e9;box-sizing:border-box}
.page{font-size:14px}.title{font-size:16px}.order-label,.row>view text:last-child,.empty,.media-item>text{font-size:13px}.state button,.media button,.review-submit{min-height:44px;font-size:14px}.rating text{min-width:44px;min-height:44px;line-height:44px;text-align:center}.card textarea{min-height:120px;font-size:14px}

/* 普通空态不再占据近半屏高度。 */
.state {
  min-height: 0;
  padding-top: 44rpx;
  padding-bottom: 44rpx;
}

/* 媒体格按文字所需宽度换列，不把两个操作塞进窄屏的 130rpx。 */
.media {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  gap: 8px;
  align-items: start;
}

.media > view,
.media > .media-add {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  margin: 0;
}

.media image {
  width: 100%;
  height: 96px;
  border-radius: 8rpx;
}

.media-actions {
  grid-template-columns: repeat(auto-fit, minmax(48px, 1fr));
  gap: 6px;
}

.media-actions > button,
.media > .media-add {
  max-width: 100%;
  margin: 0;
  padding: 6px 4px;
  white-space: normal;
  line-height: 1.4;
}
