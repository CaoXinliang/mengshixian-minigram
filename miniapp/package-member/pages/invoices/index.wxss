.page{min-height:100vh;background:#f5f8fc;color:#0f1b2d;font-size:14px;}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#176bd5;color:#fff}.topbar>text{font-size:32px}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:18px;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:13px}.card{display:flex;margin:18rpx;padding:24rpx;border-radius:16px;background:#fff;flex-direction:column;gap:12rpx}.heading,.row{display:flex;align-items:center;justify-content:space-between}.title,.heading>text{font-size:16px;font-weight:700}.heading button,.row button{margin:0;padding:8rpx 14rpx;color:#176bd5;background:#eaf2fd;font-size:13px}.row{padding:13rpx 0;border-top:1rpx solid #edf1f4}.row>view:first-child{display:flex;flex-direction:column;gap:5rpx}.row>view:first-child text:last-child,.empty{color:#667085;font-size:13px}.row>view:last-child{display:flex;gap:6rpx}.mask{position:fixed;inset:0;z-index:20;display:flex;align-items:flex-end;background:rgba(8,20,34,.48)}.sheet{display:flex;width:100%;padding:28rpx;border-radius:22rpx 22rpx 0 0;background:#fff;box-sizing:border-box;flex-direction:column;gap:14rpx}.sheet input{padding:18rpx;border:1rpx solid #d4e0eb;border-radius:8rpx}.tabs{display:grid;grid-template-columns:1fr 1fr;gap:8rpx}.tabs button{margin:0}.tabs .active{color:#fff;background:#176bd5}.state{display:flex;align-items:flex-start;justify-content:center;min-height:360rpx;margin:12px 16px;padding:20px 14px;border-radius:16px;background:#eaf2fd;flex-direction:column;gap:12rpx;text-align:left;padding-top:20px;padding-bottom:20px;line-height:1.6;color:#0f1b2d;font-size:14px;}.state.error{background:#fff7f5}

.mask{box-sizing:border-box;padding-top:24rpx}
.sheet{max-height:calc(100vh - 24rpx);padding-bottom:calc(28rpx + constant(safe-area-inset-bottom));padding-bottom:calc(28rpx + env(safe-area-inset-bottom));overflow-y:auto}
.sheet input{width:100%;min-width:0;height:44px;padding:0 18rpx;box-sizing:border-box;font-size:14px;line-height:44px}
.tabs{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
.tabs button,.sheet-submit{display:flex;align-items:center;justify-content:center;width:100%;min-width:0;height:44px;margin-right:0;margin-left:0;padding:0 18rpx;box-sizing:border-box;font-size:14px;line-height:1.25}
.sheet-submit{align-self:stretch;width:auto!important;max-width:none;height:80rpx;color:#fff;background:#176bd5;font-size:16px;font-weight:700}
.heading button,.row button{min-height:44px;line-height:1.25}
.heading .compact-action{display:flex;align-items:center;justify-content:center;width:auto!important;min-width:44px;height:44px;min-height:44px;margin:0;padding:0 20rpx;box-sizing:border-box;white-space:nowrap}.invoice-email{width:100%;min-width:0;height:44px;padding:0 18rpx;box-sizing:border-box;line-height:44px}
.page{font-size:14px}.title,.heading>text{font-size:16px}.row>view:first-child text:last-child,.empty{font-size:13px}.heading button,.row button,.tabs button,.sheet-submit,.state button{min-height:44px;font-size:14px;box-sizing:border-box}.invoice-email,.sheet input{height:44px;min-height:44px;font-size:14px;line-height:44px}

/* 未开放类普通空态保持紧凑，不占据近半屏高度。 */
.state {
  min-height: 0;
  padding-top: 44rpx;
  padding-bottom: 44rpx;
}

@media (min-width: 480px) {
  .heading button,
  .row button,
  .tabs button,
  .sheet-submit,
  .state button,
  .invoice-email,
  .sheet input { min-height: 44px; }
  .invoice-email,
  .sheet input { height: 44px; line-height: 44px; }
  .page {font-size:14px; }
  .title,
  .heading > text { font-size: 16px; }
  .row > view:first-child text:last-child,
  .empty { font-size: 13px; }
  .heading button,
  .row button,
  .tabs button,
  .sheet-submit,
  .state button { font-size: 14px; }
  .invoice-email,
  .sheet input { font-size: 14px; }
}
