.page{min-height:100vh;background:#f3f7fc;color:#203a53}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:32rpx;font-weight:700}.topbar>view text:last-child{color:#dcecff;font-size:20rpx}.card{display:flex;margin:18rpx;padding:24rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx}.heading,.row{display:flex;align-items:center;justify-content:space-between}.title,.heading>text{font-size:26rpx;font-weight:700}.heading button,.row button{margin:0;padding:8rpx 14rpx;color:#0a69e9;background:#edf5ff;font-size:20rpx}.row{padding:13rpx 0;border-top:1rpx solid #edf1f4}.row>view:first-child{display:flex;flex-direction:column;gap:5rpx}.row>view:first-child text:last-child,.empty{color:#60768c;font-size:20rpx}.row>view:last-child{display:flex;gap:6rpx}.mask{position:fixed;inset:0;z-index:20;display:flex;align-items:flex-end;background:rgba(8,20,34,.48)}.sheet{display:flex;width:100%;padding:28rpx;border-radius:22rpx 22rpx 0 0;background:#fff;box-sizing:border-box;flex-direction:column;gap:14rpx}.sheet input{padding:18rpx;border:1rpx solid #d4e0eb;border-radius:8rpx}.tabs{display:grid;grid-template-columns:1fr 1fr;gap:8rpx}.tabs button{margin:0}.tabs .active{color:#fff;background:#0a69e9}.state{display:flex;align-items:center;justify-content:center;min-height:360rpx;margin:18rpx;padding:30rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx;text-align:center}.state.error{background:#fff7f5}

.mask{box-sizing:border-box;padding-top:24rpx}
.sheet{max-height:calc(100vh - 24rpx);padding-bottom:calc(28rpx + constant(safe-area-inset-bottom));padding-bottom:calc(28rpx + env(safe-area-inset-bottom));overflow-y:auto}
.sheet input{width:100%;min-width:0;height:72rpx;padding:0 18rpx;box-sizing:border-box;font-size:23rpx;line-height:72rpx}
.tabs{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
.tabs button,.sheet-submit{display:flex;align-items:center;justify-content:center;width:100%;min-width:0;height:72rpx;margin-right:0;margin-left:0;padding:0 18rpx;box-sizing:border-box;font-size:23rpx;line-height:1.25}
.sheet-submit{align-self:stretch;width:auto!important;max-width:none;height:80rpx;color:#fff;background:#0a69e9;font-size:25rpx;font-weight:700}
.heading button,.row button{min-height:56rpx;line-height:1.25}
