<view class="page"><responsive-topbar title="电子发票" subtitle="金额、抬头与开票状态以服务端为准" bind:back="back"/><view wx:if="{{status == 'loading'}}" class="state">正在加载发票资料</view><view wx:elif="{{status == 'forbidden'}}" class="state"><text>需要登录</text><text>{{errorText}}</text></view><view wx:elif="{{status == 'error'}}" class="state error"><text>发票数据加载失败</text><text>{{errorText}}</text><button bindtap="retry">重新加载</button></view><block wx:elif="{{status == 'ready'}}"><view class="card"><view class="heading"><text>发票抬头</text><button bindtap="showForm">新增</button></view><view wx:for="{{titles}}" wx:key="_id" class="row"><view><text>{{item.name}}</text><text>{{item.type == 'company' ? item.taxNo : '个人抬头'}}</text></view><view><button bindtap="showForm" data-id="{{item._id}}">编辑</button><button bindtap="deleteTitle" data-id="{{item._id}}">删除</button></view></view><text wx:if="{{!titles.length}}" class="empty">暂无发票抬头</text></view><view class="card"><text class="title">可申请订单</text><input type="text" value="{{invoiceEmail}}" bindinput="inputEmail" placeholder="接收电子发票的邮箱"/><view wx:for="{{orders}}" wx:key="id" class="row"><view><text>{{item.orderNo}}</text><text>可开票金额 ¥{{item.amountText}}</text></view><button disabled="{{busy}}" bindtap="requestInvoice" data-id="{{item.id}}">{{busy == item.id ? '提交中' : '申请开票'}}</button></view><text wx:if="{{!orders.length}}" class="empty">暂无可开票订单</text></view><view class="card"><text class="title">开票记录</text><view wx:for="{{records}}" wx:key="_id" class="row"><view><text>{{item.titleText}}</text><text>¥{{item.amountText}} · {{item.statusText}}</text></view></view><text wx:if="{{!records.length}}" class="empty">暂无开票记录</text></view></block><view wx:if="{{formVisible}}" class="mask" catchtap="closeForm"><form class="sheet" catchtap="" bindsubmit="saveTitle"><text class="title">{{form.id ? '编辑抬头' : '新增抬头'}}</text><view class="tabs"><button type="button" class="{{form.type == 'personal' ? 'active' : ''}}" bindtap="setTitleType" data-type="personal">个人</button><button type="button" class="{{form.type == 'company' ? 'active' : ''}}" bindtap="setTitleType" data-type="company">企业</button></view><input name="name" value="{{form.name}}" placeholder="抬头名称"/><input wx:if="{{form.type == 'company'}}" name="taxNo" value="{{form.taxNo}}" placeholder="纳税人识别号"/><input name="address" value="{{form.address}}" placeholder="注册地址（选填）"/><input name="bankName" value="{{form.bankName}}" placeholder="开户行（选填）"/><input name="bankAccount" value="{{form.bankAccount}}" placeholder="银行账号（选填）"/><button class="sheet-submit" form-type="submit" disabled="{{busy}}">{{busy == 'title' ? '保存中' : '保存抬头'}}</button></form></view></view>
