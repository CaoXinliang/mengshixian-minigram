.page{min-height:100vh;background:#f3f7fc;color:#172b43;font-size:16px}
button{margin:0;padding:0;border:0;background:transparent;line-height:1.4}
button::after{display:none}
.state{display:flex;align-items:center;justify-content:center;margin:12px 16px;padding:28px 18px;border-radius:16px;background:#fff;color:#667085;flex-direction:column;gap:10px;text-align:center;line-height:1.6}
.state.error{background:#fff7f5}.state-title{color:#172b43;font-size:19px;font-weight:700}
.state button{display:flex;align-items:center;justify-content:center;min-width:96px;min-height:44px;padding:0 18px;border-radius:999px;color:#fff;background:#176bd5;font-size:16px}
.level-card{display:flex;align-items:center;gap:12px;min-height:104px;margin:12px 16px;padding:16px 18px;box-sizing:border-box;border-radius:16px;color:#fff;background:#176bd5}
.level-emblem{display:flex;align-items:center;justify-content:center;flex:none;width:52px;height:52px;border-radius:50%;color:#176bd5;background:#fff;font-size:22px;font-weight:700}
.level-copy{display:flex;min-width:0;flex:1;flex-direction:column;gap:3px}
.level-label{font-size:14px;font-weight:600}.level-name{font-size:19px;font-weight:700;line-height:1.3}.growth{font-size:13px;color:rgba(255,255,255,.86)}
.card{display:flex;align-items:flex-start;gap:10px;margin:12px 16px;padding:14px;border-radius:16px;background:#fff}
.section-icon{display:flex;align-items:center;justify-content:center;flex:none;width:38px;height:38px;border-radius:50%;background:#e9f8ef}
.section-icon.security{background:#eaf2fd}.section-icon image{width:20px;height:20px}
.section-copy{display:flex;min-width:0;flex:1;flex-direction:column;gap:4px}
.card-title{font-size:15px;font-weight:700}.supporting{color:#6f8199;font-size:12px;line-height:1.5}.benefits{display:flex;flex-direction:column}.benefit{padding:10px 0;border-top:1px solid #e7edf6;font-size:14px;line-height:1.5}
.empty{display:flex;color:#6f8199;flex-direction:column;gap:3px;font-size:12px;line-height:1.5}.empty text:first-child{color:#172b43;font-weight:600}
.points-wrap{display:flex;margin:12px 16px 24px}
.points-link{display:flex;flex:1;align-items:center;justify-content:center;box-sizing:border-box;min-width:0;min-height:48px;margin:0;border-radius:999px;color:#fff;background:#176bd5;font-size:16px;font-weight:600}
@media screen and (max-width:374px){.level-card{padding:14px}.level-name{font-size:17px}}
