.page{min-height:100vh;background:#f3f7fc;color:#172b43;font-size:16px}
button{margin:0;padding:0;border:0;background:transparent;line-height:1.4}
button::after{display:none}
.state{display:flex;align-items:center;justify-content:center;margin:12px 16px;padding:28px 18px;border-radius:16px;background:#fff;color:#667085;flex-direction:column;gap:10px;text-align:center;line-height:1.6}
.state.error{background:#fff7f5}.state-title{color:#172b43;font-size:19px;font-weight:700}
.state button{display:flex;align-items:center;justify-content:center;min-width:96px;min-height:44px;padding:0 18px;border-radius:999px;color:#fff;background:#176bd5;font-size:16px}
.level-card{display:flex;min-height:180px;margin:12px 16px;padding:24px 20px;box-sizing:border-box;border-radius:20px;color:#fff;background:linear-gradient(135deg,#176bd5,#438ee7);flex-direction:column;justify-content:center}
.level-card.is-unconfigured{color:#172b43;background:#fff}
.level-label{font-size:14px;opacity:.8}.level-name{margin-top:8px;font-size:30px;font-weight:700;line-height:1.25}.growth{margin-top:16px;font-size:15px;opacity:.86}
.card{display:flex;margin:12px 16px;padding:18px 16px;border-radius:16px;background:#fff;flex-direction:column;gap:12px}
.card-title{font-size:19px;font-weight:700}.supporting{color:#667085;line-height:1.6}.benefits{display:flex;flex-direction:column;gap:10px}.benefit{padding:13px 14px;border-radius:12px;background:#eaf2fd;line-height:1.5}
.empty{display:flex;padding:16px;border-radius:12px;background:#f3f7fc;color:#667085;flex-direction:column;gap:7px;line-height:1.5}.empty text:first-child{color:#172b43;font-weight:600}
.points-link{display:flex;align-items:center;justify-content:center;width:calc(100% - 32px);min-height:48px;margin:12px 16px 24px;border-radius:999px;color:#fff;background:#176bd5;font-size:17px;font-weight:600}
@media screen and (max-width:374px){.level-card{min-height:160px}.level-name{font-size:27px}}
