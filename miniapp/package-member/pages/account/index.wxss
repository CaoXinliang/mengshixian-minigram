.page{min-height:100vh;background:#f3f7fc;color:#172b43;font-size:16px}
button{margin:0;padding:0;border:0;background:transparent;line-height:1.4}
button::after{display:none}
.state{display:flex;align-items:center;justify-content:center;margin:12px 16px;padding:28px 18px;border-radius:16px;background:#fff;color:#667085;flex-direction:column;gap:10px;text-align:center;line-height:1.6}
.state.error{background:#fff7f5}
.state-title{color:#172b43;font-size:19px;font-weight:700}
.state button{display:flex;align-items:center;justify-content:center;min-width:96px;min-height:44px;padding:0 18px;border-radius:999px;color:#fff;background:#176bd5;font-size:16px}
.identity-card{display:flex;align-items:center;min-height:112px;margin:12px 16px;padding:20px;box-sizing:border-box;border-radius:16px;color:#fff;background:#176bd5}
.identity-card.is-disabled{background:#718196}
.avatar{display:flex;align-items:center;justify-content:center;width:52px;height:52px;margin-right:14px;border-radius:50%;color:#176bd5;background:#fff;font-size:22px;font-weight:700}
.identity-card>view:last-child{display:flex;min-width:0;flex:1;flex-direction:column}
.identity-card>view:last-child text:first-child{font-size:21px;font-weight:700}
.identity-card>view:last-child text:last-child{margin-top:5px;color:rgba(255,255,255,.84);font-size:15px}
.card{margin:12px 16px;padding:16px;border-radius:16px;background:#fff}
.card-title{font-size:19px;font-weight:700}
.info-row{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;min-height:48px;padding:12px 0;box-sizing:border-box;border-bottom:1px solid #edf1f5}
.info-row:last-child{border-bottom:0}
.info-row text:last-child{color:#667085;text-align:right;overflow-wrap:anywhere}
.action-list{padding:0 16px}
.action-list button{display:flex;align-items:center;gap:12px;width:100%;min-height:65px;border-bottom:1px solid #eef2f7;text-align:left}
.action-list button:last-child{border-bottom:0}
.action-icon{display:flex;align-items:center;justify-content:center;flex:none;width:36px;height:36px;border-radius:50%;background:#eaf2fd}
.action-icon.points{background:#e9f8ef}
.action-icon.legal{background:#fff4e5}
.action-icon.security{width:38px;height:38px}
.action-icon image{width:20px;height:20px}
.action-label{min-width:0;flex:1;color:#0f1b2d;font-size:15px;font-weight:600}
.action-chevron{flex:none;color:#6f8199;font-size:20px;line-height:1}
.security-card{display:flex;align-items:center;gap:10px;min-height:80px;box-sizing:border-box;padding:12px 14px}
.security-content{display:flex;min-width:0;flex:1;flex-direction:column;gap:3px}
.security-content .card-title{font-size:15px}
.security-note{color:#667085;font-size:14px;line-height:1.45}
.security-content .security-note{font-size:12px}
.account-extra{padding-top:0;padding-bottom:0}
.account-extra button{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:58px;border-bottom:1px solid #edf1f5;text-align:left}
.account-extra button text:first-child{font-size:17px;font-weight:600}
.account-extra button text:last-child{color:#667085;font-size:14px;text-align:right}
.logout-wrap{display:flex;margin:12px 16px 24px}
.logout{display:flex;flex:1;align-items:center;justify-content:center;box-sizing:border-box;min-width:0;min-height:48px;margin:0;border:1px solid #ed5757;border-radius:999px;color:#c93f45;background:transparent;font-size:16px;font-weight:600}
@media screen and (max-width:374px){.identity-card{padding:16px}.action-list button text:last-child{max-width:58%}}
