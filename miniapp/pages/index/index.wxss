page{background:#edf3fa;color:#1b304a;font-family:"Microsoft YaHei","PingFang SC",sans-serif;font-size:13px}
button{margin:0;padding:0;border:0;border-radius:0;color:inherit;background:transparent;font:inherit;line-height:1.4}
button::after{border:0}
.control-pressed{opacity:.72}
.app-shell{position:relative;display:flex;min-height:100vh;padding-bottom:constant(safe-area-inset-bottom);padding-bottom:env(safe-area-inset-bottom);box-sizing:border-box;background:#f7faff;flex-direction:column}
.app-shell.is-home{background:#1477ff}
.page-scroll{height:100vh;box-sizing:border-box;background:#f7faff;flex:none}
.page-scroll.is-page-entering{animation:page-content-enter 220ms cubic-bezier(.22,.78,.28,1) both}
@keyframes page-content-enter{from{opacity:.72;transform:translate3d(0,10rpx,0)}to{opacity:1;transform:translate3d(0,0,0)}}
.top-safe{height:38rpx}
.home-header{padding:0 22rpx 16rpx;color:#fff;background:linear-gradient(135deg,#1477ff,#0759dd)}
.store-row{position:relative;display:flex;align-items:center;height:44px}
.location-button{position:absolute;left:0;top:50%;z-index:1;display:flex;align-items:center;width:fit-content;min-width:44px;max-width:190rpx;min-height:44px;padding:0;overflow:visible;box-sizing:border-box;border:0;border-radius:0;color:#fff;background:transparent;font-size:14px;text-align:left;transform:translateY(-50%)}
.location-name{position:relative;z-index:1;display:flex;align-items:center;width:fit-content;max-width:100%;min-width:0;min-height:30px;margin-left:-8rpx;padding:0 8rpx;overflow:hidden;box-sizing:border-box;border:1rpx solid rgba(255,255,255,.62);border-radius:999px;background:rgba(255,255,255,.1);text-overflow:ellipsis;white-space:nowrap;flex:0 1 auto}
.brand{position:absolute;left:50%;top:50%;display:flex;align-items:center;justify-content:center;max-width:250rpx;font-size:18px;font-weight:700;letter-spacing:2rpx;text-align:center;white-space:nowrap;transform:translate(-50%,-50%);pointer-events:none}
.nav-right-space{width:190rpx;flex:none}
.mini-pill{display:flex;align-items:center;justify-content:space-evenly;width:96rpx;height:42rpx;border:1rpx solid rgba(255,255,255,.55);border-radius:22rpx;font-weight:700}
.mini-pill text:last-child{width:15rpx;height:15rpx;border:2rpx solid #fff;border-radius:50%}
.search-row{display:flex;align-items:center;height:48px;padding:0 4px 0 12px;border-radius:9rpx;background:#fff}
.search-row image{width:30rpx;height:30rpx;margin-right:12rpx}
.search-row input{min-width:0;height:48px;color:#40556d;font-size:15px;flex:1}
.search-placeholder{color:#a1b0bf}
.search-row button{display:flex;align-items:center;justify-content:center;width:72px;min-width:72px;max-width:72px;height:44px;box-sizing:border-box;border-radius:7rpx;color:#fff;background:#0b62e9;font-size:15px;font-weight:700;line-height:1;flex:0 0 72px}
.home-hero-swiper{width:100%;background:#0f57c1}
.home-hero-slide{width:100%;height:100%;overflow:hidden}
.banner-swiper{height:310rpx;background:#0f57c1}
.banner-slide{position:relative;width:100%;height:310rpx;overflow:hidden}
.banner-slide image{width:100%;height:100%}
.banner-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,35,84,.96),rgba(4,65,142,.68) 56%,rgba(4,77,173,.06))}
.banner-copy{position:absolute;left:42rpx;top:49rpx;display:flex;flex-direction:column;color:#fff}
.banner-copy text:first-child{padding-left:12rpx;border-left:5rpx solid #58dcff;font-size:13px}
.banner-copy text:nth-child(2){margin:19rpx 0 13rpx;font-size:48rpx;font-weight:700;line-height:1.15}
.banner-copy text:last-child{font-size:14px}
.banner-empty{position:relative;height:310rpx;overflow:hidden;background:#7cc8e9}
.banner-empty>image{width:100%;height:100%}
.banner-empty>.banner-shade{position:absolute;inset:0}
.banner-empty>.banner-copy{position:absolute}
.home-categories{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));grid-template-rows:repeat(2,auto);min-height:192px;padding:12px 8px 8px;box-sizing:border-box;background:#fff;row-gap:8px}
.home-category{display:flex;align-items:center;min-width:0;min-height:82px;flex-direction:column;justify-content:flex-start}
.home-category image{width:90rpx;height:90rpx;border:2rpx solid #e1ebf4;border-radius:50%;background:#f2f6fa}
.home-category text{max-width:124rpx;margin-top:7rpx;overflow:hidden;color:#233f5d;font-size:14px;font-weight:600;text-overflow:ellipsis;white-space:nowrap}
.home-category.is-skeleton{pointer-events:none}
.home-category-skeleton-face{width:90rpx;height:90rpx;border-radius:50%;background:#edf2f7}
.home-category-skeleton-label{width:64%;height:13px;margin-top:7rpx;border-radius:7px;background:#edf2f7}
.home-category-state{display:flex;align-items:center;justify-content:center;min-height:164px;color:#71849a;font-size:14px;grid-column:1/-1;grid-row:1/span 2}
.section-heading{display:flex;align-items:center;justify-content:space-between;padding:15rpx 27rpx 11rpx}
.section-heading view{display:flex;align-items:baseline;min-width:0;overflow:hidden}
.section-heading view text:first-child{color:#1c3551;font-size:33rpx;font-weight:700}
.section-heading view text:first-child,.section-heading view text:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.section-heading view text:last-child{min-width:0;margin-left:14rpx;color:#c17f35;font-size:13px}
.deal-list{padding:0 18rpx}
.deal-card{display:flex;align-items:center;min-height:174rpx;margin-bottom:13rpx;overflow:hidden;border-radius:9rpx;background:#fff;box-shadow:0 4rpx 16rpx rgba(17,53,93,.05)}
.deal-photo{position:relative;width:198rpx;height:174rpx;flex:none}
.deal-photo image{width:100%;height:100%;background:#f1f5f9}
.deal-photo text{position:absolute;left:0;top:13rpx;padding:7rpx 11rpx;border-radius:0 5rpx 5rpx 0;color:#fff;background:#ef4552;font-size:13px}
.deal-copy{display:flex;min-width:0;overflow:hidden;padding:0 10rpx 0 17rpx;flex:1;flex-direction:column}
.deal-copy>text:first-child{overflow:hidden;color:#1c3550;font-size:29rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
.deal-copy>text:nth-child(2){margin:10rpx 0;color:#75899e;font-size:14px}
.deal-copy view{display:flex;align-items:center;flex-wrap:wrap}
.deal-copy view text:first-child{color:#eb4c52;font-size:33rpx;font-weight:700}
.deal-card quantity-stepper{margin-right:12rpx}
.deal-card-skeleton{pointer-events:none}
.deal-skeleton-photo{width:198rpx;height:174rpx;background:#e8eef5;flex:none}
.deal-skeleton-copy{display:flex;min-width:0;padding:0 18rpx;flex:1;flex-direction:column;gap:14rpx}
.deal-skeleton-copy view{height:13px;border-radius:7px;background:#e8eef5}
.deal-skeleton-copy view:first-child{width:78%}
.deal-skeleton-copy view:nth-child(2){width:50%}
.deal-skeleton-copy view:last-child{width:62%}
.deal-skeleton-action{width:82rpx;height:44px;margin-right:12rpx;border-radius:999px;background:#e8eef5;flex:none}
.deal-card-skeleton,.meal-card-skeleton{animation:content-skeleton-breathe 1050ms ease-in-out infinite}
.home-load-state{display:flex;align-items:center;justify-content:center;min-height:174rpx;margin-bottom:13rpx;padding:24rpx;box-sizing:border-box;border-radius:9rpx;color:#71869a;background:#fff;box-shadow:0 4rpx 16rpx rgba(17,53,93,.05);flex-direction:column;text-align:center}
.home-load-state>text:first-child{color:#35506a;font-size:14px;font-weight:700}
.home-load-state>text:nth-child(2){margin-top:10rpx;font-size:13px;line-height:1.5}
.home-load-state>button{display:flex;align-items:center;justify-content:center;min-height:44px;margin-top:18rpx;padding:0 28rpx;border-radius:999px;color:#fff;background:#287ff1;font-size:14px;font-weight:700;line-height:1}
.bottom-space{height:calc(var(--fixed-one-space) + constant(safe-area-inset-bottom));height:calc(var(--fixed-one-space) + env(safe-area-inset-bottom))}
.sub-head{position:sticky;top:0;z-index:25;display:flex;align-items:center;min-height:56px;padding:0 12px;box-sizing:border-box;background:#f7faff}
.sub-head>button{display:flex;align-items:center;justify-content:center;width:44px;min-width:44px;height:44px;color:#0b61dc;font-size:30px}
.back-control{position:relative;border:0!important;background:transparent!important;color:#174567!important;font-size:47rpx!important;font-weight:500!important;line-height:1!important;flex:none}
.back-control::before{position:absolute;top:50%;left:50%;width:50rpx;height:50rpx;box-sizing:border-box;border:1px solid #829ab2;border-radius:50%;transform:translate(-50%,-50%);content:"";pointer-events:none}
.sub-head>view{display:flex;min-width:0;margin-left:8rpx;overflow:hidden;flex-direction:column;flex:1}
.sub-head>view text:first-child{color:#1c3550;font-size:35rpx;font-weight:700}
.sub-head>view text:first-child,.sub-head>view text:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sub-head>view text:last-child{margin-top:5rpx;color:#6e8398;font-size:13px}
.sub-head .text-btn{width:auto;min-width:76px;height:44px;padding:0 14px;box-sizing:border-box;border:1rpx solid #e79c9f;border-radius:999px;color:#bb3540;background:#fff7f7;font-size:14px;font-weight:600;line-height:1}
.catalog-top{display:flex;align-items:center;justify-content:space-between;padding:16rpx 28rpx 13rpx;background:#fff}
.catalog-top text{font-size:30rpx;font-weight:700}
.catalog-top button{color:#718399;font-size:13px}
.catalog-search{display:flex;align-items:center;min-height:48px;margin:0 22rpx 10rpx;padding:2px 4px 2px 12px;border-radius:6rpx;background:#edf2f6}
.catalog-search>text{margin-right:10rpx;color:#74889d}
.catalog-search input{min-width:0;height:44px;font-size:14px;flex:1}
.catalog-search button{display:flex;align-items:center;justify-content:center;width:72px;min-width:72px;max-width:72px;height:44px;box-sizing:border-box;border-radius:5rpx;color:#fff;background:#126ce5;font-size:14px;line-height:1;flex:0 0 72px}
.major-scroll{height:82px;background:#fff;white-space:nowrap}
.major-track{display:flex;padding:6px 0}
.major-item{display:flex;align-items:center;width:76px;margin:0 4px;color:#41566b;flex:0 0 76px;flex-direction:column}
.major-item image{width:48px;height:48px;border-radius:50%;background:#eff4f8}
.major-item text{width:100%;margin-top:7rpx;overflow:hidden;font-size:14px;text-align:center;text-overflow:ellipsis;white-space:nowrap}
.major-item.is-active text{color:#0869ea;font-weight:700}
.catalog-layout{display:flex;min-height:260px;background:#fff}
.catalog-side{width:150rpx;background:#f4f6f9;flex:none}
.side-item{display:flex;align-items:center;justify-content:center;min-height:48px;padding:0 9rpx;box-sizing:border-box;color:#52677c;font-size:14px;line-height:1.3;text-align:center}
.side-item.is-active{position:relative;color:#0969e9;background:#fff;font-weight:700}
.side-item.is-active::before{position:absolute;left:0;width:5rpx;height:37rpx;border-radius:0 4rpx 4rpx 0;background:#1177f4;content:""}
.catalog-results{width:0;min-width:0;height:100%;padding:0 12rpx;overflow:hidden;box-sizing:border-box;flex:1}
.result-title{display:flex;align-items:center;justify-content:space-between;height:66rpx}
.result-title text:first-child{font-size:14px;font-weight:700}
.result-title text:last-child{color:#76899b;font-size:13px}
.catalog-row{display:flex;align-items:center;min-width:0;min-height:168rpx;overflow:hidden;border-bottom:1rpx solid #edf1f4}
.catalog-row>image{width:112rpx;height:112rpx;margin-right:14rpx;border-radius:8rpx;background:#f3f6f9;flex:none}
.catalog-row>view{display:flex;min-width:0;flex:1;flex-direction:column}
.catalog-row>view text:first-child{overflow:hidden;font-size:29rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
.catalog-row>view text:nth-child(2),.catalog-row>view text:nth-child(3){overflow:hidden;margin:7rpx 0 0;color:#71849a;font-size:13px;line-height:1.3;text-overflow:ellipsis;white-space:nowrap}
.catalog-row>view text:last-child{margin-top:9rpx;color:#e65336;font-size:31rpx;font-weight:700}
.catalog-row>view text:last-child text{color:#8f715b;font-size:13px;font-weight:400}
.choose-spec{display:flex;align-items:center;justify-content:center;width:fit-content;min-width:44px;max-width:100%;height:44px;margin:0 8rpx 0 10rpx;padding:0;box-sizing:border-box;border:0;border-radius:0;color:#fff;background:transparent;font-size:14px;line-height:1;flex:0 0 fit-content;white-space:nowrap}
.choose-spec-face{display:flex;align-items:center;justify-content:center;min-height:30px;padding:0 8px;box-sizing:border-box;border:1px solid #287ff1;border-radius:999px;color:#fff;background:#287ff1;font-size:14px;font-weight:500;line-height:1;white-space:nowrap}
.choose-spec[disabled]{opacity:1}
.choose-spec[disabled] .choose-spec-face{border-color:#d8e1ea;color:#778a9d;background:#e7edf3}
.catalog-row quantity-stepper,.simple-row quantity-stepper,.deal-card quantity-stepper{width:112px;min-width:112px;max-width:112px;margin-left:10rpx;flex:0 0 112px}
.detail-quantity quantity-stepper{width:120px;min-width:120px;max-width:120px;flex:0 0 120px}
.catalog-bottom-space{height:calc(var(--fixed-one-space) + constant(safe-area-inset-bottom));height:calc(var(--fixed-one-space) + env(safe-area-inset-bottom))}
.catalog-bottom-space.has-quick-checkout{height:calc(var(--fixed-two-space) + constant(safe-area-inset-bottom));height:calc(var(--fixed-two-space) + env(safe-area-inset-bottom))}
.frequent-banner{display:flex;align-items:center;justify-content:space-between;margin:18rpx;padding:23rpx;border-radius:10rpx;color:#fff;background:linear-gradient(130deg,#195fc8,#2588ee)}
.frequent-banner>view{display:flex;min-width:0;flex:1;flex-direction:column}
.frequent-banner text:first-child{font-size:30rpx;font-weight:700}
.frequent-banner text:last-child{margin-top:8rpx;color:#d8ebff;font-size:13px}
.frequent-banner button{display:flex;align-items:center;justify-content:center;width:176rpx;min-width:176rpx;max-width:176rpx;height:70rpx;margin-left:16rpx;box-sizing:border-box;border-radius:6rpx;color:#1356b8;background:#fff;font-size:14px;font-weight:700;line-height:1;flex:0 0 176rpx}
.frequent-spec-hint{display:flex;align-items:center;justify-content:center;width:176rpx;min-width:176rpx;height:70rpx;margin-left:16rpx;border:1rpx solid rgba(255,255,255,.65);box-sizing:border-box;border-radius:6rpx;color:#fff;font-size:14px;font-weight:700;line-height:1;text-align:center}
.meal-head .meal-shuffle{display:flex;align-items:center;justify-content:center;width:auto;min-width:76px;min-height:44px;margin-left:16rpx;padding:0 14px;box-sizing:border-box;border:1rpx solid #bed6f5;border-radius:999px;color:#1264d6;background:#fff;font-size:14px;font-weight:600;line-height:1;flex:none;white-space:nowrap}
.meal-intro{display:flex;align-items:center;min-height:138rpx;margin:0 18rpx 16rpx;padding:22rpx 24rpx;box-sizing:border-box;border-radius:14rpx;color:#fff;background:linear-gradient(135deg,#145fc8,#2888ef)}
.meal-intro>view{display:flex;min-width:0;flex:1;flex-direction:column}
.meal-intro>view text:first-child{font-size:28rpx;font-weight:700;line-height:1.35}
.meal-intro>image{width:78rpx;height:78rpx;margin-left:20rpx;padding:12rpx;box-sizing:border-box;border-radius:50%;background:#fff;flex:none}
.meal-state{display:flex;align-items:center;margin:0 18rpx;padding:40px 16px;color:#71869a;flex-direction:column;justify-content:center;text-align:center}
.meal-state>text:first-child{color:#36516c;font-size:14px;font-weight:700}
.meal-state>text:nth-child(2){max-width:560rpx;margin-top:12rpx;font-size:13px;line-height:1.5}
.meal-state>button{display:flex;align-items:center;justify-content:center;min-height:44px;margin-top:22rpx;padding:0 30rpx;border-radius:999px;color:#fff;background:#287ff1;font-size:14px;line-height:1}
.meal-grid-skeleton{padding-bottom:4rpx}
.meal-card-skeleton{pointer-events:none}
.meal-skeleton-cover{height:208rpx;background:#e7eef6}
.meal-skeleton-copy{display:flex;min-height:148px;padding:14px 12px 12px;box-sizing:border-box;flex-direction:column;gap:12rpx}
.meal-skeleton-copy view{height:13px;border-radius:7px;background:#e7eef6}
.meal-skeleton-copy view:first-child{width:72%}
.meal-skeleton-copy view:nth-child(2){width:48%}
.meal-skeleton-copy view:last-child{width:100%;height:44px;margin-top:auto;border-radius:999px}
.meal-scene-filter{margin:0 18rpx 16rpx}
.meal-scene-label{display:block;margin-bottom:11rpx;color:#657b91;font-size:13px;font-weight:600}
.meal-scene-track{display:grid;gap:10rpx;grid-template-columns:repeat(3,minmax(0,1fr))}
.meal-scene-track button{display:flex;align-items:center;justify-content:center;width:100%;min-width:0;min-height:44px;padding:0 8rpx;box-sizing:border-box;border:1rpx solid #d8e5f2;border-radius:999px;color:#526a82;background:#fff;font-size:14px;line-height:1;white-space:nowrap}
.meal-scene-track button.is-active{border-color:#287ff1;color:#fff;background:#287ff1;font-weight:700}
.meal-grid{display:grid;padding:0 18rpx;gap:14rpx;grid-template-columns:repeat(2,minmax(0,1fr))}
.meal-card{min-width:0;overflow:hidden;border:1rpx solid #e2ebf4;border-radius:14rpx;background:#fff;box-shadow:0 5rpx 16rpx rgba(19,64,112,.05)}
.meal-card-cover{position:relative;height:208rpx;overflow:hidden;background:#eaf3ff}
.meal-card-cover image{width:100%;height:100%;background:#eaf3ff}
.meal-card-cover>text{position:absolute;left:12rpx;top:12rpx;padding:7rpx 12rpx;border-radius:18rpx;color:#fff;background:rgba(12,45,82,.72);font-size:13px;line-height:1}
.meal-card-copy{display:flex;min-height:148px;padding:14px 12px 12px;box-sizing:border-box;flex-direction:column}
.meal-card-copy>text:first-child{overflow:hidden;color:#1b3653;font-size:14px;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
.meal-card-copy>text:nth-child(2){margin-top:8rpx;color:#6f8498;font-size:13px}
.meal-card-copy>button{display:flex;align-items:center;justify-content:center;width:100%;min-width:0;max-width:100%;min-height:44px;margin-top:auto;box-sizing:border-box;border-radius:999px;color:#1768d5;background:#eaf3ff;font-size:14px;font-weight:700;line-height:1}
.meal-detail-head>button{min-width:44px;min-height:44px}
.meal-detail-head>view{width:48rpx;height:48rpx;flex:none}
.meal-detail-hero{position:relative;height:330rpx;margin:0 18rpx;overflow:hidden;border-radius:14rpx;background:#eaf3ff}
.meal-detail-hero>image{width:100%;height:100%}
.meal-detail-hero>view{position:absolute;inset:0;opacity:.22}
.meal-detail-hero>text{position:absolute;left:20rpx;top:20rpx;padding:8rpx 16rpx;border-radius:22rpx;color:#fff;background:rgba(14,42,73,.72);font-size:13px}
.meal-detail-copy{display:flex;margin:14rpx 18rpx;padding:22rpx;border-radius:12rpx;background:#fff;flex-direction:column}
.meal-detail-copy>text:first-child{color:#193653;font-size:34rpx;font-weight:700}
.meal-detail-copy>text:nth-child(2){margin-top:10rpx;color:#657b90;font-size:14px;line-height:1.55}
.meal-detail-copy>view{display:flex;margin-top:16rpx;gap:12rpx}
.meal-detail-copy>view text{padding:8rpx 14rpx;border-radius:20rpx;color:#1765cc;background:#eaf3ff;font-size:13px}
.meal-section{margin:0 18rpx 14rpx;padding:22rpx;border-radius:12rpx;background:#fff}
.meal-section-title{color:#1b3652;font-size:14px;font-weight:700}
.meal-step{display:flex;align-items:flex-start;margin-top:18rpx;color:#536b82;font-size:14px;line-height:1.55}
.meal-step>text:first-child{display:flex;align-items:center;justify-content:center;width:38rpx;height:38rpx;margin-right:13rpx;border-radius:50%;color:#fff;background:#287ff1;font-size:13px;font-weight:700;line-height:1;flex:none}
.meal-step>text:last-child{min-width:0;padding-top:2rpx;flex:1}
.meal-section-heading{display:flex;align-items:baseline;justify-content:space-between;gap:14rpx}
.meal-section-heading>text:last-child{color:#8a9bad;font-size:13px;text-align:right}
.meal-product-list{margin-top:12rpx}
.meal-product{display:flex;align-items:center;min-height:112rpx;padding:10rpx 0;border-top:1rpx solid #edf2f6}
.meal-product>image{width:88rpx;height:88rpx;margin-right:13rpx;border-radius:8rpx;background:#f1f5f9;flex:none}
.meal-product>view{display:flex;min-width:0;flex:1;flex-direction:column}
.meal-product>view text:first-child{overflow:hidden;color:#24425f;font-size:14px;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
.meal-product>view text:last-child{margin-top:7rpx;overflow:hidden;color:#7b8fa2;font-size:13px;text-overflow:ellipsis;white-space:nowrap}
.meal-product>button{display:flex;align-items:center;justify-content:center;width:108rpx;min-width:108rpx;min-height:44px;margin-left:10rpx;border-radius:999px;color:#fff;background:#287ff1;font-size:14px;line-height:1}
