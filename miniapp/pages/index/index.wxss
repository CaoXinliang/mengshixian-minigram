page{background:#f5f8fc;color:#172b43;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:14px}
button{margin:0;padding:0;border:0;border-radius:0;color:inherit;background:transparent;font:inherit;line-height:1.4}
button::after{border:0}
.control-pressed{opacity:.72}
.app-shell{position:relative;display:flex;min-height:100vh;padding-bottom:constant(safe-area-inset-bottom);padding-bottom:env(safe-area-inset-bottom);box-sizing:border-box;background:#f7faff;flex-direction:column}
.app-shell.is-home{background:#1477ff}
.page-scroll{height:100vh;box-sizing:border-box;background:#f7faff;flex:none}
member-home-panel,cart-panel{display:block;width:100%}
.page-scroll.is-page-entering{animation:page-content-enter 120ms cubic-bezier(.22,.78,.28,1) both}
@keyframes page-content-enter{from{opacity:.72;transform:translate3d(0,10rpx,0)}to{opacity:1;transform:translate3d(0,0,0)}}
.top-safe{height:38rpx}
.home-header{padding:0 22rpx 16rpx;color:#fff;background:linear-gradient(135deg,#1477ff,#0759dd)}
.store-row{position:relative;display:flex;align-items:center;height:44px}
.location-button{position:absolute;left:0;top:50%;z-index:1;display:flex;align-items:center;width:fit-content;min-width:44px;max-width:40%;min-height:44px;padding:0;overflow:visible;box-sizing:border-box;border:0;border-radius:0;color:#fff;background:transparent;font-size:16px;text-align:left;transform:translateY(-50%)}
.location-name{position:relative;z-index:1;display:flex;align-items:center;width:auto;max-width:100%;min-width:0;min-height:32px;padding:0 10px;overflow:hidden;box-sizing:border-box;border:1px solid rgba(255,255,255,.62);border-radius:999px;background:rgba(255,255,255,.1);text-overflow:ellipsis;white-space:nowrap;flex:0 1 auto}
.brand{position:absolute;left:50%;top:50%;display:flex;align-items:center;justify-content:center;max-width:42%;font-size:22px;font-weight:700;letter-spacing:1px;text-align:center;white-space:nowrap;transform:translate(-50%,-50%);pointer-events:none}
.nav-right-space{width:40%;flex:none}
.mini-pill{display:flex;align-items:center;justify-content:space-evenly;width:96rpx;height:42rpx;border:1rpx solid rgba(255,255,255,.55);border-radius:22rpx;font-weight:700}
.mini-pill text:last-child{width:15rpx;height:15rpx;border:2rpx solid #fff;border-radius:50%}
.search-row{display:flex;align-items:center;height:48px;padding:0 4px 0 12px;border-radius:9rpx;background:#fff}
.search-row image{width:30rpx;height:30rpx;margin-right:12rpx}
.search-row input{min-width:0;height:48px;color:#40556d;font-size:17px;flex:1}
.search-placeholder{color:#46566b}
.search-row button{display:flex;align-items:center;justify-content:center;width:auto;min-width:44px;height:44px;padding:0;box-sizing:border-box;border:0;border-radius:0;color:#fff;background:transparent;font-size:16px;font-weight:700;line-height:1;flex:none}
.search-action-face{display:flex;align-items:center;justify-content:center;min-height:36px;padding:0 14px;box-sizing:border-box;border-radius:10px;color:#fff;background:#287ff1;line-height:1;white-space:nowrap}
.home-hero-swiper{width:100%;background:#0f57c1}
.home-hero-slide{width:100%;height:100%;overflow:hidden}
.banner-swiper{height:310rpx;background:#0f57c1}
.banner-slide{position:relative;width:100%;height:310rpx;overflow:hidden}
.banner-slide image{width:100%;height:100%}
.banner-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,35,84,.96),rgba(4,65,142,.68) 56%,rgba(4,77,173,.06))}
.banner-copy{position:absolute;left:42rpx;top:49rpx;display:flex;flex-direction:column;color:#fff}
.banner-copy text:first-child{padding-left:12rpx;border-left:5rpx solid #58dcff;font-size:16px}
.banner-copy text:nth-child(2){margin:19rpx 0 13rpx;font-size:28px;font-weight:700;line-height:1.15}
.banner-copy text:last-child{font-size:16px}
.banner-empty{position:relative;height:310rpx;overflow:hidden;background:#7cc8e9}
.banner-empty>image{width:100%;height:100%}
.banner-empty>.banner-shade{position:absolute;inset:0}
.banner-empty>.banner-copy{position:absolute}
.home-categories{display:grid;min-height:150px;grid-template-columns:repeat(5,minmax(0,1fr));grid-template-rows:repeat(2,minmax(66px,auto));padding:12px 8px 10px;box-sizing:border-box;background:#fff;gap:8px 4px}
.home-category{display:flex;align-items:center;justify-content:flex-start;min-width:0;min-height:66px;padding:0 2px;box-sizing:border-box;flex-direction:column}
.home-category image{width:48px;height:48px;border:1px solid #e1ebf4;border-radius:50%;background:#f2f6fa;flex:none}
.home-category text{display:-webkit-box;width:100%;max-width:100%;margin-top:6px;overflow:hidden;color:#233f5d;font-size:16px;font-weight:600;line-height:1.2;text-align:center;white-space:normal;overflow-wrap:anywhere;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.home-category.is-skeleton{pointer-events:none}
.home-category-skeleton-face{width:48px;height:48px;border-radius:50%;background:#edf2f7}
.home-category-skeleton-label{width:64%;height:12px;margin-top:6px;border-radius:7px;background:#edf2f7}
.home-category-state{display:flex;align-items:center;justify-content:center;min-height:140px;color:#46566b;font-size:16px;grid-column:1/-1;grid-row:1/span 2}
.section-heading{display:flex;align-items:center;justify-content:space-between;padding:15rpx 27rpx 11rpx}
.section-heading view{display:flex;align-items:baseline;min-width:0;overflow:hidden}
.section-heading view text:first-child{color:#1c3551;font-size:24px;font-weight:700;letter-spacing:.2px}
.section-heading view text:first-child,.section-heading view text:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.section-heading view text:last-child{min-width:0;margin-left:14rpx;color:#c17f35;font-size:16px}
.deal-list{padding:0 12px}
.deal-card{display:flex;align-items:center;min-height:122px;margin-bottom:10px;overflow:hidden;border-radius:14px;background:#fff;box-shadow:0 4px 16px rgba(17,53,93,.05)}
.deal-photo{position:relative;width:96px;height:122px;flex:none}
.deal-photo image{width:100%;height:100%;background:#f1f5f9}
.deal-photo text{position:absolute;left:0;top:13rpx;padding:7rpx 11rpx;border-radius:0 5rpx 5rpx 0;color:#fff;background:#ef4552;font-size:16px}
.deal-copy{display:flex;min-width:0;overflow:hidden;padding:0 8px 0 12px;flex:1;flex-direction:column}
.deal-copy>text:first-child{display:-webkit-box;overflow:hidden;color:#1c3550;font-size:19px;font-weight:700;line-height:1.3;white-space:normal;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.deal-copy>text:nth-child(2){margin:6px 0;color:#46566b;font-size:16px;line-height:1.3}
.deal-copy view{display:flex;align-items:center;flex-wrap:wrap}
.deal-copy view text:first-child{color:#eb4c52;font-size:24px;font-weight:700}
.deal-card quantity-stepper{margin-right:12rpx}
.deal-card-skeleton{pointer-events:none}
.deal-skeleton-photo{width:96px;height:122px;background:#e8eef5;flex:none}
.deal-skeleton-copy{display:flex;min-width:0;padding:0 18rpx;flex:1;flex-direction:column;gap:14rpx}
.deal-skeleton-copy view{height:13px;border-radius:7px;background:#e8eef5}
.deal-skeleton-copy view:first-child{width:78%}
.deal-skeleton-copy view:nth-child(2){width:50%}
.deal-skeleton-copy view:last-child{width:62%}
.deal-skeleton-action{width:82rpx;height:44px;margin-right:12rpx;border-radius:999px;background:#e8eef5;flex:none}
.deal-card-skeleton{animation:content-skeleton-breathe 1050ms ease-in-out infinite}
.home-load-state{display:flex;align-items:center;justify-content:center;min-height:174rpx;margin-bottom:13rpx;padding:24rpx;box-sizing:border-box;border-radius:9rpx;color:#46566b;background:#fff;box-shadow:0 4rpx 16rpx rgba(17,53,93,.05);flex-direction:column;text-align:center}
.home-load-state>text:first-child{color:#35506a;font-size:16px;font-weight:700}
.home-load-state>text:nth-child(2){margin-top:10rpx;font-size:16px;line-height:1.5}
.home-load-state>button{display:flex;align-items:center;justify-content:center;min-height:44px;margin-top:18rpx;padding:0 28rpx;border-radius:999px;color:#fff;background:#287ff1;font-size:16px;font-weight:700;line-height:1}
.bottom-space{height:calc(var(--fixed-one-space) + constant(safe-area-inset-bottom));height:calc(var(--fixed-one-space) + env(safe-area-inset-bottom))}
.sub-head{position:sticky;top:0;z-index:25;display:flex;align-items:center;min-height:56px;padding:0 12px;box-sizing:border-box;background:#f7faff}
.sub-head>button{display:flex;align-items:center;justify-content:center;width:44px;min-width:44px;height:44px;color:#0b61dc;font-size:30px}
.back-control{position:relative;border:0!important;background:transparent!important;color:#174567!important;font-size:47rpx!important;font-weight:500!important;line-height:1!important;flex:none}
.back-control::before{position:absolute;top:50%;left:50%;width:50rpx;height:50rpx;box-sizing:border-box;border:1px solid #829ab2;border-radius:50%;transform:translate(-50%,-50%);content:"";pointer-events:none}
.sub-head>view{display:flex;min-width:0;margin-left:8rpx;overflow:hidden;flex-direction:column;flex:1}
.sub-head>view text:first-child{color:#1c3550;font-size:22px;font-weight:700}
.sub-head>view text:first-child,.sub-head>view text:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sub-head>view text:last-child{margin-top:5rpx;color:#46566b;font-size:16px}
.sub-head .text-btn{display:flex;align-items:center;justify-content:center;width:auto;min-width:44px;height:44px;padding:0;box-sizing:border-box;border:0;border-radius:0;color:#bb3540;background:transparent;font-size:16px;font-weight:600;line-height:1}
.text-btn-face{display:flex;align-items:center;justify-content:center;min-height:32px;padding:0 12px;box-sizing:border-box;border:1px solid #e79c9f;border-radius:999px;color:#bb3540;background:#fff7f7;white-space:nowrap}
.catalog-top{display:flex;align-items:center;justify-content:space-between;padding:16rpx 28rpx 13rpx;background:#fff}
.catalog-top text{font-size:17px;font-weight:700}
.catalog-top button{color:#718399;font-size:16px}
.catalog-search{display:flex;align-items:center;min-height:48px;margin:0 22rpx 10rpx;padding:2px 0;gap:8px;background:transparent}
.catalog-search-field{display:flex;align-items:center;min-width:0;height:44px;padding:0 14px;box-sizing:border-box;flex:1;border-radius:22px;background:#fff}
.catalog-search-field>text{margin-right:8px;color:#74889d;flex:none}
.catalog-search input{min-width:0;height:44px;font-size:16px;flex:1}
.catalog-search button{display:flex;align-items:center;justify-content:center;width:auto;min-width:44px;height:44px;padding:0;box-sizing:border-box;border:0;border-radius:0;color:#fff;background:transparent;font-size:16px;line-height:1;flex:none}
.catalog-search-action-face{display:flex;align-items:center;justify-content:center;min-height:40px;padding:0 20px;box-sizing:border-box;border-radius:20px;color:#fff;background:#176bd5;line-height:1;white-space:nowrap}
.recent-searches{min-height:88px;padding:7px 12px 9px;box-sizing:border-box;background:#f5f8fc}
.recent-searches-head{display:flex;align-items:center;justify-content:space-between;height:30px;color:#35506a;font-size:16px;font-weight:700}
.recent-searches-head button{display:flex;align-items:center;justify-content:center;width:auto;min-width:44px;height:30px;margin:0;padding:0 4px;border:0;color:#176bd5;background:transparent;font-size:14px;line-height:1}
.recent-searches-scroll{height:42px;white-space:nowrap}
.recent-searches-track{display:flex;align-items:center;min-width:100%;height:42px;gap:8px}
.recent-searches-track button{display:flex;align-items:center;justify-content:center;width:auto;min-width:44px;max-width:180px;height:34px;margin:0;padding:0 14px;overflow:hidden;box-sizing:border-box;border:1px solid #cedef1;border-radius:17px;color:#35506a;background:#fff;font-size:15px;line-height:1;text-overflow:ellipsis;white-space:nowrap;flex:none}
.recent-searches-empty{display:flex;align-items:center;height:42px;color:#74889d;font-size:15px}
.major-scroll{height:82px;background:#fff;white-space:nowrap}
.major-track{display:flex;height:82px;padding:6px 0;box-sizing:border-box}
.major-item{display:flex;align-items:center;width:96px;margin:0;color:#41566b;flex:0 0 96px;flex-direction:column}
.major-item image{width:48px;height:48px;border-radius:50%;background:#eff4f8;flex:none}
.major-item text{width:100%;margin-top:4px;overflow:hidden;font-size:16px;line-height:1.15;text-align:center;text-overflow:ellipsis;white-space:nowrap}
.major-item.is-active text{color:#0869ea;font-weight:700}
.catalog-layout{display:flex;min-height:0;overflow:hidden;background:#fff}
.catalog-side{width:76px;height:auto;max-height:100%;overflow:hidden;background:#f4f6f9;align-self:flex-start;flex:none}
.side-item{display:flex;align-items:center;justify-content:center;min-height:48px;padding:0 9rpx;box-sizing:border-box;color:#52677c;font-size:16px;line-height:1.3;text-align:center}
.side-item.is-active{position:relative;color:#0969e9;background:#fff;font-weight:700}
.side-item.is-active::before{position:absolute;left:0;width:5rpx;height:37rpx;border-radius:0 4rpx 4rpx 0;background:#1177f4;content:""}
.catalog-results{width:0;min-width:0;height:100%;padding:0 10px;overflow:hidden;box-sizing:border-box;flex:1}
.result-title{display:flex;align-items:center;justify-content:space-between;height:66rpx}
.result-title text:first-child{font-size:16px;font-weight:700}
.result-title text:last-child{color:#46566b;font-size:16px}
.catalog-row{display:grid;align-items:center;min-width:0;min-height:136px;padding:10px;margin-bottom:10px;box-sizing:border-box;border:0;border-radius:14px;background:#fff;grid-template-columns:82px minmax(0,1fr);grid-template-rows:auto 44px;grid-template-areas:"catalog-image catalog-copy" "catalog-image catalog-action";column-gap:10px}
.catalog-row>image{width:82px;height:82px;margin-right:10px;border-radius:10px;background:#f3f6f9;flex:none}
.catalog-row>view{display:flex;min-width:0;flex:1;flex-direction:column}
.catalog-row>view text:first-child{display:-webkit-box;overflow:hidden;font-size:19px;font-weight:700;line-height:1.3;white-space:normal;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.catalog-row .catalog-item-spec{margin:5px 0 0;color:#46566b;font-size:16px;line-height:1.3}
.choose-spec{display:flex;align-items:center;justify-content:center;width:auto;min-width:44px;max-width:100%;height:44px;margin:0 4px 0 8px;padding:0;box-sizing:border-box;border:0;border-radius:0;color:#fff;background:transparent;font-size:16px;line-height:1;flex:none;white-space:nowrap}
.choose-spec-face{display:flex;align-items:center;justify-content:center;min-height:34px;padding:0 13px;box-sizing:border-box;border:1px solid #287ff1;border-radius:999px;color:#fff;background:#287ff1;font-size:16px;font-weight:600;line-height:1;white-space:nowrap}
.choose-spec[disabled]{opacity:1}
.choose-spec[disabled] .choose-spec-face{border-color:#d8e1ea;color:#778a9d;background:#e7edf3}
.catalog-row quantity-stepper,.simple-row quantity-stepper,.deal-card quantity-stepper{width:112px;min-width:112px;max-width:112px;margin-left:8px;flex:0 0 112px}
.detail-quantity quantity-stepper{width:120px;min-width:120px;max-width:120px;flex:0 0 120px}
.catalog-bottom-space{height:calc(var(--fixed-one-space) + constant(safe-area-inset-bottom));height:calc(var(--fixed-one-space) + env(safe-area-inset-bottom))}
.catalog-bottom-space.has-quick-checkout{height:calc(var(--fixed-two-space) + constant(safe-area-inset-bottom));height:calc(var(--fixed-two-space) + env(safe-area-inset-bottom))}
.frequent-banner{display:flex;align-items:center;justify-content:space-between;margin:18rpx;padding:23rpx;border-radius:10rpx;color:#fff;background:linear-gradient(130deg,#195fc8,#2588ee)}
.frequent-banner>view{display:flex;min-width:0;flex:1;flex-direction:column}
.frequent-banner text:first-child{font-size:30rpx;font-weight:700}
.frequent-banner text:last-child{margin-top:8rpx;color:#d8ebff;font-size:13px}
.frequent-banner button{display:flex;align-items:center;justify-content:center;width:176rpx;min-width:176rpx;max-width:176rpx;height:70rpx;margin-left:16rpx;box-sizing:border-box;border-radius:6rpx;color:#1356b8;background:#fff;font-size:14px;font-weight:700;line-height:1;flex:0 0 176rpx}
.frequent-spec-hint{display:flex;align-items:center;justify-content:center;width:176rpx;min-width:176rpx;height:70rpx;margin-left:16rpx;border:1rpx solid rgba(255,255,255,.65);box-sizing:border-box;border-radius:6rpx;color:#fff;font-size:14px;font-weight:700;line-height:1;text-align:center}
.simple-list{padding:0 18rpx}
.simple-row{display:flex;align-items:center;min-height:132rpx;margin-bottom:10rpx;padding:12rpx;border-radius:8rpx;background:#fff}
.simple-row>image{width:105rpx;height:105rpx;margin-right:16rpx}
.simple-row>view{display:flex;min-width:0;flex:1;flex-direction:column}
.simple-row>view text:first-child{overflow:hidden;font-size:14px;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
.simple-row>view text:nth-child(2){margin:8rpx 0;color:#75889b;font-size:13px}
.simple-row>view text:last-child{color:#e45d35;font-size:14px;font-weight:700}
.simple-row>view .price-pending.is-locked{color:#46566b;font-size:16px;font-weight:600}
.simple-row>view .price-pending.is-temporary{color:#e96762}
.empty-state{display:flex;align-items:center;padding:40px 16px;flex-direction:column}
.empty-state image{width:98rpx;height:98rpx;opacity:.48}
.empty-state text:nth-child(2){margin-top:22rpx;font-size:28rpx;font-weight:700}
.empty-state text:nth-child(3){margin-top:9rpx;color:#7e8fa0;font-size:13px}
.empty-state button{display:flex;align-items:center;justify-content:center;min-height:44px;margin-top:18px;padding:0 24px;border-radius:6rpx;color:#fff;background:#0c69ec;font-size:14px}
.contact-panel{display:flex;margin:0 18rpx 18rpx;padding:22rpx 20rpx;border-radius:10rpx;background:#fff;box-shadow:0 4rpx 12rpx rgba(18,55,89,.045);flex-direction:column}
.contact-panel>text:first-child{font-size:14px;font-weight:700}
.contact-panel>text:nth-child(2){margin:10rpx 0;color:#637a90;font-size:13px}
.contact-panel button{display:flex;align-items:center;justify-content:center;min-height:44px;margin-top:12rpx;padding:0 22rpx;box-sizing:border-box;border:1rpx solid #b8d4f2;border-radius:8rpx;color:#0768e9;background:#f3f8ff;font-size:14px;font-weight:700;line-height:1}
.detail-head{position:sticky;top:0;z-index:25;display:grid;align-items:center;height:56px;padding:0 12px;box-sizing:border-box;background:#fff;grid-template-columns:44px 1fr 44px}
.detail-head>button{display:flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0}
.detail-head>button:first-child{font-size:30px}
.detail-head>text{text-align:center;font-size:22px;font-weight:700}
.detail-head>button:last-child image{width:37rpx;height:37rpx}
.detail-product{display:flex;margin:0 16px;padding:0;background:transparent;flex-direction:column}
.detail-image{position:relative;display:flex;align-items:center;justify-content:center;height:390rpx;border-radius:8rpx;background:#f4f7fa;overflow:hidden}
.detail-image image{width:100%;height:100%}
.detail-image-state{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#7890a5;background:rgba(244,247,250,.92);flex-direction:column;font-size:16px}
.detail-image-state button{display:flex;align-items:center;justify-content:center;min-height:44px;margin-top:16rpx;padding:0 26rpx;border:1rpx solid #8ebcf2;border-radius:999px;color:#0869e9;background:#fff;font-size:16px;font-weight:700;line-height:1}
.detail-image-state.is-loading text{color:#46566b}
.detail-image-state.is-error{color:#46566b}
.detail-image.is-error{background:#edf2f6}
.detail-image>text{position:absolute;left:12rpx;top:12rpx;padding:6rpx 10rpx;border-radius:4rpx;color:#fff;background:#ef4c57;font-size:16px}
.detail-product>text:nth-child(2){display:-webkit-box;margin-top:14px;overflow:hidden;color:#182f49;font-size:24px;font-weight:700;line-height:1.35;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.detail-product>text:nth-child(3){margin-top:8rpx;color:#71859a;font-size:16px;line-height:1.45}
.detail-product>view{margin-top:13rpx}
.detail-product>view .detail-price{margin-left:0;color:#e65336;font-size:28px;font-weight:700;text-decoration:none}
.detail-product>view .detail-price.is-temporary{color:#e8583b}
.detail-product>view .detail-price.is-locked{color:#46566b;font-size:16px;font-weight:600}
.detail-product>view .detail-tier-status{margin-left:16rpx;color:#0b69e9;font-size:16px;font-weight:600}
.detail-panel{margin:8px 16px 0;padding:14px;border-radius:16px;background:#fff}
.detail-line{display:flex;gap:20rpx;min-width:0;padding:12rpx 0;color:#1d354d;font-size:16px}
.detail-line>.detail-label{width:64px;font-weight:700;white-space:nowrap;flex:0 0 64px}
