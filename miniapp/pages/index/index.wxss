page{background:#edf3fa;color:#1b304a;font-family:"Microsoft YaHei","PingFang SC",sans-serif;font-size:24rpx}
button{margin:0;padding:0;border:0;border-radius:0;color:inherit;background:transparent;font:inherit;line-height:1.4}
button::after{border:0}
.app-shell{position:relative;min-height:100vh;padding-bottom:constant(safe-area-inset-bottom);padding-bottom:env(safe-area-inset-bottom);box-sizing:border-box;background:#f7faff}
.page-scroll{height:100vh;box-sizing:border-box}
.page-scroll.is-page-entering{animation:page-content-enter 220ms cubic-bezier(.22,.78,.28,1) both}
@keyframes page-content-enter{from{opacity:.72;transform:translate3d(0,10rpx,0)}to{opacity:1;transform:translate3d(0,0,0)}}
.top-safe{height:38rpx}
.home-header{padding:0 22rpx 16rpx;color:#fff;background:linear-gradient(135deg,#1477ff,#0759dd)}
.store-row{display:flex;align-items:center;height:58rpx}
.location-button{display:flex;align-items:center;width:190rpx;min-width:0;color:#fff;font-size:23rpx;text-align:left}
.location-button image{width:28rpx;height:28rpx;margin-right:7rpx}
.location-button text:nth-child(2){overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.location-button .chevron{margin-left:8rpx}
.brand{font-size:31rpx;font-weight:700;letter-spacing:2rpx;flex:1;text-align:center}
.nav-right-space{width:190rpx;flex:none}
.mini-pill{display:flex;align-items:center;justify-content:space-evenly;width:96rpx;height:42rpx;border:1rpx solid rgba(255,255,255,.55);border-radius:22rpx;font-weight:700}
.mini-pill text:last-child{width:15rpx;height:15rpx;border:2rpx solid #fff;border-radius:50%}
.search-row{display:flex;align-items:center;height:68rpx;padding:0 8rpx 0 18rpx;border-radius:9rpx;background:#fff}
.search-row image{width:30rpx;height:30rpx;margin-right:12rpx}
.search-row input{min-width:0;height:68rpx;color:#40556d;font-size:25rpx;flex:1}
.search-placeholder{color:#a1b0bf}
.search-row button{display:flex;align-items:center;justify-content:center;width:100rpx;min-width:100rpx;max-width:100rpx;height:60rpx;box-sizing:border-box;border-radius:7rpx;color:#fff;background:#0b62e9;font-size:24rpx;font-weight:700;line-height:1;flex:0 0 100rpx}
.banner-swiper{height:310rpx;background:#0f57c1}
.banner-slide{position:relative;width:100%;height:310rpx;overflow:hidden}
.banner-slide image{width:100%;height:100%}
.banner-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,35,84,.96),rgba(4,65,142,.68) 56%,rgba(4,77,173,.06))}
.banner-copy{position:absolute;left:42rpx;top:49rpx;display:flex;flex-direction:column;color:#fff}
.banner-copy text:first-child{padding-left:12rpx;border-left:5rpx solid #58dcff;font-size:21rpx}
.banner-copy text:nth-child(2){margin:19rpx 0 13rpx;font-size:48rpx;font-weight:700;line-height:1.15}
.banner-copy text:last-child{font-size:22rpx}
.banner-empty{position:relative;height:310rpx;overflow:hidden;background:#7cc8e9}
.banner-empty>image{width:100%;height:100%}
.banner-empty>.banner-shade{position:absolute;inset:0}
.banner-empty>.banner-copy{position:absolute}
.home-categories{display:grid;grid-template-columns:repeat(5,1fr);padding:21rpx 16rpx 13rpx;background:#fff}
.home-category{display:flex;align-items:center;margin-bottom:13rpx;flex-direction:column}
.home-category image{width:90rpx;height:90rpx;border:2rpx solid #e1ebf4;border-radius:50%;background:#f2f6fa}
.home-category text{max-width:124rpx;margin-top:7rpx;overflow:hidden;color:#233f5d;font-size:22rpx;font-weight:600;text-overflow:ellipsis;white-space:nowrap}
.news-strip{display:flex;align-items:center;width:100%;height:70rpx;margin:12rpx 0;padding:0 27rpx;box-sizing:border-box;color:#0d63df;background:#fff;text-align:left}
.news-icon{display:flex;align-items:center;justify-content:center;width:35rpx;height:29rpx;margin-right:10rpx;border-radius:6rpx;color:#fff;background:#1477ff;font-size:18rpx;letter-spacing:1rpx}
.news-title{min-width:0;overflow:hidden;font-size:25rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap;flex:none}
.news-copy{overflow:hidden;margin-left:34rpx;color:#667c91;font-size:21rpx;text-overflow:ellipsis;white-space:nowrap;flex:1}
.news-more{font-size:21rpx}
.section-heading{display:flex;align-items:center;justify-content:space-between;padding:15rpx 27rpx 11rpx}
.section-heading view{display:flex;align-items:baseline;min-width:0;overflow:hidden}
.section-heading view text:first-child{color:#1c3551;font-size:33rpx;font-weight:700}
.section-heading view text:first-child,.section-heading view text:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.section-heading view text:last-child{min-width:0;margin-left:14rpx;color:#c17f35;font-size:21rpx}
.section-heading button{color:#0865e9;font-size:21rpx}
.deal-list{padding:0 18rpx}
.deal-card{display:flex;align-items:center;min-height:174rpx;margin-bottom:13rpx;overflow:hidden;border-radius:9rpx;background:#fff;box-shadow:0 4rpx 16rpx rgba(17,53,93,.05)}
.deal-photo{position:relative;width:198rpx;height:174rpx;flex:none}
.deal-photo image{width:100%;height:100%;background:#f1f5f9}
.deal-photo text{position:absolute;left:0;top:13rpx;padding:7rpx 11rpx;border-radius:0 5rpx 5rpx 0;color:#fff;background:#ef4552;font-size:20rpx}
.deal-copy{display:flex;min-width:0;overflow:hidden;padding:0 10rpx 0 17rpx;flex:1;flex-direction:column}
.deal-copy>text:first-child{overflow:hidden;color:#1c3550;font-size:29rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
.deal-copy>text:nth-child(2){margin:10rpx 0;color:#75899e;font-size:22rpx}
.deal-copy view{display:flex;align-items:center;flex-wrap:wrap}
.deal-copy view text:first-child{color:#eb4c52;font-size:33rpx;font-weight:700}
.deal-copy view .deal-benefit{width:100%;margin-top:8rpx;overflow:hidden;color:#61778e;font-size:21rpx;text-decoration:none;text-overflow:ellipsis;white-space:nowrap}
.deal-card quantity-stepper{margin-right:12rpx}
.bottom-space{height:calc(255rpx + constant(safe-area-inset-bottom));height:calc(255rpx + env(safe-area-inset-bottom))}
.sub-head{display:flex;align-items:center;min-height:98rpx;padding:0 24rpx;background:#f7faff}
.sub-head>button{display:flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;color:#0b61dc;font-size:46rpx}
.sub-head>view{display:flex;min-width:0;margin-left:8rpx;overflow:hidden;flex-direction:column;flex:1}
.sub-head>view text:first-child{color:#1c3550;font-size:35rpx;font-weight:700}
.sub-head>view text:first-child,.sub-head>view text:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sub-head>view text:last-child{margin-top:5rpx;color:#6e8398;font-size:21rpx}
.sub-head .text-btn{width:auto;color:#0d66e9;font-size:23rpx}
.catalog-top{display:flex;align-items:center;justify-content:space-between;padding:16rpx 28rpx 13rpx;background:#fff}
.catalog-top text{font-size:30rpx;font-weight:700}
.catalog-top button{color:#718399;font-size:21rpx}
.catalog-search{display:flex;align-items:center;height:58rpx;margin:0 22rpx 10rpx;padding:0 14rpx;border-radius:6rpx;background:#edf2f6}
.catalog-search>text{margin-right:10rpx;color:#74889d}
.catalog-search input{min-width:0;height:58rpx;font-size:22rpx;flex:1}
.catalog-search button{display:flex;align-items:center;justify-content:center;width:94rpx;min-width:94rpx;max-width:94rpx;height:52rpx;box-sizing:border-box;border-radius:5rpx;color:#fff;background:#126ce5;font-size:21rpx;line-height:1;flex:0 0 94rpx}
.major-scroll{height:158rpx;background:#fff;white-space:nowrap}
.major-track{display:flex;padding:12rpx 0 14rpx}
.major-item{display:flex;align-items:center;width:130rpx;margin:0 10rpx;color:#41566b;flex:0 0 130rpx;flex-direction:column}
.major-item image{width:96rpx;height:96rpx;border-radius:50%;background:#eff4f8}
.major-item text{width:100%;margin-top:7rpx;overflow:hidden;font-size:22rpx;text-align:center;text-overflow:ellipsis;white-space:nowrap}
.major-item.is-active text{color:#0869ea;font-weight:700}
.catalog-layout{display:flex;min-height:260px;background:#fff}
.catalog-side{width:150rpx;background:#f4f6f9;flex:none}
.side-item{display:flex;align-items:center;justify-content:center;min-height:98rpx;padding:0 9rpx;box-sizing:border-box;color:#52677c;font-size:22rpx;line-height:1.3;text-align:center}
.side-item.is-active{position:relative;color:#0969e9;background:#fff;font-weight:700}
.side-item.is-active::before{position:absolute;left:0;width:5rpx;height:37rpx;border-radius:0 4rpx 4rpx 0;background:#1177f4;content:""}
.catalog-results{height:100%;padding:0 12rpx;box-sizing:border-box;flex:1}
.result-title{display:flex;align-items:center;justify-content:space-between;height:66rpx}
.result-title text:first-child{font-size:27rpx;font-weight:700}
.result-title text:last-child{color:#76899b;font-size:21rpx}
.catalog-row{display:flex;align-items:center;min-height:168rpx;border-bottom:1rpx solid #edf1f4}
.catalog-row>image{width:112rpx;height:112rpx;margin-right:14rpx;border-radius:8rpx;background:#f3f6f9;flex:none}
.catalog-row>view{display:flex;min-width:0;flex:1;flex-direction:column}
.catalog-row>view text:first-child{overflow:hidden;font-size:29rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
.catalog-row>view text:nth-child(2),.catalog-row>view text:nth-child(3){overflow:hidden;margin:7rpx 0 0;color:#71849a;font-size:21rpx;line-height:1.3;text-overflow:ellipsis;white-space:nowrap}
.catalog-row>view text:last-child{margin-top:9rpx;color:#e65336;font-size:31rpx;font-weight:700}
.catalog-row>view text:last-child text{color:#8f715b;font-size:20rpx;font-weight:400}
.choose-spec{display:flex;align-items:center;justify-content:center;width:108rpx;min-width:108rpx;height:56rpx;margin:0 8rpx 0 10rpx;padding:0;box-sizing:border-box;border-radius:28rpx;color:#fff;background:#0c69ec;font-size:20rpx;line-height:1;flex:0 0 108rpx}
.catalog-row quantity-stepper,.simple-row quantity-stepper{margin-left:10rpx}
.catalog-bottom-space{height:calc(230rpx + constant(safe-area-inset-bottom));height:calc(230rpx + env(safe-area-inset-bottom))}
.frequent-banner{display:flex;align-items:center;justify-content:space-between;margin:18rpx;padding:23rpx;border-radius:10rpx;color:#fff;background:linear-gradient(130deg,#195fc8,#2588ee)}
.frequent-banner>view{display:flex;min-width:0;flex:1;flex-direction:column}
.frequent-banner text:first-child{font-size:30rpx;font-weight:700}
.frequent-banner text:last-child{margin-top:8rpx;color:#d8ebff;font-size:20rpx}
.frequent-banner button{display:flex;align-items:center;justify-content:center;width:176rpx;min-width:176rpx;max-width:176rpx;height:70rpx;margin-left:16rpx;box-sizing:border-box;border-radius:6rpx;color:#1356b8;background:#fff;font-size:22rpx;font-weight:700;line-height:1;flex:0 0 176rpx}
.frequent-spec-hint{display:flex;align-items:center;justify-content:center;width:176rpx;min-width:176rpx;height:70rpx;margin-left:16rpx;border:1rpx solid rgba(255,255,255,.65);box-sizing:border-box;border-radius:6rpx;color:#fff;font-size:21rpx;font-weight:700;line-height:1;text-align:center}
.simple-list{padding:0 18rpx}
.simple-row{display:flex;align-items:center;min-height:132rpx;margin-bottom:10rpx;padding:12rpx;border-radius:8rpx;background:#fff}
.simple-row>image{width:105rpx;height:105rpx;margin-right:16rpx}
.simple-row>view{display:flex;min-width:0;flex:1;flex-direction:column}
.simple-row>view text:first-child{overflow:hidden;font-size:26rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
.simple-row>view text:nth-child(2){margin:8rpx 0;color:#75889b;font-size:21rpx}
.simple-row>view text:last-child{color:#e45d35;font-size:27rpx;font-weight:700}
.simple-row>view .price-pending.is-locked,.cart-row>view .price-pending.is-locked{color:#6f8498;font-size:21rpx;font-weight:500}
.simple-row>view .price-pending.is-temporary,.cart-row>view .price-pending.is-temporary{color:#e96762}
.delivery-note{display:flex;align-items:center;margin:0 18rpx 12rpx;padding:22rpx;border-radius:8rpx;background:#eaf3ff}
.delivery-note image{width:47rpx;height:47rpx;margin-right:14rpx}
.delivery-note view{display:flex;flex-direction:column}
.delivery-note text:first-child{color:#1e4b87;font-size:24rpx;font-weight:700}
.delivery-note text:last-child{margin-top:6rpx;color:#69819a;font-size:20rpx}
.cart-list{margin:0 18rpx;border-radius:8rpx;background:#fff}
.cart-row{display:flex;align-items:center;min-height:143rpx;padding:0 14rpx;border-bottom:1rpx solid #edf1f4}
.cart-row:last-child{border-bottom:0}
.cart-row>image{width:104rpx;height:104rpx;margin-right:14rpx}
.cart-row>.cart-check{width:38rpx;height:38rpx;margin-right:5rpx;flex:0 0 38rpx}
.cart-row>.cart-check .wx-checkbox-input{width:30rpx;height:30rpx;border-radius:50%;border-color:#c7d5e3}
.cart-row>.cart-check .wx-checkbox-input.wx-checkbox-input-checked{border-color:#0b69e9;background:#0b69e9}
.cart-row>view{display:flex;min-width:0;overflow:hidden;flex:1;flex-direction:column}
.cart-row>view text:first-child{overflow:hidden;font-size:26rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
.cart-row>view text:nth-child(2){margin:9rpx 0;color:#75889d;font-size:22rpx}
.cart-row>view text:last-child{color:#e45b37;font-size:27rpx;font-weight:700}
.cart-head-count{color:#1c4f87;font-size:23rpx;font-weight:700}
.cart-row>.stepper{display:flex;align-items:center;width:172rpx;min-width:172rpx;max-width:172rpx;flex:0 0 172rpx;flex-direction:row;flex-wrap:nowrap}
.stepper button{display:flex;align-items:center;justify-content:center;width:60rpx;height:72rpx;border-radius:50%;color:#0867e8;background:radial-gradient(circle at center,#eaf3ff 0,#eaf3ff 27rpx,transparent 28rpx);font-size:30rpx;font-weight:500}
.stepper text{width:52rpx;text-align:center;color:#203e5d;font-size:27rpx;font-weight:700}
.cart-total{position:fixed;right:0;bottom:calc(112rpx + constant(safe-area-inset-bottom));bottom:calc(112rpx + env(safe-area-inset-bottom));left:0;z-index:10;display:flex;align-items:center;justify-content:space-between;height:100rpx;padding:6rpx 18rpx 6rpx 28rpx;box-sizing:border-box;background:#fff;box-shadow:0 -4rpx 14rpx rgba(20,55,91,.08)}
.cart-total-copy{display:flex;min-width:0;flex:1;flex-direction:column}
.cart-total-copy>text:first-child{margin-bottom:3rpx;color:#73869a;font-size:20rpx}
.cart-total-copy>text:last-child{color:#40546a;font-size:22rpx}
.cart-total-copy>text:last-child text{color:#e75d38;font-size:34rpx;font-weight:700}
.cart-total button{display:flex;align-items:center;justify-content:center;width:166rpx;height:88rpx;margin-left:14rpx;box-sizing:border-box;border-radius:8rpx;color:#fff;background:#0d69ec;font-size:26rpx;font-weight:700;line-height:1.4}
.cart-total button[disabled]{opacity:.45}
.cart-bottom-space{height:calc(224rpx + constant(safe-area-inset-bottom));height:calc(224rpx + env(safe-area-inset-bottom))}
.empty-state{display:flex;align-items:center;padding-top:180rpx;flex-direction:column}
.empty-state image{width:98rpx;height:98rpx;opacity:.48}
.empty-state text:nth-child(2){margin-top:22rpx;font-size:28rpx;font-weight:700}
.empty-state text:nth-child(3){margin-top:9rpx;color:#7e8fa0;font-size:21rpx}
.empty-state button{margin-top:25rpx;padding:17rpx 30rpx;border-radius:6rpx;color:#fff;background:#0c69ec;font-size:23rpx}
.guest-card{display:flex;align-items:center;margin:18rpx;padding:25rpx;box-sizing:border-box;border-radius:10rpx;background:#fff;text-align:left}
.guest-card image{width:78rpx;height:78rpx;margin-right:18rpx;padding:10rpx;border-radius:50%;background:#edf4ff}
.guest-card view{display:flex;flex-direction:column;flex:1}
.guest-card view text:first-child{font-size:29rpx;font-weight:700}
.guest-card view text:last-child{margin-top:8rpx;color:#73869a;font-size:21rpx}
.guest-card>text{color:#99a8b7;font-size:38rpx}
.contact-strip{display:flex;align-items:center;height:78rpx;margin:0 18rpx;box-sizing:border-box;border-radius:9rpx;background:#fff;text-align:left}
.contact-strip image{width:37rpx;height:37rpx;margin:0 15rpx}
.contact-strip text:nth-child(2){font-size:25rpx;flex:1}
.contact-strip text:last-child{margin-right:16rpx;color:#6f849a;font-size:21rpx}
.guest-hint{display:flex;margin:0 18rpx 18rpx;padding:23rpx 25rpx;border-radius:10rpx;background:rgba(255,255,255,.56);flex-direction:column}
.guest-hint text:first-child{color:#35506a;font-size:23rpx;font-weight:700}
.guest-hint text:last-child{margin-top:9rpx;color:#6e8296;font-size:21rpx;line-height:1.5}
.profile-card{margin:18rpx 18rpx 0;padding:25rpx;border-radius:12rpx;background:linear-gradient(115deg,#eff5ff,#dceaff);box-shadow:0 6rpx 16rpx rgba(17,103,128,.08)}
.profile-top{display:flex;align-items:center}
.avatar{display:flex;align-items:center;justify-content:center;width:75rpx;height:75rpx;margin-right:15rpx;border-radius:50%;color:#0b6ae9;background:#fff;font-size:32rpx;font-weight:700}
.profile-top>view:nth-child(2){display:flex;flex:1;flex-direction:column}
.profile-top>view:nth-child(2) text:first-child{font-size:28rpx;font-weight:700}
.profile-top>view:nth-child(2) text:last-child{margin-top:7rpx;color:#668094;font-size:21rpx}
.profile-top button{display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;border-radius:50%;color:#41718a;background:rgba(255,255,255,.62);font-size:28rpx;line-height:1}
.profile-stats{display:flex;margin-top:24rpx}
.profile-stats button{display:flex;width:33.333%;min-width:0;box-sizing:border-box;border-right:1rpx solid rgba(40,127,241,.24);flex:0 0 33.333%;flex-direction:column}
.profile-stats button:last-child{border:0}
.profile-stats text:first-child{font-size:28rpx;font-weight:700}
.profile-stats text:last-child{margin-top:7rpx;color:#617e88;font-size:21rpx}
.member-banner{display:flex;align-items:center;height:66rpx;margin:13rpx 18rpx 0;padding:0 16rpx;box-sizing:border-box;border-radius:7rpx;color:#fff;background:linear-gradient(90deg,#0d62d2,#2588ec);text-align:left}
.member-banner text:first-child{margin-right:10rpx;padding:5rpx 7rpx;border-radius:4rpx;background:rgba(255,255,255,.18);font-size:20rpx}
.member-banner text:nth-child(2){min-width:0;overflow:hidden;font-size:22rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap;flex:1}
.member-banner text:last-child{font-size:21rpx}
.mine-card{margin:15rpx 18rpx;padding:22rpx 20rpx;border-radius:10rpx;background:#fff;box-shadow:0 4rpx 12rpx rgba(18,55,89,.045)}
.mine-title{display:flex;align-items:center;justify-content:space-between}
.mine-title text,.tool-title{font-size:27rpx;font-weight:700}
.mine-title button{padding:6rpx 0;color:#62788f;font-size:21rpx;line-height:1.35}
.order-grid{display:flex;margin-top:20rpx;flex-wrap:wrap}
.order-grid button,.tool-grid button{position:relative;display:flex;align-items:center;min-width:0;box-sizing:border-box;flex-direction:column}
.order-grid button{width:25%;flex:0 0 25%}
.order-grid image,.tool-grid image{width:43rpx;height:43rpx}
.order-grid text:nth-child(2),.tool-grid text{margin-top:8rpx;color:#475f76;font-size:21rpx}
.order-grid .order-count{position:absolute;top:-9rpx;right:20rpx;display:flex;align-items:center;justify-content:center;min-width:32rpx;height:32rpx;margin:0;border:2rpx solid #fff;border-radius:50%;color:#fff;background:#ef4b57;font-size:20rpx;font-weight:700}
.tool-grid{display:flex;margin-top:22rpx;flex-wrap:wrap;row-gap:24rpx}
.tool-grid button{width:33.333%;flex:0 0 33.333%}
.contact-panel{display:flex;margin:0 18rpx 18rpx;padding:22rpx 20rpx;border-radius:10rpx;background:#fff;box-shadow:0 4rpx 12rpx rgba(18,55,89,.045);flex-direction:column}
.contact-panel text:first-child{font-size:27rpx;font-weight:700}
.contact-panel text:nth-child(2){margin:10rpx 0;color:#637a90;font-size:21rpx}
.contact-panel button{padding-top:14rpx;border-top:1rpx solid #edf1f4;color:#0768e9;font-size:21rpx;text-align:left}
.detail-head{display:grid;align-items:center;height:91rpx;padding:0 20rpx;background:#fff;grid-template-columns:50rpx 1fr 50rpx}
.detail-head>button:first-child{font-size:47rpx}
.detail-head>text{text-align:center;font-size:28rpx;font-weight:700}
.detail-head>button:last-child image{width:37rpx;height:37rpx}
