.checkout-action-bar{position:fixed;right:0;bottom:0;left:0;z-index:20;height:calc(var(--fixed-bar-height) + constant(safe-area-inset-bottom));height:calc(var(--fixed-bar-height) + env(safe-area-inset-bottom));padding:6px 9px calc(6px + constant(safe-area-inset-bottom));padding:6px 9px calc(6px + env(safe-area-inset-bottom));box-sizing:border-box;background:#fff;box-shadow:0 -4rpx 14rpx rgba(18,55,89,.1)}
.submit-order{display:flex;align-items:center;justify-content:center;width:100%;height:52px;box-sizing:border-box;border-radius:6rpx;color:#fff;background:#0869e9;font-size:16px;font-weight:700}
.service-intro{display:flex;align-items:center;margin:18rpx;padding:23rpx;border-radius:10rpx;background:#fff;box-shadow:0 4rpx 12rpx rgba(18,55,89,.045)}
.service-intro view:last-child{display:flex;flex-direction:column}
.service-intro view:last-child text:first-child{font-size:14px;font-weight:700}
.service-intro view:last-child text:last-child{margin-top:8rpx;color:#628097;font-size:13px}
.service-chat{display:flex;margin:18rpx;padding:23rpx;border-radius:10rpx;background:#fff;box-shadow:0 4rpx 12rpx rgba(18,55,89,.045);flex-direction:column;align-items:stretch}
.service-chat>text{padding:14rpx;border-radius:8rpx;color:#39536a;background:#f0f5f9;font-size:14px;line-height:1.55}
.service-actions{display:flex;margin-top:18rpx;flex-direction:column}
.service-chat button{display:flex;align-items:center;justify-content:center;min-height:44px;padding:8px 14px;box-sizing:border-box;border:1rpx solid #b8d7ef;border-radius:6rpx;color:#0a69e9;background:#fff;font-size:14px;line-height:1.4}
.service-contact-action{width:100%;border-color:#0a69e9!important;color:#fff!important;background:#0a69e9!important;font-size:14px!important;font-weight:700}
.service-quick-actions{display:flex;margin-top:12rpx;gap:12rpx}
.service-quick-actions button{min-width:0;flex:1}
.chat-input{display:flex;margin:18rpx;height:72rpx;border-radius:7rpx;overflow:hidden;background:#fff}
.chat-input input{min-width:0;padding:0 18rpx;color:#294158;font-size:14px;flex:1}
.chat-input button{display:flex;align-items:center;justify-content:center;width:108rpx;box-sizing:border-box;color:#fff;background:#0a69ea;font-size:14px;line-height:1.4}
.address-empty{display:flex;margin:18rpx;padding:30rpx 24rpx;border-radius:8rpx;background:#fff;flex-direction:column}
.address-empty text:first-child{color:#2b435c;font-size:14px;font-weight:700}
.address-empty text:last-child{margin-top:11rpx;color:#6d8297;font-size:13px;line-height:1.5}
.points-hero{align-items:center;text-align:center}
.points-hero text:first-child{font-size:58rpx;font-weight:700}
.points-hero text:nth-child(2){margin:8rpx 0 20rpx;color:#d7ebff;font-size:13px}
.points-hero button{display:flex;align-items:center;justify-content:center;width:100%;height:68rpx;box-sizing:border-box;border-radius:5rpx;color:#0b68df;background:#fff;font-size:14px;font-weight:700;line-height:1.4}

/* Synced from the current web preview: light-blue brand skin. */
/* Web-preview parity: keep text columns shrinkable so fixed media/actions do not cause narrow-screen overflow. */
.home-header{background:linear-gradient(135deg,#2b86ff,#1257bc)}
.brand{gap:8rpx}
.banner-shade{background:linear-gradient(90deg,rgba(54,151,199,.91),rgba(84,183,230,.75) 56%,rgba(185,232,250,.22))}
.search-row button,.cart-total button,.quick-checkout>button:last-child,.detail-actions button:last-child,.empty-state button{background:#287ff1}
.search-row button,.detail-actions button:last-child{border-color:#287ff1}
.tabbar button.is-active,.major-item.is-active text,.side-item.is-active,.sub-head>button{color:#1257bc}
.side-item.is-active::before{background:#287ff1}
.price-pending{font-weight:600}
.price-pending.is-locked{color:#6f8498;font-size:14px;font-weight:500}
.price-pending.is-temporary{color:#e96762}
.group-heading{margin-top:4rpx}
.group-list,.group-utility-list{padding:0 18rpx 18rpx}
.group-card{display:flex;align-items:center;gap:14rpx;margin-bottom:12rpx;padding:14rpx;border:1rpx solid #d8edf8;border-radius:12rpx;background:#fff}
.group-card>image{width:118rpx;height:118rpx;border-radius:10rpx;background:#f1f8fc}
.group-card-copy{display:flex;min-width:0;flex:1;flex-direction:column;gap:6rpx}
.group-card-copy text:first-child{overflow:hidden;color:#18334d;font-size:14px;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
.group-card-copy text:nth-child(2),.group-card-copy text:last-child{color:#7890a3;font-size:13px}
.group-card-copy .price-pending{font-size:14px}
.group-card>button{display:flex;align-items:center;justify-content:center;min-width:112rpx;min-height:44px;padding:0 16rpx;border-radius:999px;color:#fff;background:#287ff1;font-size:14px;font-weight:700;line-height:1}
.group-card>button[disabled]{color:#7c8fa3;background:#e7edf3}
.group-utility-list{padding-top:18rpx}

/* Compact phones: retain the approved structure while preventing controls and labels from competing for one line. */
@media screen and (max-width: 360px){
  .home-header{padding-right:18rpx;padding-left:18rpx}
  .location-button{width:fit-content;max-width:164rpx;font-size:14px}
  .nav-right-space{width:164rpx}
  .brand{font-size:17px;letter-spacing:1rpx}
  .home-category text{display:-webkit-box;max-width:100%;font-size:13px;line-height:1.2;text-align:center;white-space:normal;-webkit-box-orient:vertical;-webkit-line-clamp:2}
  .banner-copy{left:32rpx}
  .banner-copy text:nth-child(2){font-size:42rpx}
  .banner-empty{padding-right:32rpx;padding-left:32rpx}
  .banner-empty text:first-child{font-size:40rpx}
  .deal-photo{width:178rpx}
  .deal-copy{padding-left:13rpx}
  .deal-copy>text:first-child{font-size:14px}
  .catalog-side{width:138rpx}
  .catalog-results{padding:0 10rpx}
  .catalog-row>image{width:88rpx;height:88rpx;margin-right:10rpx}
  .catalog-row>view text:first-child{font-size:14px}
  .choose-spec{width:fit-content;min-width:44px;height:44px;margin-left:6rpx;padding:0;font-size:14px;flex-basis:fit-content}
  .simple-row>image{width:88rpx;height:88rpx;margin-right:12rpx}
  .cart-row{padding:0 10rpx}
  .cart-row>image{width:88rpx;height:88rpx;margin-right:10rpx}
  .cart-row>.stepper{width:120px;min-width:120px;max-width:120px;flex-basis:120px}
  .stepper button{width:44px;height:44px;background:transparent}
  .stepper text{width:32px;font-size:15px}
  .cart-total{padding-right:14rpx;padding-left:20rpx}
  .cart-total button{width:104px;margin-left:8px;font-size:15px}
  .guest-card{padding:21rpx}
  .guest-card image{width:70rpx;height:70rpx;margin-right:13rpx}
  .coupon-card{padding:20rpx}
  .coupon-card>text:first-child{font-size:35rpx}
  .coupon-card view{margin-left:16rpx}
  .detail-line{align-items:flex-start}
  .detail-line text:last-child{word-break:break-all}
}

/* Shared responsive corrections: keep the approved structure while allowing
 * text and controls to shrink inside their own columns. */
.result-title{min-width:0;padding-right:16rpx;box-sizing:border-box;gap:12rpx}
.result-title text:first-child{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.result-title text:last-child{flex:none;white-space:nowrap}
.catalog-row>view text:first-child{line-height:1.25}
.detail-actions button{width:100%;min-width:0;padding-right:12rpx;padding-left:12rpx;overflow:hidden;box-sizing:border-box;text-overflow:ellipsis}
.quantity-picker{max-height:calc(100vh - var(--quantity-picker-safe-top) - 24rpx);overflow-y:auto}
.tabbar-bottom-space,.bottom-space,.meal-bottom-space{height:calc(var(--fixed-one-space) + constant(safe-area-inset-bottom));height:calc(var(--fixed-one-space) + env(safe-area-inset-bottom))}
.tabbar-bottom-space.has-quick-checkout,.meal-bottom-space.has-quick-checkout{height:calc(var(--fixed-two-space) + constant(safe-area-inset-bottom));height:calc(var(--fixed-two-space) + env(safe-area-inset-bottom))}
.catalog-bottom-space{height:calc(var(--fixed-one-space) + constant(safe-area-inset-bottom));height:calc(var(--fixed-one-space) + env(safe-area-inset-bottom))}
.catalog-bottom-space.has-quick-checkout{height:calc(var(--fixed-two-space) + constant(safe-area-inset-bottom));height:calc(var(--fixed-two-space) + env(safe-area-inset-bottom))}
.cart-bottom-space{height:calc(var(--fixed-two-space) + constant(safe-area-inset-bottom));height:calc(var(--fixed-two-space) + env(safe-area-inset-bottom))}
.search-row input,.catalog-search input,.chat-input input{line-height:1.35}

/* Neutralize native button intrinsic widths only where the surrounding
 * flex/grid layout already defines the intended width. */
.service-quick-actions button{width:100%;max-width:100%}
.order-card-actions{flex-wrap:wrap}
.order-card-actions button{width:auto;min-width:0;max-width:100%;flex:0 1 auto;white-space:normal;overflow-wrap:anywhere}
.order-filter button{width:auto;min-width:0;max-width:none;flex:0 0 auto}
.spec-list button,.quantity-picker-specs button{width:auto;min-width:44px;max-width:100%;flex:0 1 auto;overflow-wrap:anywhere}
.group-card>button{width:auto;max-width:100%;flex:0 1 auto;white-space:normal;overflow-wrap:anywhere}

@media screen and (max-width: 414px){
  .banner-copy text:first-child,.banner-copy text:last-child{line-height:1.35}
  .banner-copy text:nth-child(2){line-height:1.2}
  .home-category text{display:-webkit-box;max-width:100%;font-size:14px;line-height:1.2;text-align:center;white-space:normal;-webkit-box-orient:vertical;-webkit-line-clamp:2}
  .catalog-row{align-items:flex-start;padding:14rpx 0}
  .catalog-row>view text:first-child{display:-webkit-box;overflow:hidden;white-space:normal;-webkit-box-orient:vertical;-webkit-line-clamp:2}
  .catalog-row>view text:nth-child(2),.catalog-row>view text:nth-child(3){white-space:nowrap}
  .catalog-row>quantity-stepper,.catalog-row>.choose-spec{align-self:center}
  .quantity-picker{padding-right:24rpx;padding-left:24rpx}
  .quick-checkout .quick-summary-line.is-compact .quick-count-label{display:none}
}

@media screen and (max-width: 374px){
  .quick-checkout .quick-count-label,.quick-checkout .quick-total-label,.quick-checkout .quick-currency{font-size:13px}
  .quick-checkout .quick-count{font-size:14px}
  .quick-checkout .quick-amount{font-size:20px}
}

@media screen and (max-width: 390px){
  .quick-checkout .quick-summary-line.is-compact .quick-amount{font-size:15px}
}

@media screen and (max-width: 360px){
  .home-category text{font-size:13px}
  .meal-intro>view text:first-child,.empty-state text:nth-child(2),.guest-card view text:first-child,.profile-top>view:nth-child(2) text:first-child,.profile-stats text:first-child,.detail-head>text,.order-empty text:first-child,.delivery-status>text:nth-child(2),.business-title,.checkout-total text:last-child{font-size:14px}
  .quick-checkout .quick-count-label{display:none}
  .quick-checkout .quick-total-label{margin-left:6px;padding-left:6px}
  .quick-checkout .quick-amount{font-size:18px}
  .quick-checkout .quick-summary-line.is-compact .quick-total-label{display:none}
  .quick-checkout .quick-summary-line.is-compact .quick-currency{margin-left:6px;padding-left:6px;border-left:1px solid #d7e0e9}
  .quick-checkout .quick-summary-line.is-compact .quick-amount{font-size:14px}
}

@media (prefers-reduced-motion: reduce){
  .page-scroll.is-page-entering,.cart-tab-icon.is-pulsing,.catalog-empty.is-loading text:first-child,.deal-card-skeleton,.meal-card-skeleton{animation:none}
  .login-mask,.login-mask.is-visible,.login-card{transition:none}
}

@keyframes content-skeleton-breathe{0%,100%{opacity:.62}50%{opacity:1}}
