.business-form label{display:flex;margin-bottom:20rpx;color:#30485f;font-size:22rpx;flex-direction:column}
.business-form input{margin-top:10rpx;padding:16rpx;border:1rpx solid #dce5ee;border-radius:5rpx;color:#253f58;font:inherit;font-size:22rpx}
.business-form button{display:flex;align-items:center;justify-content:center;height:80rpx;box-sizing:border-box;border-radius:6rpx;color:#fff;background:#0969e9;font-size:25rpx;font-weight:700;line-height:1.4}
.business-form button[disabled]{color:#fff;background:#8fb9ec}
.checkout-address{display:flex;align-items:center;justify-content:space-between;width:100%;margin-bottom:11rpx;padding:23rpx;box-sizing:border-box;background:#fff;text-align:left}
.checkout-address view{display:flex;min-width:0;flex:1;flex-direction:column}
.checkout-address view text:first-child{font-size:25rpx;font-weight:700}
.checkout-address view text:last-child{margin-top:10rpx;color:#60768c;font-size:22rpx;line-height:1.45}
.checkout-address>text{color:#97a8b9;font-size:35rpx}
.checkout-delivery{display:flex;margin-bottom:11rpx;padding:23rpx;border-left:5rpx solid #0b6bea;background:#fff;flex-direction:column}
.checkout-delivery text:first-child{font-size:25rpx;font-weight:700}
.checkout-delivery text:nth-child(2){margin:8rpx 0;color:#0c69e9;font-size:24rpx;font-weight:700}
.checkout-delivery text:last-child{color:#71859a;font-size:21rpx}
.checkout-items{padding:0 23rpx;background:#fff}
.checkout-items>view{display:flex;align-items:center;padding:16rpx 0;border-bottom:1rpx solid #edf1f4}
.checkout-items>view image{width:78rpx;height:78rpx;margin-right:13rpx}
.checkout-items>view view{display:flex;min-width:0;flex:1;flex-direction:column}
.checkout-items>view view text:first-child{overflow:hidden;font-size:23rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
.checkout-items>view view text:last-child{margin-top:7rpx;color:#788a9c;font-size:21rpx}
.checkout-items>view>text{min-width:145rpx;color:#df5b35;font-size:23rpx;text-align:right;white-space:nowrap}
.checkout-total{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:11rpx;padding:24rpx;background:#fff}
.checkout-total>view{display:flex;min-width:0;flex:1;flex-direction:column;gap:7rpx}
.checkout-total>view text{color:#708398;font-size:23rpx;line-height:1.35}
.checkout-total text:first-child{color:#708398;font-size:23rpx}
.checkout-total text:last-child{min-width:0;color:#e55736;font-size:28rpx;font-weight:700;text-align:right;white-space:nowrap}
.checkout-action-bar{position:fixed;right:0;bottom:0;left:0;z-index:20;padding:15rpx 18rpx calc(15rpx + constant(safe-area-inset-bottom));padding:15rpx 18rpx calc(15rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#fff;box-shadow:0 -4rpx 14rpx rgba(18,55,89,.1)}
.submit-order{display:flex;align-items:center;justify-content:center;width:100%;height:82rpx;box-sizing:border-box;border-radius:6rpx;color:#fff;background:#0869e9;font-size:26rpx;font-weight:700}
.service-intro{display:flex;align-items:center;margin:18rpx;padding:23rpx;border-radius:10rpx;background:#fff;box-shadow:0 4rpx 12rpx rgba(18,55,89,.045)}
.service-intro view:last-child{display:flex;flex-direction:column}
.service-intro view:last-child text:first-child{font-size:26rpx;font-weight:700}
.service-intro view:last-child text:last-child{margin-top:8rpx;color:#628097;font-size:21rpx}
.service-chat{display:flex;margin:18rpx;padding:23rpx;border-radius:10rpx;background:#fff;box-shadow:0 4rpx 12rpx rgba(18,55,89,.045);flex-direction:column;align-items:stretch}
.service-chat>text{padding:14rpx;border-radius:8rpx;color:#39536a;background:#f0f5f9;font-size:22rpx;line-height:1.55}
.service-actions{display:flex;margin-top:18rpx;flex-direction:column}
.service-chat button{display:flex;align-items:center;justify-content:center;min-height:68rpx;padding:13rpx 16rpx;box-sizing:border-box;border:1rpx solid #b8d7ef;border-radius:6rpx;color:#0a69e9;background:#fff;font-size:21rpx;line-height:1.4}
.service-contact-action{width:100%;border-color:#0a69e9!important;color:#fff!important;background:#0a69e9!important;font-size:23rpx!important;font-weight:700}
.service-quick-actions{display:flex;margin-top:12rpx;gap:12rpx}
.service-quick-actions button{min-width:0;flex:1}
.chat-input{display:flex;margin:18rpx;height:72rpx;border-radius:7rpx;overflow:hidden;background:#fff}
.chat-input input{min-width:0;padding:0 18rpx;color:#294158;font-size:22rpx;flex:1}
.chat-input button{display:flex;align-items:center;justify-content:center;width:108rpx;box-sizing:border-box;color:#fff;background:#0a69ea;font-size:22rpx;line-height:1.4}
.address-empty{display:flex;margin:18rpx;padding:30rpx 24rpx;border-radius:8rpx;background:#fff;flex-direction:column}
.address-empty text:first-child{color:#2b435c;font-size:26rpx;font-weight:700}
.address-empty text:last-child{margin-top:11rpx;color:#6d8297;font-size:21rpx;line-height:1.5}
.points-hero{align-items:center;text-align:center}
.points-hero text:first-child{font-size:58rpx;font-weight:700}
.points-hero text:nth-child(2){margin:8rpx 0 20rpx;color:#d7ebff;font-size:21rpx}
.points-hero button{display:flex;align-items:center;justify-content:center;width:100%;height:68rpx;box-sizing:border-box;border-radius:5rpx;color:#0b68df;background:#fff;font-size:22rpx;font-weight:700;line-height:1.4}

/* Synced from the current web preview: light-blue brand skin. */
/* Web-preview parity: keep text columns shrinkable so fixed media/actions do not cause narrow-screen overflow. */
.home-header{background:linear-gradient(135deg,#2b86ff,#1257bc)}
.brand{display:flex;align-items:center;justify-content:center;gap:8rpx}
.brand image{width:38rpx;height:38rpx;border-radius:50%;background:#fff}
.banner-shade{background:linear-gradient(90deg,rgba(54,151,199,.91),rgba(84,183,230,.75) 56%,rgba(185,232,250,.22))}
.search-row button,.choose-spec,.cart-total button,.quick-checkout>button:last-child,.detail-actions button:last-child,.empty-state button{background:#287ff1}
.search-row button,.choose-spec,.detail-actions button:last-child{border-color:#287ff1}
.tabbar button.is-active,.major-item.is-active text,.side-item.is-active,.sub-head>button{color:#1257bc}
.side-item.is-active::before{background:#287ff1}
.price-pending{font-weight:600}
.price-pending.is-locked{color:#6f8498;font-size:21rpx;font-weight:500}
.price-pending.is-temporary{color:#e96762}
.group-heading{margin-top:4rpx}
.group-list,.group-utility-list{padding:0 18rpx 18rpx}
.group-card{display:flex;align-items:center;gap:14rpx;margin-bottom:12rpx;padding:14rpx;border:1rpx solid #d8edf8;border-radius:12rpx;background:#fff}
.group-card>image{width:118rpx;height:118rpx;border-radius:10rpx;background:#f1f8fc}
.group-card-copy{display:flex;min-width:0;flex:1;flex-direction:column;gap:6rpx}
.group-card-copy text:first-child{overflow:hidden;color:#18334d;font-size:24rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
.group-card-copy text:nth-child(2),.group-card-copy text:last-child{color:#7890a3;font-size:19rpx}
.group-card-copy .price-pending{font-size:21rpx}
.group-card>button{display:flex;align-items:center;justify-content:center;min-width:112rpx;height:56rpx;padding:0 12rpx;border-radius:28rpx;color:#fff;background:#287ff1;font-size:20rpx;line-height:1}
.group-utility-list{padding-top:18rpx}

/* Compact phones: retain the approved structure while preventing controls and labels from competing for one line. */
@media screen and (max-width: 360px){
  .home-header{padding-right:18rpx;padding-left:18rpx}
  .location-button,.nav-right-space{width:164rpx}
  .location-button{font-size:21rpx}
  .brand{font-size:29rpx;letter-spacing:1rpx}
  .banner-copy{left:32rpx}
  .banner-copy text:nth-child(2){font-size:42rpx}
  .banner-empty{padding-right:32rpx;padding-left:32rpx}
  .banner-empty text:first-child{font-size:40rpx}
  .news-strip{padding:0 20rpx}
  .news-copy{margin-left:18rpx}
  .deal-photo{width:178rpx}
  .deal-copy{padding-left:13rpx}
  .deal-copy>text:first-child{font-size:27rpx}
  .catalog-side{width:138rpx}
  .catalog-results{padding:0 10rpx}
  .catalog-row>image{width:88rpx;height:88rpx;margin-right:10rpx}
  .catalog-row>view text:first-child{font-size:24rpx}
  .choose-spec{width:96rpx;min-width:96rpx;height:60rpx;margin-left:6rpx;font-size:20rpx;flex-basis:96rpx}
  .simple-row>image{width:88rpx;height:88rpx;margin-right:12rpx}
  .cart-row{padding:0 10rpx}
  .cart-row>image{width:88rpx;height:88rpx;margin-right:10rpx}
  .cart-row>.stepper{width:188rpx;min-width:188rpx;max-width:188rpx;flex-basis:188rpx}
  .stepper button{width:72rpx;height:72rpx;background:radial-gradient(circle at center,#eaf3ff 0,#eaf3ff 23rpx,transparent 24rpx)}
  .stepper text{width:44rpx;font-size:25rpx}
  .cart-total{padding-right:14rpx;padding-left:20rpx}
  .cart-total button{width:148rpx;margin-left:8rpx;font-size:24rpx}
  .guest-card{padding:21rpx}
  .guest-card image{width:70rpx;height:70rpx;margin-right:13rpx}
  .coupon-card{padding:20rpx}
  .coupon-card>text:first-child{font-size:35rpx}
  .coupon-card view{margin-left:16rpx}
  .detail-line{align-items:flex-start}
  .detail-line text:last-child{word-break:break-all}
}
