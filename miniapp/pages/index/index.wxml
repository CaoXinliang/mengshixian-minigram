<template name="homeHeroHeader">
  <view class="home-header">
    <view class="top-safe" style="height: {{navSafeHeight}};"></view>
    <view class="store-row">
      <button class="location-button" bindtap="openUtility" data-type="warehouse">
        <image src="/assets/icons/location-white.svg" mode="aspectFit" />
        <view class="location-name">{{warehouse.name}}</view>
      </button>
      <view class="brand">
        <image src="/assets/brand/mengshixian-logo.jpg" mode="aspectFit" />
        <text>梦食鲜</text>
      </view>
      <view class="nav-right-space"></view>
    </view>
    <view class="search-row">
      <image src="/assets/icons/search.svg" mode="aspectFit" />
      <input value="{{query}}" placeholder="搜索商品" placeholder-class="search-placeholder" confirm-type="search" bindinput="onSearchInput" bindconfirm="startSearch" />
      <button bindtap="startSearch">搜索</button>
    </view>
  </view>
</template>

<view class="app-shell {{motionReduced ? 'is-motion-reduced' : ''}}">
  <scroll-view class="page-scroll {{pageMotion ? 'is-page-entering' : ''}}" scroll-y="true" scroll-top="{{pageScrollTop}}" enhanced="true" show-scrollbar="false">
    <view wx:if="{{page != 'home'}}" class="sub-nav-safe" style="height: {{navContentTop}};"></view>
    <block wx:if="{{page == 'home'}}">
      <swiper wx:if="{{bannerItems.length}}" class="home-hero-swiper" style="height: calc({{navSafeHeight}} + 452rpx);" autoplay="true" interval="4500" circular="true" indicator-dots="{{bannerItems.length > 1}}" indicator-color="rgba(255,255,255,.55)" indicator-active-color="#fff">
        <swiper-item wx:for="{{bannerItems}}" wx:key="headline">
          <view class="home-hero-slide">
            <template is="homeHeroHeader" data="{{warehouse: warehouse, navSafeHeight: navSafeHeight, query: query}}" />
            <view class="banner-slide" role="button" bindtap="openBanner" data-index="{{index}}">
              <image src="{{item.image}}" mode="aspectFill" />
              <view class="banner-shade"></view>
              <view class="banner-copy">
                <text>{{item.eyebrow}}</text>
                <text>{{item.headline}}</text>
                <text>{{item.subline}}</text>
              </view>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <swiper wx:else class="home-hero-swiper" style="height: calc({{navSafeHeight}} + 452rpx);" autoplay="{{false}}" circular="{{false}}" indicator-dots="{{false}}">
        <swiper-item>
          <view class="home-hero-slide">
            <template is="homeHeroHeader" data="{{warehouse: warehouse, navSafeHeight: navSafeHeight, query: query}}" />
            <view class="banner-empty" role="button" bindtap="openHomeSection" data-section-type="special">
              <image src="/assets/products/frozen-hero-v2.jpg" mode="aspectFill" />
              <view class="banner-shade"></view>
              <view class="banner-copy">
                <text>中秋家庭囤货季 · 冷链严选</text>
                <text>鲜冻好物\n悦享团圆</text>
                <text>全场满 99 元免基础配送费</text>
              </view>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view class="home-categories">
<view class="home-category" wx:for="{{homeCategories}}" wx:key="label" bindtap="openCategory" data-category="{{item.label}}">
<image src="{{item.image}}" mode="aspectFill" />
<text>{{item.label}}</text>
</view>
</view>
<view class="news-strip" role="button" bindtap="openHomeSection" data-section-type="news">
<text class="news-icon">••</text>
<text class="news-title">{{activityTitle}}</text>
<text class="news-copy">{{activityCopy}}</text>
<text class="news-more">{{activityMoreText}}</text>
</view>
      <view class="section-heading">
<view>
<text>{{specialTitle}}</text>
<text>{{specialSubtitle}}</text>
</view>
<button bindtap="openHomeSection" data-section-type="special">{{specialMoreText}} ›</button>
</view>
      <view class="deal-list">
<view class="deal-card" wx:for="{{specials}}" wx:key="id" bindtap="openProduct" data-id="{{item.id}}">
<view class="deal-photo">
<image src="{{item.img}}" mode="aspectFit" />
<text wx:if="{{item.tag && item.tag != '待补充'}}">{{item.tag}}</text>
</view>
<view class="deal-copy">
<text>{{item.name}}</text>
<text>{{item.unit}}</text>
<view>
<text class="price-pending {{item.priceTemporary ? 'is-temporary' : 'is-locked'}}">{{item.priceText || priceFallback}}</text>

<text class="deal-benefit">{{item.benefit}}</text>
</view>
</view>
<button wx:if="{{item.specs && item.specs.length > 1}}" disabled="{{loggedIn && item.priceUnavailable}}" class="choose-spec quantity-first-trigger" catchtap="openQuantityPicker" data-id="{{item.id}}">{{loggedIn && item.priceUnavailable ? '暂不可售' : '选数量'}}</button>
<quantity-stepper wx:else quantity="{{item.cartQty || 0}}" disabled="{{loggedIn && item.priceUnavailable}}" compact bind:change="changeQuantity" data-id="{{item.id}}" data-spec="{{item.specLabel || item.unit}}" />
</view>
</view>
      <view class="bottom-space">
</view>
    </block>

    <block wx:elif="{{page == 'category'}}">
      <view class="sub-head">
<button bindtap="switchTab" data-tab="home">‹</button>
<view>
<text>商品分类</text>
<text>按需挑选，冷链送到家</text>
</view>
<view class="sub-head-spacer"></view>
</view>
      <view class="catalog-search">
<text>⌕</text>
<input value="{{query}}" placeholder="搜索冻品、火锅食材、早餐面点" bindinput="onSearchInput" bindconfirm="startSearch" />
<button bindtap="startSearch">搜索</button>
</view>
      <scroll-view class="major-scroll" scroll-x="true" show-scrollbar="false">
<view class="major-track">
<view class="major-item {{categoryGroup == item.id ? 'is-active' : ''}}" wx:for="{{categoryGroups}}" wx:key="id" bindtap="selectGroup" data-group="{{item.id}}">
<image src="{{item.image}}" mode="aspectFill" />
<text>{{item.label}}</text>
</view>
</view>
</scroll-view>
      <view class="catalog-layout" style="height: {{catalogHeight}};">
<scroll-view class="catalog-side" scroll-y="true" show-scrollbar="false">
<view class="side-item {{category == item ? 'is-active' : ''}}" wx:for="{{subCategories}}" wx:key="*this" bindtap="selectCategory" data-category="{{item}}">{{item}}</view>
</scroll-view>
<scroll-view class="catalog-results" scroll-y="true" scroll-top="{{catalogResultsScrollTop}}" show-scrollbar="false">
<view class="result-title">
<text>{{category == '全部' ? activeGroup.label : category}}</text>
<text>共 {{categoryProducts.length || '0'}} 件</text>
</view>
<view wx:if="{{catalogStatus == 'loading'}}" class="catalog-empty is-loading">
<text>正在加载商品</text>
<text>正在同步冷链商品目录，请稍候</text>
</view>
<view wx:elif="{{catalogStatus == 'error'}}" class="catalog-empty is-error">
<text>{{catalogErrorTitle}}</text>
<text>{{catalogErrorText}}</text>
<button bindtap="retryRemoteCatalog">重新加载</button>
</view>
<view wx:elif="{{!categoryProducts.length}}" class="catalog-empty">
<text>没有找到相关冻品</text>
<text>换个关键词，或从上方分类继续挑选</text>
</view>
<block wx:elif="{{catalogStatus == 'ready'}}">
<view class="catalog-row" wx:for="{{categoryProducts}}" wx:key="id" bindtap="openProduct" data-id="{{item.id}}">
<image src="{{item.img}}" mode="aspectFit" />
<view>
<text>{{item.name}}</text>
<text>{{item.unit}}</text>
<text wx:if="{{item.specLabel && item.specLabel != item.unit}}">规格：{{item.specLabel}}</text>
<text class="price-pending {{item.priceTemporary ? 'is-temporary' : 'is-locked'}}">{{item.priceText || priceFallback}}</text>
</view>
<button wx:if="{{item.specs && item.specs.length > 1}}" disabled="{{loggedIn && item.priceUnavailable}}" class="choose-spec quantity-first-trigger" catchtap="openQuantityPicker" data-id="{{item.id}}">{{loggedIn && item.priceUnavailable ? '暂不可售' : '选数量'}}</button>
<quantity-stepper wx:else quantity="{{item.cartQty || 0}}" disabled="{{loggedIn && item.priceUnavailable}}" compact bind:change="changeQuantity" data-id="{{item.id}}" data-spec="{{item.specLabel || item.unit}}" />
</view>
</block>
<view class="catalog-bottom-space">
</view>
</scroll-view>
</view>
    </block>

    <block wx:elif="{{page == 'frequent'}}">
<view class="sub-head">
<view>
<text>常用清单</text>
<text>{{frequentHasMultiSku ? '请逐个选择数量和规格，再加入购物车' : '把常买的好物一键加入购物车'}}</text>
</view>
</view>
<view class="frequent-banner">
<view>
<text>常买好物</text>
<text>{{frequentHasMultiSku ? '通过小面板选择数量和规格' : '一键补齐冰箱库存'}}</text>
</view>
<button wx:if="{{!frequentHasMultiSku}}" bindtap="addFrequent">全部加购</button>
<text wx:else class="frequent-spec-hint">逐个选择</text>
</view>
      <view class="simple-list">
<view class="simple-row" wx:for="{{frequent}}" wx:key="id" bindtap="openProduct" data-id="{{item.id}}">
<image src="{{item.img}}" mode="aspectFit" />
<view>
<text>{{item.name}}</text>
<text>{{item.unit}} · {{item.category}}</text>
<text class="price-pending {{item.priceTemporary ? 'is-temporary' : 'is-locked'}}">{{item.priceText || priceFallback}}</text>
</view>
<button wx:if="{{item.specs && item.specs.length > 1}}" disabled="{{loggedIn && item.priceUnavailable}}" class="choose-spec quantity-first-trigger" catchtap="openQuantityPicker" data-id="{{item.id}}">{{loggedIn && item.priceUnavailable ? '暂不可售' : '选数量'}}</button>
<quantity-stepper wx:else quantity="{{item.cartQty || 0}}" disabled="{{loggedIn && item.priceUnavailable}}" compact bind:change="changeQuantity" data-id="{{item.id}}" data-spec="{{item.specLabel || item.unit}}" />
</view>
</view>
<view class="bottom-space">
</view>
    </block>

    <block wx:elif="{{page == 'cart'}}">
      <view class="sub-head">
<view>
<text>购物车</text>
<text><text class="cart-head-count">{{cartCount}} 件</text> 商品 · {{warehouse.name}}配送</text>
</view>
<button wx:if="{{cartCount}}" class="text-btn" bindtap="clearCart">清空</button>
</view>
      <view wx:if="{{cartCount}}">
<view class="delivery-note">
<image src="/assets/icons/truck.svg" mode="aspectFit" />
<view>
<text>{{address.name ? warehouse.eta : '填写地址后确认送达时间'}}</text>
<text>配送范围、时间与费用以确认订单为准</text>
</view>
</view>
<view class="cart-list">
<view class="cart-row" wx:for="{{cartItems}}" wx:key="cartKey">
<checkbox class="cart-check" value="{{item.cartKey}}" checked="{{item.selected !== false}}" bindchange="toggleCartSelection" data-sku-id="{{item.skuId}}" data-id="{{item.id}}" data-spec="{{item.selectedSpec}}" />
<image src="{{item.img}}" mode="aspectFit" />
<view>
<text>{{item.name}}</text>
<text class="cart-spec">{{item.selectedSpec}}</text>
<text wx:if="{{item.purchaseRuleText}}" class="cart-purchase-rule">{{item.purchaseRuleText}}</text>
<text wx:if="{{item.activeTierText}}" class="cart-tier-status">{{item.activeTierText}}</text>
<text class="cart-unit-price price-pending {{item.priceTemporary ? 'is-temporary' : 'is-locked'}}">{{item.priceText ? (item.priceText + ' / 件') : priceFallback}}</text>
</view>
<view class="stepper">
<button bindtap="changeQuantity" data-id="{{item.id}}" data-spec="{{item.selectedSpec}}" data-delta="-1">−</button>
<text>{{item.qty}}</text>
<button bindtap="changeQuantity" data-id="{{item.id}}" data-spec="{{item.selectedSpec}}" data-delta="1">+</button>
</view>
</view>
</view>
<view class="cart-bottom-space"></view>
<view class="cart-total">
<view class="cart-total-copy">
<text>已选 {{selectedCartCount}} / {{cartCount}} 件</text>
<text>合计 <text>{{selectedCartTotal}}</text></text>
</view>
<button disabled="{{!selectedCartCount}}" bindtap="goCheckout">去结算</button>
</view>
</view>
<view wx:else class="empty-state">
<image src="/assets/icons/cart.svg" mode="aspectFit" />
<text>购物车还是空的</text>
<text>去首页挑一些喜欢的食材吧</text>
<button bindtap="switchTab" data-tab="home">去逛逛</button>
</view>
    </block>

    <block wx:elif="{{page == 'mine'}}">
      <view class="sub-head">
<view>
<text>我的</text>
<text>欢迎回来，今天也要好好吃饭</text>
</view>
</view>
      <view wx:if="{{!loggedIn}}">
<view class="guest-card" role="button" bindtap="openLogin">
<image src="/assets/icons/user.svg" mode="aspectFit" />
<view>
<text>微信登录</text>
<text>登录后查看订单、优惠券和收货地址</text>
</view>
<text>›</text>
</view>
<view class="guest-hint">
<text>登录后可同步账户服务</text>
<text>订单、收货地址和优惠活动会在登录后展示</text>
</view>
<view class="contact-strip" role="button" bindtap="openUtility" data-type="service">
<image src="/assets/icons/headset.svg" mode="aspectFit" />
<text>联系客服</text>
<text>咨询 ›</text>
</view>
</view>
      <view wx:else>
<view class="profile-card">
<view class="profile-top">
<view class="avatar">鲜</view>
<view>
<text>{{profileTitle}}</text>
<text>{{profileSub}}</text>
</view>
<button bindtap="openUtility" data-type="account">⚙</button>
</view>
<view class="profile-stats">
<button bindtap="openUtility" data-type="coupon">
<text>{{couponCount}}</text>
<text>优惠活动</text>
</button>
<button bindtap="openUtility" data-type="points">
<text>{{points}}</text>
<text>积分</text>
</button>
<button bindtap="openUtility" data-type="special">
<text>{{specials.length}}</text>
<text>特价好物</text>
</button>
</view>
</view>
<view class="member-banner" role="button" bindtap="openUtility" data-type="coupon">
<text>限时好价</text>
<text>家庭囤货更省心</text>
<text>查看好价 ›</text>
</view>
<view class="mine-card">
<view class="mine-title">
<text>我的订单</text>
<button bindtap="openUtility" data-type="orders">全部订单 ›</button>
</view>
<view class="order-grid">
<button bindtap="openUtility" data-type="orders" data-filter="待付款">
<image src="/assets/icons/wallet.svg" mode="aspectFit" />
<text>待付款</text>
</button>
<button bindtap="openUtility" data-type="orders" data-filter="待收货">
<image src="/assets/icons/box.svg" mode="aspectFit" />
<text>待收货</text>
<text wx:if="{{pendingReceiptCount}}" class="order-count">{{pendingReceiptCount}}</text>
</button>
<button bindtap="openUtility" data-type="aftersale">
<image src="/assets/icons/refresh.svg" mode="aspectFit" />
<text>售后/退款</text>
</button>
<button bindtap="openUtility" data-type="review">
<image src="/assets/icons/file.svg" mode="aspectFit" />
<text>评价晒单</text>
</button>
</view>
</view>
<view class="mine-card">
<text class="tool-title">常用工具</text>
<view class="tool-grid">
<button bindtap="switchTab" data-tab="frequent">
<image src="/assets/icons/list.svg" mode="aspectFit" />
<text>常购清单</text>
</button>
<button bindtap="openUtility" data-type="trace">
<image src="/assets/icons/package.svg" mode="aspectFit" />
<text>商品保障</text>
</button>
<button bindtap="openUtility" data-type="aftersale">
<image src="/assets/icons/refresh.svg" mode="aspectFit" />
<text>售后服务</text>
</button>
<button bindtap="openUtility" data-type="invoice">
<image src="/assets/icons/file.svg" mode="aspectFit" />
<text>电子发票</text>
</button>
<button bindtap="openUtility" data-type="points">
<image src="/assets/icons/coupon.svg" mode="aspectFit" />
<text>积分中心</text>
</button>
<button bindtap="openUtility" data-type="review">
<image src="/assets/icons/file.svg" mode="aspectFit" />
<text>评价晒单</text>
</button>
<button bindtap="openUtility" data-type="storedValue">
<image src="/assets/icons/wallet.svg" mode="aspectFit" />
<text>储值账户</text>
</button>
<button bindtap="openUtility" data-type="bundles">
<image src="/assets/icons/package.svg" mode="aspectFit" />
<text>套餐采购</text>
</button>
<button bindtap="openUtility" data-type="address">
<image src="/assets/icons/location.svg" mode="aspectFit" />
<text>收货地址</text>
</button>
<button bindtap="openUtility" data-type="coldchain">
<image src="/assets/icons/truck.svg" mode="aspectFit" />
<text>冷链保障</text>
</button>
<button bindtap="openUtility" data-type="about">
<image src="/assets/icons/user.svg" mode="aspectFit" />
<text>关于梦食鲜</text>
</button>
</view>
</view>
<view class="contact-panel">
<text>客服中心</text>
<text>订单、配送与商品问题可通过微信客服咨询</text>
<button bindtap="openUtility" data-type="service">进入微信客服 ›</button>
<view class="mine-legal-links">
<text data-document="terms" bindtap="openLegalDocument">用户服务协议</text>
<text data-document="privacy" bindtap="openLegalDocument">隐私政策</text>
</view>
</view>
</view>
<view class="bottom-space">
</view>
    </block>

    <block wx:elif="{{page == 'detail'}}">
      <view class="detail-head">
<button bindtap="backFromDetail">‹</button>
<text>商品详情</text>
<button bindtap="openUtility" data-type="service">
<image src="/assets/icons/headset.svg" mode="aspectFit" />
</button>
</view>
<view class="detail-product">
<view class="detail-image {{detailImageError ? 'is-error' : ''}}">
<image wx:if="{{!detailImageError}}" src="{{detailImageSrc}}" data-src="{{detailImageSrc}}" mode="aspectFit" bindload="handleDetailImageLoad" binderror="handleDetailImageError" catchtap="previewDetailImage" />
<view wx:if="{{detailImageLoading && !detailImageError}}" class="detail-image-state is-loading"><text>图片加载中</text></view>
<view wx:if="{{detailImageError}}" class="detail-image-state is-error" bindtap="retryDetailImage"><text>图片暂时无法加载</text><text>点击重试</text></view>
<text wx:if="{{!detailImageError && selectedProduct.tag && selectedProduct.tag != '待补充'}}">{{selectedProduct.tag}}</text>
</view>
<text>{{selectedProduct.name}}</text>
<text>{{selectedSpec}}</text>
<view>
<text class="detail-price price-pending {{selectedProduct.priceTemporary ? 'is-temporary' : 'is-locked'}}">{{selectedProduct.priceText || priceFallback}}</text>
<text wx:if="{{selectedProduct.activeTierText}}" class="detail-tier-status">{{selectedProduct.activeTierText}}</text>
</view>
</view>
<view wx:if="{{detailStatus == 'loading'}}" class="detail-load-state is-loading"><text>正在加载商品详情</text><text>正在核对规格与商品资料</text></view>
<view wx:elif="{{detailStatus == 'error'}}" class="detail-load-state is-error"><text>商品详情加载失败</text><text>{{detailErrorText}}</text><button bindtap="retryRemoteProductDetail">重新加载</button></view>
<block wx:if="{{detailStatus == 'ready'}}">
<view wx:if="{{detailLimited}}" class="detail-load-state is-limited"><text>商品资料待完善</text><text>{{detailErrorText}}</text></view>
<view wx:if="{{selectedProduct.specs && selectedProduct.specs.length > 1}}" class="detail-panel">
<view class="detail-quantity detail-quantity-first">
<text>购买数量</text>
<quantity-stepper quantity="{{detailDraftQty}}" disabled="{{loggedIn && selectedProduct.priceUnavailable}}" bind:change="changeDetailQuantity" />
</view>
<view class="detail-line detail-spec-heading">
<text>选择规格</text>
<text>{{selectedSpec}}</text>
</view>
<view class="spec-flow-hint">已选 {{detailDraftQty}} 件，当前规格：{{selectedSpec}}</view>
<view class="spec-list">
<button wx:for="{{selectedProduct.specs}}" wx:key="*this" class="{{selectedSpec == item ? 'is-active' : ''}}" bindtap="selectSpec" data-spec="{{item}}">{{item}}</button>
</view>
</view>
<view wx:else class="detail-panel detail-quantity single-spec">
<text>购买数量</text>
<quantity-stepper quantity="{{detailDraftQty}}" disabled="{{loggedIn && selectedProduct.priceUnavailable}}" bind:change="changeDetailQuantity" />
</view>
<view wx:if="{{selectedProduct.purchaseRuleText || selectedProduct.quantityTierRows.length}}" class="detail-panel purchase-rule-panel">
<view wx:if="{{selectedProduct.purchaseRuleText}}" class="purchase-rule-heading"><text>购买规则</text><text>{{selectedProduct.purchaseRuleText}}</text></view>
<view wx:if="{{selectedProduct.quantityTierRows.length}}" class="tier-price-list">
<view wx:for="{{selectedProduct.quantityTierRows}}" wx:key="minQuantity" wx:for-item="tier" class="tier-price-row {{tier.active ? 'is-active' : ''}}"><text>{{tier.label}}</text><text>{{tier.priceText}} / 件</text></view>
</view>
</view>
<view wx:if="{{selectedGroup}}" class="detail-panel detail-group-panel">
<view class="detail-line">
<text>拼团专场</text>
<text>{{selectedGroup.size}} 人团</text>
</view>
<text>{{selectedGroup.ends}} · 已参团 {{selectedGroup.joined}}/{{selectedGroup.size}} 人 · 拼团价不分身份</text>
<text class="price-pending is-locked">登录后查看拼团价</text>
<button class="group-buy" bindtap="joinGroup" data-product-id="{{selectedGroup.productId}}">{{selectedGroup.joined >= selectedGroup.size ? '查看成团结果' : '去拼团'}}</button>
</view>
<view class="detail-panel">
<view class="detail-line">
<text>配送</text>
<text>{{warehouse.name}} · 冷链配送 · 配送时间以确认订单为准</text>
</view>
<view class="detail-line">
<text>服务</text>
<text>全程冷链 · 商品异常请在签收后 48 小时内联系售后客服</text>
</view>
</view>
<view class="detail-panel">
<text class="detail-title">商品详情</text>
<view wx:if="{{selectedProduct.unit && selectedProduct.unit != selectedSpec}}" class="detail-line">
<text>包装规格</text>
<text>{{selectedProduct.unit}}</text>
</view>
<view class="detail-line">
<text>贮存条件</text>
<text>-18℃ 冷冻保存</text>
</view>
<view class="detail-line">
<text>温馨提示</text>
<text>开封后请尽快食用；预计送达时间以订单页面展示为准。</text>
</view>
</view>
