      <view wx:if="{{quantityPickerProduct.skuOptions && quantityPickerProduct.skuOptions.length}}" class="quantity-picker-spec-row">
        <text>购买规格</text>
        <view class="quantity-picker-specs">
          <button wx:for="{{quantityPickerProduct.skuOptions}}" wx:key="id" class="{{quantityPickerSpec == item.label ? 'is-active' : ''}} {{item.purchaseAvailable ? '' : 'is-disabled'}}" hover-class="control-pressed" disabled="{{!item.purchaseAvailable}}" bindtap="selectQuantityPickerSpec" data-spec="{{item.label}}"><text class="spec-option-face">{{item.label}}</text></button>
        </view>
      </view>
      <view class="quantity-picker-row">
        <view class="quantity-picker-quantity-copy"><text>数量</text></view>
        <view class="quantity-picker-stepper"><quantity-stepper quantity="{{quantityPickerQty}}" min="{{quantityPickerProduct.minimumQuantity || 1}}" max="{{quantityPickerProduct.maximumQuantity || 999}}" step="{{quantityPickerProduct.orderMultiple || 1}}" disabled="{{quantityPickerProduct.presentation.confirmAction == 'select' || quantityPickerProduct.presentation.confirmAction == 'disabled'}}" bind:change="changeQuantityPicker" /></view>
      </view>
      <view class="quantity-picker-actions">
        <button class="quantity-picker-confirm" hover-class="control-pressed" disabled="{{quantityPickerProduct.presentation.confirmAction == 'select' || quantityPickerProduct.presentation.confirmAction == 'disabled' || quantityPickerQty < 1}}" bindtap="addQuantityPicker"><text class="quantity-picker-action-face">{{quantityPickerProduct.presentation.confirmAction == 'select' ? '请选择可售规格' : (quantityPickerProduct.presentation.confirmAction == 'disabled' ? (quantityPickerProduct.presentation.statusText || '暂不可购买') : (quantityPickerQty < 1 ? '暂不可购买' : '加入购物车'))}}</text></button>
      </view>
    </view>
  </view>

  <view class="quick-checkout" wx:if="{{cartCount && (page == 'home' || page == 'category' || page == 'frequent' || page == 'mealIdeas' || page == 'mealIdea')}}">
<button aria-label="查看购物车，已选{{selectedCartCount}}件，{{selectedCartPriceReady ? '合计' + selectedCartTotal + '元' : '价格待确认'}}" hover-class="control-pressed" bindtap="switchTab" data-tab="cart">
<image src="/assets/icons/cart.svg" mode="aspectFit" />
<view class="quick-cart-copy">
<view class="quick-summary-line {{selectedCartPriceReady ? '' : 'is-pending'}} {{selectedCartAmountCompact ? 'is-compact' : ''}}">
<view class="quick-count-group"><text class="quick-count-label">已选</text><text class="quick-count">{{selectedCartCount}} 件</text></view>
<text class="quick-total-label">合计</text>
<text wx:if="{{selectedCartPriceReady}}" class="quick-currency">¥</text>
<text class="quick-amount">{{selectedCartTotal}}</text>
</view>
</view>
</button>
<button class="quick-checkout-action {{!selectedCartCount || !selectedCartPriceReady ? 'is-disabled' : ''}}" aria-disabled="{{!selectedCartCount || !selectedCartPriceReady}}" hover-class="control-pressed" bindtap="goCheckout"><text class="quick-checkout-action-face">{{selectedCartCount && !selectedCartPriceReady ? '暂不可结算' : '去结算'}}</text></button>
</view>
  <view class="campaign-action-bar" wx:if="{{page == 'campaign'}}">
    <text>已选 {{selectedCartCount}} 件</text>
    <view><text>活动状态</text><text>{{homeCampaign.statusText}}</text></view>
    <button hover-class="control-pressed" bindtap="returnHomeCampaign">返回首页</button>
  </view>
  <view class="detail-actions" wx:if="{{page == 'detail'}}">
<button class="detail-cart-action" disabled="{{detailStatus != 'ready' || selectedProduct.presentation.confirmAction == 'select' || selectedProduct.presentation.confirmAction == 'disabled' || detailDraftQty < 1}}" bindtap="addSelected"><text class="detail-action-face">{{detailStatus == 'loading' ? '详情加载中' : (detailStatus == 'error' ? '请先重试' : (selectedProduct.presentation.confirmAction == 'select' ? '请选择可售规格' : (selectedProduct.presentation.confirmAction == 'disabled' ? (selectedProduct.presentation.statusText || '暂不可购买') : (detailDraftQty < 1 ? '暂不可购买' : '加入购物车'))))}}</text></button>
<button class="detail-checkout-action" disabled="{{detailStatus != 'ready' || selectedProduct.presentation.confirmAction == 'select' || selectedProduct.presentation.confirmAction == 'disabled' || detailDraftQty < 1}}" bindtap="detailCheckout"><text class="detail-action-face">{{detailStatus == 'ready' && (selectedProduct.presentation.confirmAction == 'purchase' || selectedProduct.presentation.confirmAction == 'login') && detailDraftQty > 0 ? '立即结算' : '暂不可结算'}}</text></button>
</view>
  <app-tabbar
    wx:if="{{page != 'detail'}}"
    active="{{activeTab}}"
    shortcut-label="{{shortcutLabel}}"
    shortcut-icon="{{shortcutIcon}}"
    cart-count="{{cartCount}}"
    cart-pulse="{{cartPulse}}"
    bind:change="changeMainTab"
  />
<purchase-purpose
  visible="{{purchasePurposeVisible}}"
  safe-top="{{navContentTop}}"
  bind:select="selectPurchasePurpose"
  bind:skip="skipPurchasePurpose"
/>
<view wx:if="{{sessionExpiredVisible}}" class="session-expired-mask">
  <view class="session-expired-card" role="dialog" aria-label="登录状态已失效">
    <text class="session-expired-title">登录状态已失效</text>
    <text class="session-expired-copy">为保护您的价格、订单和地址信息，请重新登录后继续。</text>
    <button class="session-expired-primary" hover-class="control-pressed" bindtap="retrySessionLogin">重新登录</button>
    <button class="session-expired-secondary" hover-class="control-pressed" bindtap="cancelSessionRecovery">先返回首页</button>
  </view>
</view>
<view id="login-mask" class="login-mask {{loginVisible ? 'is-visible' : ''}}" wx:if="{{loginMounted}}" bindtap="closeLogin">
<view class="login-card {{loginVisible ? 'is-visible' : ''}}" catchtap="preventClose">
<button class="login-close" aria-label="关闭登录窗口" data-close="true" bindtap="closeLogin">×</button>
<view class="wechat-mark">微信</view>
<text>授权手机号登录</text>
<text>登录后可查看订单、优惠活动和收货地址</text>
<checkbox-group class="login-agreement" bindchange="changeAgreement">
<label aria-role="checkbox" aria-label="同意用户服务协议和隐私政策" aria-checked="{{agreed}}">
<checkbox value="agree" checked="{{agreed}}" />
<view>我已阅读并同意<text class="policy-link" data-document="terms" aria-role="link" aria-label="查看用户服务协议" catchtap="openLegalDocument">《用户服务协议》</text>和<text class="policy-link" data-document="privacy" aria-role="link" aria-label="查看隐私政策" catchtap="openLegalDocument">《隐私政策》</text></view>
</label>
</checkbox-group>
<view wx:if="{{loginErrorText}}" class="login-error login-error-{{loginStatus}}"><text>{{loginErrorText}}</text></view>
<button open-type="getPhoneNumber" bindgetphonenumber="completeLogin" loading="{{loginStatus == 'loading'}}" disabled="{{!agreed || loginStatus == 'loading'}}">{{loginStatus == 'loading' ? '登录中' : (loginStatus == 'denied' || loginStatus == 'unsupported' || loginStatus == 'failed' ? '重新授权登录' : '微信一键登录')}}</button>
</view>
</view>
</view>
