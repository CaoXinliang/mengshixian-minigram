      <block wx:elif="{{utilityType == 'trace'}}">
<view class="info-card">
<text>{{selectedProduct ? selectedProduct.name : '商品保障说明'}}</text>
<text>商品生产信息、批次号和保质期以实际出库包装为准</text>
<text>收货时请核对外包装、规格和商品状态</text>
<text>商品与配送问题可通过微信客服咨询</text>
<button open-type="contact" session-from="梦食鲜商品咨询">联系微信客服</button>
</view>
</block>
      <block wx:elif="{{utilityType == 'aftersale'}}">
<view class="info-card">
<text>售后服务说明</text>
<text>签收后如遇商品或配送问题，可通过微信客服反馈。</text>
<text>售后时效和处理标准以订单及店铺规则为准</text>
<button open-type="contact" session-from="梦食鲜售后咨询">联系微信客服</button>
</view>
</block>
      <block wx:elif="{{utilityType == 'invoice'}}">
<view class="invoice-hero">
<text>开票说明</text>
<text>在线开票服务将在订单服务接入后开放</text>
</view>
<view class="info-card">
<text>电子发票暂未开放</text>
<text>后续接入订单服务后，可在已完成订单中申请电子发票。</text>
</view>
</block>
      <block wx:elif="{{utilityType == 'points'}}">
<view class="points-hero">
<text>{{points}}</text>
<text>当前可用积分</text>
<button bindtap="dailyCheckin">{{checkedIn ? '今日已签到' : '今日签到领积分'}}</button>
</view>
</block>
      <block wx:elif="{{utilityType == 'review'}}">
<view class="info-card">
<text>暂无可评价订单</text>
<text>订单完成后，可在这里查看可评价商品。</text>
<button bindtap="openUtility" data-type="orders" data-filter="待收货">查看待收货订单</button>
</view>
</block>
      <block wx:elif="{{utilityType == 'coldchain'}}">
<view class="info-card">
<text>冷链服务说明</text>
<text>1. 冷冻商品的配送范围和服务规则以所选仓为准</text>
<text>2. 收货时请检查外包装、规格和商品状态</text>
<text>3. 商品异常可通过微信客服咨询</text>
</view>
</block>
      <block wx:elif="{{utilityType == 'about'}}">
<view class="info-card">
<text>梦食鲜冻品商城</text>
<text>面向家庭用户提供速冻面点、火锅食材、海鲜水产、调理肉制品及冷冻食品配送服务。</text>
</view>
</block>
      <block wx:elif="{{utilityType == 'faq'}}">
<view class="info-card">
<text>配送时间如何计算？</text>
<text>结算页会显示所选地址对应的预计送达时间。</text>
<text>冷冻食品如何验收？</text>
<text>请在收货时核对包装与商品状态，如有异常及时联系客服。</text>
</view>
</block>
<block wx:elif="{{utilityType == 'policy'}}">
<view class="info-card">
<text>隐私与协议</text>
<button data-document="terms" aria-label="查看用户服务协议" bindtap="openLegalDocument">查看用户服务协议</button>
<button data-document="privacy" aria-label="查看隐私政策" bindtap="openLegalDocument">查看隐私政策</button>
</view>
</block>
      <block wx:elif="{{utilityType == 'account'}}">
<view class="info-card">
<text>{{profileTitle}}</text>
<text>{{profileSub}} · {{points}} 积分</text>
<button wx:if="{{cloudModeEnabled && isApprovedBusiness}}" bindtap="openProcurementCenter">进入企业采购中心</button>
<button wx:if="{{cloudModeEnabled && canApplyBusiness}}" bindtap="openBusinessApplication">申请商家采购</button>
<text wx:if="{{cloudModeEnabled && businessStatus == 'pending'}}" class="business-pending">企业采购申请审核中</text>
<button bindtap="logout">退出登录</button>
</view>
</block>
      <block wx:elif="{{utilityType == 'businessApplication'}}">
<view class="business-form-card">
<text class="business-title">{{businessStatus == 'rejected' ? '重新提交企业资料' : '商家采购申请'}}</text>
<text class="business-copy">提交后由运营审核；审核通过后开放商家价格和采购下单。</text>
<text wx:if="{{businessStatus == 'pending'}}" class="business-pending">企业资料已提交，等待运营审核。</text>
<form wx:if="{{cloudModeEnabled && canApplyBusiness}}" class="business-form" bindsubmit="submitBusinessApplication">
<label>企业名称<input name="companyName" maxlength="120" placeholder="营业执照主体名称" /></label>
<label>统一社会信用代码<input name="unifiedCode" maxlength="30" placeholder="18 位统一社会信用代码" /></label>
<label>联系人<input name="contactName" maxlength="40" placeholder="企业采购联系人" /></label>
<label>联系人手机号<input name="contactPhone" type="number" maxlength="11" placeholder="11 位手机号码" /></label>
<button disabled="{{businessSubmitting}}" form-type="submit">{{businessSubmitting ? '提交中' : '提交申请'}}</button>
</form>
<button class="business-return-action" aria-label="返回账户信息" hover-class="control-pressed" bindtap="returnUtility">返回账户信息</button>
</view>
</block>
      <view class="tabbar-bottom-space">
</view>
    </block>
  </scroll-view>

  <view wx:if="{{quantityPickerVisible}}" class="quantity-picker-mask" style="--quantity-picker-safe-top: {{navContentTop}};" bindtap="closeQuantityPicker">
    <view class="quantity-picker" catchtap="preventClose">
      <view class="quantity-picker-head">
        <view class="quantity-picker-summary" catchtouchstart="startQuantityPickerSummarySwipe" catchtouchmove="moveQuantityPickerSummarySwipe" catchtouchend="endQuantityPickerSummarySwipe" catchtouchcancel="cancelQuantityPickerSummarySwipe">
          <image src="{{quantityPickerProduct.img}}" mode="aspectFit" aria-role="button" aria-label="查看{{quantityPickerProduct.name}}详情" hover-class="control-pressed" catchtap="openDetailFromQuantityPicker" />
          <view class="quantity-picker-product-copy">
            <text>{{quantityPickerProduct.name}}</text>
            <text class="quantity-picker-price price-pending {{quantityPickerProduct.priceTemporary ? 'is-temporary' : (!quantityPickerProduct.priceText ? 'is-locked' : '')}}">{{quantityPickerProduct.priceText || priceFallback}}</text>
          </view>
        </view>
        <button class="quantity-picker-close" aria-label="关闭选数量窗口" hover-class="control-pressed" catchtap="closeQuantityPicker"><text class="quantity-picker-close-face" aria-hidden="true">×</text></button>
      </view>
      <view wx:if="{{quantityPickerProduct.specs && quantityPickerProduct.specs.length > 1}}" class="quantity-picker-spec-row">
        <text>规格</text>
        <view class="quantity-picker-specs">
          <button wx:for="{{quantityPickerProduct.specs}}" wx:key="*this" class="{{quantityPickerSpec == item ? 'is-active' : ''}}" hover-class="control-pressed" bindtap="selectQuantityPickerSpec" data-spec="{{item}}"><text class="spec-option-face">{{item}}</text></button>
        </view>
      </view>
      <view class="quantity-picker-row">
        <view class="quantity-picker-quantity-copy"><text>数量</text><text>按需要调整</text></view>
        <view class="quantity-picker-stepper"><quantity-stepper quantity="{{quantityPickerQty}}" min="{{quantityPickerProduct.minimumQuantity || 1}}" max="{{quantityPickerProduct.maximumQuantity || 999}}" disabled="{{loggedIn && quantityPickerProduct.priceUnavailable}}" bind:change="changeQuantityPicker" /></view>
      </view>
      <view wx:if="{{quantityPickerProduct.purchaseRuleText || quantityPickerProduct.quantityTierRows.length}}" class="quantity-picker-rules">
        <text wx:if="{{quantityPickerProduct.purchaseRuleText}}">{{quantityPickerProduct.purchaseRuleText}}</text>
        <text wx:if="{{quantityPickerProduct.activeTierText}}" class="quantity-picker-tier-status">{{quantityPickerProduct.activeTierText}}</text>
        <scroll-view wx:if="{{quantityPickerProduct.quantityTierRows.length}}" class="quantity-picker-tiers" scroll-x="true" show-scrollbar="false">
          <view wx:for="{{quantityPickerProduct.quantityTierRows}}" wx:key="minQuantity" wx:for-item="tier" class="quantity-picker-tier {{tier.active ? 'is-active' : ''}}"><text>{{tier.label}}</text><text>{{tier.priceText}}{{quantityPickerProduct.priceUnitLabel ? ' / ' + quantityPickerProduct.priceUnitLabel : ''}}</text></view>
        </scroll-view>
      </view>
      <view class="quantity-picker-actions">
        <button class="quantity-picker-detail" hover-class="control-pressed" bindtap="openDetailFromQuantityPicker"><text class="quantity-picker-action-face">查看详情</text></button>
        <button class="quantity-picker-confirm" hover-class="control-pressed" disabled="{{quantityPickerProduct.purchaseRuleUnavailable || (loggedIn && quantityPickerProduct.priceUnavailable) || quantityPickerQty < 1}}" bindtap="addQuantityPicker"><text class="quantity-picker-action-face">{{loggedIn && quantityPickerProduct.priceUnavailable ? '暂不可售' : (quantityPickerProduct.purchaseRuleUnavailable || quantityPickerQty < 1 ? '暂不可购买' : '加入购物车')}}</text></button>
      </view>
    </view>
  </view>

  <view class="quick-checkout" wx:if="{{cartCount && (page == 'home' || page == 'category' || page == 'frequent' || page == 'mealIdeas' || page == 'mealIdea')}}">
<button aria-label="查看购物车，已选{{selectedCartCount}}件，{{selectedCartPriceReady ? '合计' + selectedCartTotal + '元' : '价格待确认'}}" bindtap="switchTab" data-tab="cart">
<image src="/assets/icons/cart.svg" mode="aspectFit" />
<view class="quick-cart-copy">
<view class="quick-summary-line {{selectedCartPriceReady ? '' : 'is-pending'}} {{selectedCartAmountCompact ? 'is-compact' : ''}}">
<view class="quick-count-group"><text class="quick-count-label">数量</text><text class="quick-count">{{selectedCartCount > 99 ? '99+' : selectedCartCount}} 件</text></view>
<text class="quick-total-label">合计</text>
<text wx:if="{{selectedCartPriceReady}}" class="quick-currency">¥</text>
<text class="quick-amount">{{selectedCartTotal}}</text>
</view>
</view>
</button>
<button class="quick-checkout-action" disabled="{{!selectedCartCount || !selectedCartPriceReady}}" bindtap="goCheckout">{{selectedCartCount && !selectedCartPriceReady ? '待定价' : '去结算'}}</button>
</view>
  <view class="detail-actions" wx:if="{{page == 'detail'}}">
<button disabled="{{detailStatus != 'ready' || selectedProduct.purchaseRuleUnavailable || (loggedIn && selectedProduct.priceUnavailable) || detailDraftQty < 1}}" bindtap="addSelected">{{detailStatus == 'loading' ? '详情加载中' : (detailStatus == 'error' ? '请先重试' : (loggedIn && selectedProduct.priceUnavailable ? '暂不可售' : (selectedProduct.purchaseRuleUnavailable || detailDraftQty < 1 ? '暂不可购买' : '加入购物车')))}}</button>
<button disabled="{{detailStatus != 'ready' || selectedProduct.purchaseRuleUnavailable || (loggedIn && selectedProduct.priceUnavailable) || detailDraftQty < 1}}" bindtap="detailCheckout">{{detailStatus == 'ready' && !selectedProduct.purchaseRuleUnavailable && !(loggedIn && selectedProduct.priceUnavailable) && detailDraftQty > 0 ? '立即结算' : '暂不可结算'}}</button>
</view>
  <view class="checkout-action-bar" wx:if="{{page == 'utility' && utilityType == 'checkout'}}">
<view class="submit-order {{checkoutQuoteState == 'ready' ? '' : 'is-disabled'}}" aria-role="button" aria-label="{{checkoutQuoteState == 'ready' ? '提交订单' : '正在计算订单金额'}}" hover-class="control-pressed" bindtap="placeOrder">{{checkoutQuoteState == 'ready' ? '提交订单' : '正在计算订单金额'}}</view>
</view>
  <view class="tabbar" wx:if="{{page != 'detail' && !(page == 'utility' && (utilityType == 'checkout' || utilityType == 'demoPayment'))}}">
<button aria-label="首页" aria-pressed="{{activeTab == 'home'}}" hover-class="control-pressed" class="{{activeTab == 'home' ? 'is-active' : ''}}" bindtap="switchTab" data-tab="home">
<image src="/assets/icons/home.svg" mode="aspectFit" />
<text>首页</text>
</button>
<button aria-label="分类" aria-pressed="{{activeTab == 'category'}}" hover-class="control-pressed" class="{{activeTab == 'category' ? 'is-active' : ''}}" bindtap="switchTab" data-tab="category">
<image src="/assets/icons/grid.svg" mode="aspectFit" />
<text>分类</text>
</button>
<button aria-label="{{shortcutLabel}}" aria-pressed="{{activeTab == 'frequent'}}" hover-class="control-pressed" class="{{activeTab == 'frequent' ? 'is-active' : ''}}" bindtap="switchTab" data-tab="frequent">
<image src="{{shortcutIcon}}" mode="aspectFit" />
<text>{{shortcutLabel}}</text>
</button>
<button aria-label="购物车，共 {{cartCount}} 件商品" aria-pressed="{{activeTab == 'cart'}}" hover-class="control-pressed" class="{{activeTab == 'cart' ? 'is-active' : ''}}" bindtap="switchTab" data-tab="cart">
<view class="cart-tab-icon {{cartPulse ? 'is-pulsing' : ''}}">
<image src="/assets/icons/cart.svg" mode="aspectFit" />
<text wx:if="{{cartCount}}">{{cartCount > 99 ? '99+' : cartCount}}</text>
</view>
<text>购物车</text>
</button>
<button aria-label="我的" aria-pressed="{{activeTab == 'mine'}}" hover-class="control-pressed" class="{{activeTab == 'mine' ? 'is-active' : ''}}" bindtap="switchTab" data-tab="mine">
<image src="/assets/icons/user.svg" mode="aspectFit" />
<text>我的</text>
</button>
</view>
<view id="login-mask" class="login-mask {{loginVisible ? 'is-visible' : ''}}" wx:if="{{loginMounted}}" bindtap="closeLogin">
<view class="login-card {{loginVisible ? 'is-visible' : ''}}" catchtap="preventClose">
<button class="login-close" aria-label="关闭登录窗口" data-close="true" bindtap="closeLogin">×</button>
<view class="wechat-mark">微信</view>
<text>授权手机号登录</text>
<text>登录后可查看订单、优惠活动和收货地址</text>
<checkbox-group class="login-agreement" bindchange="changeAgreement">
<label aria-role="checkbox" aria-label="同意用户服务协议和隐私政策" aria-checked="{{agreed}}">
<checkbox value="agree" checked="{{agreed}}" />
<view>我已阅读并同意<text class="policy-link" data-document="terms" aria-role="link" aria-label="查看用户服务协议" catchtap="openLegalDocument">《用户服务协议》</text>和<text class="policy-link" data-document="privacy" aria-role="link" aria-label="查看隐私政策" catchtap="openLegalDocument">《隐私政策》</text></view>
</label>
</checkbox-group>
<button open-type="getPhoneNumber" bindgetphonenumber="completeLogin" disabled="{{!agreed}}">微信一键登录</button>
</view>
</view>
</view>
