<template name="homeHeroHeader">
  <view class="home-header">
    <view class="top-safe" style="height: {{navSafeHeight}};"></view>
    <view class="store-row">
      <button class="location-button" aria-label="切换配送仓库，当前为{{warehouse.name}}" hover-class="control-pressed" bindtap="openUtility" data-type="warehouse">
        <view class="location-name">{{warehouse.name || '选择仓库'}}</view>
      </button>
      <view class="brand">
        <text>梦食鲜</text>
      </view>
      <view class="nav-right-space"></view>
    </view>
    <view class="search-row">
      <view class="home-search-field">
      <image src="/assets/icons/search.svg" mode="aspectFit" />
      <input value="{{query}}" placeholder="搜索商品" placeholder-class="search-placeholder" confirm-type="search" bindinput="onSearchInput" bindconfirm="startSearch" />
      </view>
      <button hover-class="control-pressed" bindtap="startSearch"><text class="search-action-face">搜索</text></button>
    </view>
  </view>
</template>

<view class="app-shell {{page == 'home' ? 'is-home' : ''}} {{motionReduced ? 'is-motion-reduced' : ''}}" style="{{fixedLayerStyle}}">
  <scroll-view class="page-scroll {{pageMotion ? 'is-page-entering' : ''}}" style="height: {{page == 'home' || page == 'campaign' ? '100vh' : pageViewportHeight}}; margin-top: {{page == 'home' || page == 'campaign' ? '0rpx' : navContentTop}};" scroll-y="true" scroll-top="{{pageScrollTop}}" bindscroll="onPageContentScroll" enhanced="true" show-scrollbar="false">
    <block wx:if="{{page == 'home'}}">
      <template is="homeHeroHeader" data="{{warehouse: warehouse, navSafeHeight: navSafeHeight, query: searchDraft}}" />
      <view wx:if="{{homeViewShowBlockingState}}" class="home-blocking-state">
        <content-state
          layout="home-blocking"
          tone="{{homeViewStatus == 'error' ? 'error' : (homeViewStatus == 'empty' ? 'empty' : 'loading')}}"
          title="{{homeViewStateTitle}}"
          message="{{homeViewStateMessage}}"
          action-label="{{homeViewStateActionLabel}}"
          bind:action="retryHomeContent"
        />
      </view>
      <block wx:else>
      <swiper wx:if="{{bannerItems.length}}" class="home-hero-swiper" autoplay="true" interval="4500" circular="true" indicator-dots="{{bannerItems.length > 1}}" indicator-color="rgba(255,255,255,.55)" indicator-active-color="#fff">
        <swiper-item wx:for="{{bannerItems}}" wx:key="headline">
          <view class="home-hero-slide">
            <view class="banner-slide">
              <image class="{{item.imageUnavailable ? 'is-media-unavailable' : ''}}" src="{{item.image}}" mode="{{item.imageUnavailable ? 'aspectFit' : 'aspectFill'}}" binderror="handleBannerImageError" data-index="{{index}}" data-src="{{item.image}}" />
              <view class="banner-shade"></view>
              <view class="banner-copy">
                <text>{{item.eyebrow}}</text>
                <text>{{item.headline}}</text>
                <text>{{item.subline}}</text>
              </view>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <swiper wx:else class="home-hero-swiper" autoplay="{{false}}" circular="{{false}}" indicator-dots="{{false}}">
        <swiper-item>
          <view class="home-hero-slide">
            <view class="banner-empty">
              <image src="/assets/products/frozen-hero-v2.jpg" mode="aspectFill" />
              <view class="banner-shade"></view>
              <view class="banner-copy">
                <text>精选冻品 · 冷链严选</text>
                <text>鲜冻好物\n悦享团圆</text>
                <text>配送范围与费用在下单前确认</text>
              </view>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view class="home-categories">
<block wx:if="{{homeCategories.length}}">
<view class="home-category" wx:for="{{homeCategories}}" wx:key="label" aria-role="button" aria-label="查看{{item.label}}分类" hover-class="control-pressed" bindtap="openCategory" data-category="{{item.label}}">
<view class="home-category-icon"><image src="{{item.icon || item.image}}" mode="aspectFit" /></view>
<text>{{item.label}}</text>
</view>
</block>
<block wx:elif="{{catalogStatus == 'loading'}}">
<view class="home-category is-skeleton" wx:for="{{homeCategorySkeletons}}" wx:key="id" aria-hidden="true"><view class="home-category-skeleton-face"></view><view class="home-category-skeleton-label"></view></view>
</block>
<view wx:else class="home-category-state"><text>分类暂时无法显示</text></view>
</view>
      <view wx:if="{{specialSectionEntryEnabled}}" class="section-heading home-module-entry" aria-role="button" aria-label="打开{{specialTitle}}" hover-class="control-pressed" bindtap="openHomeSection" data-section-type="special">
<view><text>{{specialTitle}}</text></view>
<text class="home-module-entry__chevron">›</text>
      </view>
      <view wx:else class="section-heading">
<view><text>{{specialTitle}}</text></view>
      </view>
      <view class="deal-list">
<view wx:if="{{homeViewStatus == 'refresh-error'}}" class="home-load-state home-refresh-error"><text>{{homeViewStateMessage}}</text><button hover-class="control-pressed" bindtap="retryHomeContent">重新加载首页</button></view>
<block wx:if="{{specials.length}}">
<product-card
  wx:for="{{specials}}"
  wx:key="id"
  product-id="{{item.id}}"
  name="{{item.name}}"
  spec-label="{{item.specLabel || item.unit}}"
  image-src="{{item.img || '/assets/products/placeholder.svg'}}"
  tag="{{item.tag || ''}}"
  price-text="{{loggedIn ? (item.priceText || '') : ''}}"
  price-unit-label="{{loggedIn && item.priceText ? item.priceUnitLabel : ''}}"
  price-label="{{loggedIn ? priceFallback : '登录后查看价格'}}"
  price-state="{{!loggedIn || !item.priceText ? 'locked' : (item.priceTemporary ? 'temporary' : 'ready')}}"
  status-text="{{item.presentation.statusText || ''}}"
  action-label="{{loggedIn ? (item.specSelectionText || '选规格') : '选规格'}}"
  action-disabled="{{item.presentation.action == 'disabled'}}"
  action-mode="{{item.presentation.action == 'quantity' ? 'quantity' : 'select'}}"
  quantity="{{item.cartQty || 0}}"
  minimum="{{item.minimumQuantity || 1}}"
  maximum="{{item.maximumQuantity || 999}}"
  multiple="{{item.orderMultiple || 1}}"
  wide-price="{{loggedIn && item.priceText && item.priceText.length >= 9}}"
  bind:open="openProductFromCard"
  bind:choose="chooseProductFromCard"
  bind:change="changeProductPurchaseQuantity"
  bind:mediaerror="handleProductCardMediaError"
/>
</block>
<block wx:elif="{{catalogStatus == 'loading'}}">
<view class="deal-card deal-card-skeleton" aria-hidden="true"><view class="deal-skeleton-photo"></view><view class="deal-skeleton-copy"><view></view><view></view><view></view></view><view class="deal-skeleton-action"></view></view>
<view class="deal-card deal-card-skeleton" aria-hidden="true"><view class="deal-skeleton-photo"></view><view class="deal-skeleton-copy"><view></view><view></view><view></view></view><view class="deal-skeleton-action"></view></view>
</block>
<content-state wx:elif="{{catalogStatus == 'error'}}" tone="error" title="{{catalogErrorTitle}}" message="{{catalogErrorText}}" action-label="重新加载商品" bind:action="retryRemoteCatalog" />
<content-state wx:else tone="empty" title="暂时没有特价商品" message="商品上架后会在这里显示" />
</view>
      </block>
      <view class="tabbar-bottom-space {{cartCount ? 'has-quick-checkout' : ''}}">
</view>
    </block>

    <block wx:elif="{{page == 'campaign'}}">
      <view class="campaign-page">
        <view class="campaign-header">
          <view class="top-safe" style="height: {{navSafeHeight}};"></view>
          <view class="store-row">
            <button class="location-button" aria-label="切换配送仓库，当前为{{warehouse.name}}" hover-class="control-pressed" bindtap="openUtility" data-type="warehouse"><view class="location-name">{{warehouse.name || '选择仓库'}}</view></button>
            <view class="brand"><text>{{homeCampaign.title}}</text></view>
            <view class="nav-right-space"></view>
          </view>
          <view class="campaign-search-row">
            <view class="campaign-search-field"><image src="/assets/icons/search.svg" mode="aspectFit" /><input value="{{campaignQuery}}" placeholder="搜索活动商品" placeholder-class="search-placeholder" confirm-type="search" bindinput="onCampaignSearchInput" bindconfirm="searchCampaignProducts" /></view>
            <button hover-class="control-pressed" bindtap="searchCampaignProducts"><text>搜索</text></button>
          </view>
        </view>

        <view class="campaign-hero {{homeCampaign.imageUnavailable || !homeCampaign.image ? 'is-media-unavailable' : ''}}">
          <image wx:if="{{homeCampaign.image}}" src="{{homeCampaign.image}}" mode="aspectFill" />
          <view class="campaign-hero-shade"></view>
          <view class="campaign-hero-copy">
            <text>{{homeCampaign.title}}</text>
            <text wx:if="{{homeCampaign.periodText}}">{{homeCampaign.periodText}}</text>
          </view>
        </view>

        <view class="home-categories campaign-categories">
          <view class="home-category" wx:for="{{homeCategories}}" wx:key="label" aria-role="button" aria-label="查看{{item.label}}分类" hover-class="control-pressed" bindtap="openCategory" data-category="{{item.label}}">
            <view class="home-category-icon"><image src="{{item.icon || item.image}}" mode="aspectFit" /></view>
            <text>{{item.label}}</text>
          </view>
        </view>

        <view class="campaign-section-title"><text>活动规则</text></view>
        <view wx:if="{{homeCampaign.rules.length}}" class="campaign-rules">
          <text wx:for="{{homeCampaign.rules}}" wx:key="*this">{{item}}</text>
        </view>
        <view wx:if="{{homeCampaign.categoryLabel}}" class="campaign-category-link" aria-role="button" hover-class="control-pressed" bindtap="openCategory" data-category="{{homeCampaign.categoryLabel}}">
          <text>活动分类</text><text>{{homeCampaign.categoryLabel}} ›</text>
        </view>

        <view class="campaign-products">
          <content-state wx:if="{{campaignProductsLoading}}" tone="loading" title="正在读取活动商品" message="请稍候" />
          <content-state wx:elif="{{campaignProductsError}}" tone="error" title="活动商品加载失败" message="请检查网络后重试" action-label="重新加载" bind:action="retryCampaignProducts" />
          <block wx:elif="{{campaignProducts.length}}">
            <product-card
              wx:for="{{campaignProducts}}"
              wx:key="id"
              product-id="{{item.id}}"
              name="{{item.name}}"
              spec-label="{{item.specLabel || item.unit}}"
              image-src="{{item.img || '/assets/products/placeholder.svg'}}"
              tag="{{item.tag || ''}}"
              price-text="{{loggedIn ? (item.priceText || '') : ''}}"
              price-unit-label="{{loggedIn && item.priceText ? item.priceUnitLabel : ''}}"
              price-label="{{loggedIn ? priceFallback : '登录后查看价格'}}"
              price-state="{{!loggedIn || !item.priceText ? 'locked' : (item.priceTemporary ? 'temporary' : 'ready')}}"
              status-text="{{item.presentation.statusText || ''}}"
              action-label="{{loggedIn ? (item.specSelectionText || '选规格') : '选规格'}}"
              action-disabled="{{item.presentation.action == 'disabled'}}"
              action-mode="{{item.presentation.action == 'quantity' ? 'quantity' : 'select'}}"
              quantity="{{item.cartQty || 0}}"
              minimum="{{item.minimumQuantity || 1}}"
              maximum="{{item.maximumQuantity || 999}}"
              multiple="{{item.orderMultiple || 1}}"
              wide-price="{{loggedIn && item.priceText && item.priceText.length >= 9}}"
              bind:open="openCampaignProduct"
              bind:choose="chooseCampaignProduct"
              bind:change="changeProductPurchaseQuantity"
              bind:mediaerror="handleProductCardMediaError"
            />
          </block>
          <content-state wx:elif="{{campaignQuery}}" tone="empty" title="没有找到相关活动商品" message="请尝试其他关键词" />
          <content-state wx:else tone="empty" title="暂无可展示的活动商品" message="活动商品由后台配置，您仍可查看其他分类" />
        </view>
        <view class="campaign-bottom-space"></view>
      </view>
    </block>

    <block wx:elif="{{page == 'category'}}">
      <view class="sub-head catalog-head">
<button wx:if="{{searchMode}}" class="back-control" aria-label="返回搜索来源" bindtap="exitSearch">‹</button>
<view wx:else class="catalog-location"><text>{{warehouse.name}}</text></view>
<text class="catalog-title">{{searchMode ? '搜索商品' : '商品分类'}}</text>
<view class="sub-head-spacer"></view>
</view>
      <view class="catalog-search">
<view class="catalog-search-field">
<text>⌕</text>
<input value="{{searchDraft}}" placeholder="搜索冻品、火锅食材、早餐面点" confirm-type="search" bindinput="onSearchInput" bindconfirm="startSearch" />
</view>
<button wx:if="{{searchMode}}" bindtap="clearSearchKeyword"><text class="catalog-search-action-face">清空</text></button>
<button wx:else bindtap="startSearch"><text class="catalog-search-action-face">搜索</text></button>
</view>
      <view wx:if="{{searchMode}}" class="recent-searches">
<view class="recent-searches-head"><text>最近搜索</text><button wx:if="{{recentSearches.length}}" bindtap="clearRecentSearches">清除记录</button></view>
<scroll-view wx:if="{{recentSearches.length}}" class="recent-searches-scroll" scroll-x="true" show-scrollbar="false">
<view class="recent-searches-track"><button wx:for="{{recentSearches}}" wx:key="*this" bindtap="selectRecentSearch" data-keyword="{{item}}">{{item}}</button></view>
</scroll-view>
<text wx:else class="recent-searches-empty">暂无最近搜索</text>
      </view>
      <scroll-view wx:else class="major-scroll" scroll-x="true" show-scrollbar="false">
<view class="major-track">
<view class="major-item {{categoryGroup == item.id ? 'is-active' : ''}}" wx:for="{{categoryGroups}}" wx:key="id" aria-role="button" aria-pressed="{{categoryGroup == item.id}}" aria-label="选择{{item.label}}" hover-class="control-pressed" bindtap="selectGroup" data-group="{{item.id}}">
<view class="major-icon"><image src="{{item.icon || item.image}}" mode="aspectFit" /></view>
<text>{{item.label}}</text>
</view>
</view>
      </scroll-view>
      <view class="catalog-layout" style="height: {{catalogHeight}};">
<scroll-view wx:if="{{searchMode}}" class="catalog-side search-side" scroll-y="true" enhanced="true" show-scrollbar="false">
<block wx:for="{{searchCategorySuggestions}}" wx:key="id">
<view wx:if="{{item.type == 'results'}}" class="side-item is-active">{{item.label}}</view>
<view wx:else class="side-item" aria-role="button" aria-label="查看{{item.label}}" hover-class="control-pressed" bindtap="selectSearchCategory" data-category="{{item.category}}">{{item.label}}</view>
</block>
</scroll-view>
<scroll-view wx:else class="catalog-side" scroll-y="true" enhanced="true" show-scrollbar="false">
<view class="side-item {{category == item ? 'is-active' : ''}}" wx:for="{{subCategories}}" wx:key="*this" aria-role="button" aria-pressed="{{category == item}}" aria-label="选择{{item}}" hover-class="control-pressed" bindtap="selectCategory" data-category="{{item}}">{{item}}</view>
</scroll-view>
<scroll-view class="catalog-results" scroll-y="true" scroll-top="{{catalogResultsScrollTop}}" bindscroll="onCatalogResultsScroll" show-scrollbar="false">
<view class="result-title">
<text>{{searchMode ? '搜索结果' : (category == '全部' ? activeGroup.label : category)}}</text>
<text wx:if="{{catalogBrowseLoading}}">正在加载…</text>
<text wx:else>共 {{categoryProducts.length || '0'}} 件</text>
</view>
<view wx:if="{{catalogStatus == 'loading'}}" class="catalog-empty is-loading">
<text>正在加载商品</text>
</view>
<view wx:elif="{{catalogStatus == 'error'}}" class="catalog-empty is-error">
<text>{{catalogErrorTitle}}</text>
<text>{{catalogErrorText}}</text>
<button bindtap="retryRemoteCatalog">重新加载</button>
</view>
<view wx:elif="{{catalogBrowseLoading && !categoryProducts.length}}" class="catalog-empty is-loading">
<text>正在查找商品</text>
<text>结果到达后会立即显示</text>
</view>
<view wx:elif="{{catalogBrowseError && !categoryProducts.length}}" class="catalog-empty is-error">
<text>{{catalogBrowseError}}</text>
<text>关键词和筛选已保留</text>
<button hover-class="control-pressed" bindtap="retryCatalogBrowse">重试</button>
</view>
<view wx:elif="{{searchMode && !query}}" class="catalog-empty search-empty">
<text>输入关键词开始搜索</text>
<text>也可以从左侧真实分类继续浏览</text>
<view class="catalog-empty-actions"><button hover-class="control-pressed" bindtap="viewAllCategoriesFromSearch">查看分类</button></view>
</view>
<view wx:elif="{{!categoryProducts.length}}" class="catalog-empty search-empty">
<text>{{searchMode ? '没有找到相关商品' : '没有找到相关冻品'}}</text>
<text>{{searchMode ? '清除关键词，或从真实分类继续挑选' : '换个关键词，或从上方分类继续挑选'}}</text>
<view wx:if="{{searchMode}}" class="catalog-empty-actions">
<button hover-class="control-pressed" bindtap="clearSearchKeyword">清除筛选</button>
<button hover-class="control-pressed" bindtap="viewAllCategoriesFromSearch">查看分类</button>
</view>
<view wx:else class="catalog-empty-actions">
<button hover-class="control-pressed" bindtap="clearCategoryFilters">清除当前分类</button>
</view>
</view>
<block wx:elif="{{catalogStatus == 'ready'}}">
<view class="catalog-row {{item.catalogPriceWide ? 'has-wide-price' : ''}}" wx:for="{{categoryProducts}}" wx:key="id">
<image src="{{item.img || '/assets/products/placeholder.svg'}}" mode="aspectFit" aria-hidden="true" hover-class="control-pressed" bindtap="openProduct" binderror="handleCatalogImageError" data-id="{{item.id}}" />
<view aria-role="button" aria-label="查看商品：{{item.name}}" hover-class="control-pressed" bindtap="openProduct" data-id="{{item.id}}">
<text class="catalog-item-name">{{item.name}}</text>
<text class="catalog-item-spec">{{item.specLabel || item.unit}}</text>
<text wx:if="{{!item.catalogPriceWide}}" class="catalog-item-price price-pending {{!item.priceText ? 'is-locked' : (item.priceTemporary ? 'is-temporary' : '')}}">{{item.priceText || priceFallback}}</text>
<text wx:if="{{item.presentation.statusText && item.presentation.action == 'disabled'}}" class="catalog-item-status">{{item.presentation.statusText}}</text>
</view>
<text wx:if="{{item.catalogPriceWide}}" class="catalog-wide-price price-pending {{item.priceTemporary ? 'is-temporary' : ''}}" bindtap="openProduct" data-id="{{item.id}}">{{item.priceText}}</text>
<product-purchase-action
  mode="{{(item.specs && item.specs.length > 1) || (loggedIn && item.specSelectionUnavailable) ? 'select' : 'quantity'}}"
  product-id="{{item.id}}"
  spec-label="{{item.specLabel || item.unit}}"
  action-label="{{loggedIn ? (item.specSelectionText || '选规格') : '选规格'}}"
  quantity="{{item.cartQty || 0}}"
  minimum="{{item.minimumQuantity || 1}}"
  maximum="{{item.maximumQuantity || 999}}"
  multiple="{{item.orderMultiple || 1}}"
  disabled="{{item.presentation.action == 'disabled'}}"
  bind:choose="chooseProductFromCard"
  bind:change="changeProductPurchaseQuantity"
/>
</view>
</block>
<view wx:if="{{catalogBrowseLoading && categoryProducts.length}}" class="catalog-inline-status is-loading">正在补充更多商品…</view>
<view wx:if="{{catalogBrowseError && categoryProducts.length}}" class="catalog-inline-status is-error"><text>{{catalogBrowseError}}</text><button hover-class="control-pressed" bindtap="retryCatalogBrowse">重试</button></view>
<view class="catalog-bottom-space {{cartCount ? 'has-quick-checkout' : ''}}">
</view>
</scroll-view>
</view>
    </block>

    <block wx:elif="{{page == 'mealIdeas' || page == 'mealIdea'}}">
      <meal-experience-panel
        mode="{{page == 'mealIdea' ? 'detail' : 'list'}}"
        ideas="{{mealIdeas}}" rows="{{mealIdeaRows}}" status="{{mealIdeasStatus}}" error-text="{{mealIdeasErrorText}}"
        scenes="{{mealScenes}}" active-scene="{{mealScene}}" can-shuffle="{{mealCanShuffle}}"
        selected-idea="{{selectedMealIdea}}" video-status="{{mealVideoStatus}}" video-src="{{mealVideoSrc}}" video-cover="{{mealVideoCover}}" video-error-text="{{mealVideoErrorText}}" cart-count="{{cartCount}}" motion-reduced="{{motionReduced}}"
        bind:selectscene="selectMealScene" bind:shuffle="shuffleMealIdeas" bind:openidea="openMealIdea" bind:retrycollection="retryRemoteMealIdeas"
        bind:back="backToMealIdeas" bind:retryvideo="retryMealVideo" bind:videoplay="handleMealVideoPlay" bind:videopause="handleMealVideoPause" bind:videowaiting="handleMealVideoWaiting" bind:videoerror="handleMealVideoError" bind:videofullscreen="handleMealVideoFullscreenChange"
        bind:mediaerror="handleMealCoverError" bind:openproduct="openProduct"
      />
    </block>

    <block wx:elif="{{page == 'frequent'}}">
<view class="sub-head">
<view>
<text>常购清单</text>
<text>快速补货</text>
</view>
</view>
<view class="frequent-banner">
<view>
<text>高频采购</text>
</view>
<button wx:if="{{!frequentHasMultiSku}}" bindtap="addFrequent">全部加购</button>
<text wx:else class="frequent-spec-hint">逐个选择</text>
</view>
      <view class="simple-list">
<view class="simple-row" wx:for="{{frequent}}" wx:key="id">
<image src="{{item.img || '/assets/products/placeholder.svg'}}" mode="aspectFit" aria-hidden="true" hover-class="control-pressed" bindtap="openProduct" data-id="{{item.id}}" />
<view aria-role="button" aria-label="查看商品：{{item.name}}" hover-class="control-pressed" bindtap="openProduct" data-id="{{item.id}}">
<text>{{item.name}}</text>
<text>{{item.specLabel || item.unit}}</text>
<text class="price-pending {{!item.priceText ? 'is-locked' : (item.priceTemporary ? 'is-temporary' : '')}}">{{item.priceText || priceFallback}}</text>
</view>
<button wx:if="{{(item.specs && item.specs.length > 1) || (loggedIn && item.specSelectionUnavailable)}}" disabled="{{loggedIn && item.specSelectionUnavailable}}" class="choose-spec quantity-first-trigger {{loggedIn && item.specSelectionUnavailable ? 'is-unavailable' : ''}}" hover-class="control-pressed" catchtap="openQuantityPicker" data-id="{{item.id}}"><text class="choose-spec-face">{{loggedIn ? item.specSelectionText : '选规格'}}</text></button>
<quantity-stepper wx:else quantity="{{item.cartQty || 0}}" min="{{item.minimumQuantity || 1}}" max="{{item.maximumQuantity || 999}}" step="{{item.orderMultiple || 1}}" allow-zero="{{true}}" disabled="{{item.presentation.action == 'disabled'}}" compact bind:change="changeQuantity" data-id="{{item.id}}" data-spec="{{item.specLabel || item.unit}}" />
</view>
</view>
<view class="tabbar-bottom-space {{cartCount ? 'has-quick-checkout' : ''}}">
</view>
    </block>

    <block wx:elif="{{page == 'cart'}}">
      <cart-panel
        cart-status="{{cartStatus}}"
        cart-error-text="{{cartErrorText}}"
        cart-items="{{cartItems}}"
        cart-count="{{cartCount}}"
        warehouse-name="{{warehouse.name}}"
        warehouse-eta="{{warehouse.eta}}"
        has-address="{{address.name}}"
        address-name="{{address.name}}"
        address-masked="{{address.masked}}"
        address-detail="{{address.detail}}"
        all-cart-selected="{{allCartSelected}}"
        selectable-cart-count="{{selectableCartCount}}"
        selected-cart-count="{{selectedCartCount}}"
        selected-cart-total="{{selectedCartTotal}}"
        selected-cart-price-ready="{{selectedCartPriceReady}}"
        price-fallback="{{priceFallback}}"
        bind:clear="clearCart"
        bind:retry="loadRemoteCart"
        bind:address="openCartAddress"
        bind:toggleall="toggleCartSelectAll"
        bind:togglerow="handleCartPanelRowSelection"
        bind:quantitychange="handleCartPanelQuantityChange"
        bind:checkout="goCheckout"
        bind:browse="browseFromCartPanel"
      />
    </block>

    <block wx:elif="{{page == 'mine'}}">
      <member-home-panel style="display:block;width:100%;"
