</view>
  <view class="detail-actions" wx:if="{{page == 'detail'}}">
<button disabled="{{detailStatus != 'ready' || selectedProduct.purchaseRuleUnavailable || (loggedIn && selectedProduct.priceUnavailable) || detailDraftQty < 1}}" bindtap="addSelected">{{detailStatus == 'loading' ? '详情加载中' : (detailStatus == 'error' ? '请先重试' : (loggedIn && selectedProduct.priceUnavailable ? '暂不可售' : (selectedProduct.purchaseRuleUnavailable || detailDraftQty < 1 ? '规则不可用' : '加入购物车')))}}</button>
<button disabled="{{detailStatus != 'ready' || selectedProduct.purchaseRuleUnavailable || (loggedIn && selectedProduct.priceUnavailable) || detailDraftQty < 1}}" bindtap="detailCheckout">{{detailStatus == 'ready' && !selectedProduct.purchaseRuleUnavailable && !(loggedIn && selectedProduct.priceUnavailable) && detailDraftQty > 0 ? '立即结算' : '暂不可结算'}}</button>
</view>
  <view class="checkout-action-bar" wx:if="{{page == 'utility' && utilityType == 'checkout'}}">
<view class="submit-order {{checkoutQuoteState == 'ready' ? '' : 'is-disabled'}}" role="button" bindtap="placeOrder">{{checkoutQuoteState == 'ready' ? '确认订单并进入支付确认' : '正在核验本次报价'}}</view>
</view>
  <view class="checkout-action-bar" wx:if="{{page == 'utility' && utilityType == 'demoPayment'}}">
<view class="submit-order" role="button" bindtap="finishDemoPayment">完成支付确认</view>
</view>
  <view class="tabbar" wx:if="{{page != 'detail' && !(page == 'utility' && (utilityType == 'checkout' || utilityType == 'demoPayment'))}}">
<button class="{{activeTab == 'home' ? 'is-active' : ''}}" bindtap="switchTab" data-tab="home">
<image src="/assets/icons/home.svg" mode="aspectFit" />
<text>首页</text>
</button>
<button class="{{activeTab == 'category' ? 'is-active' : ''}}" bindtap="switchTab" data-tab="category">
<image src="/assets/icons/grid.svg" mode="aspectFit" />
<text>分类</text>
</button>
<button class="{{activeTab == 'frequent' ? 'is-active' : ''}}" bindtap="switchTab" data-tab="frequent">
<image src="/assets/icons/list.svg" mode="aspectFit" />
<text>常用清单</text>
</button>
<button class="{{activeTab == 'cart' ? 'is-active' : ''}}" bindtap="switchTab" data-tab="cart">
<view class="cart-tab-icon {{cartPulse ? 'is-pulsing' : ''}}">
<image src="/assets/icons/cart.svg" mode="aspectFit" />
<text wx:if="{{cartCount}}">{{cartCount}}</text>
</view>
<text>购物车</text>
</button>
<button class="{{activeTab == 'mine' ? 'is-active' : ''}}" bindtap="switchTab" data-tab="mine">
<image src="/assets/icons/user.svg" mode="aspectFit" />
<text>我的</text>
</button>
</view>
<view id="login-mask" class="login-mask {{loginVisible ? 'is-visible' : ''}}" wx:if="{{loginMounted}}" bindtap="closeLogin">
<view class="login-card {{loginVisible ? 'is-visible' : ''}}" catchtap="preventClose">
<button class="login-close" data-close="true" bindtap="closeLogin">×</button>
<view class="wechat-mark">微信</view>
<text>授权手机号登录</text>
<text>登录后可查看订单、优惠活动和收货地址</text>
<checkbox-group class="login-agreement" bindchange="changeAgreement">
<label>
<checkbox value="agree" checked="{{agreed}}" />
<view>我已阅读并同意<text class="policy-link" data-document="terms" catchtap="openLegalDocument">《用户服务协议》</text>和<text class="policy-link" data-document="privacy" catchtap="openLegalDocument">《隐私政策》</text></view>
</label>
</checkbox-group>
<button open-type="getPhoneNumber" bindgetphonenumber="completeLogin" disabled="{{!agreed}}">微信一键登录</button>
</view>
</view>
</view>
