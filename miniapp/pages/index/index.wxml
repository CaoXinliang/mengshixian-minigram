<template name="homeHeroHeader">
  <view class="home-header">
    <view class="top-safe" style="height: {{navSafeHeight}};"></view>
    <view class="store-row">
      <button class="location-button" aria-label="切换配送仓库，当前为{{warehouse.name}}" hover-class="control-pressed" bindtap="openUtility" data-type="warehouse">
        <view class="location-name">{{warehouse.name}}</view>
      </button>
      <view class="brand">
        <text>梦食鲜</text>
      </view>
      <view class="nav-right-space"></view>
    </view>
    <view class="search-row">
      <image src="/assets/icons/search.svg" mode="aspectFit" />
      <input value="{{query}}" placeholder="搜索商品" placeholder-class="search-placeholder" confirm-type="search" bindinput="onSearchInput" bindconfirm="startSearch" />
      <button bindtap="startSearch">搜索</button>
    </view>
  </view>
</template>

<view class="app-shell {{page == 'home' ? 'is-home' : ''}} {{motionReduced ? 'is-motion-reduced' : ''}}" style="{{fixedLayerStyle}}">
  <scroll-view class="page-scroll {{pageMotion ? 'is-page-entering' : ''}}" style="height: {{page == 'home' ? '100vh' : pageViewportHeight}}; margin-top: {{page == 'home' ? '0rpx' : navContentTop}};" scroll-y="true" scroll-top="{{pageScrollTop}}" enhanced="true" show-scrollbar="false">
    <block wx:if="{{page == 'home'}}">
      <swiper wx:if="{{bannerItems.length}}" class="home-hero-swiper" style="height: calc({{navSafeHeight}} + 100px + 310rpx);" autoplay="true" interval="4500" circular="true" indicator-dots="{{bannerItems.length > 1}}" indicator-color="rgba(255,255,255,.55)" indicator-active-color="#fff">
        <swiper-item wx:for="{{bannerItems}}" wx:key="headline">
          <view class="home-hero-slide">
            <template is="homeHeroHeader" data="{{warehouse: warehouse, navSafeHeight: navSafeHeight, query: query}}" />
            <view class="banner-slide">
              <image src="{{item.image}}" mode="aspectFill" />
              <view class="banner-shade"></view>
              <view class="banner-copy">
                <text>{{item.eyebrow}}</text>
                <text>{{item.headline}}</text>
                <text>{{item.subline}}</text>
              </view>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <swiper wx:else class="home-hero-swiper" style="height: calc({{navSafeHeight}} + 100px + 310rpx);" autoplay="{{false}}" circular="{{false}}" indicator-dots="{{false}}">
        <swiper-item>
          <view class="home-hero-slide">
            <template is="homeHeroHeader" data="{{warehouse: warehouse, navSafeHeight: navSafeHeight, query: query}}" />
            <view class="banner-empty">
              <image src="/assets/products/frozen-hero-v2.jpg" mode="aspectFill" />
              <view class="banner-shade"></view>
              <view class="banner-copy">
                <text>精选冻品 · 冷链严选</text>
                <text>鲜冻好物\n悦享团圆</text>
                <text>配送范围与费用在下单前确认</text>
              </view>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view class="home-categories">
<block wx:if="{{homeCategories.length}}">
<view class="home-category" wx:for="{{homeCategories}}" wx:key="label" aria-role="button" aria-label="查看{{item.label}}分类" hover-class="control-pressed" bindtap="openCategory" data-category="{{item.label}}">
<image src="{{item.image}}" mode="aspectFill" />
<text>{{item.label}}</text>
</view>
</block>
<block wx:elif="{{catalogStatus == 'loading'}}">
<view class="home-category is-skeleton" wx:for="{{homeCategorySkeletons}}" wx:key="id" aria-hidden="true"><view class="home-category-skeleton-face"></view><view class="home-category-skeleton-label"></view></view>
</block>
<view wx:else class="home-category-state"><text>分类暂时无法显示</text></view>
</view>
      <view class="section-heading">
<view>
<text>{{specialTitle}}</text>
<text>{{specialSubtitle}}</text>
</view>
</view>
      <view class="deal-list">
<block wx:if="{{specials.length}}">
<view class="deal-card" wx:for="{{specials}}" wx:key="id" aria-role="button" aria-label="查看商品：{{item.name}}" hover-class="control-pressed" bindtap="openProduct" data-id="{{item.id}}">
<view class="deal-photo">
<image src="{{item.img || '/assets/products/placeholder.svg'}}" mode="aspectFit" />
<text wx:if="{{item.tag && item.tag != '待补充'}}">{{item.tag}}</text>
</view>
<view class="deal-copy">
<text>{{item.name}}</text>
<text>{{item.unit}}</text>
<view>
<text class="price-pending {{item.priceTemporary ? 'is-temporary' : (!item.priceText ? 'is-locked' : '')}}">{{item.priceText || priceFallback}}</text>

</view>
</view>
<button wx:if="{{item.specs && item.specs.length > 1}}" disabled="{{loggedIn && item.priceUnavailable}}" class="choose-spec quantity-first-trigger {{loggedIn && item.priceUnavailable ? 'is-unavailable' : ''}}" hover-class="control-pressed" catchtap="openQuantityPicker" data-id="{{item.id}}"><text class="choose-spec-face">{{loggedIn && item.priceUnavailable ? '暂不可售' : '选数量'}}</text></button>
<quantity-stepper wx:else quantity="{{item.cartQty || 0}}" max="{{item.maximumQuantity || 999}}" disabled="{{loggedIn && item.priceUnavailable}}" compact bind:change="changeQuantity" data-id="{{item.id}}" data-spec="{{item.specLabel || item.unit}}" />
</view>
</block>
<block wx:elif="{{catalogStatus == 'loading'}}">
<view class="deal-card deal-card-skeleton" aria-hidden="true"><view class="deal-skeleton-photo"></view><view class="deal-skeleton-copy"><view></view><view></view><view></view></view><view class="deal-skeleton-action"></view></view>
<view class="deal-card deal-card-skeleton" aria-hidden="true"><view class="deal-skeleton-photo"></view><view class="deal-skeleton-copy"><view></view><view></view><view></view></view><view class="deal-skeleton-action"></view></view>
</block>
<view wx:elif="{{catalogStatus == 'error'}}" class="home-load-state is-error"><text>{{catalogErrorTitle}}</text><text>{{catalogErrorText}}</text><button hover-class="control-pressed" bindtap="retryRemoteCatalog">重新加载商品</button></view>
<view wx:else class="home-load-state"><text>暂时没有特价商品</text><text>商品上架后会在这里显示</text></view>
</view>
      <view class="tabbar-bottom-space {{cartCount ? 'has-quick-checkout' : ''}}">
</view>
    </block>

    <block wx:elif="{{page == 'category'}}">
      <view class="sub-head">
<button class="back-control" aria-label="返回首页" bindtap="switchTab" data-tab="home">‹</button>
<view>
<text>商品分类</text>
<text>冷链送到家</text>
</view>
<view class="sub-head-spacer"></view>
</view>
      <view class="catalog-search">
<text>⌕</text>
<input value="{{query}}" placeholder="搜索冻品、火锅食材、早餐面点" bindinput="onSearchInput" bindconfirm="startSearch" />
<button bindtap="startSearch">搜索</button>
</view>
      <scroll-view class="major-scroll" scroll-x="true" show-scrollbar="false">
<view class="major-track">
<view class="major-item {{categoryGroup == item.id ? 'is-active' : ''}}" wx:for="{{categoryGroups}}" wx:key="id" aria-role="button" aria-pressed="{{categoryGroup == item.id}}" aria-label="选择{{item.label}}" hover-class="control-pressed" bindtap="selectGroup" data-group="{{item.id}}">
<image src="{{item.image}}" mode="aspectFill" />
<text>{{item.label}}</text>
</view>
</view>
</scroll-view>
      <view class="catalog-layout" style="height: {{catalogHeight}};">
<scroll-view class="catalog-side" scroll-y="true" show-scrollbar="false">
<view class="side-item {{category == item ? 'is-active' : ''}}" wx:for="{{subCategories}}" wx:key="*this" aria-role="button" aria-pressed="{{category == item}}" aria-label="选择{{item}}" hover-class="control-pressed" bindtap="selectCategory" data-category="{{item}}">{{item}}</view>
</scroll-view>
<scroll-view class="catalog-results" scroll-y="true" scroll-top="{{catalogResultsScrollTop}}" show-scrollbar="false">
<view class="result-title">
<text>{{category == '全部' ? activeGroup.label : category}}</text>
<text wx:if="{{catalogBrowseLoading}}">正在加载…</text>
<text wx:else>共 {{categoryProducts.length || '0'}} 件</text>
</view>
<view wx:if="{{catalogStatus == 'loading'}}" class="catalog-empty is-loading">
<text>正在加载商品</text>
</view>
<view wx:elif="{{catalogStatus == 'error'}}" class="catalog-empty is-error">
<text>{{catalogErrorTitle}}</text>
<text>{{catalogErrorText}}</text>
<button bindtap="retryRemoteCatalog">重新加载</button>
</view>
<view wx:elif="{{catalogBrowseLoading && !categoryProducts.length}}" class="catalog-empty is-loading">
<text>正在查找商品</text>
<text>结果到达后会立即显示</text>
</view>
<view wx:elif="{{catalogBrowseError && !categoryProducts.length}}" class="catalog-empty is-error">
<text>{{catalogBrowseError}}</text>
<button hover-class="control-pressed" bindtap="retryCatalogBrowse">重试</button>
</view>
<view wx:elif="{{!categoryProducts.length}}" class="catalog-empty">
<text>没有找到相关冻品</text>
<text>换个关键词，或从上方分类继续挑选</text>
</view>
<block wx:elif="{{catalogStatus == 'ready'}}">
<view class="catalog-row" wx:for="{{categoryProducts}}" wx:key="id" aria-role="button" aria-label="查看商品：{{item.name}}" hover-class="control-pressed" bindtap="openProduct" data-id="{{item.id}}">
<image src="{{item.img || '/assets/products/placeholder.svg'}}" mode="aspectFit" />
<view>
<text>{{item.name}}</text>
<text>{{item.specLabel || item.unit}}</text>
<text class="price-pending {{item.priceTemporary ? 'is-temporary' : (!item.priceText ? 'is-locked' : '')}}">{{item.priceText || priceFallback}}</text>
</view>
<button wx:if="{{item.specs && item.specs.length > 1}}" disabled="{{loggedIn && item.priceUnavailable}}" class="choose-spec quantity-first-trigger {{loggedIn && item.priceUnavailable ? 'is-unavailable' : ''}}" hover-class="control-pressed" catchtap="openQuantityPicker" data-id="{{item.id}}"><text class="choose-spec-face">{{loggedIn && item.priceUnavailable ? '暂不可售' : '选数量'}}</text></button>
<quantity-stepper wx:else quantity="{{item.cartQty || 0}}" max="{{item.maximumQuantity || 999}}" disabled="{{loggedIn && item.priceUnavailable}}" compact bind:change="changeQuantity" data-id="{{item.id}}" data-spec="{{item.specLabel || item.unit}}" />
</view>
</block>
<view wx:if="{{catalogBrowseLoading && categoryProducts.length}}" class="catalog-inline-status is-loading">正在补充更多商品…</view>
<view wx:if="{{catalogBrowseError && categoryProducts.length}}" class="catalog-inline-status is-error"><text>{{catalogBrowseError}}</text><button hover-class="control-pressed" bindtap="retryCatalogBrowse">重试</button></view>
<view class="catalog-bottom-space {{cartCount ? 'has-quick-checkout' : ''}}">
</view>
</scroll-view>
</view>
    </block>

    <block wx:elif="{{page == 'mealIdeas'}}">
<view class="sub-head meal-head">
<view>
<text>今天吃什么</text>
<text>按场景挑菜，选好食材再加入购物车</text>
</view>
<button class="meal-shuffle" bindtap="shuffleMealIdeas">换一批</button>
</view>
<view class="meal-intro">
<view>
<text>一顿饭，从一道想吃的菜开始</text>
</view>
<image src="/assets/icons/meal.svg" mode="aspectFit" />
</view>
<block wx:if="{{mealIdeaRows.length || mealIdeasStatus == 'ready'}}">
<view class="meal-scene-filter">
<text class="meal-scene-label">按用餐场景筛选</text>
<view class="meal-scene-track">
<button class="{{mealScene == item ? 'is-active' : ''}}" wx:for="{{mealScenes}}" wx:key="*this" bindtap="selectMealScene" data-scene="{{item}}">{{item}}</button>
</view>
</view>
<view wx:if="{{mealIdeaRows.length}}" class="meal-grid">
<view class="meal-card" wx:for="{{mealIdeaRows}}" wx:key="id" aria-role="button" aria-label="查看菜品搭配：{{item.title}}" hover-class="control-pressed" bindtap="openMealIdea" data-id="{{item.id}}">
<view class="meal-card-cover" style="background: {{item.accent}};">
<image src="{{item.cover}}" mode="aspectFill" />
<text>{{item.scene}}</text>
</view>
<view class="meal-card-copy">
<text>{{item.title}}</text>
<text>{{item.cookMinutes}} 分钟 · {{item.servings}}</text>
<button catchtap="openMealIdea" data-id="{{item.id}}">查看搭配</button>
</view>
</view>
</view>
<view wx:else class="meal-state"><text>暂时没有符合条件的菜品</text><text>可切换上方场景继续挑选</text></view>
</block>
<block wx:elif="{{mealIdeasStatus == 'loading'}}">
<view class="meal-grid meal-grid-skeleton" aria-hidden="true">
<view class="meal-card meal-card-skeleton"><view class="meal-skeleton-cover"></view><view class="meal-skeleton-copy"><view></view><view></view><view></view></view></view>
<view class="meal-card meal-card-skeleton"><view class="meal-skeleton-cover"></view><view class="meal-skeleton-copy"><view></view><view></view><view></view></view></view>
<view class="meal-card meal-card-skeleton"><view class="meal-skeleton-cover"></view><view class="meal-skeleton-copy"><view></view><view></view><view></view></view></view>
<view class="meal-card meal-card-skeleton"><view class="meal-skeleton-cover"></view><view class="meal-skeleton-copy"><view></view><view></view><view></view></view></view>
</view>
</block>
<view wx:elif="{{mealIdeasStatus == 'error'}}" class="meal-state is-error"><text>菜品搭配加载失败</text><text>{{mealIdeasErrorText}}</text><button hover-class="control-pressed" bindtap="retryRemoteCatalog">重新加载菜品</button></view>
<view wx:else class="meal-state"><text>暂时没有菜品搭配</text><text>商品与菜品配置完成后会在这里显示</text></view>
<view class="meal-bottom-space {{cartCount ? 'has-quick-checkout' : ''}}"></view>
    </block>

    <block wx:elif="{{page == 'mealIdea'}}">
<view class="detail-head meal-detail-head">
<button class="back-control" aria-label="返回吃什么" bindtap="backToMealIdeas">‹</button>
<text>菜品搭配</text>
<view></view>
</view>
<view class="meal-detail-hero">
<image src="{{selectedMealIdea.cover}}" mode="aspectFill" />
<view style="background: linear-gradient(90deg, {{selectedMealIdea.accent}}, transparent);"></view>
<text>{{selectedMealIdea.scene}}</text>
</view>
<view class="meal-detail-copy">
<text>{{selectedMealIdea.title}}</text>
<text>{{selectedMealIdea.summary}}</text>
<view>
<text>约 {{selectedMealIdea.cookMinutes}} 分钟</text>
<text>{{selectedMealIdea.servings}}</text>
</view>
</view>
<view class="meal-section">
<text class="meal-section-title">简单做法</text>
<view class="meal-step" wx:for="{{selectedMealIdea.steps}}" wx:key="*this" wx:for-index="stepIndex">
<text>{{stepIndex + 1}}</text>
<text>{{item}}</text>
</view>
</view>
<view class="meal-section">
<view class="meal-section-heading">
<text class="meal-section-title">搭配食材</text>
</view>
<view wx:if="{{selectedMealIdea.linkedProducts.length}}" class="meal-product-list">
<view class="meal-product" wx:for="{{selectedMealIdea.linkedProducts}}" wx:key="id" bindtap="openProduct" data-id="{{item.id}}">
<image src="{{item.img || '/assets/products/placeholder.svg'}}" mode="aspectFit" />
<view>
<text>{{item.name}}</text>
<text>{{item.specLabel || item.unit}}</text>
</view>
<button catchtap="openProduct" data-id="{{item.id}}">查看商品</button>
</view>
</view>
<view wx:else class="meal-product-empty">
<text>相关食材正在补充</text>
<text>你仍可从分类页按菜名关键词挑选商品</text>
</view>
</view>
<view class="meal-disclaimer">本页为选菜灵感，不构成营养、健康或烹饪安全建议；请按商品包装说明充分加热。</view>
<view class="meal-bottom-space {{cartCount ? 'has-quick-checkout' : ''}}"></view>
    </block>

    <block wx:elif="{{page == 'frequent'}}">
<view class="sub-head">
<view>
<text>常购清单</text>
<text>快速补货</text>
</view>
</view>
<view class="frequent-banner">
<view>
<text>高频采购</text>
</view>
<button wx:if="{{!frequentHasMultiSku}}" bindtap="addFrequent">全部加购</button>
<text wx:else class="frequent-spec-hint">逐个选择</text>
</view>
      <view class="simple-list">
<view class="simple-row" wx:for="{{frequent}}" wx:key="id" aria-role="button" aria-label="查看商品：{{item.name}}" hover-class="control-pressed" bindtap="openProduct" data-id="{{item.id}}">
<image src="{{item.img || '/assets/products/placeholder.svg'}}" mode="aspectFit" />
<view>
<text>{{item.name}}</text>
<text>{{item.specLabel || item.unit}}</text>
<text class="price-pending {{item.priceTemporary ? 'is-temporary' : (!item.priceText ? 'is-locked' : '')}}">{{item.priceText || priceFallback}}</text>
</view>
<button wx:if="{{item.specs && item.specs.length > 1}}" disabled="{{loggedIn && item.priceUnavailable}}" class="choose-spec quantity-first-trigger {{loggedIn && item.priceUnavailable ? 'is-unavailable' : ''}}" hover-class="control-pressed" catchtap="openQuantityPicker" data-id="{{item.id}}"><text class="choose-spec-face">{{loggedIn && item.priceUnavailable ? '暂不可售' : '选数量'}}</text></button>
<quantity-stepper wx:else quantity="{{item.cartQty || 0}}" max="{{item.maximumQuantity || 999}}" disabled="{{loggedIn && item.priceUnavailable}}" compact bind:change="changeQuantity" data-id="{{item.id}}" data-spec="{{item.specLabel || item.unit}}" />
</view>
</view>
<view class="tabbar-bottom-space {{cartCount ? 'has-quick-checkout' : ''}}">
</view>
    </block>

    <block wx:elif="{{page == 'cart'}}">
      <view class="sub-head">
<view>
<text>购物车</text>
<text><text class="cart-head-count">{{cartCount}} 件</text> 商品 · {{warehouse.name}}配送</text>
</view>
<button wx:if="{{cartCount}}" class="text-btn" aria-label="清空购物车" hover-class="control-pressed" bindtap="clearCart">清空</button>
</view>
      <view wx:if="{{cartCount}}">
<view class="delivery-note">
<image src="/assets/icons/truck.svg" mode="aspectFit" />
<view>
<text>{{address.name ? warehouse.eta : '填写地址后确认送达时间'}}</text>
<text>配送范围、时间与费用以确认订单为准</text>
</view>
</view>
<view class="cart-list">
<view class="cart-row" wx:for="{{cartItems}}" wx:key="cartKey">
<checkbox class="cart-check" aria-label="{{item.selected !== false ? '取消选择' : '选择'}} {{item.name}}" value="{{item.cartKey}}" checked="{{item.selected !== false}}" bindchange="toggleCartSelection" data-sku-id="{{item.skuId}}" data-id="{{item.id}}" data-spec="{{item.selectedSpec}}" />
<image src="{{item.img || '/assets/products/placeholder.svg'}}" mode="aspectFit" />
<view>
<text>{{item.name}}</text>
<text class="cart-spec">{{item.selectedSpec}}</text>
<text wx:if="{{item.purchaseRuleText}}" class="cart-purchase-rule">{{item.purchaseRuleText}}</text>
<text class="cart-unit-price price-pending {{item.priceTemporary ? 'is-temporary' : (!item.priceText ? 'is-locked' : '')}}">{{item.priceText ? (item.priceText + (item.priceUnitLabel ? ' / ' + item.priceUnitLabel : '')) : priceFallback}}</text>
</view>
<view class="stepper">
<button aria-label="减少{{item.name}}数量" hover-class="control-pressed" bindtap="changeQuantity" data-id="{{item.id}}" data-spec="{{item.selectedSpec}}" data-delta="-1"><text class="step-face" aria-hidden="true">−</text></button>
<text>{{item.qty}}</text>
<button aria-label="增加{{item.name}}数量" hover-class="control-pressed" bindtap="changeQuantity" data-id="{{item.id}}" data-spec="{{item.selectedSpec}}" data-delta="1"><text class="step-face" aria-hidden="true">+</text></button>
</view>
</view>
</view>
<view class="cart-bottom-space"></view>
<view class="cart-total">
<view class="cart-total-copy">
<text>已选 {{selectedCartCount}} / {{cartCount}} 件</text>
<text>合计 <text>{{selectedCartTotal}}</text></text>
</view>
<button disabled="{{!selectedCartCount}}" bindtap="goCheckout">去结算</button>
</view>
</view>
<view wx:else class="empty-state">
<image src="/assets/icons/cart.svg" mode="aspectFit" />
<text>购物车还是空的</text>
<text>去首页挑一些喜欢的食材吧</text>
<button bindtap="switchTab" data-tab="home">去逛逛</button>
</view>
    </block>

    <block wx:elif="{{page == 'mine'}}">
      <view class="sub-head">
<view>
<text>我的</text>
<text>欢迎回来，今天也要好好吃饭</text>
</view>
</view>
      <view wx:if="{{!loggedIn}}">
<view class="guest-card" aria-role="button" aria-label="微信登录" hover-class="control-pressed" bindtap="openLogin">
<image src="/assets/icons/user.svg" mode="aspectFit" />
<view>
<text>微信登录</text>
<text>登录后查看订单、优惠券和收货地址</text>
</view>
<text>›</text>
</view>
<view class="contact-strip" aria-role="button" aria-label="联系客服" hover-class="control-pressed" bindtap="openUtility" data-type="service">
<image src="/assets/icons/headset.svg" mode="aspectFit" />
<text>联系客服</text>
<text>咨询 ›</text>
</view>
</view>
      <view wx:else>
<view class="profile-card">
<view class="profile-top">
<view class="avatar">鲜</view>
<view>
<text>{{profileTitle}}</text>
<text>{{profileSub}}</text>
</view>
<button aria-label="打开账户设置" bindtap="openUtility" data-type="account">⚙</button>
</view>
<view class="profile-stats">
<button aria-label="查看优惠活动" hover-class="control-pressed" bindtap="openUtility" data-type="coupon">
<text>{{couponCount}}</text>
<text>优惠活动</text>
</button>
<button aria-label="查看积分" hover-class="control-pressed" bindtap="openUtility" data-type="points">
<text>{{points}}</text>
<text>积分</text>
</button>
<button aria-label="查看特价好物" hover-class="control-pressed" bindtap="openUtility" data-type="special">
<text>{{specials.length}}</text>
<text>特价好物</text>
</button>
</view>
</view>
<view class="member-banner" aria-role="button" aria-label="查看限时好价" hover-class="control-pressed" bindtap="openUtility" data-type="coupon">
<text>限时好价</text>
<text>家庭囤货更省心</text>
<text>查看好价 ›</text>
</view>
<view class="mine-card">
<view class="mine-title">
<text>我的订单</text>
<button class="mine-orders-action" aria-label="查看全部订单" hover-class="control-pressed" bindtap="openUtility" data-type="orders">全部订单 ›</button>
</view>
