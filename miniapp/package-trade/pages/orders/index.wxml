<view class="page">
  <view class="topbar"><text bindtap="back">‹</text><text>我的订单</text></view>
  <view class="filters"><view class="filter-track"><button wx:for="{{filters}}" wx:key="*this" class="{{filter == item ? 'active' : ''}}" bindtap="switchFilter" data-filter="{{item}}">{{item}}</button></view></view>
  <view wx:if="{{loading}}" class="empty">正在加载订单…</view>
  <view wx:elif="{{error}}" class="empty"><text>订单加载失败</text><text>{{errorText}}</text><button bindtap="retry">重新加载</button></view>
  <block wx:elif="{{rows.length}}">
    <view wx:for="{{rows}}" wx:key="id" class="order">
      <view><text>梦食鲜</text><text>{{item.status}}</text></view>
      <text class="order-number">{{item.summary}}</text><text wx:if="{{item.itemSummary}}" class="order-items">{{item.itemSummary}}</text><text class="order-delivery">{{item.deliveryTime}}</text><text class="order-total">{{item.amountLabel}} ¥{{item.total}}</text>
      <view class="actions">
        <button wx:if="{{item.canCancel}}" disabled="{{actionBusyId == item.id}}" bindtap="cancel" data-id="{{item.id}}">{{actionBusyId == item.id && actionBusyType == 'cancel' ? '处理中' : '取消订单'}}</button>
        <button wx:if="{{item.canConfirm}}" disabled="{{actionBusyId == item.id}}" bindtap="confirm" data-id="{{item.id}}">{{actionBusyId == item.id && actionBusyType == 'confirm' ? '处理中' : '确认收货'}}</button>
        <button wx:if="{{item.canRefund}}" disabled="{{actionBusyId == item.id}}" bindtap="refund" data-id="{{item.id}}">{{actionBusyId == item.id && actionBusyType == 'refund' ? '处理中' : '申请售后'}}</button>
      </view>
    </view>
    <button wx:if="{{hasMore || loadMoreError}}" class="load-more" disabled="{{loadingMore}}" bindtap="loadMore">{{loadingMore ? '正在加载…' : (loadMoreError ? '加载失败，点这里重试' : '查看更多订单')}}</button>
  </block>
  <view wx:else class="empty"><text>{{emptyTitle}}</text><text>{{emptyHint}}</text><button wx:if="{{hasMore || loadMoreError}}" bindtap="loadMore">{{loadingMore ? '正在加载…' : (loadMoreError ? '加载失败，点这里重试' : '继续查看更早订单')}}</button></view>
  <view wx:if="{{refundFormVisible}}" class="refund-mask" catchtap="closeRefundForm"><view class="refund-card" catchtap="noop"><text class="refund-title">申请售后</text><text class="refund-copy">请写明售后原因，提交后客服会跟进处理。</text><textarea class="refund-input" value="{{refundReason}}" maxlength="300" placeholder="例如：商品破损、少件、质量问题" bindinput="onRefundReasonInput"/><view class="refund-actions"><button bindtap="closeRefundForm">暂不申请</button><button bindtap="submitRefund">提交申请</button></view></view></view>
</view>
