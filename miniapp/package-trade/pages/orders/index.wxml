<view class="page">
  <responsive-topbar title="我的订单" bind:back="back"/>
  <view class="filters"><view class="filter-track"><button wx:for="{{filters}}" wx:key="*this" class="{{filter == item ? 'active' : ''}}" bindtap="switchFilter" data-filter="{{item}}">{{item}}</button></view></view>
  <view wx:if="{{loading}}" class="empty">正在加载订单…</view>
  <view wx:elif="{{error}}" class="empty"><text>订单加载失败</text><text>{{errorText}}</text><button bindtap="retry">重新加载</button></view>
  <block wx:elif="{{rows.length}}">
    <view wx:for="{{rows}}" wx:key="id" class="order" bindtap="openDetail" data-id="{{item.id}}">
      <view><text>梦食鲜</text><text>{{item.status}}</text></view>
      <text class="order-number">{{item.summary}}</text><text wx:if="{{item.itemSummary}}" class="order-items">{{item.itemSummary}}</text><text class="order-delivery">{{item.deliveryTime}}</text><text class="order-total">{{item.amountLabel}} ¥{{item.total}}</text>
      <view class="actions">
        <button wx:if="{{item.canCancel}}" disabled="{{actionBusyId == item.id}}" catchtap="cancel" data-id="{{item.id}}">{{actionBusyId == item.id && actionBusyType == 'cancel' ? '处理中' : '取消订单'}}</button>
        <button wx:if="{{item.canConfirm}}" disabled="{{actionBusyId == item.id}}" catchtap="confirm" data-id="{{item.id}}">{{actionBusyId == item.id && actionBusyType == 'confirm' ? '处理中' : '确认收货'}}</button>
        <button wx:if="{{item.canRefund}}" disabled="{{actionBusyId == item.id}}" catchtap="refund" data-id="{{item.id}}">申请售后</button>
        <button wx:if="{{item.afterSaleId}}" catchtap="viewAftersale" data-id="{{item.id}}">查看售后</button>
      </view>
    </view>
    <button wx:if="{{hasMore || loadMoreError}}" class="load-more" disabled="{{loadingMore}}" bindtap="loadMore">{{loadingMore ? '正在加载…' : (loadMoreError ? '加载失败，点这里重试' : '查看更多订单')}}</button>
  </block>
  <view wx:else class="empty"><text>{{emptyTitle}}</text><text>{{emptyHint}}</text><button wx:if="{{hasMore || loadMoreError}}" bindtap="loadMore">{{loadingMore ? '正在加载…' : (loadMoreError ? '加载失败，点这里重试' : '继续查看更早订单')}}</button></view>
</view>
