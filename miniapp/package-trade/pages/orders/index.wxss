.page{min-height:100vh;background:#f3f7fc;color:#203a53}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar text:first-child{font-size:52rpx;line-height:1}.topbar text:last-child{font-size:18px;font-weight:700}.filters{box-sizing:border-box;padding:18rpx;background:#fff}.filter-track{display:flex;gap:10rpx}.filters button{display:flex;align-items:center;justify-content:center;min-width:0;margin:0;padding:12rpx 8rpx;border-radius:28rpx;color:#687d91;background:#eef2f6;font-size:13px;line-height:1.25;flex:1}.filters button.active{color:#fff;background:#0a69e9}.order{display:flex;margin:18rpx;padding:24rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:10rpx}.order>view:first-child{display:flex;justify-content:space-between}.order>view:first-child text:first-child{font-size:16px;font-weight:700}.order>view:first-child text:last-child{color:#0a69e9;font-size:14px}.order-number{color:#203a53;font-size:14px;font-weight:600;line-height:1.35}.order-items{color:#2f5577;font-size:14px;line-height:1.5;overflow-wrap:anywhere}.order-delivery{color:#60768c;font-size:14px}.order-total{color:#e35d36;font-size:16px;font-weight:700}.actions{display:flex;justify-content:flex-end;gap:12rpx;padding-top:14rpx;border-top:1rpx solid #edf1f4}.actions button{margin:0;padding:10rpx 18rpx;border:1rpx solid #b7d4f1;border-radius:6rpx;color:#0a69e9;background:#fff;font-size:14px}.actions button:last-child{border-color:#0a69e9;color:#fff;background:#0a69e9}.empty{display:flex;padding:120rpx 36rpx;color:#60768c;flex-direction:column;gap:12rpx;text-align:center}.empty text:first-child{color:#203a53;font-size:16px;font-weight:700}.load-more{display:block;margin:8rpx 18rpx 36rpx;padding:16rpx;border:1rpx solid #b7d4f1;border-radius:8rpx;color:#0a69e9;background:#fff;font-size:14px}.refund-mask{position:fixed;inset:0;z-index:20;display:flex;align-items:flex-end;background:rgba(11,28,48,.45)}.refund-card{box-sizing:border-box;width:100%;padding:32rpx 28rpx 44rpx;border-radius:24rpx 24rpx 0 0;background:#fff}.refund-title{display:block;color:#203a53;font-size:18px;font-weight:700}.refund-copy{display:block;margin-top:12rpx;color:#60768c;font-size:14px}.refund-input{box-sizing:border-box;width:100%;height:180rpx;margin-top:24rpx;padding:16rpx;border:1rpx solid #b7d4f1;border-radius:8rpx;color:#203a53;font-size:16px}.refund-actions{display:flex;gap:16rpx;margin-top:24rpx}.refund-actions button{flex:1;margin:0;padding:16rpx;border:1rpx solid #b7d4f1;border-radius:8rpx;color:#0a69e9;background:#fff;font-size:16px}.refund-actions button:last-child{border-color:#0a69e9;color:#fff;background:#0a69e9}


/* 交付态控件层级：触控尺寸使用 px，避免窄屏被 rpx 继续缩小。 */
button {
  min-height: 44px;
  box-sizing: border-box;
  white-space: nowrap;
  line-height: 1.25;
}

.control-pressed {
  opacity: .72;
}

.empty {
  padding-top: 44rpx;
  padding-bottom: 44rpx;
}

.empty.state-loading {
  min-height: 320rpx;
}

.actions {
  flex-wrap: wrap;
}

.actions button {
  width: auto;
  min-width: 0;
  max-width: 100%;
  flex: 0 1 auto;
  white-space: normal;
  overflow-wrap: anywhere;
}

.refund-actions button {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  white-space: normal;
  overflow-wrap: anywhere;
}


input,
textarea,
picker {
  min-height: 44px;
  box-sizing: border-box;
  font-size: 14px;
}
