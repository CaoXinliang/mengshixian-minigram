.page{min-height:100vh;background:#f3f7fc;color:#203a53}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar text:first-child{font-size:52rpx;line-height:1}.topbar text:last-child{font-size:32rpx;font-weight:700}.filters{box-sizing:border-box;padding:18rpx;background:#fff}.filter-track{display:flex;gap:10rpx}.filters button{display:flex;align-items:center;justify-content:center;min-width:0;margin:0;padding:12rpx 8rpx;border-radius:28rpx;color:#687d91;background:#eef2f6;font-size:20rpx;line-height:1.25;flex:1}.filters button.active{color:#fff;background:#0a69e9}.order{display:flex;margin:18rpx;padding:24rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:10rpx}.order>view:first-child{display:flex;justify-content:space-between}.order>view:first-child text:first-child{font-size:25rpx;font-weight:700}.order>view:first-child text:last-child{color:#0a69e9;font-size:22rpx}.order-number{color:#203a53;font-size:24rpx;font-weight:600;line-height:1.35}.order-items{color:#2f5577;font-size:22rpx;line-height:1.5;overflow-wrap:anywhere}.order-delivery{color:#60768c;font-size:22rpx}.order-total{color:#e35d36;font-size:25rpx;font-weight:700}.actions{display:flex;justify-content:flex-end;gap:12rpx;padding-top:14rpx;border-top:1rpx solid #edf1f4}.actions button{margin:0;padding:10rpx 18rpx;border:1rpx solid #b7d4f1;border-radius:6rpx;color:#0a69e9;background:#fff;font-size:21rpx}.actions button:last-child{border-color:#0a69e9;color:#fff;background:#0a69e9}.empty{display:flex;padding:120rpx 36rpx;color:#60768c;flex-direction:column;gap:12rpx;text-align:center}.empty text:first-child{color:#203a53;font-size:27rpx;font-weight:700}
