<view class="page">
<responsive-topbar title="申请售后" subtitle="{{orderNo ? ('订单 ' + orderNo) : ''}}" bind:back="back"/>
  <view wx:if="{{status == 'loading'}}" class="state state-loading"><text>正在加载售后商品</text></view>
  <view wx:elif="{{status == 'error'}}" class="state error"><text>加载失败</text><text>{{errorText}}</text><button bindtap="retry">重新加载</button></view>
  <view wx:elif="{{status == 'empty'}}" class="state"><text>该订单当前不可申请售后</text><text>{{errorText}}</text><button bindtap="back">返回</button></view>
  <block wx:elif="{{status == 'ready'}}">
    <view class="card"><view class="application-heading"><text class="title">填写售后申请</text><text>选择商品与数量，金额以订单记录为准</text></view><text class="field-label">申请商品</text><view wx:for="{{items}}" wx:key="id" class="item {{item.selected ? 'selected' : ''}}"><view class="check" data-id="{{item.id}}" aria-role="checkbox" aria-disabled="{{submitLocked || draftFrozen}}" aria-checked="{{item.selected}}" aria-label="{{item.selected ? '取消选择' : '选择'}} {{item.name}}" hover-class="control-pressed" bindtap="toggleItem"><text aria-hidden="true">{{item.selected ? '✓' : ''}}</text></view><image src="{{item.media || '/assets/products/placeholder.svg'}}" mode="aspectFit"/><view class="item-info" data-id="{{item.id}}" aria-role="button" aria-disabled="{{submitLocked || draftFrozen}}" aria-label="{{item.selected ? '取消选择' : '选择'}} {{item.name}}" hover-class="control-pressed" bindtap="toggleItem"><text>{{item.name}}</text><text>{{item.spec}}</text><text>订单数量 ×{{item.orderedQuantity}} · 剩余可售后 ×{{item.remainingQuantity}}</text><text>实付分摊 ¥{{item.paidAmount}} · 当前可退 ¥{{item.refundableAmount}}</text></view><view class="quantity"><quantity-stepper compact disabled="{{submitLocked || draftFrozen}}" quantity="{{item.requestQuantity}}" min="{{1}}" max="{{item.remainingQuantity}}" step="{{1}}" bind:change="changeQuantity" data-id="{{item.id}}" /></view></view></view>
    <view class="card"><text class="title">售后原因</text><view class="reason-list"><view wx:for="{{reasons}}" wx:key="code" class="reason-trigger {{reasonCode == item.code ? 'active' : ''}}" data-code="{{item.code}}" aria-role="button" aria-disabled="{{submitLocked || draftFrozen}}" aria-label="选择售后原因 {{item.label}}" hover-class="control-pressed" bindtap="selectReason"><text class="reason-face">{{item.label}}</text></view></view><textarea disabled="{{submitLocked || draftFrozen}}" maxlength="500" value="{{description}}" bindinput="inputDescription" placeholder="请描述商品、包装与配送情况" cursor-spacing="96"/><text class="counter">{{description.length}}/500</text></view>
    <view class="card"><text class="title">上传凭证</text><text class="notice">最多添加 6 项；图片不超过 4 MB，视频不超过 10 MB。</text><view class="evidence"><view wx:for="{{evidence}}" wx:key="id"><image wx:if="{{item.path}}" src="{{item.path}}" mode="aspectFill"/><text wx:if="{{item.status == 'uploading'}}" class="evidence-status">上传中</text><text wx:if="{{item.status == 'failed'}}" class="evidence-status">上传失败</text><button wx:if="{{item.status == 'failed'}}" disabled="{{submitLocked || draftFrozen}}" class="evidence-action evidence-action-retry" data-id="{{item.id}}" aria-label="重试上传凭证" hover-class="control-pressed" bindtap="retryEvidence">重试上传</button><text wx:if="{{item.status == 'uploaded'}}" class="evidence-status evidence-status-success">已上传</text><text wx:if="{{item.status == 'pending'}}" class="evidence-status">待上传</text><button wx:if="{{item.status != 'uploading'}}" disabled="{{submitLocked || draftFrozen}}" class="evidence-action evidence-action-remove" data-id="{{item.id}}" aria-label="移除凭证" hover-class="control-pressed" bindtap="removeEvidence">移除</button></view><button wx:if="{{evidence.length < 6}}" disabled="{{submitLocked || draftFrozen}}" bindtap="chooseEvidence">＋ 添加凭证</button></view><text class="counter">{{evidence.length}}/6</text></view>
    <text wx:if="{{submitError}}" class="submit-error">{{submitError}}</text><button wx:if="{{submissionRecoveryPending}}" disabled="{{submitLocked}}" bindtap="querySubmissionResult">{{submitLocked ? '查询中' : '查询提交结果'}}</button><view class="submit-bar"><button class="cancel-action" bindtap="back" disabled="{{submitLocked}}">取消</button><button disabled="{{submitLocked || submissionRecoveryPending || !selectedItemCount || !reasonCode || (reasonCode == 'other' && !descriptionReady)}}" bindtap="submit">{{submitLocked ? '正在提交' : (draftFrozen ? '重新提交原申请' : '提交申请')}}</button></view>
  </block>
</view>
