<view class="page">
<responsive-topbar title="申请售后" subtitle="{{orderNo ? ('订单 ' + orderNo) : ''}}" bind:back="back"/>
  <view wx:if="{{status == 'loading'}}" class="state state-loading"><text>正在加载售后商品</text></view>
  <view wx:elif="{{status == 'error'}}" class="state error"><text>加载失败</text><text>{{errorText}}</text><button bindtap="retry">重新加载</button></view>
  <view wx:elif="{{status == 'empty'}}" class="state"><text>暂时无法申请售后</text><text>{{errorText}}</text><button bindtap="back">返回</button></view>
  <block wx:elif="{{status == 'ready'}}">
    <view class="card"><text class="title">1. 选择商品和数量</text><view wx:for="{{items}}" wx:key="id" class="item {{item.selected ? 'selected' : ''}}"><view class="check" data-id="{{item.id}}" aria-role="checkbox" aria-checked="{{item.selected}}" aria-label="{{item.selected ? '取消选择' : '选择'}} {{item.name}}" hover-class="control-pressed" bindtap="toggleItem"><text aria-hidden="true">{{item.selected ? '✓' : ''}}</text></view><image src="{{item.media || '/assets/products/placeholder.svg'}}" mode="aspectFit"/><view class="item-info" data-id="{{item.id}}" aria-role="button" aria-label="{{item.selected ? '取消选择' : '选择'}} {{item.name}}" hover-class="control-pressed" bindtap="toggleItem"><text>{{item.name}}</text><text>{{item.spec}}</text><text>订单数量 ×{{item.orderedQuantity}}</text><text>实付分摊 ¥{{item.paidAmount}} · 当前可退 ¥{{item.refundableAmount}}</text></view><view class="quantity"><button data-id="{{item.id}}" data-delta="-1" aria-label="减少 {{item.name}} 售后数量" bindtap="changeQuantity"><text aria-hidden="true">−</text></button><text>{{item.requestQuantity}}</text><button data-id="{{item.id}}" data-delta="1" aria-label="增加 {{item.name}} 售后数量" bindtap="changeQuantity"><text aria-hidden="true">＋</text></button></view></view></view>
    <view class="card"><text class="title">2. 选择原因</text><view class="reason-list"><text wx:for="{{reasons}}" wx:key="code" class="reason {{reasonCode == item.code ? 'active' : ''}}" data-code="{{item.code}}" aria-role="button" aria-label="选择售后原因 {{item.label}}" hover-class="control-pressed" bindtap="selectReason">{{item.label}}</text></view><textarea maxlength="500" value="{{description}}" bindinput="inputDescription" placeholder="请补充问题说明（最多500字）"/><text class="counter">{{description.length}}/500</text></view>
    <view class="card"><text class="title">3. 添加凭证（选填）</text><text class="notice">最多添加 6 项；图片不超过 4 MB，视频不超过 10 MB。</text><view class="evidence"><view wx:for="{{evidence}}" wx:key="id"><image wx:if="{{item.path}}" src="{{item.path}}" mode="aspectFill"/><text wx:if="{{item.status == 'uploading'}}">上传中</text><text wx:elif="{{item.status == 'failed'}}" data-id="{{item.id}}" aria-role="button" aria-label="重试上传凭证" hover-class="control-pressed" bindtap="retryEvidence">重试上传</text><text wx:elif="{{item.status == 'uploaded'}}">已上传</text><text wx:else data-id="{{item.id}}" aria-role="button" aria-label="移除凭证" hover-class="control-pressed" bindtap="removeEvidence">移除</text></view><button wx:if="{{evidence.length < 6}}" bindtap="chooseEvidence">＋ 添加凭证</button></view><text class="counter">{{evidence.length}}/6</text></view>
    <text wx:if="{{submitError}}" class="submit-error">{{submitError}}</text><view class="submit-bar"><button disabled="{{submitLocked}}" bindtap="submit">{{submitLocked ? '正在提交' : '提交售后申请'}}</button></view>
  </block>
</view>
