/* 交付态控件层级：触控尺寸使用 px，避免窄屏被 rpx 继续缩小。 */
button {
  min-height: 44px;
  box-sizing: border-box;
  white-space: nowrap;
  line-height: 1.25;
}

.control-pressed {
  opacity: .72;
}

.state {
  min-height: 0;
  padding-top: 44rpx;
  padding-bottom: 44rpx;
}

.state-loading {
  min-height: 320rpx;
}

.check,
.quantity button {
  width: 44px;
  min-width: 44px;
  height: 44px;
  min-height: 44px;
  padding: 0;
}


input,
textarea,
picker {
  min-height: 44px;
  box-sizing: border-box;
  font-size: 14px;
}

.reason,
.evidence text[aria-role="button"] {
  display: flex;
  align-items: center;
  min-height: 44px;
  box-sizing: border-box;
}

/* 底部内容占位与固定提交栏高度使用同一组安全区计算。 */
.page {
  padding-bottom: calc(44px + 30rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(44px + 30rpx + env(safe-area-inset-bottom));
}

.submit-bar {
  padding: 15rpx 18rpx calc(15rpx + constant(safe-area-inset-bottom));
  padding: 15rpx 18rpx calc(15rpx + env(safe-area-inset-bottom));
}

/* 凭证格留足操作文案宽度，窄屏自动换列，大字允许完整换行。 */
.evidence {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  gap: 8px;
}

.evidence > view,
.evidence > button {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 96px;
  box-sizing: border-box;
}

.evidence > button {
  padding: 8px;
  white-space: normal;
  line-height: 1.4;
}

.evidence > view text {
  justify-content: center;
  white-space: normal;
  line-height: 1.4;
}

/* Keep selection and quantity hit targets large while preserving small faces. */
.check {
  position: relative;
  width: 44px;
  min-width: 44px;
  height: 44px;
  border: 0;
  background: transparent;
}

.check::before {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 34rpx;
  max-width: 22px;
  height: 34rpx;
  max-height: 22px;
  border: 1px solid #a9bed2;
  border-radius: 50%;
  box-sizing: border-box;
  background: #fff;
  transform: translate(-50%, -50%);
  content: "";
}

.selected .check {
  border: 0;
  background: transparent;
}

.selected .check::before {
  border-color: #0a69e9;
  background: #0a69e9;
}

.check > text {
  position: relative;
  z-index: 1;
}

.quantity button {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.quantity button::after {
  border: 0;
}

.quantity button > text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  min-width: 0;
  max-width: 28px;
  height: 42rpx;
  max-height: 28px;
  box-sizing: border-box;
  border: 1px solid #829ab2;
  border-radius: 50%;
  color: #365675;
  background: #fff;
  line-height: 1;
}

.quantity button:last-child > text {
  border-color: #287ff1;
  color: #fff;
  background: #287ff1;
}

/* 凭证状态和可执行动作必须从视觉上明确区分。 */
.evidence-status,
.evidence-action {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 44px;
  margin: 0;
  padding: 5rpx 10rpx;
  border: 0;
  border-radius: 0;
  color: #fff;
  background: rgba(32, 58, 83, .82);
  font-size: 13px;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
}

.evidence-status-success {
  background: rgba(31, 132, 87, .9);
}

.evidence-action-retry {
  background: rgba(10, 105, 233, .94);
}

.evidence-action-remove {
  background: rgba(178, 65, 65, .92);
}

.evidence-action::after {
  border: 0;
}
