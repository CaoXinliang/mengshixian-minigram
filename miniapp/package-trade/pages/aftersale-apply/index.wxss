/* Pixso 顾客端展示：信息随内容展开，字号与触控尺寸不随屏宽缩小。 */
.page{min-height:100vh;padding-bottom:24px;background:#f5f8fc;color:#0f1b2d;font-size:14px;line-height:1.5}
button{display:flex;align-items:center;justify-content:center;width:auto;min-width:44px;min-height:44px;max-width:100%;margin:0;padding:0 16px;box-sizing:border-box;border:0;border-radius:22px;color:#176bd5;background:#eaf2fd;font-size:14px;font-weight:600;line-height:1.35;white-space:normal;overflow-wrap:anywhere}
button::after{border:0}
button[disabled]{opacity:1;color:#667085;background:#dce7f5}
.control-pressed{opacity:.72}
.card{display:flex;min-width:0;margin:12px 16px;padding:16px;border-radius:16px;background:#fff;flex-direction:column;gap:12px}
.title{color:#0f1b2d;font-size:16px;font-weight:700;line-height:1.4}
.state{display:flex;min-height:0;margin:12px 16px;padding:24px 16px;border-radius:16px;background:#fff;flex-direction:column;align-items:flex-start;gap:12px;text-align:left}
.state text:first-child{color:#0f1b2d;font-size:18px;font-weight:700}
.state text:nth-child(2){color:#667085;font-size:14px;overflow-wrap:anywhere}
.state button{align-self:center;margin-top:8px}
.state-loading{min-height:160px;justify-content:center}
.state.error{background:#fff4f2}
.state.error text:first-child{color:#c95042}
input,textarea,picker{min-width:0;min-height:44px;box-sizing:border-box;font-size:14px;color:#0f1b2d}

.application-heading{display:flex;margin:-16px -16px 0;padding:16px;border-radius:16px 16px 12px 12px;background:#eaf2fd;flex-direction:column;gap:6px}
.application-heading>text:last-child{color:#667085;font-size:14px}
.field-label{font-size:14px;font-weight:600}
.item{display:grid;min-width:0;padding:12px 0;border-top:1px solid #e6edf5;grid-template-columns:44px 56px minmax(0,1fr);align-items:center;gap:8px}
.item.selected{background:#f5f9ff}
.check{position:relative;display:flex;width:44px;min-width:44px;height:44px;align-items:center;justify-content:center;color:#fff;background:transparent}
.check::before{position:absolute;top:50%;left:50%;width:22px;height:22px;box-sizing:border-box;border:1px solid #a9bed2;border-radius:50%;background:#fff;transform:translate(-50%,-50%);content:""}
.selected .check::before{border-color:#176bd5;background:#176bd5}
.check>text{position:relative;z-index:1}
.item>image{width:56px;height:56px;border-radius:10px;background:#f0f6ff}
.item-info{display:flex;min-width:0;min-height:44px;flex-direction:column;gap:4px}
.item-info>text:first-child{display:-webkit-box;overflow:hidden;font-size:16px;font-weight:600;line-height:1.4;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.item-info>text:not(:first-child){color:#667085;font-size:13px;overflow-wrap:anywhere}
.quantity{display:flex;width:120px;min-width:120px;height:44px;grid-column:2/4;justify-self:end;align-items:center;gap:2px}
.quantity button{width:44px;min-width:44px;height:44px;padding:0;background:transparent;flex:none}
.quantity button>text{display:flex;width:28px;min-width:28px;height:28px;border:1px solid #829ab2;border-radius:50%;align-items:center;justify-content:center;color:#43566d;background:#fff;font-size:20px;line-height:1}
.quantity button:last-child>text{border-color:#176bd5;color:#fff;background:#176bd5}
.quantity>text{width:28px;min-width:28px;color:#0f1b2d;font-size:14px;text-align:center}
.reason-list{display:flex;min-width:0;gap:8px 12px;flex-wrap:wrap}
.reason-trigger{display:flex;min-width:44px;min-height:44px;max-width:100%;align-items:center;justify-content:center}
.reason-face{display:flex;min-height:36px;max-width:100%;padding:5px 14px;align-items:center;justify-content:center;border:1px solid #176bd5;border-radius:18px;color:#176bd5;background:#fff;font-size:14px;line-height:1.4;overflow-wrap:anywhere}
.reason-trigger.active .reason-face{background:#eaf2fd}
.card textarea{width:100%;height:128px;padding:14px;border:1px solid #d7e2ef;border-radius:12px;background:#f7faff;color:#0f1b2d;font-size:14px;line-height:1.5}
.counter{align-self:flex-end;color:#73859d;font-size:12px}
.notice{color:#667085;font-size:13px;line-height:1.5}
.evidence{display:grid;grid-template-columns:repeat(auto-fill,minmax(104px,1fr));gap:12px}
.evidence>view,.evidence>button{position:relative;width:100%;min-width:0;max-width:100%;height:104px;margin:0;overflow:hidden;border-radius:12px}
.evidence>view{display:flex;height:auto;flex-direction:column;align-self:start;background:#f5f8fc}
.evidence>button{padding:12px;color:#176bd5;background:#eaf2fd;font-size:14px;line-height:1.4}
.evidence image{width:100%;height:104px;flex:none}
.evidence-status,.evidence-action{position:static;display:flex;width:100%;min-height:44px;margin:0;padding:5px 8px;border:0;border-radius:0;box-sizing:border-box;flex:none;align-items:center;justify-content:center;color:#fff;background:rgba(32,58,83,.82);font-size:16px;font-weight:600;line-height:1.4;text-align:center;white-space:normal;overflow-wrap:anywhere}
.evidence-status-success{background:rgba(31,132,87,.9)}
.evidence-action-retry{background:rgba(23,107,213,.94)}
.evidence-action-remove{background:rgba(178,65,65,.92)}
.submit-error{display:block;margin:12px 16px;padding:12px;border-radius:12px;color:#c95042;background:#fff4f2;font-size:14px;overflow-wrap:anywhere}
.page{padding-bottom:calc(76px + constant(safe-area-inset-bottom));padding-bottom:calc(76px + env(safe-area-inset-bottom))}
.submit-bar{position:fixed;z-index:10;right:0;bottom:0;left:0;display:flex;min-height:64px;padding:10px 16px calc(10px + constant(safe-area-inset-bottom));padding:10px 16px calc(10px + env(safe-area-inset-bottom));box-sizing:border-box;background:#fff;align-items:center;justify-content:center;gap:12px}
.page>.submit-bar button{width:100%;min-width:0;max-width:100%;padding:0 16px;border:1px solid #176bd5;border-radius:22px;color:#fff;background:#176bd5;font-size:16px;flex:1}
.page>.submit-bar .cancel-action{color:#176bd5;background:#fff}
.page>.submit-bar button[disabled]{border-color:#d7e2ef;color:#667085;background:#dce7f5}
