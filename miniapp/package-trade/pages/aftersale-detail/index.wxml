<view class="page"><responsive-topbar title="售后详情" subtitle="查看申请与处理进度" bind:back="back"/><view wx:if="{{status == 'loading'}}" class="state state-loading"><text>正在加载售后进度</text></view><view wx:elif="{{status == 'error'}}" class="state error"><text>售后进度加载失败</text><text>{{errorText}}</text><button bindtap="retry">重新加载</button></view><view wx:elif="{{status == 'empty'}}" class="state"><text>未找到售后申请</text><text>{{errorText}}</text><button bindtap="back">返回订单</button></view><block wx:elif="{{detail}}"><view class="card hero"><text>{{detail.statusText}}</text><text>退款金额 ¥{{detail.amount}}</text><text>{{detail.updatedAt || detail.createdAt}}</text></view><view class="card"><text class="title">处理进度</text><view wx:for="{{detail.timeline}}" wx:key="key" class="timeline {{item.state}}"><view></view><view><text>{{item.label}}</text><text>{{item.note}}</text></view></view><text wx:if="{{detail.manualRefundRequired}}" class="channel-note">退款尚未完成，请以订单中的退款状态为准。</text></view><view class="card"><text class="title">申请信息</text><view class="row"><text>售后单号</text><text>{{detail.refundNo || detail.id}}</text></view><view class="row"><text>申请时间</text><text>{{detail.createdAt}}</text></view><view class="row"><text>申请原因</text><text>{{detail.reason || '未填写补充说明'}}</text></view><view class="row"><text>凭证数量</text><text>{{detail.mediaCount}} 个</text></view><view wx:if="{{detail.reviewNote}}" class="review-note"><text>审核说明</text><text>{{detail.reviewNote}}</text></view></view><view wx:if="{{detail.items.length}}" class="card"><text class="title">售后商品</text><view wx:for="{{detail.items}}" wx:key="orderItemId" class="item"><view><text>{{item.productNameSnapshot || '订单商品'}}</text><text>{{item.specSnapshot}} {{item.packageUnitSnapshot}}</text></view><text>×{{item.quantity}}</text></view></view></block></view>
