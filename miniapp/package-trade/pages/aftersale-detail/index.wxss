.page{min-height:100vh;background:#f3f7fc;color:#203a53}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:18px;font-weight:700}.topbar>view text:last-child{margin-top:5rpx;color:#dcecff;font-size:13px}.card{display:flex;margin:18rpx;padding:24rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:14rpx}.hero{color:#fff;background:linear-gradient(135deg,#0a69e9,#278bf4)}.hero text:first-child{font-size:18px;font-weight:700}.hero text:nth-child(2){font-size:16px}.hero text:last-child{color:#dcecff;font-size:13px}.title{font-size:16px;font-weight:700}.timeline{display:flex;align-items:flex-start;gap:14rpx;color:#8292a3}.timeline>view:first-child{width:15rpx;height:15rpx;margin-top:8rpx;border-radius:50%;background:#d5e0ea}.timeline>view:last-child{display:flex;flex-direction:column;gap:4rpx}.timeline>view:last-child text:first-child{font-size:14px;font-weight:700}.timeline>view:last-child text:last-child{font-size:13px}.timeline.done{color:#49647d}.timeline.done>view:first-child{background:#64b489}.timeline.current{color:#0a69e9}.timeline.current>view:first-child{background:#0a69e9;box-shadow:0 0 0 6rpx #e8f2ff}.timeline.error{color:#c95042}.timeline.error>view:first-child{background:#e56858}.channel-note,.source-note{color:#8b6430;background:#fff8ea;font-size:13px;line-height:1.55}.row{display:flex;justify-content:space-between;gap:20rpx;color:#60768c;font-size:14px}.row text:last-child{max-width:70%;color:#203a53;text-align:right;overflow-wrap:anywhere}.review-note{display:flex;padding:14rpx;border-radius:8rpx;color:#70501f;background:#fff7e8;flex-direction:column;gap:7rpx;font-size:14px}.review-note text:first-child{font-weight:700}.item{display:flex;align-items:center;justify-content:space-between;gap:14rpx;padding:13rpx 0;border-top:1rpx solid #edf1f4}.item>view{display:flex;min-width:0;flex:1;flex-direction:column;gap:5rpx}.item>view text:first-child{font-size:14px;font-weight:700}.item>view text:last-child,.item>text{color:#60768c;font-size:13px}.state{display:flex;align-items:center;justify-content:center;min-height:360rpx;margin:18rpx;padding:30rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx;text-align:center}.state text:first-child{font-size:16px;font-weight:700}.state text:nth-child(2){color:#60768c;font-size:14px}.state button{padding:10rpx 22rpx;color:#0a69e9;background:#edf5ff;font-size:14px}.state.error{background:#fff7f5}.state.error text:first-child{color:#c95042}


/* 交付态控件层级：触控尺寸使用 px，避免窄屏被 rpx 继续缩小。 */
button {
  min-height: 44px;
  box-sizing: border-box;
  white-space: nowrap;
  line-height: 1.25;
}

.control-pressed {
  opacity: .72;
}

.state {
  min-height: 0;
  padding-top: 44rpx;
  padding-bottom: 44rpx;
}

.state-loading {
  min-height: 320rpx;
}


input,
textarea,
picker {
  min-height: 44px;
  box-sizing: border-box;
  font-size: 14px;
}
