<view class="page">
  <responsive-topbar title="确认订单" subtitle="选择配送方式并确认商品" bind:back="back"/>
  <view wx:if="{{entryInvalid}}" class="load-error"><text>暂无结算内容</text><text>请从购物车选择商品后进入结算</text><button bindtap="back">返回购物车</button></view>
  <block wx:else>
  <view wx:if="{{loadError}}" class="load-error"><text>订单信息加载失败</text><text>{{loadErrorText}}</text><button bindtap="retryLoad">重新加载</button></view>
  <view wx:if="{{quoteState == 'error'}}" class="quote-error"><text>订单金额暂时无法计算</text><text>{{quoteErrorText}}</text><button bindtap="retryQuote">重新计算</button></view>
  <view class="card fulfillment-card"><text class="section-title">收货方式</text><view class="fulfillment-tabs"><button class="{{fulfillmentType == 'delivery' ? 'active' : ''}}" bindtap="selectFulfillmentType" data-type="delivery">冷链配送</button><button wx:if="{{!groupMode}}" class="{{fulfillmentType == 'pickup' ? 'active' : ''}}" bindtap="selectFulfillmentType" data-type="pickup">到店自提</button></view><text wx:if="{{groupMode}}">拼团订单仅支持冷链配送</text></view>
  <view wx:if="{{fulfillmentType == 'delivery'}}" class="address-card" bindtap="chooseAddress" aria-role="button" aria-label="管理收货地址" hover-class="control-pressed"><view><text wx:if="{{address.name}}">{{address.name}} {{address.masked}}</text><text wx:else>请先添加收货地址</text><text>{{address.detail || '填写后可确认配送费和送达范围'}}</text></view><text>管理 <text aria-hidden="true">›</text></text></view>
  <view class="card"><text class="section-title">{{fulfillmentType == 'pickup' ? '自提安排' : '配送方式'}}</text><view class="warehouse-list"><button wx:for="{{warehouses}}" wx:key="id" class="{{warehouse.id == item.id ? 'active' : ''}}" bindtap="selectWarehouse" data-id="{{item.id}}">{{item.name}}</button></view><block wx:if="{{fulfillmentType == 'delivery'}}"><text wx:if="{{!warehouse}}">当前暂无可配送仓库</text><text>配送范围：{{warehouseAreaText}}</text><view wx:if="{{deliverySlotsContractAvailable}}" class="delivery-slot-section"><text class="delivery-slot-title">选择配送时段</text><view wx:if="{{deliverySlots.length}}" class="delivery-slot-list"><button wx:for="{{deliverySlots}}" wx:key="id" class="{{deliverySlot.id == item.id ? 'active' : ''}}" bindtap="selectDeliverySlot" data-id="{{item.id}}"><text>{{item.name}}</text><text wx:if="{{item.startTime || item.endTime}}">{{item.startTime}}-{{item.endTime}}</text></button></view><view wx:else class="delivery-slot-empty">当前仓库与收货区域暂无可用配送时段，暂不能提交订单</view></view></block><block wx:else><view wx:if="{{pickupSites.length}}" class="pickup-list"><button wx:for="{{pickupSites}}" wx:key="id" class="pickup-site {{pickupSite.id == item.id ? 'active' : ''}}" bindtap="selectPickupSite" data-id="{{item.id}}"><text>{{item.name}}</text><text>{{item.address}}</text><text>营业时间：{{item.openingHours}}</text></button></view><view wx:else class="delivery-slot-empty">当前仓库暂无可用自提点，请切换仓库</view></block><text wx:if="{{quoteState == 'ready' && fulfillmentType == 'pickup' && pickupFree}}">自提免运费</text><text wx:elif="{{quoteState == 'ready' && fulfillmentType == 'pickup'}}">自提服务费 ¥{{freightTotal}}</text><text wx:elif="{{quoteState == 'ready'}}">本次配送费 ¥{{freightTotal}}</text><text wx:elif="{{quoteState == 'invalid'}}">{{quoteErrorText}}</text><text wx:elif="{{quoteState == 'error'}}">金额计算失败，请重试</text><text wx:else>正在计算本次订单金额</text></view>
  <view class="card"><text class="section-title">商品清单</text><view class="item" wx:for="{{cartItems}}" wx:key="id"><image src="{{item.image}}" mode="aspectFit"/><view><text>{{item.name}}</text><text>{{item.unit}} × {{item.qty}}</text><text wx:if="{{item.unitPriceText}}" class="item-unit-price">单价 ¥{{item.unitPriceText}}</text></view><text wx:if="{{item.subtotalText}}" class="item-amount">¥{{item.subtotalText}}</text><text wx:else class="item-quote-pending">待计算</text></view><view wx:if="{{!cartItems.length}}" class="empty">购物车暂无可结算商品</view></view>
  <view wx:if="{{!groupMode}}" class="card coupon-entry" bindtap="chooseCoupon" aria-role="button" aria-label="选择优惠券" hover-class="control-pressed"><view><text class="section-title">优惠券</text><text>{{coupon ? (coupon.name || '已选择优惠券') : '选择可用优惠券'}}</text></view><text>{{couponId ? '更换' : '选择'}}</text></view>
  <view class="card total"><view><text>商品小计</text><text>¥{{cartTotal}}</text></view><view><text>{{fulfillmentType == 'pickup' ? '自提服务费' : '配送费'}}</text><text wx:if="{{fulfillmentType == 'pickup' && quoteState == 'ready' && pickupFree}}">免运费</text><text wx:else>¥{{freightTotal}}</text></view><view wx:if="{{discountTotal != '0.00'}}"><text>优惠券抵扣</text><text>-¥{{discountTotal}}</text></view><view><text>应付合计</text><text>¥{{orderTotal}}</text></view></view>
  <view class="bottom"><button disabled="{{quoteState != 'ready' || submitting}}" bindtap="submitOrder">{{submitting ? '正在提交订单' : (quoteState == 'ready' ? '提交订单' : (quoteState == 'error' ? '请先重新计算金额' : (quoteState == 'invalid' ? '暂不能提交订单' : '正在计算订单金额')))}}</button></view>
  </block>
</view>
