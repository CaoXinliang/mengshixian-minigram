<view class="page">
  <responsive-topbar
    title="确认订单"
    subtitle="选择配送方式并确认商品"
    bind:back="back"
  />

  <view class="checkout-body">
  <view wx:if="{{entryInvalid}}" class="state-card state-card-error load-error">
    <text class="state-title">暂无结算内容</text>
    <text class="state-copy">请从购物车选择商品后进入结算</text>
    <button class="state-action" bindtap="back">
      <text class="state-action-face">返回购物车</text>
    </button>
  </view>

  <block wx:else>
    <view wx:if="{{loadError}}" class="state-card state-card-error load-error">
      <text class="state-title">订单信息加载失败</text>
      <text class="state-copy">{{loadErrorText}}</text>
      <button class="state-action" bindtap="retryLoad">
        <text class="state-action-face">重新加载</text>
      </button>
    </view>

    <view wx:if="{{quoteState == 'error'}}" class="state-card state-card-error quote-error">
      <text class="state-title">订单金额暂时无法计算</text>
      <text class="state-copy">{{quoteErrorText}}</text>
      <button class="state-action" bindtap="retryQuote">
        <text class="state-action-face">重新计算</text>
      </button>
    </view>

    <view wx:if="{{inquiryQuoteInvalid}}" class="state-card state-card-error quote-error">
      <text class="state-title">询价报价已失效</text>
      <text class="state-copy">{{quoteErrorText}}</text>
      <button class="state-action" bindtap="returnToInquiry">
        <text class="state-action-face">返回询价单</text>
      </button>
    </view>

    <view wx:if="{{orderSubmitState == 'unknown' || orderSubmitState == 'resolving'}}" class="state-card state-card-error quote-error">
      <text class="state-title">订单结果正在核对</text>
      <text class="state-copy">{{orderSubmitText}}</text>
      <button class="state-action" disabled="{{submitting}}" bindtap="queryOrderResult">
        <text class="state-action-face">{{orderSubmitState == 'resolving' ? '正在查询' : '查询订单结果'}}</text>
      </button>
    </view>

    <view wx:if="{{orderSubmitState == 'error' || orderSubmitState == 'not_found'}}" class="state-card {{orderSubmitState == 'error' ? 'state-card-error' : ''}} quote-error">
      <text class="state-title">{{orderSubmitState == 'error' ? '订单未能创建' : '未查询到已创建订单'}}</text>
      <text class="state-copy">{{orderSubmitText}}</text>
    </view>

    <view class="card fulfillment-card">
      <view class="section-heading">
        <text class="section-title">收货方式</text>
        <text wx:if="{{groupMode}}" class="section-helper">拼团订单仅支持冷链配送</text>
      </view>
      <view class="{{groupMode ? 'fulfillment-tabs fulfillment-tabs-single' : 'fulfillment-tabs'}}">
        <button
          class="fulfillment-option {{fulfillmentType == 'delivery' ? 'active' : ''}}"
          bindtap="selectFulfillmentType"
          data-type="delivery"
        >冷链配送</button>
        <button
          wx:if="{{!groupMode}}"
          class="fulfillment-option {{fulfillmentType == 'pickup' ? 'active' : ''}}"
          bindtap="selectFulfillmentType"
          data-type="pickup"
        >到店自提</button>
      </view>
    </view>

    <view
      wx:if="{{fulfillmentType == 'delivery'}}"
      class="address-card"
      bindtap="chooseAddress"
      aria-role="button"
      aria-label="选择收货地址"
      hover-class="control-pressed"
    >
      <view class="address-mark" aria-hidden="true">址</view>
      <view class="address-copy">
        <text wx:if="{{address.name}}" class="address-person">{{address.name}} {{address.masked}}</text>
        <text wx:else class="address-person">请先添加收货地址</text>
        <text class="address-detail">{{address.detail || '填写后可确认配送费和送达范围'}}</text>
      </view>
      <view class="address-action">
        <text>选择</text>
        <text aria-hidden="true">›</text>
      </view>
    </view>

    <view class="card delivery-card">
      <view class="section-heading">
        <text class="section-title">{{fulfillmentType == 'pickup' ? '自提安排' : '配送方式'}}</text>
      </view>

      <view class="warehouse-section">
        <text class="field-label">履约仓库</text>
        <view class="warehouse-list">
          <button
            wx:for="{{warehouses}}"
            wx:key="id"
            class="warehouse-option {{warehouse.id == item.id ? 'active' : ''}}"
            bindtap="selectWarehouse"
            data-id="{{item.id}}"
          >{{item.name}}</button>
        </view>
      </view>

      <block wx:if="{{fulfillmentType == 'delivery'}}">
        <text wx:if="{{!warehouse}}" class="section-note section-note-warning">当前暂无可配送仓库</text>
        <text class="section-note">配送范围：{{warehouseAreaText}}</text>
        <view wx:if="{{deliverySlotsContractAvailable}}" class="delivery-slot-section">
          <text class="field-label delivery-slot-title">选择配送时段</text>
          <view wx:if="{{deliverySlots.length}}" class="delivery-slot-list">
            <button
              wx:for="{{deliverySlots}}"
              wx:key="id"
              class="delivery-slot-option {{deliverySlot.id == item.id ? 'active' : ''}}"
              bindtap="selectDeliverySlot"
              data-id="{{item.id}}"
            >
              <text>{{item.name}}</text>
              <text wx:if="{{item.startTime || item.endTime}}" class="delivery-slot-time">{{item.startTime}}-{{item.endTime}}</text>
            </button>
          </view>
          <view wx:else class="delivery-slot-empty">当前仓库与收货区域暂无可用配送时段，暂不能提交订单</view>
        </view>
      </block>

      <block wx:else>
        <view wx:if="{{pickupSites.length}}" class="pickup-list">
          <button
            wx:for="{{pickupSites}}"
            wx:key="id"
            class="pickup-site {{pickupSite.id == item.id ? 'active' : ''}}"
            bindtap="selectPickupSite"
            data-id="{{item.id}}"
          >
            <text>{{item.name}}</text>
            <text>{{item.address}}</text>
            <text>营业时间：{{item.openingHours}}</text>
          </button>
        </view>
        <view wx:else class="delivery-slot-empty">当前仓库暂无可用自提点，请切换仓库</view>
      </block>

      <view class="fee-status">
        <text wx:if="{{quoteState == 'ready' && fulfillmentType == 'pickup' && pickupFree}}">自提免运费</text>
        <text wx:elif="{{quoteState == 'ready' && fulfillmentType == 'pickup'}}">自提服务费 ¥{{freightTotal}}</text>
        <text wx:elif="{{quoteState == 'ready'}}">本次配送费 ¥{{freightTotal}}</text>
        <text wx:elif="{{quoteState == 'invalid'}}">{{quoteErrorText}}</text>
        <text wx:elif="{{quoteState == 'error'}}">金额计算失败，请重试</text>
        <text wx:else>正在计算本次订单金额</text>
      </view>
    </view>

    <view class="card product-card">
      <view class="section-heading">
        <text class="section-title">商品清单</text>
        <text class="section-helper">共 {{cartItemQty}} 件</text>
      </view>
      <view class="item" wx:for="{{cartItems}}" wx:key="id">
        <image class="item-image" src="{{item.image}}" mode="aspectFit" />
        <view class="item-copy">
          <text class="item-name">{{item.name}}</text>
          <text class="item-spec">{{item.unit}} × {{item.qty}}</text>
          <text wx:if="{{item.unitPriceText}}" class="item-unit-price">单价 ¥{{item.unitPriceText}}</text>
        </view>
        <text wx:if="{{item.subtotalText}}" class="item-amount">¥{{item.subtotalText}}</text>
        <text wx:else class="item-quote-pending">待计算</text>
      </view>
      <view wx:if="{{!cartItems.length}}" class="empty">购物车暂无可结算商品</view>
    </view>

    <view
      wx:if="{{!groupMode}}"
      class="card coupon-entry"
      bindtap="chooseCoupon"
      aria-role="button"
      aria-label="选择优惠券"
      hover-class="control-pressed"
    >
      <view class="coupon-copy">
        <text class="section-title">优惠券</text>
        <text class="coupon-description">{{coupon ? (coupon.name || '已选择优惠券') : '选择可用优惠券'}}</text>
      </view>
      <view class="coupon-action">
        <text>{{couponId ? '更换' : '选择'}}</text>
        <text aria-hidden="true">›</text>
      </view>
    </view>

    <view class="card total-card total">
      <view class="total-row">
        <text>商品小计</text>
        <text wx:if="{{quoteState == 'ready'}}">¥{{cartTotal}}</text>
        <text wx:else>—</text>
      </view>
      <view class="total-row">
        <text>{{fulfillmentType == 'pickup' ? '自提服务费' : '配送费'}}</text>
        <text wx:if="{{fulfillmentType == 'pickup' && quoteState == 'ready' && pickupFree}}">免运费</text>
        <text wx:elif="{{quoteState == 'ready'}}">¥{{freightTotal}}</text>
        <text wx:else>—</text>
      </view>
      <block wx:if="{{discountTotal != '0.00'}}">
        <view wx:if="{{quoteState == 'ready'}}" class="total-row total-discount">
          <text>优惠券抵扣</text>
          <text>-¥{{discountTotal}}</text>
        </view>
      </block>
      <view class="total-row total-payable">
        <text>应付合计</text>
        <text wx:if="{{quoteState == 'ready'}}">¥{{orderTotal}}</text>
        <text wx:else>—</text>
      </view>
    </view>

    <view class="bottom">
      <view class="bottom-summary">
        <text class="bottom-count">共 <text>{{cartItemQty}}</text> 件</text>
        <view class="bottom-divider" aria-hidden="true"></view>
        <text class="bottom-label">应付</text>
        <text wx:if="{{quoteState == 'ready'}}" class="bottom-amount">¥{{orderTotal}}</text>
        <text wx:else class="bottom-pending">待计算</text>
      </view>
      <button
        class="submit-button"
        disabled="{{quoteState != 'ready' || submitting || orderSubmitState == 'unknown' || orderSubmitState == 'resolving'}}"
        bindtap="submitOrder"
      >{{submitting ? '正在提交订单' : (quoteState == 'ready' ? '提交订单' : (quoteState == 'error' ? '请先重新计算金额' : (quoteState == 'invalid' ? '暂不能提交订单' : '正在计算订单金额')))}}</button>
    </view>
  </block>
  </view>
</view>
