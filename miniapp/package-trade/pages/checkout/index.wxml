<view class="page">
  <view class="topbar"><text bindtap="back">‹</text><view><text>确认订单</text><text>金额由服务端核验</text></view></view>
  <view wx:if="{{loadError}}" class="load-error"><text>订单信息加载失败</text><text>{{loadErrorText}}</text><button bindtap="retryLoad">重新加载</button></view>
  <view wx:if="{{quoteState == 'error'}}" class="quote-error"><text>本次报价暂时无法核验</text><text>{{quoteErrorText}}</text><button bindtap="retryQuote">重新核验报价</button></view>
  <view class="address-card" bindtap="chooseAddress"><view><text wx:if="{{address.name}}">{{address.name}} {{address.masked}}</text><text wx:else>请先添加收货地址</text><text>{{address.detail || '填写后可核验配送费和送达范围'}}</text></view><text>›</text></view>
  <view class="card"><text class="section-title">配送方式</text><view class="warehouse-list"><button wx:for="{{warehouses}}" wx:key="id" class="{{warehouse.id == item.id ? 'active' : ''}}" bindtap="selectWarehouse" data-id="{{item.id}}">{{item.name}}</button></view><text>{{warehouse ? warehouse.eta : '暂未配置配送仓'}}</text><text>配送范围：{{warehouseAreaText}}</text><text wx:if="{{quoteState == 'ready'}}">本次配送费 ¥{{freightTotal}}，金额已由服务端核验</text><text wx:elif="{{quoteState == 'invalid'}}">{{quoteErrorText}}</text><text wx:elif="{{quoteState == 'error'}}">报价暂时失败，请重新核验</text><text wx:else>正在按收货地址核验配送费</text></view>
  <view class="card"><text class="section-title">商品清单</text><view class="item" wx:for="{{cartItems}}" wx:key="id"><image src="{{item.image}}" mode="aspectFit"/><view><text>{{item.name}}</text><text>{{item.unit}} × {{item.qty}}</text><text wx:if="{{item.unitPriceText}}" class="item-unit-price">单价 ¥{{item.unitPriceText}}</text></view><text wx:if="{{item.subtotalText}}" class="item-amount">¥{{item.subtotalText}}</text><text wx:else class="item-quote-pending">以报价为准</text></view><view wx:if="{{!cartItems.length}}" class="empty">购物车暂无可结算商品</view></view>
  <view class="card total"><view><text>商品小计</text><text>¥{{cartTotal}}</text></view><view><text>配送费</text><text>¥{{freightTotal}}</text></view><view><text>应付合计</text><text>¥{{orderTotal}}</text></view></view>
  <view class="bottom"><button disabled="{{quoteState != 'ready' || submitting}}" bindtap="submitOrder">{{submitting ? '正在锁定订单' : (quoteState == 'ready' ? '确认订单并进入支付确认' : (quoteState == 'error' ? '请先重新核验报价' : '请先完善收货与商品信息'))}}</button></view>
</view>
