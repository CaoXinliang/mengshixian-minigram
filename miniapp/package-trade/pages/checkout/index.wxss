/* 交付态控件层级：触控尺寸使用 px，避免窄屏被 rpx 继续缩小。 */
button {
  min-height: 44px;
  box-sizing: border-box;
  white-space: nowrap;
  line-height: 1.25;
}

.control-pressed {
  opacity: .72;
}


input,
textarea,
picker {
  min-height: 44px;
  box-sizing: border-box;
  font-size: 14px;
}

/* 底部内容占位与固定操作栏高度使用同一组安全区计算。 */
.page {
  padding-bottom: calc(44px + 32rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(44px + 32rpx + env(safe-area-inset-bottom));
}

.bottom {
  padding: 16rpx 18rpx calc(16rpx + constant(safe-area-inset-bottom));
  padding: 16rpx 18rpx calc(16rpx + env(safe-area-inset-bottom));
}

/* 仓库、配送时段和自提地址均可来自后台，不能被通用 nowrap 截断。 */
.warehouse-list {
  flex-wrap: wrap;
}

.warehouse-list button,
.delivery-slot-list button,
.pickup-site,
.pickup-site text,
.bottom button {
  max-width: 100%;
  min-width: 0;
  white-space: normal;
  overflow-wrap: anywhere;
  word-break: break-word;
}

/* Native buttons carry an intrinsic width in the simulator. Grid choices fill
 * their track; wrapped choices keep content width instead of escaping it. */
.fulfillment-tabs {
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
}

.fulfillment-tabs button {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
}

.warehouse-list button,
.delivery-slot-list button {
  width: auto;
  flex: 0 1 auto;
}

.pickup-site {
  width: 100%;
}
