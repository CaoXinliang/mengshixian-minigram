.page{min-height:100vh;padding-bottom:150rpx;background:#f3f7fc;color:#203a53}.topbar{display:flex;gap:20rpx;align-items:center;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx;line-height:1}.topbar view{display:flex;flex-direction:column}.topbar view text:first-child{font-size:32rpx;font-weight:700}.topbar view text:last-child{margin-top:6rpx;color:#dcecff;font-size:20rpx}.load-error{display:flex;margin:18rpx;padding:22rpx;border:1rpx solid #ffd4cd;border-radius:12rpx;background:#fff7f5;flex-direction:column;gap:10rpx}.load-error text:first-child{color:#c95042;font-size:25rpx;font-weight:700}.load-error text:nth-child(2){color:#8a6a66;font-size:22rpx}.load-error button{align-self:flex-start;margin:4rpx 0 0;padding:8rpx 20rpx;color:#0a69e9;background:#edf5ff;font-size:22rpx}.card,.address-card{display:flex;margin:18rpx;padding:24rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:14rpx}.address-card{flex-direction:row;align-items:center;justify-content:space-between}.address-card view{display:flex;flex:1;flex-direction:column;gap:8rpx}.address-card text:first-child,.section-title{font-size:26rpx;font-weight:700}.address-card text:nth-child(2),.card>text:not(.section-title){color:#60768c;font-size:22rpx}.warehouse-list{display:flex;gap:12rpx}.warehouse-list button{margin:0;padding:10rpx 18rpx;border:1rpx solid #b7d4f1;border-radius:28rpx;color:#0a69e9;background:#fff;font-size:22rpx}.warehouse-list button.active{color:#fff;background:#0a69e9}.item{display:flex;align-items:center;gap:16rpx;padding:16rpx 0;border-top:1rpx solid #edf1f4}.item image{width:86rpx;height:86rpx}.item view{display:flex;flex:1;min-width:0;flex-direction:column;gap:8rpx}.item view text:first-child{font-size:24rpx;font-weight:600}.item view text:last-child,.item>text{color:#60768c;font-size:21rpx}.item-unit-price{color:#60768c;font-size:20rpx}.item-amount{align-self:center;color:#e35d36;font-size:24rpx;font-weight:700;white-space:nowrap}.item-quote-pending{align-self:center;color:#60768c;font-size:20rpx;white-space:nowrap}.total>view{display:flex;justify-content:space-between}.total>view:last-child{margin-top:8rpx;color:#e35d36;font-size:29rpx;font-weight:700}.empty{color:#60768c;text-align:center}.bottom{position:fixed;right:0;bottom:0;left:0;padding:16rpx 18rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -4rpx 14rpx rgba(18,55,89,.1)}.bottom button{color:#fff;background:#0a69e9}.bottom button[disabled]{color:#9aaabd;background:#dce4ec}
.quote-error{display:flex;margin:18rpx;padding:22rpx;border:1rpx solid #ffd4cd;border-radius:12rpx;background:#fff7f5;flex-direction:column;gap:10rpx}.quote-error text:first-child{color:#c95042;font-size:25rpx;font-weight:700}.quote-error text:nth-child(2){color:#8a6a66;font-size:22rpx}.quote-error button{align-self:flex-start;margin:4rpx 0 0;padding:8rpx 20rpx;color:#0a69e9;background:#edf5ff;font-size:22rpx}
