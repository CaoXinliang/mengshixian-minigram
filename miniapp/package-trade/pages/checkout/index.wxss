.page {
  min-height: 100vh;
  padding: 0;
  padding-bottom: calc(104px + constant(safe-area-inset-bottom));
  padding-bottom: calc(104px + env(safe-area-inset-bottom));
  box-sizing: border-box;
  color: #0f1b2d;
  background: #f5f8fc;
  font-size: 16px;
}

.checkout-body {
  padding-top: 12px;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  box-sizing: border-box;
  margin: 0;
  font-size: 16px;
  line-height: 1.25;
}

button::after {
  border: 0;
}

.control-pressed {
  opacity: .72;
}

.card,
.address-card,
.state-card {
  width: calc(100% - 24px);
  margin: 0 12px 12px;
  box-sizing: border-box;
  border: 1px solid #e6edf5;
  border-radius: 16px;
  background: #fff;
  box-shadow: none;
}

.card {
  display: flex;
  padding: 16px;
  flex-direction: column;
  gap: 14px;
}

.section-heading {
  display: flex;
  min-width: 0;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
}

.section-title {
  min-width: 0;
  color: #0f1b2d;
  font-size: 20px;
  font-weight: 700;
  line-height: 1.35;
}

.section-helper {
  flex: 0 1 auto;
  min-width: 0;
  color: #46566b;
  font-size: 15px;
  line-height: 1.45;
  text-align: right;
  overflow-wrap: anywhere;
}

.state-card {
  display: flex;
  padding: 16px;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
}

.state-card-error {
  border-color: #ffd8d1;
  background: #fff8f6;
  box-shadow: none;
}

.state-title {
  color: #b9382f;
  font-size: 19px;
  font-weight: 700;
  line-height: 1.4;
}

.state-copy {
  color: #704f4a;
  font-size: 16px;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.state-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  width: auto;
  max-width: 100%;
  min-width: 44px;
  padding: 0;
  border: 0;
  color: inherit;
  background: transparent;
  font-weight: 600;
}

.state-action-face {
  display: inline-flex;
  min-height: 36px;
  padding: 0 14px;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1px solid #bfd8f8;
  border-radius: 999px;
  color: #176bd5;
  background: #eaf2fd;
  white-space: nowrap;
}

.fulfillment-card {
  gap: 12px;
}

.fulfillment-tabs {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 12px;
}

.fulfillment-tabs-single {
  grid-template-columns: minmax(0, 1fr);
}

.fulfillment-option,
.fulfillment-tabs button {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  padding: 0 14px;
  border: 1px solid #cddff5;
  border-radius: 999px;
  color: #176bd5;
  background: #fff;
  font-weight: 600;
  white-space: nowrap;
}

.fulfillment-option.active {
  border-color: #2f80ed;
  color: #fff;
  background: #2f80ed;
}

.address-card {
  display: grid;
  min-height: 82px;
  padding: 14px 16px;
  grid-template-columns: 36px minmax(0, 1fr) auto;
  align-items: center;
  gap: 12px;
}

.address-mark {
  display: flex;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  color: #176bd5;
  background: #eaf2fd;
  font-size: 17px;
  font-weight: 700;
  align-items: center;
  justify-content: center;
}

.address-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 5px;
}

.address-person {
  color: #0f1b2d;
  font-size: 19px;
  font-weight: 700;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.address-detail {
  display: block;
  color: #46566b;
  font-size: 16px;
  line-height: 1.45;
  overflow: visible;
  overflow-wrap: anywhere;
}

.address-action,
.coupon-action {
  display: flex;
  min-height: 44px;
  color: #176bd5;
  font-size: 16px;
  font-weight: 600;
  align-items: center;
  justify-content: center;
  gap: 3px;
  white-space: nowrap;
}

.delivery-card {
  gap: 13px;
}

.warehouse-section {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.field-label {
  color: #0f1b2d;
  font-size: 16px;
  font-weight: 700;
  line-height: 1.4;
}

.warehouse-list,
.delivery-slot-list {
  display: flex;
  min-width: 0;
  gap: 8px;
  flex-wrap: wrap;
}

.warehouse-option,
.warehouse-list button {
  width: auto;
  max-width: 100%;
  min-width: 0;
  padding: 0 15px;
  border: 1px solid #cddff5;
  border-radius: 999px;
  color: #176bd5;
  background: #fff;
  font-weight: 600;
  flex: 0 1 auto;
  white-space: normal;
  overflow-wrap: anywhere;
}

.warehouse-option.active {
  border-color: #2f80ed;
  color: #fff;
  background: #2f80ed;
}

.section-note {
  color: #46566b;
  font-size: 16px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.section-note-warning {
  color: #b9382f;
}

.delivery-slot-section {
  display: flex;
  padding-top: 13px;
  border-top: 1px solid #e6edf5;
  flex-direction: column;
  gap: 9px;
}

.delivery-slot-option,
.delivery-slot-list button {
  display: flex;
  width: auto;
  max-width: 100%;
  min-width: 132px;
  padding: 7px 14px;
  border: 1px solid #d4e1ef;
  border-radius: 12px;
  color: #43566d;
  background: #fff;
  text-align: left;
  flex: 0 1 auto;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  white-space: normal;
  overflow-wrap: anywhere;
}

.delivery-slot-option text:first-child {
  font-size: 16px;
  font-weight: 600;
  line-height: 1.35;
}

.delivery-slot-time {
  margin-top: 2px;
  color: #46566b;
  font-size: 15px;
  line-height: 1.35;
}

.delivery-slot-option.active {
  border-color: #2f80ed;
  color: #176bd5;
  background: #eaf2fd;
}

.delivery-slot-empty {
  padding: 12px;
  border-radius: 12px;
  color: #a43c31;
  background: #fff4f1;
  font-size: 16px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.pickup-list {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 9px;
}

.pickup-site {
  display: flex;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  padding: 11px 14px;
  border: 1px solid #d4e1ef;
  border-radius: 12px;
  color: #43566d;
  background: #fff;
  text-align: left;
  flex-direction: column;
  align-items: flex-start;
  white-space: normal;
  overflow-wrap: anywhere;
}

.pickup-site text:first-child {
  color: #0f1b2d;
  font-size: 17px;
  font-weight: 700;
  line-height: 1.4;
}

.pickup-site text:not(:first-child) {
  margin-top: 4px;
  color: #46566b;
  font-size: 16px;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.pickup-site.active {
  border-color: #2f80ed;
  background: #eaf2fd;
}

.pickup-site.active text:first-child {
  color: #176bd5;
}

.fee-status {
  display: flex;
  min-height: 40px;
  padding: 10px 12px;
  box-sizing: border-box;
  border-radius: 12px;
  color: #43566d;
  background: #f5f8fc;
  font-size: 16px;
  font-weight: 600;
  line-height: 1.45;
  align-items: center;
  overflow-wrap: anywhere;
}

.product-card {
  gap: 0;
}

.product-card .section-heading {
  padding-bottom: 12px;
}

.item {
  display: grid;
  min-width: 0;
  padding: 13px 0;
  border-top: 1px solid #e6edf5;
  grid-template-columns: 64px minmax(0, 1fr) auto;
  align-items: center;
  gap: 12px;
}

.item-image {
  width: 64px;
  height: 64px;
  border-radius: 12px;
  background: #f5f8fc;
}

.item-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 4px;
}

.item-name {
  display: -webkit-box;
  color: #0f1b2d;
  font-size: 19px;
  font-weight: 700;
  line-height: 1.4;
  overflow: hidden;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.item-spec {
  color: #46566b;
  font-size: 16px;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.item-unit-price {
  color: #46566b;
  font-size: 15px;
  line-height: 1.35;
}

.item-amount,
.item-quote-pending {
  min-width: 0;
  max-width: 112px;
  color: #ef5b45;
  font-size: 19px;
  font-weight: 700;
  line-height: 1.35;
  text-align: right;
  white-space: normal;
  overflow-wrap: anywhere;
  font-variant-numeric: tabular-nums;
}

.item-quote-pending {
  color: #46566b;
  font-size: 16px;
  font-weight: 600;
}

.empty {
  padding: 24px 10px 14px;
  border-top: 1px solid #e6edf5;
  color: #46566b;
  font-size: 16px;
  line-height: 1.5;
  text-align: center;
}

.coupon-entry {
  min-height: 74px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.coupon-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 5px;
}

.coupon-description {
  display: -webkit-box;
  color: #46566b;
  font-size: 16px;
  line-height: 1.4;
  overflow: hidden;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.coupon-action {
  flex: 0 0 auto;
}

.total-card {
  gap: 11px;
}

.total-row {
  display: flex;
  min-width: 0;
  color: #43566d;
  font-size: 16px;
  line-height: 1.45;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.total-row text:first-child {
  min-width: 0;
  overflow-wrap: anywhere;
}

.total-row text:last-child {
  min-width: 0;
  max-width: 100%;
  flex: 0 1 auto;
  color: #0f1b2d;
  text-align: right;
  white-space: normal;
  overflow-wrap: anywhere;
}

.total-discount text:last-child {
  color: #ef5b45;
}

.total-payable {
  margin-top: 2px;
  padding-top: 12px;
  border-top: 1px solid #e6edf5;
  color: #0f1b2d;
  font-size: 19px;
  font-weight: 700;
  align-items: baseline;
}

.total-payable text:last-child {
  color: #ef5b45;
  font-size: 24px;
}

.bottom {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  min-height: 66px;
  padding: 10px 12px calc(10px + constant(safe-area-inset-bottom));
  padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-top: 1px solid #e6edf5;
  background: rgba(255, 255, 255, .98);
  box-shadow: 0 -6px 18px rgba(24, 56, 92, .08);
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.bottom-summary {
  display: flex;
  flex: 1 1 auto;
  min-width: 0;
  color: #46566b;
  font-size: 16px;
  line-height: 1.2;
  align-items: baseline;
  gap: 5px;
  white-space: nowrap;
}

.bottom-count text {
  color: #0f1b2d;
  font-weight: 700;
}

.bottom-divider {
  width: 1px;
  height: 15px;
  margin: 0 2px;
  background: #d8e1eb;
  align-self: center;
}

.bottom-label {
  color: #43566d;
}

.bottom-amount {
  min-width: 0;
  color: #ef5b45;
  font-size: 24px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  flex: none;
}

.bottom-pending {
  color: #46566b;
  font-size: 16px;
  font-weight: 600;
}

.submit-button {
  width: auto;
  max-width: 160px;
  min-width: 112px;
  padding: 0 18px;
  border-radius: 999px;
  color: #fff;
  background: #2f80ed;
  font-size: 17px;
  font-weight: 700;
  flex: 0 1 auto;
  white-space: normal;
  overflow-wrap: anywhere;
}

.submit-button[disabled] {
  opacity: 1;
  border: 1px solid #c6d2df;
  color: #43566d;
  background: #dfe7f0;
}

@media (max-width: 360px) {
  .card,
  .address-card,
  .state-card {
    width: calc(100% - 20px);
    margin-right: 10px;
    margin-left: 10px;
  }

  .card,
  .state-card {
    padding-right: 14px;
    padding-left: 14px;
  }

  .address-card {
    padding-right: 12px;
    padding-left: 12px;
    grid-template-columns: 32px minmax(0, 1fr) auto;
    gap: 9px;
  }

  .address-mark {
    width: 32px;
    height: 32px;
  }

  .item {
    grid-template-columns: 58px minmax(0, 1fr);
    grid-template-rows: auto auto;
    gap: 9px;
  }

  .item-image {
    width: 58px;
    height: 58px;
    align-self: start;
    grid-column: 1;
    grid-row: 1 / 3;
  }

  .item-copy {
    grid-column: 2;
    grid-row: 1;
  }

  .item-amount,
  .item-quote-pending {
    max-width: none;
    margin-top: -3px;
    font-size: 19px;
    text-align: left;
    grid-column: 2;
    grid-row: 2;
  }

  .bottom {
    padding-right: 10px;
    padding-left: 10px;
    gap: 8px;
  }

  .bottom-summary {
    display: grid;
    align-items: baseline;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto auto;
    gap: 2px 5px;
  }

  .bottom-count {
    grid-column: 1 / 3;
    grid-row: 1;
  }

  .bottom-divider {
    display: none;
  }

  .bottom-label {
    grid-column: 1;
    grid-row: 2;
  }

  .bottom-amount,
  .bottom-pending {
    grid-column: 2;
    grid-row: 2;
  }

  .bottom-amount {
    font-size: 24px;
  }

  .submit-button {
    max-width: 150px;
    min-width: 104px;
    padding-right: 14px;
    padding-left: 14px;
    font-size: 16px;
  }
}

@media (min-width: 480px) {
  .card,
  .address-card,
  .state-card {
    width: calc(100% - 32px);
    margin-right: 16px;
    margin-left: 16px;
  }

  .card {
    padding: 18px;
  }

  .bottom {
    padding-right: 16px;
    padding-left: 16px;
  }
}

/* Keep enlarged totals and action copy readable at narrow phone widths. */
.bottom-summary{display:grid;grid-template-columns:auto minmax(0,1fr);gap:2px 5px;white-space:normal;line-height:1.3}
.bottom-count{grid-column:1/3;grid-row:1}
.bottom-divider{display:none}
.bottom-label{grid-column:1;grid-row:2}
.bottom-amount,.bottom-pending{grid-column:2;grid-row:2}
.bottom-amount{font-size:24px;white-space:normal;overflow-wrap:anywhere}
.submit-button{font-size:17px;line-height:1.4;min-height:48px;padding-top:6px;padding-bottom:6px}
.section-heading{flex-wrap:wrap}
.item-name{font-size:19px}
.field-label{font-size:17px}
