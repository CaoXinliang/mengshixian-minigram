<view class="page">
  <responsive-topbar title="订单详情" bind:back="back"/>
  <view wx:if="{{status == 'loading'}}" class="state state-loading"><text>正在加载订单详情</text></view>
  <view wx:elif="{{status == 'empty'}}" class="state"><text>订单不存在</text><text>{{errorText}}</text><button bindtap="back"><text class="action-face">返回订单列表</text></button></view>
  <view wx:elif="{{status == 'error'}}" class="state error"><text>订单详情加载失败</text><text>{{errorText}}</text><button bindtap="retry"><text class="action-face">重新加载</text></button></view>
  <block wx:elif="{{order}}">
    <view class="card status-card {{order.rawStatus == 'cancelled' ? 'is-cancelled' : ''}}"><view><text>{{order.statusText}}</text><text class="status-note">{{order.rawStatus == 'cancelled' ? '订单已取消，未进入后续履约' : '请以当前订单状态为准'}}</text><text>订单号 {{order.orderNo}}</text></view><text>{{order.updatedAt || order.createdAt}}</text></view>
    <view class="card"><text class="title">商品清单</text><view wx:for="{{order.items}}" wx:key="id" class="item"><image src="{{item.media || '/assets/products/placeholder.svg'}}" mode="aspectFit"/><view><text>{{item.name}}</text><text>{{item.spec}}</text><text wx:if="{{item.unitPrice}}">¥{{item.unitPrice}} × {{item.quantity}}</text></view><text>{{item.subtotal ? ('¥' + item.subtotal) : ('×' + item.quantity)}}</text></view><text wx:if="{{!order.items.length}}" class="muted">商品信息暂时无法显示</text></view>
    <view class="card"><text class="title">{{order.isPickup ? '自提信息' : '配送信息'}}</text><block wx:if="{{order.isPickup}}"><text>{{order.pickupSite.name || '自提点信息待确认'}}</text><text>{{order.pickupSite.address}}</text><text>营业时间：{{order.pickupSite.openingHours || '以门店通知为准'}}</text></block><block wx:else><text>{{order.address.name}} {{order.address.phoneMasked}}</text><text>{{order.address.detail}}</text><text>{{order.deliverySlot.name || '配送时间以订单状态为准'}}</text></block></view>
    <view class="card totals"><text class="title">金额明细</text><view><text>商品小计</text><text>¥{{order.goodsTotal}}</text></view><view><text>{{order.isPickup ? '自提服务费' : '配送费'}}</text><text>{{order.isPickup && order.freightTotal == '0' ? '免运费' : ('¥' + order.freightTotal)}}</text></view><view wx:if="{{order.couponSnapshot || order.discountTotal != '0'}}"><text>{{order.couponSnapshot.name || '优惠券抵扣'}}</text><text>-¥{{order.discountTotal}}</text></view><view><text>订单合计</text><text>¥{{order.total}}</text></view></view>
    <view class="card"><text class="title">{{order.progressTitle}}</text><text class="muted">{{order.progressHint}}</text><view wx:for="{{order.timeline}}" wx:key="key" wx:if="{{order.rawStatus != 'cancelled' || item.key == 'pending_payment' || item.current}}" class="timeline {{item.done ? 'done' : ''}} {{item.current ? 'current' : ''}}"><view></view><text>{{item.label}}</text><text>{{item.time}}</text></view></view>
    <view class="card"><text class="title">订单消息提醒</text><text class="muted">{{order.notificationText}}</text><button disabled="{{!order.notificationAvailable}}"><text class="action-face">{{order.notificationAvailable ? '设置提醒' : '暂未开放'}}</text></button></view>
    <view wx:if="{{order.afterSaleSummaryUnknown}}" class="card error"><text>售后状态暂时无法确认</text><text>为避免重复确认收货或申请售后，请重新加载后再操作。</text><button bindtap="retry"><text class="action-face">重新加载</text></button></view>
    <view wx:if="{{order.refundId || order.refundStatus}}" class="card aftersale-entry" bindtap="viewAftersale" aria-role="button" aria-label="查看售后退款进度" hover-class="control-pressed"><view><text>售后/退款进度</text><text>查看处理进度</text></view><text aria-hidden="true">›</text></view>
    <payment-recovery-panel wx:if="{{paymentRecovery}}" kind="{{paymentRecovery.kind}}" text="{{paymentRecovery.text}}" can-query="{{paymentRecovery.canQuery}}" can-retry="{{paymentRecovery.canRetry}}" busy="{{actionBusy != ''}}" bind:query="queryPaymentResult" bind:retry="preparePayment"/>
    <view wx:if="{{actionRecovery}}" class="card"><text class="muted">{{actionRecovery.text}}</text><button disabled="{{actionBusy}}" bindtap="resolveOrderAction"><text class="action-face">{{actionBusy == 'resolve' ? '查询中' : '查询操作结果'}}</text></button></view>
    <view wx:if="{{(order.canPay && !paymentRecovery) || order.canInvoice || order.canRepurchase || order.canReview || order.canCancel || order.canConfirm || order.canRefund}}" class="actions"><button wx:if="{{order.canPay && !paymentRecovery}}" disabled="{{actionBusy}}" bindtap="preparePayment"><text class="action-face">{{actionBusy == 'pay' ? '处理中' : '继续支付'}}</text></button><button wx:if="{{order.canInvoice}}" disabled="{{actionBusy}}" bindtap="requestInvoice"><text class="action-face">申请发票</text></button><button wx:if="{{order.canRepurchase}}" bindtap="repurchase"><text class="action-face">再次购买</text></button><button wx:if="{{order.canReview}}" bindtap="reviewOrder"><text class="action-face">评价晒单</text></button><button wx:if="{{order.canCancel}}" disabled="{{actionBusy}}" bindtap="cancelOrder"><text class="action-face">{{actionBusy == 'cancel' ? '处理中' : '取消订单'}}</text></button><button wx:if="{{order.canConfirm}}" disabled="{{actionBusy}}" bindtap="confirmReceipt"><text class="action-face">{{actionBusy == 'confirm' ? '处理中' : '确认收货'}}</text></button><button wx:if="{{order.canRefund}}" disabled="{{actionBusy}}" bindtap="applyAftersale"><text class="action-face">申请售后</text></button></view>
  </block>
</view>
