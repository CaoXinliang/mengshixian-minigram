<view class="page">
  <responsive-topbar title="订单详情" subtitle="金额与状态来自服务端" bind:back="back"/>
  <view wx:if="{{status == 'loading'}}" class="state"><text>正在加载订单详情</text></view>
  <view wx:elif="{{status == 'empty'}}" class="state"><text>订单不存在</text><text>{{errorText}}</text><button bindtap="back">返回订单列表</button></view>
  <view wx:elif="{{status == 'error'}}" class="state error"><text>订单详情加载失败</text><text>{{errorText}}</text><button bindtap="retry">重新加载</button></view>
  <block wx:elif="{{order}}">
    <view class="card status-card"><view><text>{{order.statusText}}</text><text>订单号 {{order.orderNo}}</text></view><text>{{order.updatedAt || order.createdAt}}</text></view>
    <view class="card"><text class="title">商品清单</text><view wx:for="{{order.items}}" wx:key="id" class="item"><image src="{{item.media || '/assets/products/placeholder.svg'}}" mode="aspectFit"/><view><text>{{item.name}}</text><text>{{item.spec}}</text><text wx:if="{{item.unitPrice}}">¥{{item.unitPrice}} × {{item.quantity}}</text></view><text>{{item.subtotal ? ('¥' + item.subtotal) : ('×' + item.quantity)}}</text></view><text wx:if="{{!order.items.length}}" class="muted">订单商品快照暂不可用</text></view>
    <view class="card"><text class="title">{{order.isPickup ? '自提信息' : '配送信息'}}</text><block wx:if="{{order.isPickup}}"><text>{{order.pickupSite.name || '自提点信息待同步'}}</text><text>{{order.pickupSite.address}}</text><text>营业时间：{{order.pickupSite.openingHours || '以门店通知为准'}}</text></block><block wx:else><text>{{order.address.name}} {{order.address.phoneMasked}}</text><text>{{order.address.detail}}</text><text>{{order.deliverySlot.name || '配送时间以订单状态为准'}}</text></block></view>
    <view class="card totals"><view><text>商品小计</text><text>¥{{order.goodsTotal}}</text></view><view><text>{{order.isPickup ? '自提服务费' : '配送费'}}</text><text>{{order.isPickup && order.freightTotal == '0' ? '免运费' : ('¥' + order.freightTotal)}}</text></view><view wx:if="{{order.couponSnapshot || order.discountTotal != '0'}}"><text>{{order.couponSnapshot.name || '优惠券抵扣'}}</text><text>-¥{{order.discountTotal}}</text></view><view><text>订单合计</text><text>¥{{order.total}}</text></view></view>
    <view class="card"><text class="title">订单进度</text><view wx:for="{{order.timeline}}" wx:key="key" class="timeline {{item.done ? 'done' : ''}} {{item.current ? 'current' : ''}}"><view></view><text>{{item.label}}</text><text>{{item.time}}</text></view></view>
    <view wx:if="{{order.refundId || order.refundStatus}}" class="card aftersale-entry" bindtap="viewAftersale"><view><text>售后/退款进度</text><text>查看服务端当前处理状态</text></view><text>›</text></view>
    <view class="actions"><button bindtap="repurchase">再次购买</button><button wx:if="{{order.canReview}}" bindtap="reviewOrder">评价晒单</button><button wx:if="{{order.canInvoice}}" bindtap="requestInvoice">申请发票</button><button wx:if="{{order.canCancel}}" disabled="{{actionBusy}}" bindtap="cancelOrder">{{actionBusy == 'cancel' ? '处理中' : '取消订单'}}</button><button wx:if="{{order.canPay}}" disabled="{{actionBusy}}" bindtap="preparePayment">{{actionBusy == 'pay' ? '准备支付' : (order.paymentMethod == 'demo' ? '继续支付确认' : '微信支付')}}</button><button wx:if="{{order.canConfirm}}" disabled="{{actionBusy}}" bindtap="confirmReceipt">{{actionBusy == 'confirm' ? '处理中' : '确认收货'}}</button><button wx:if="{{order.canRefund}}" disabled="{{actionBusy}}" bindtap="applyAftersale">申请售后</button></view>
  </block>
</view>
