.page{min-height:100vh;padding-bottom:150rpx;background:#f3f7fc;color:#203a53}.topbar{display:flex;align-items:center;gap:20rpx;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx}.topbar>view{display:flex;flex-direction:column}.topbar>view text:first-child{font-size:32rpx;font-weight:700}.topbar>view text:last-child{margin-top:5rpx;color:#dcecff;font-size:20rpx}.card{display:flex;margin:18rpx;padding:24rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx}.title{font-size:26rpx;font-weight:700}.muted,.card>text:not(.title){color:#60768c;font-size:22rpx}.status-card{flex-direction:row;align-items:center;justify-content:space-between}.status-card>view{display:flex;flex-direction:column;gap:6rpx}.status-card>view text:first-child{color:#0a69e9;font-size:30rpx;font-weight:700}.status-card>view text:last-child,.status-card>text{color:#60768c;font-size:20rpx}.item{display:flex;align-items:center;gap:14rpx;padding:13rpx 0;border-top:1rpx solid #edf1f4}.item image{width:82rpx;height:82rpx}.item>view{display:flex;min-width:0;flex:1;flex-direction:column;gap:6rpx}.item>view text:first-child{font-size:23rpx;font-weight:700}.item>view text:last-child,.item>text{color:#60768c;font-size:21rpx}.totals>view{display:flex;justify-content:space-between;color:#60768c;font-size:22rpx}.totals>view:last-child{padding-top:10rpx;border-top:1rpx solid #edf1f4;color:#e35d36;font-size:27rpx;font-weight:700}.timeline{display:grid;align-items:center;grid-template-columns:20rpx 1fr auto;gap:12rpx;color:#8292a3;font-size:21rpx}.timeline>view{width:14rpx;height:14rpx;border-radius:50%;background:#d5e0ea}.timeline.done{color:#49647d}.timeline.done>view{background:#86baf7}.timeline.current{color:#0a69e9;font-weight:700}.timeline.current>view{background:#0a69e9;box-shadow:0 0 0 7rpx #e8f2ff}.aftersale-entry{flex-direction:row;align-items:center;justify-content:space-between}.aftersale-entry>view{display:flex;flex-direction:column;gap:6rpx}.aftersale-entry>view text:first-child{font-weight:700}.aftersale-entry>view text:last-child{color:#60768c;font-size:21rpx}.actions{position:fixed;right:0;bottom:0;left:0;z-index:10;display:flex;justify-content:flex-end;padding:15rpx 18rpx calc(15rpx + env(safe-area-inset-bottom));gap:10rpx;background:#fff;box-shadow:0 -4rpx 14rpx rgba(18,55,89,.1)}.actions button{margin:0;padding:12rpx 18rpx;border:1rpx solid #0a69e9;border-radius:8rpx;color:#0a69e9;background:#fff;font-size:21rpx}.actions button:last-child{color:#fff;background:#0a69e9}.state{display:flex;align-items:center;justify-content:center;min-height:360rpx;margin:18rpx;padding:30rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx;text-align:center}.state text:first-child{font-size:27rpx;font-weight:700}.state text:nth-child(2){color:#60768c;font-size:22rpx}.state button{padding:10rpx 22rpx;color:#0a69e9;background:#edf5ff;font-size:22rpx}.state.error{background:#fff7f5}.state.error text:first-child{color:#c95042}
