/* 交付态控件层级：触控尺寸使用 px，避免窄屏被 rpx 继续缩小。 */
button {
  min-height: 44px;
  box-sizing: border-box;
  white-space: nowrap;
  line-height: 1.25;
}

.control-pressed {
  opacity: .72;
}

.state {
  min-height: 0;
  padding-top: 44rpx;
  padding-bottom: 44rpx;
}

.state-loading {
  min-height: 320rpx;
}

.actions {
  justify-content: flex-start;
  overflow-x: auto;
  flex-wrap: nowrap;
}


input,
textarea,
picker {
  min-height: 44px;
  box-sizing: border-box;
  font-size: 14px;
}

/* 底部内容占位与单行滚动操作栏高度使用同一组安全区计算。 */
.page {
  padding-bottom: calc(44px + 30rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(44px + 30rpx + env(safe-area-inset-bottom));
}

.actions {
  padding: 15rpx 18rpx calc(15rpx + constant(safe-area-inset-bottom));
  padding: 15rpx 18rpx calc(15rpx + env(safe-area-inset-bottom));
}

.actions button {
  width: auto;
  min-width: 0;
  max-width: 100%;
  flex: 0 0 auto;
}
