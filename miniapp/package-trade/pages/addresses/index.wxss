
.page{min-height:100vh;padding-bottom:150rpx;background:#f3f7fc;color:#203a53}.topbar{display:flex;gap:20rpx;align-items:center;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx;line-height:1}.topbar view{display:flex;flex-direction:column}.topbar view text:first-child{font-size:32rpx;font-weight:700}.topbar view text:last-child{margin-top:6rpx;color:#dcecff;font-size:20rpx}.state{display:flex;align-items:center;justify-content:center;min-height:300rpx;margin:18rpx;padding:28rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:12rpx;text-align:center}.state text:first-child{font-size:27rpx;font-weight:700}.state text:nth-child(2){color:#71879c;font-size:22rpx}.state button{margin-top:10rpx;padding:10rpx 24rpx;color:#0a69e9;background:#edf5ff;font-size:22rpx}.state.error{border:1rpx solid #ffd4cd;background:#fff7f5}.state.error text:first-child{color:#c95042}.address-list{margin:18rpx}.address-row{margin-bottom:14rpx;padding:22rpx;border:1rpx solid transparent;border-radius:12rpx;background:#fff}.address-row.is-default{border-color:#b8d7fb}.address-main{display:flex;gap:8rpx;flex-direction:column}.address-main>view{display:flex;align-items:center;gap:10rpx}.address-main>view>text:first-child{font-size:26rpx;font-weight:700}.address-main>view>text:nth-child(2){color:#49647d;font-size:22rpx}.address-main>text{color:#60768c;font-size:22rpx}.tag,.default-tag{padding:3rpx 8rpx;border-radius:5rpx;color:#60768c;background:#eef3f7;font-size:18rpx}.default-tag{color:#0a69e9;background:#eaf3ff}.address-actions{display:flex;justify-content:flex-end;margin-top:16rpx;padding-top:14rpx;border-top:1rpx solid #edf1f4;gap:10rpx}.address-actions button{margin:0;padding:8rpx 15rpx;border:1rpx solid #d5e0ea;border-radius:7rpx;color:#49647d;background:#fff;font-size:20rpx}.address-actions button:last-child{color:#c95042}.bottom{position:fixed;right:0;bottom:0;left:0;padding:16rpx 18rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -4rpx 14rpx rgba(18,55,89,.1)}.bottom button{color:#fff;background:#0a69e9}.form-card{display:flex;margin:18rpx;padding:24rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:18rpx}.form-note{display:flex;flex-direction:column;gap:6rpx}.form-note text:first-child{font-size:28rpx;font-weight:700}.form-note text:last-child{color:#71879c;font-size:20rpx}.wechat-import{margin:0;padding:12rpx;color:#0a69e9;background:#edf5ff;font-size:22rpx}.form-card>label{display:flex;flex-direction:column;gap:9rpx}.form-card>label>text{font-size:22rpx;font-weight:700}.form-card input,.form-card textarea,.region-picker{box-sizing:border-box;width:100%;padding:17rpx;border:1rpx solid #d8e3ed;border-radius:8rpx;background:#fbfdff;font-size:23rpx}.form-card textarea{height:128rpx}.region-picker{display:flex;justify-content:space-between;color:#49647d}.default-check{display:flex;align-items:center;color:#49647d;font-size:22rpx}.default-check checkbox{margin-right:10rpx}.form-actions{display:grid;grid-template-columns:1fr 1.35fr;gap:12rpx}.form-actions button{margin:0;border:1rpx solid #0a69e9;color:#0a69e9;background:#fff}.form-actions button:last-child{color:#fff;background:#0a69e9}

.form-card input{height:72rpx;padding:0 17rpx;line-height:72rpx}
.form-card textarea{padding:15rpx 17rpx;line-height:1.5}
.region-picker{padding:17rpx}

.form-card input{width:100%;min-width:0;box-sizing:border-box}
.form-actions{width:100%;grid-template-columns:minmax(0,1fr) minmax(0,1.35fr)}
.form-actions button{display:flex;align-items:center;justify-content:center;width:100%;min-width:0;height:80rpx;padding:0 12rpx;overflow:hidden;box-sizing:border-box;line-height:1.25;text-overflow:ellipsis;white-space:nowrap}

@media screen and (max-width: 360px){
  .form-card{margin-right:14rpx;margin-left:14rpx;padding-right:20rpx;padding-left:20rpx}
  .form-actions{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
}
