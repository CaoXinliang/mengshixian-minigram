.page{min-height:100vh;background:#f3f7fc;color:#203a53}.topbar{display:flex;gap:20rpx;align-items:center;padding:56rpx 28rpx 24rpx;background:#0a69e9;color:#fff}.topbar>text{font-size:52rpx;line-height:1}.topbar view{display:flex;flex-direction:column}.topbar view text:first-child{font-size:32rpx;font-weight:700}.topbar view text:last-child{margin-top:6rpx;color:#dcecff;font-size:20rpx}.hero{display:flex;margin:28rpx 18rpx;padding:34rpx;border-radius:14rpx;color:#fff;background:linear-gradient(135deg,#2b86ff,#1257bc);flex-direction:column;gap:14rpx}.hero text:first-child{align-self:flex-start;padding:5rpx 12rpx;border-radius:999rpx;color:#1665bd;background:#fff;font-size:20rpx;font-weight:700}.hero text:nth-child(2){font-size:34rpx;font-weight:700}.hero text:nth-child(3){color:#dcecff;font-size:22rpx}.hero text:last-child{margin-top:10rpx;color:#fff;font-size:38rpx;font-weight:700}.note{display:flex;margin:18rpx;padding:25rpx;border-radius:12rpx;background:#fff;flex-direction:column;gap:10rpx}.note text:first-child{font-size:25rpx;font-weight:700}.note text:last-child{color:#60768c;font-size:22rpx;line-height:1.6}.state{display:flex;padding:120rpx 36rpx;color:#60768c;text-align:center;align-items:center;flex-direction:column;gap:18rpx}.state button{min-width:240rpx;margin:0;color:#0a69e9;background:#fff;border:1rpx solid #b7d4f1}.bottom{position:fixed;right:0;bottom:0;left:0;padding:16rpx 18rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -4rpx 14rpx rgba(18,55,89,.1)}.bottom button{color:#fff;background:#0a69e9}
