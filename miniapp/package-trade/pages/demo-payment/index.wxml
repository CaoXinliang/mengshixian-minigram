<view class="page"><responsive-topbar title="订单支付" subtitle="查看订单金额" bind:back="back"/><view wx:if="{{loading}}" class="state state-loading">正在加载订单</view><view wx:elif="{{failed}}" class="state"><text>{{errorText}}</text><button wx:if="{{retryable}}" bindtap="retry">重新加载</button><button bindtap="back">返回订单页</button></view><block wx:else><view class="hero"><text>在线支付暂未开放</text><text>订单号 {{order.orderNo}}</text><text wx:if="{{order.itemSummary}}" class="item-summary">{{order.itemSummary}}</text><text>应付合计 ¥{{order.total}}</text></view><view class="bottom"><button bindtap="back">返回订单页</button></view></block></view>
