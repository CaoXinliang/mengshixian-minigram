<view class="page">
  <responsive-topbar title="订单结果" bind:back="back"/>
  <view wx:if="{{loading}}" class="state state-loading">正在加载订单</view>
  <view wx:elif="{{failed}}" class="state"><text>{{errorText}}</text><button wx:if="{{retryable}}" bindtap="retry">重新加载</button><button bindtap="back">返回订单页</button></view>
  <block wx:else>
    <view class="hero"><text class="result-badge {{order.rawStatus == 'cancelled' ? 'is-cancelled' : ''}}">{{order.status}}</text><text class="result-title">{{order.rawStatus == 'cancelled' ? '订单已取消' : '订单已提交'}}</text><text class="result-hint">{{order.trackingHint}}</text></view>
    <view class="card"><text class="title">订单信息</text><view class="row"><text>订单号</text><text>{{order.orderNo || order.id}}</text></view><view wx:if="{{order.itemSummary}}" class="row"><text>商品</text><text class="item-summary">{{order.itemSummary}}</text></view></view>
    <view class="card"><text class="title">订单金额</text><view class="row total-row"><text>应付合计</text><text>¥{{order.total}}</text></view></view>
    <payment-recovery-panel kind="{{paymentPresentation.kind}}" text="{{paymentPresentation.text}}" show-view-order="{{true}}" bind:vieworder="finish"/>
    <view class="bottom"><button bindtap="back">查看订单</button></view>
  </block>
</view>
