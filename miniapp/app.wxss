page {
  --color-brand-primary: #176bd5;
  --color-brand-soft: #eaf2fd;
  --color-text-primary: #0f1b2d;
  --color-text-secondary: #667085;
  --color-surface-page: #f5f8fc;
  --color-surface-card: #ffffff;
  --color-border-default: #d7e2ef;
  --color-state-success: #1aa76c;
  --color-state-warning: #d98b26;
  --color-state-danger: #e65353;
  --color-coupon-muted: #71839a;
  --color-coupon-status: #33506e;
  --color-coupon-muted-surface: #f8fafc;
  --color-coupon-error-surface: #fff4ef;
  --color-coupon-error-text: #9d3f2f;
  --color-coupon-success-surface: #eaf8f1;
  --color-coupon-success-text: #20734a;
  --color-coupon-disabled-surface: #dbe7f5;
  --color-coupon-disabled-text: #69849f;
  --space-sm: 8px;
  --space-md: 12px;
  --space-lg: 16px;
  --radius-card: 14px;
  --radius-coupon-card: 16px;
  --radius-pill: 22px;
  --font-caption: 12px;
  --font-support: 13px;
  --font-body: 14px;
  --font-title: 16px;
  --font-large-title: 18px;
  --font-coupon-section: 17px;
  --font-coupon-value: 20px;
  --control-hit: 44px;
  --control-face: 32px;
  min-height: 100%;
  background: var(--color-surface-page);
  color: var(--color-text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 14px;
}

view,
text,
image,
scroll-view,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

/* Shared responsive primitives. Page and component styles own their layout;
 * these rules only normalize native control sizing across platforms. */
button,
input,
textarea,
picker {
  min-width: 0;
  min-height: 44px;
  box-sizing: border-box;
  font-family: inherit;
}

textarea {
  min-height: 96px;
}

button[disabled] {
  opacity: 0.48;
}

/* Empty/error recovery actions keep a 44px target without inheriting the
 * native button's full-row visual width. Page-specific full-width submit
 * actions remain unaffected because they live outside .state/.empty. */
.state > button,
.empty > button {
  display: inline-flex;
  width: fit-content;
  min-width: 44px;
  max-width: 100%;
  min-height: 44px;
  align-self: center;
  flex: none;
}

.page > .bottom,
.page > .bar,
.page > .submit-bar {
  box-sizing: border-box;
}

.page > .bottom button,
.page > .bar button,
.page > .submit-bar button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  min-height: 44px;
  margin: 0;
  padding: 0 22rpx;
  box-sizing: border-box;
  line-height: 1.3;
}
